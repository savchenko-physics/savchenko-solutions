<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta name="robots" content="noindex, nofollow" />
    <%- include(`default/head_${lang}.ejs`) %>
    <%- include('default/main_site_header_head') %>
    <title><%= titleText(t.recoverTitle) %></title>
    <script src="/js/analytics.js"></script>
</head>
<body class="auth-page">
    <%- include('default/header.ejs') %>
    <div class="container1">
        <h2><%= t.recoverTitle %></h2>
        <% if (state === 'received') { %>
            <p class="success" role="status"><%= t.recoverReceived %></p>
        <% } else { %>
            <% if (error) { %>
                <p class="error" role="alert"><%= error %></p>
            <% } %>
            <p class="mt-0 mb-3"><%= t.recoverIntro %></p>
            <form action="/recover-account" method="POST">
                <input type="hidden" name="lang" value="<%= lang %>">
                <div class="form-group">
                    <label for="email"><%= t.recoverEmailLabel %></label>
                    <input type="email" id="email" name="email" value="<%= email %>" required maxlength="<%= limits.identifierMaxLength %>" autocomplete="email" />
                </div>
                <div class="form-group">
                    <label for="message"><%= t.recoverMessageLabel %></label>
                    <textarea id="message" name="message" class="ss-input" rows="4" maxlength="2000"><%= message %></textarea>
                </div>
                <button type="submit" class="submit-button"><%= t.recoverSubmit %></button>
            </form>
        <% } %>
        <p><a href="/<%= lang %>/login"><%= t.backToLogin %></a></p>
    </div>
    <%- include('default/modern_footer') %>
    <%- include('default/main_site_footer_scripts') %>
</body>
</html>
