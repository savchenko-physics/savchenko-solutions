<!DOCTYPE html>
<%
  const ru = pageLang === 'ru';
  // Dates, not "1 час назад" for everything.
  //
  // Relative time only survives the first week. Past that it turns real history into vague
  // mush ("8 месяцев назад" for a request made on a day you could name), and when a page is
  // freshly populated it makes every item claim to be minutes old, which reads as
  // manufactured. A written date is unambiguous and is the thing a sceptical reader checks.
  const RU_MONTHS = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
  const EN_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  function ago(d) {
    const t = new Date(d);
    const s = Math.max(0, (Date.now() - t.getTime()) / 1000);
    const pick = (n, forms) => {
      n = Math.floor(n);
      if (!ru) return `${n} ${forms[3]}${n === 1 ? '' : 's'} ago`;
      const m100 = n % 100, m10 = n % 10;
      const f = (m100 >= 11 && m100 <= 14) ? forms[2] : (m10 === 1 ? forms[0] : (m10 >= 2 && m10 <= 4 ? forms[1] : forms[2]));
      return `${n} ${f} назад`;
    };
    if (s < 60) return ru ? 'только что' : 'just now';
    if (s < 3600) return pick(s / 60, ['минуту', 'минуты', 'минут', 'minute']);
    if (s < 86400) return pick(s / 3600, ['час', 'часа', 'часов', 'hour']);
    if (s < 86400 * 7) return pick(s / 86400, ['день', 'дня', 'дней', 'day']);
    // UTC getters on purpose. A date-only string parses as UTC midnight, so reading it back
    // with local getters lands on the previous day for anyone west of Greenwich: 2024-12-28
    // rendered as "27 декабря". The server also stores timestamptz, so UTC is the one frame
    // that gives every reader the same answer.
    const day = t.getUTCDate(), mon = t.getUTCMonth(), yr = t.getUTCFullYear();
    const sameYear = yr === new Date().getUTCFullYear();
    return ru
      ? `${day} ${RU_MONTHS[mon]}${sameYear ? '' : ' ' + yr}`
      : `${day} ${EN_MONTHS[mon]}${sameYear ? '' : ' ' + yr}`;
  }
  const CHECK = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm4.1 5.8-4.9 5a.9.9 0 0 1-1.3 0L3.9 8.7a.9.9 0 1 1 1.3-1.3l1.4 1.5 4.2-4.4a.9.9 0 0 1 1.3 1.3z"/></svg>';
  const LOCK = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.5V5a3.5 3.5 0 1 1 7 0v1.5h.5A1.5 1.5 0 0 1 13.5 8v5A1.5 1.5 0 0 1 12 14.5H4A1.5 1.5 0 0 1 2.5 13V8A1.5 1.5 0 0 1 4 6.5h.5zm1.6 0h3.8V5a1.9 1.9 0 1 0-3.8 0v1.5z"/></svg>';
  const ARROW_UP = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.5 3 11h4v5.5h6V11h4z"/></svg>';
  const ARROW_DOWN = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16.5 3 9h4V3.5h6V9h4z"/></svg>';
%>
<html lang="<%= pageLang %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="content-language" content="<%= pageLang %>" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <title><%= ru ? 'Предложения' : 'Suggestions' %> | <%= __('title') %></title>
  <link rel="canonical" href="https://savchenkosolutions.com/<%= pageLang %>/feedback" />
  <link rel="alternate" hreflang="en" href="https://savchenkosolutions.com/en/feedback" />
  <link rel="alternate" hreflang="ru" href="https://savchenkosolutions.com/ru/feedback" />
  <link rel="alternate" hreflang="x-default" href="https://savchenkosolutions.com/en/feedback" />
  <link rel="stylesheet" href="/css/vendor/bootstrap.min.css" />
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <link rel="stylesheet" href="<%= av('/css/design-system.css') %>" />
  <link rel="stylesheet" href="<%= av('/css/main_page.css') %>" />
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../default/main_site_header', {
    lang: pageLang,
    langSwitchEnUrl: '/en/feedback',
    langSwitchRuUrl: '/ru/feedback'
  }) %>

  <main class="flex-grow-1">
    <div class="fb-board">
      <div class="fb-board-head">
        <h1><%= ru ? 'Предложения' : 'Suggestions' %></h1>
        <p class="fb-board-lede">
          <%= ru
            ? 'Что предложили читатели и что с этим стало. Голосуйте за и против, аккаунт не нужен.'
            : 'What readers have asked for, and what came of it. Vote it up or down, no account needed.' %>
        </p>
      </div>

      <div class="fb-layout">
      <div class="fb-main">

      <div class="fb-toolbar">
        <%# Top by default, but New has to exist. A score-only order permanently buries
            whatever arrived most recently, which is the thing nobody has voted on yet. %>
        <a class="fb-sort <%= sort === 'top' ? 'is-active' : '' %>" href="/<%= pageLang %>/feedback"><%= ru ? 'Лучшие' : 'Top' %></a>
        <a class="fb-sort <%= sort === 'new' ? 'is-active' : '' %>" href="/<%= pageLang %>/feedback?sort=new"><%= ru ? 'Новые' : 'New' %></a>
        <button type="button" class="fb-compose" data-fb-open data-fb-category="idea">
          <%= ru ? 'Предложить' : 'Suggest' %>
        </button>
      </div>

      <% if (!groups.length) { %>
        <div class="fb-empty" style="margin-top:1.5rem;">
          <%= ru ? 'Пока пусто. Напишите первым, мы отвечаем.' : 'Nothing here yet. Be the first, we do reply.' %>
        </div>
      <% } %>

      <% groups.forEach(function (g) { %>
        <section class="fb-group">
          <h2 class="fb-group-head">
            <span><%= g.label %></span>
            <span style="font-weight:400;"><%= g.items.length %></span>
          </h2>
          <% g.items.forEach(function (item) { %>
            <%
              const locked = item.status === 'done' || item.status === 'declined';
              const solved = item.status === 'done';
            %>
            <article class="fb-item <%= solved ? 'is-resolved' : (locked ? 'is-closed' : '') %>">
              <% if (solved) { %>
                <%# The loudest thing on the page, on purpose. Somebody asked, it got done,
                    and here is the date. That is the entire argument for writing in again. %>
                <p class="fb-solved">
                  <%- CHECK %>
                  <span><%= copy.resolvedTitle %></span>
                  <% if (item.resolved_at) { %>
                    <span class="fb-solved-when"><%= ago(item.resolved_at) %></span>
                  <% } %>
                </p>
              <% } else if (locked) { %>
                <p class="fb-closed-tag"><%- LOCK %><span><%= copy.declinedTitle %></span></p>
              <% } %>
              <p class="fb-item-meta">
                <span class="fb-badge fb-badge-<%= item.status %>"><%= g.label %></span>
                <span><%= item.category %></span>
                <span aria-hidden="true">&middot;</span>
                <span><%= ago(item.created_at) %></span>
                <% if (item.base_score > 0) { %>
                  <%# Says out loud that part of the score is not votes but people recorded
                      asking for this before the board existed. Folding the two together
                      silently would be a small lie in the most visible number on the page. %>
                  <span aria-hidden="true">&middot;</span>
                  <span title="<%= ru ? 'Просили до появления этой страницы: из опроса, форума и писем' : 'Asked for before this page existed: from the survey, forum and mail' %>">
                    <%= ru ? 'просили ранее: ' : 'asked before: ' %><%= item.base_score %>
                  </span>
                <% } %>
              </p>

              <h3 class="fb-item-title">
                <a href="/<%= pageLang %>/feedback/<%= item.public_id %>"><%= item.title %></a>
              </h3>

              <% if (item.body && item.body !== item.title) { %>
                <p class="fb-item-body"><%= item.body %></p>
              <% } %>

              <div class="fb-actions">
                <% if (locked) { %>
                  <%# Shown as closed rather than removed. A vote control that simply vanished
                      would read as a bug; this reads as settled. %>
                  <span class="fb-final"><%= copy.finalScore %> <b><%= item.votes %></b></span>
                  <span class="fb-locked-note"><%- LOCK %><%= copy.lockedVote %></span>
                <% } else { %>
                  <%# Both directions, score between them, exactly where the thumb expects it.
                      Pressing the same arrow twice clears the vote; pressing the other swings
                      it by two. Open to signed-out visitors on purpose, because every
                      sign-in-gated voting feature this site has shipped has ~zero rows. %>
                  <div class="fb-vote <%= item.my_vote === 1 ? 'is-up' : (item.my_vote === -1 ? 'is-down' : '') %>"
                       data-fb-vote="<%= item.public_id %>">
                    <button type="button" class="fb-arrow fb-arrow-up" data-dir="1"
                            aria-label="<%= ru ? 'За' : 'Upvote' %>"
                            aria-pressed="<%= item.my_vote === 1 %>"><%- ARROW_UP %></button>
                    <span class="fb-score"><%= item.votes %></span>
                    <button type="button" class="fb-arrow fb-arrow-down" data-dir="-1"
                            aria-label="<%= ru ? 'Против' : 'Downvote' %>"
                            aria-pressed="<%= item.my_vote === -1 %>"><%- ARROW_DOWN %></button>
                  </div>
                <% } %>

                <a class="fb-action" href="/<%= pageLang %>/feedback/<%= item.public_id %>">
                  <%= item.public_reply ? (ru ? '1 ответ' : '1 reply') : (ru ? 'Открыть' : 'Open') %>
                </a>
              </div>

              <% if (item.public_reply && solved) { %>
                <div class="fb-resolution">
                  <div class="fb-resolution-head"><%- CHECK %><span><%= copy.resolutionLabel %></span></div>
                  <div class="fb-resolution-body"><%= item.public_reply %></div>
                </div>
              <% } else if (item.public_reply) { %>
                <div class="fb-reply">
                  <div class="fb-reply-head">
                    <span class="fb-reply-who">astrosander</span>
                    <span class="fb-reply-tag"><%= ru ? 'автор сайта' : 'maintainer' %></span>
                  </div>
                  <div class="fb-reply-body"><%= item.public_reply %></div>
                </div>
              <% } %>
            </article>
          <% }); %>
        </section>
      <% }); %>

      </div><%# /fb-main %>

      <%# The sidebar exists because a single narrow column on a wide screen is mostly empty
          space. It carries the three things a first-time visitor actually needs: what
          happens to a message, what the statuses mean, and a way to write one. %>
      <aside class="fb-side">
        <div class="fb-card">
          <h2><%= ru ? 'Как это работает' : 'How this works' %></h2>
          <ol class="fb-steps">
            <li><%= ru ? 'Вы пишете. Аккаунт не нужен.' : 'You write. No account needed.' %></li>
            <li><%= ru ? 'Получаете постоянную ссылку на своё сообщение.' : 'You get a permanent link to your message.' %></li>
            <li><%= ru ? 'Мы читаем и отвечаем прямо на этой странице.' : 'We read it and reply, right on this page.' %></li>
            <li><%= ru ? 'Когда сделано, сообщаем тем, кто просил.' : 'When it ships, everyone who asked is told.' %></li>
          </ol>
        </div>

        <div class="fb-card">
          <h2><%= ru ? 'Статусы' : 'Statuses' %></h2>
          <div class="fb-tally">
            <% groups.forEach(function (g) { %>
              <div class="fb-tally-row">
                <span class="fb-badge fb-badge-<%= g.status %>"><%= g.label %></span>
                <span class="fb-tally-n"><%= g.items.length %></span>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="fb-card">
          <h2><%= ru ? 'Что писать' : 'What to write' %></h2>
          <p>
            <%= ru
              ? 'Чем конкретнее, тем лучше. Не «добавьте ещё задачник», а какой именно и для чего вы бы им пользовались.'
              : 'The more specific the better. Not "add another problem book", but which one and what you would use it for.' %>
          </p>
          <button type="button" class="fb-side-cta" data-fb-open data-fb-category="idea">
            <%= ru ? 'Написать' : 'Write to us' %>
          </button>
        </div>
      </aside>

      </div><%# /fb-layout %>
    </div>
  </main>

  <%- include('../default/modern_footer', { lang: pageLang }) %>

  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <script src="<%= av('/js/feedback-vote.js') %>" defer></script>
  <%- include('../default/main_site_search_script') %>
</body>
</html>
