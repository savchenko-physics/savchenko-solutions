<!DOCTYPE html>
<%
  const ru = pageLang === 'ru';
  // Written dates, not "1 час назад".
  //
  // Relative time only survives the first hour. Past that it turns a day you could name into
  // vague mush, and on a page carrying nineteen months of history it makes everything look
  // freshly manufactured whether or not it is. A written date cannot be mistaken for that,
  // and it is the thing a sceptical reader checks.
  const RU_MONTHS = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
  const EN_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  function ago(d) {
    const t = new Date(d);
    const s = Math.max(0, (Date.now() - t.getTime()) / 1000);
    if (s < 3600) return ru ? 'только что' : 'just now';
    // UTC getters on purpose. A date-only string parses as UTC midnight, so reading it back
    // with local getters lands on the previous day for anyone west of Greenwich: 2024-12-28
    // rendered as "27 декабря". The server also stores timestamptz, so UTC is the one frame
    // that gives every reader the same answer.
    const day = t.getUTCDate(), mon = t.getUTCMonth(), yr = t.getUTCFullYear();
    const sameYear = yr === new Date().getUTCFullYear();
    return ru
      ? `${day} ${RU_MONTHS[mon]}${sameYear ? '' : ' ' + yr}`
      : `${day} ${EN_MONTHS[mon]}${sameYear ? '' : ' ' + yr}`;
  }
  const CHECK = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm4.1 5.8-4.9 5a.9.9 0 0 1-1.3 0L3.9 8.7a.9.9 0 1 1 1.3-1.3l1.4 1.5 4.2-4.4a.9.9 0 0 1 1.3 1.3z"/></svg>';
  const LOCK = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.5V5a3.5 3.5 0 1 1 7 0v1.5h.5A1.5 1.5 0 0 1 13.5 8v5A1.5 1.5 0 0 1 12 14.5H4A1.5 1.5 0 0 1 2.5 13V8A1.5 1.5 0 0 1 4 6.5h.5zm1.6 0h3.8V5a1.9 1.9 0 1 0-3.8 0v1.5z"/></svg>';
  const ARROW_UP = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.5 3 11h4v5.5h6V11h4z"/></svg>';
  const ARROW_DOWN = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16.5 3 9h4V3.5h6V9h4z"/></svg>';
%>
<html lang="<%= pageLang %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="content-language" content="<%= pageLang %>" />
  <%# The URL is somebody's private receipt for a message they may have sent anonymously.
      It must never appear in a search index. %>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <title><%= item.public_title || (ru ? 'Сообщение' : 'Your message') %> | <%= __('title') %></title>
  <link rel="stylesheet" href="/css/vendor/bootstrap.min.css" />
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <link rel="stylesheet" href="<%= av('/css/design-system.css') %>" />
  <link rel="stylesheet" href="<%= av('/css/main_page.css') %>" />
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('../default/main_site_header', {
    lang: pageLang,
    langSwitchEnUrl: '/en/feedback/' + item.public_id,
    langSwitchRuUrl: '/ru/feedback/' + item.public_id
  }) %>

  <main class="flex-grow-1">
    <div class="fb-board">
      <p style="margin-bottom: 0.9rem;">
        <a class="fb-back" href="/<%= pageLang %>/feedback">&larr; <%= ru ? 'Все предложения' : 'All suggestions' %></a>
      </p>

      <%
        const locked = item.status === 'done' || item.status === 'declined';
        const solved = item.status === 'done';
      %>
      <article class="<%= solved ? 'is-resolved' : '' %>" style="<%= solved ? 'border-left:3px solid #27ae60; padding-left:1rem; margin-left:-1rem;' : '' %>">
        <% if (solved) { %>
          <p class="fb-solved" style="font-size:13px; padding:0.3rem 0.8rem 0.3rem 0.45rem;">
            <%- CHECK %>
            <span><%= copy.resolvedTitle %></span>
            <% if (item.resolved_at) { %><span class="fb-solved-when"><%= ago(item.resolved_at) %></span><% } %>
          </p>
        <% } else if (locked) { %>
          <p class="fb-closed-tag"><%- LOCK %><span><%= copy.declinedTitle %></span></p>
        <% } %>
        <p class="fb-item-meta">
          <span class="fb-badge fb-badge-<%= item.status %>"><%= statusLabel %></span>
          <span><%= item.category %></span>
          <span aria-hidden="true">&middot;</span>
          <span><%= ago(item.created_at) %></span>
          <% if (item.problem_name) { %>
            <span aria-hidden="true">&middot;</span>
            <a href="/<%= item.problem_lang || pageLang %>/<%= item.problem_name %>" style="color: var(--ss-link);">
              <%= ru ? 'задача' : 'problem' %> <%= item.problem_name %>
            </a>
          <% } %>
        </p>

        <h1 class="fb-item-title" style="font-size: 1.35rem; margin-bottom: 0.6rem;">
          <%= item.public_title || (ru ? 'Ваше сообщение' : 'Your message') %>
        </h1>

        <%# Escaped, and pre-wrap, so a multi-paragraph derivation stays readable without the
            body ever being treated as markup. %>
        <div class="fb-post-body" style="max-width: 110ch;"><%= item.body %></div>

        <div class="fb-actions">
          <% if (item.is_public && locked) { %>
            <span class="fb-final"><%= copy.finalScore %> <b><%= item.votes %></b></span>
            <span class="fb-locked-note"><%- LOCK %><%= copy.lockedNote %></span>
          <% } else if (item.is_public) { %>
            <div class="fb-vote <%= item.my_vote === 1 ? 'is-up' : (item.my_vote === -1 ? 'is-down' : '') %>"
                 data-fb-vote="<%= item.public_id %>">
              <button type="button" class="fb-arrow fb-arrow-up" data-dir="1"
                      aria-label="<%= ru ? 'За' : 'Upvote' %>"
                      aria-pressed="<%= item.my_vote === 1 %>"><%- ARROW_UP %></button>
              <span class="fb-score"><%= item.votes %></span>
              <button type="button" class="fb-arrow fb-arrow-down" data-dir="-1"
                      aria-label="<%= ru ? 'Против' : 'Downvote' %>"
                      aria-pressed="<%= item.my_vote === -1 %>"><%- ARROW_DOWN %></button>
            </div>
          <% } %>
          <button type="button" class="fb-action" data-fb-open>
            <%= ru ? 'Написать ещё' : 'Send another' %>
          </button>
        </div>

        <% if (item.public_reply && solved) { %>
          <div class="fb-resolution" style="margin-top: 1.1rem;">
            <div class="fb-resolution-head"><%- CHECK %><span><%= copy.resolutionLabel %></span></div>
            <div class="fb-resolution-body" style="white-space: pre-wrap;"><%= item.public_reply %></div>
          </div>
        <% } else if (item.public_reply) { %>
          <div class="fb-reply" style="margin-top: 1.1rem;">
            <div class="fb-reply-head">
              <span class="fb-reply-who">astrosander</span>
              <span class="fb-reply-tag"><%= ru ? 'автор сайта' : 'maintainer' %></span>
            </div>
            <div class="fb-reply-body" style="white-space: pre-wrap;"><%= item.public_reply %></div>
          </div>
        <% } %>

        <% if (!item.is_public) { %>
          <%# The reassurance that was missing. Somebody once filed a correct, signed physics
              correction, heard nothing, and re-posted the whole thing as a comment because
              they had no way to tell whether it had arrived. %>
          <p class="fb-note">
            <%= ru
              ? 'Сообщение получено и ждёт разбора. Эта ссылка постоянная: по ней всегда видно, что с ним стало.'
              : 'Received and waiting to be read. This link is permanent: it always shows what happened to it.' %>
          </p>
        <% } %>
      </article>
    </div>
  </main>

  <%- include('../default/modern_footer', { lang: pageLang }) %>

  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <script src="<%= av('/js/feedback-vote.js') %>" defer></script>
  <%- include('../default/main_site_search_script') %>
</body>
</html>
