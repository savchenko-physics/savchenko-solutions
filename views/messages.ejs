                   placeholder="<%= lang === 'ru' ? 'Название группы (опционально)' : 'Group name (optional)' %>"
                   style="margin-bottom: var(--ss-space-2);" />
            <button id="createGroupBtn"
                    style="width:100%;height:40px;background:var(--msg-primary);color:var(--ss-on-navy);border:none;border-radius:var(--ss-radius);font-size:var(--ss-fs-14);cursor:pointer;font-weight:var(--ss-fw-strong);"
                    disabled>
              <%= lang === 'ru' ? 'Создать группу' : 'Create group' %>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Forward modal -->
<div class="msg-modal-backdrop" id="forwardModal">
  <div class="msg-modal">
    <div class="msg-modal-header">
      <h3><%= lang === 'ru' ? 'Переслать' : 'Forward to…' %></h3>
      <button class="msg-modal-close" id="forwardClose">&times;</button>
    </div>
    <div class="msg-modal-body">
      <input type="text" class="msg-modal-search" id="forwardSearch"
             placeholder="<%= lang === 'ru' ? 'Поиск людей...' : 'Search people...' %>" />
      <div id="forwardResults"></div>
      <div id="forwardTargets">
        <a class="msg-user-result" data-saved="1" style="cursor:pointer">
          <span class="msg-saved-avatar" style="width:36px;height:36px;"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></span>
          <div><div class="msg-user-result-name"><%= lang === 'ru' ? 'Избранное' : 'Saved Messages' %></div></div>
        </a>
        <% conversations.forEach(function(c) { if (c.isSaved) return; %>
          <a class="msg-user-result" data-conv-id="<%= c.id %>" style="cursor:pointer">
            <% if (c.is_group) { %>
              <span style="width:36px;height:36px;border-radius:50%;overflow:hidden;display:inline-block;flex-shrink:0;"><%- groupAvatarSVG(c.id, c.displayName, 36, c.community_lang) %></span>
            <% } else { %>
              <img src="<%= c.displayPicture || '/img/profile_images/Default_placeholder.svg' %>" alt="" />
            <% } %>
            <div><div class="msg-user-result-name"><%= c.displayName %></div></div>
          </a>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<%
  // Times are written in the reader's zone (the ss_tz cookie, `timeZone`) and the page's language,
  // exactly as the page's script writes them, so nothing changes after load. Without the cookie
  // (a first visit) they are written in UTC, kept out of sight, and rewritten by the script.
  // (Functions, not consts: the sidebar above this block calls them before it has run.)
  function TIME_ZONE() { return (typeof timeZone === 'string' && timeZone) ? timeZone : 'UTC'; }
  function TIME_LOCALE() { return lang === 'ru' ? 'ru-RU' : 'en-US'; }
  function formatTime(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    const now = new Date();
    const diff = now - d;
    if (diff < 86400000 && dayKeyOf(d) === dayKeyOf(now)) {
      return d.toLocaleTimeString(TIME_LOCALE(), { hour: '2-digit', minute: '2-digit', timeZone: TIME_ZONE() });
    }
    if (diff < 604800000) {
      return d.toLocaleDateString(TIME_LOCALE(), { weekday: 'short', timeZone: TIME_ZONE() });
    }
    return d.toLocaleDateString(TIME_LOCALE(), { month: 'short', day: 'numeric', timeZone: TIME_ZONE() });
  }

  function formatMessageTime(dateStr) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleTimeString(TIME_LOCALE(), { hour: '2-digit', minute: '2-digit', timeZone: TIME_ZONE() });
  }

  function formatBytes(n) {
    n = Number(n) || 0;
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
    return (n / (1024 * 1024)).toFixed(1) + ' MB';
  }

  // A video plays inline; the containers are listed once, in lib/messageAttachments.js.
  function isVideoName(name) {
    const m = /\.([A-Za-z0-9]+)$/.exec(String(name || ''));
    return !!m && attachmentRules.video.indexOf(m[1].toLowerCase()) !== -1;
  }
  function isAudioName(name) {
    const m = /\.([A-Za-z0-9]+)$/.exec(String(name || ''));
    return !!m && attachmentRules.audio.indexOf(m[1].toLowerCase()) !== -1;
  }
  // An audio file's card; the page's script (renderAudioHTML) draws the same.
  function audioHTML(m) {
    return `<span class="msg-audio" data-src="${attrEsc(m.file_url)}" data-name="${attrEsc(m.file_name)}"><button type="button" class="msg-audio-play" aria-label="${lang === 'ru' ? 'Слушать' : 'Play'}"><svg class="msg-audio-play-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg><svg class="msg-audio-pause-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg></button><span class="msg-audio-meta"><span class="msg-audio-name">${attrEsc(m.file_name)}</span><span class="msg-audio-time">${formatBytes(m.file_size)}</span><span class="msg-audio-bar"><span class="msg-audio-fill"></span></span></span></span>`;
  }
  // "1 участник, 2 участника, 5 участников" — the same rule the page's script uses (plural).
  function pluralWord(n, forms) {
    if (lang !== 'ru') return n === 1 ? forms[0] : forms[1];
    const a = n % 10, b = n % 100;
    return (a === 1 && b !== 11) ? forms[0] : (a >= 2 && a <= 4 && (b < 10 || b >= 20)) ? forms[1] : forms[2];
  }
  function attrEsc(v) {
    return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  // What a message shows inline: 'image', 'video' (converted and ready), or null (text, a card).
  function mediaKindOf(m) {
    if (m.image_url) return 'image';
    if (m.file_url && isVideoName(m.file_name) && !m.attachment_status) return 'video';
    return null;
  }
  // The box a picture gets: Telegram Desktop's 430 × 430 at most, never upscaled. The same rule
  // is in the page's script (mediaBox) for messages that arrive live.
  function mediaBox(w, h) {
    if (!(w > 0 && h > 0)) return null;
    return { width: Math.max(1, Math.min(w, 430, Math.round(430 * w / h))), w, h };
  }
  // The media of a bubble: the picture or the video, and for a media-only message its time in
  // the corner (timeHtml), so the script and this template draw the same thing. (A function,
  // not a const, so it is usable above this block: function declarations hoist, const does not.)
  function mediaHTML(m, kind, timeHtml) {
    const PLAY_SVG = '<svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>';
    const box = mediaBox(m.image_width, m.image_height);
    let style = box ? `width:${box.width}px;aspect-ratio:${box.w}/${box.h};` : '';
    if (m.image_placeholder) style += `background-image:url(${m.image_placeholder});`;
    const cls = 'msg-media ' + (kind === 'image' ? 'msg-bubble-image-wrap' : 'msg-bubble-video-wrap') + (box ? ' has-dims' : '');
    const inner = kind === 'image'
      ? `<img class="msg-bubble-image" src="${attrEsc(m.image_url)}" alt="" data-full="${attrEsc(m.image_url)}" loading="lazy" />`
      : `<video class="msg-bubble-video" src="${attrEsc(m.file_url)}" preload="metadata" playsinline data-name="${attrEsc(m.file_name)}" data-size="${Number(m.file_size) || 0}"></video><span class="msg-video-badge"></span><span class="msg-video-play">${PLAY_SVG}</span>`;
    return `<span class="${cls}" style="${style}">${inner}${timeHtml || ''}</span>`;
  }

  // Day separators are grouped in the reader's zone when it is known; the page regroups them
  // only when its zone differs from the one the page was written in (regroupDaySeparators).
  // The reader's day (en-CA writes YYYY-MM-DD), the same key the page's clientDayKey computes.
  function dayKeyOf(dateStr) {
    return new Date(dateStr).toLocaleDateString('en-CA', { timeZone: TIME_ZONE(), year: 'numeric', month: '2-digit', day: '2-digit' });
  }
  function daySepText(dateStr) {
    return new Date(dateStr).toLocaleDateString(TIME_LOCALE(), { timeZone: TIME_ZONE(), month: 'short', day: 'numeric', year: 'numeric' });
  }

  function checkHTML(isRead) {
    if (isRead) {
      return '<span class="msg-check read"><svg viewBox="0 0 20 12" width="17" height="11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6.5l3.2 3.4L10 2.4"/><path d="M8 6.5l3.2 3.4L17 2.4"/></svg></span>';
    }
    return '<span class="msg-check"><svg viewBox="0 0 14 12" width="13" height="11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5l3.2 3.4L11.5 2.4"/></svg></span>';
  }
%>

