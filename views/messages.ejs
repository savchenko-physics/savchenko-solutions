<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <title><%= docTitle(lang === 'ru' ? 'Сообщения' : 'Messages', 'Savchenko Solutions') %></title>
  <%# The service worker is retired: in Firefox it made every avatar here reload on each chat switch (public/sw.js). This removes it from browsers that still have it. %>
  <script>try{navigator.serviceWorker&&navigator.serviceWorker.getRegistrations().then(function(rs){rs.forEach(function(r){r.unregister();});}).catch(function(){});}catch(e){}</script>
  <%- include('default/site_styles') %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <%# Reaction glyphs (js/reactions.js): community emoji are SVGs in img/emoji, the six Unicode ones are text. Guarded, so a process that has not restarted yet still renders this template. %>
  <% var rxUrls = (typeof reactionUrls === 'function') ? reactionUrls() : {}; var rxGlyph = (typeof reactionGlyph === 'function') ? function (v) { return reactionGlyph(v, lang, rxUrls); } : null; %>
  <!-- MathJax: render $…$ / $$…$$ in messages. We typeset manually as bubbles arrive. -->
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true
      },
      options: {
        ignoreHtmlClass: 'tex2jax_ignore',
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
      },
      startup: {
        typeset: false,
        pageReady: function () {
          return MathJax.startup.defaultPageReady().then(function () {
            var chat = document.getElementById('chatMessages');
            if (!chat) return;
            return MathJax.typesetPromise([chat]).then(function () {
              var hash = (location.hash.match(/^#msg-(\d+)$/) || [])[1];
              var el = hash ? chat.querySelector('.msg-bubble-row[data-msg-id="' + hash + '"]')
                            : document.getElementById('newMessagesDivider');
              if (el) el.scrollIntoView({ block: 'center' });
              else chat.scrollTop = chat.scrollHeight;
              chat.classList.remove('msg-chat-loading');
            });
          });
        }
      }
    };
  </script>
  <script id="MathJax-script" async src="/vendor/mathjax/tex-chtml.js"></script>
  <link rel="stylesheet" href="<%= av('/css/messages.css') %>">
</head>
<body>

<div class="msg-app">
  <!-- Shared site header (same as the rest of the site) -->
  <%# The messenger has its own composer pinned to the bottom-right; a floating tab
      would sit on top of it. %>
  <%- include('default/main_site_header', { hideFeedbackTab: true }) %>

  <%# Everything the page's script binds to sits in #messengerApp: a chat switch fetches the
      next page and swaps this one element in place (js/messages-page.js switchTo), so the
      header stays, nothing reloads and nothing flashes (the owner, 2026-09-21). %>
  <div id="messengerApp">
  <!-- Main body -->
  <div class="msg-body<%= activeConversation ? ' has-active' : '' %><%= (typeof timeZone === 'string' && timeZone) ? '' : ' msg-times-utc' %>" data-tz="<%= (typeof timeZone === 'string' && timeZone) ? timeZone : '' %>">
    <!-- Sidebar: conversation list -->
    <div class="msg-sidebar">
      <div class="msg-sidebar-header">
        <span class="msg-search-wrap">
          <input type="text" class="msg-search" id="convSearch" placeholder="<%= lang === 'ru' ? 'Поиск...' : 'Search...' %>" autocomplete="off" />
          <button type="button" class="msg-search-clear" id="convSearchClear" hidden aria-label="<%= lang === 'ru' ? 'Очистить' : 'Clear' %>">&times;</button>
        </span>
        <button class="msg-new-btn" id="newMsgBtn" title="<%= lang === 'ru' ? 'Новое сообщение' : 'New message' %>">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            <line x1="12" y1="8" x2="12" y2="14"></line>
            <line x1="9" y1="11" x2="15" y2="11"></line>
          </svg>
        </button>
      </div>

      <!-- Pinned Saved Messages (self-chat) — always available to every user.
           Kept outside #convList so the live sidebar refresh never removes it. -->
      <% const savedConv = conversations.find(function(c){ return c.isSaved; }); %>
      <a href="/<%= lang %>/messages/saved"
         class="msg-conv-item msg-saved-item<%= activeConversation && activeConversation.isSaved ? ' active' : '' %>"
         data-name="<%= lang === 'ru' ? 'избранное saved messages' : 'saved messages избранное' %>">
        <div class="msg-saved-avatar">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="msg-conv-info">
          <div class="msg-conv-name"><%= lang === 'ru' ? 'Избранное' : 'Saved Messages' %></div>
          <% if (savedConv && (savedConv.last_message_content || savedConv.last_message_image || savedConv.last_message_file)) { %>
            <div class="msg-conv-preview tex2jax_ignore">
              <% if (savedConv.last_message_content) { %><%= savedConv.last_message_content.substring(0, 60) %><% } else if (savedConv.last_message_file) { %><%= savedConv.last_message_file %><% } else { %><%= lang === 'ru' ? 'Фото' : 'Photo' %><% } %>
            </div>
          <% } %>
        </div>
      </a>

      <div class="msg-list-section" id="convSearchChats" hidden><%= lang === 'ru' ? 'Чаты' : 'Chats' %></div>
      <div class="msg-conv-list tex2jax_ignore" id="convList">
        <% const nonSaved = conversations.filter(function(c){ return !c.isSaved; }); %>
        <% if (nonSaved.length === 0) { %>
          <div style="padding: var(--ss-space-7) var(--ss-space-4); text-align: center; color: var(--msg-muted); font-size: var(--ss-fs-14);">
            <%= lang === 'ru' ? 'Нет сообщений' : 'No conversations yet' %>
          </div>
        <% } else { %>
          <% nonSaved.forEach(function(c) { %>
            <a href="/<%= lang %>/messages/<%= c.id %>"
               class="msg-conv-item<%= activeConversation && activeConversation.id === c.id ? ' active' : '' %>"
               data-name="<%= c.displayName.toLowerCase() %>">
              <% if (c.is_group) { %>
                <div class="msg-conv-avatar-group"><%- groupAvatarSVG(c.id, c.displayName, 44, c.community_lang) %></div>
              <% } else { %>
                <span class="avatar-presence">
                  <img class="msg-conv-avatar"
                       src="<%= c.displayPicture || '/img/profile_images/Default_placeholder.svg' %>"
                       alt="" />
                  <% if (c.isOnline) { %><span class="online-dot online-dot--lg" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %>
                </span>
              <% } %>
              <div class="msg-conv-info">
                <div class="msg-conv-name<% if (!c.is_group && !c.isSaved && c.otherUser) { %> <%= rankClass(c.otherUser.username) %><% } %>"><%= c.displayName %></div>
                <div class="msg-conv-preview">
                  <% if (c.last_message_content || c.last_message_image || c.last_message_file) { %>
                    <% if (c.last_message_sender_id === userId) { %><%= lang === 'ru' ? 'Вы: ' : 'You: ' %><% } %>
                    <% if (c.last_message_content) { %>
                      <%= c.last_message_content.substring(0, 60) %><% if (c.last_message_content.length > 60) { %>...<% } %>
                    <% } else if (c.last_message_file) { %>
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:2px;opacity:0.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><%= c.last_message_file.substring(0, 40) %>
                    <% } else { %>
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-1px;margin-right:2px;opacity:0.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><%= lang === 'ru' ? 'Фото' : 'Photo' %>
                    <% } %>
                  <% } %>
                </div>
              </div>
              <div class="msg-conv-meta">
                <span class="msg-conv-time" data-iso="<%= c.last_message_at ? new Date(c.last_message_at).toISOString() : '' %>"><%= formatTime(c.last_message_at) %></span>
                <% if (c.unread_count > 0) { %>
                  <span class="msg-conv-badge<%= c.muted ? ' muted' : '' %>"><%= c.unread_count > 99 ? '99+' : c.unread_count %></span>
                <% } %>
              </div>
            </a>
          <% }); %>
        <% } %>
      </div>
      <%# Every chat is its own page, so the list reopened at the top and a chat far down had to
          be scrolled to again after each click. Keep the list's scroll position across the
          navigation (per tab) and bring the open chat into view. This runs as soon as the list
          is parsed, before the first paint, so it never visibly jumps. On a phone the list is
          hidden while a chat is open; saving then would record 0, so only a visible list saves. %>
      <script>
        (function () {
          const list = document.getElementById('convList');
          const KEY = 'msgConvListScroll';
          try {
            const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
            if (saved && Date.now() - saved.at < 30 * 60 * 1000) list.scrollTop = saved.top;
          } catch (e) { /* storage unavailable: start at the top as before */ }
          const active = list.querySelector('.msg-conv-item.active');
          if (active && list.clientHeight > 0) {
            const box = list.getBoundingClientRect();
            const item = active.getBoundingClientRect();
            if (item.top < box.top) list.scrollTop += item.top - box.top;
            else if (item.bottom > box.bottom) list.scrollTop += item.bottom - box.bottom;
          }
          window.addEventListener('pagehide', function () {
            if (list.clientHeight === 0) return;
            try {
              sessionStorage.setItem(KEY, JSON.stringify({ top: list.scrollTop, at: Date.now() }));
            } catch (e) { /* storage unavailable */ }
          });
        })();
      </script>
      <div class="msg-search-global tex2jax_ignore" id="convSearchResults" hidden></div>
    </div>

    <!-- Chat pane -->
    <div class="msg-chat" data-drop-text="<%= lang === 'ru' ? 'Отпустите, чтобы прикрепить' : 'Drop to attach' %>">
      <% if (activeConversation) { %>
        <!-- Chat header -->
        <div class="msg-chat-header-wrap">
          <div class="msg-chat-header">
            <button class="msg-back-btn" data-switch="/<%= lang %>/messages">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <% if (activeConversation.is_group) { %>
              <div class="msg-conv-avatar-group" style="width:36px;height:36px;"><%- groupAvatarSVG(activeConversation.id, activeConversation.displayName, 36, activeConversation.communityLang) %></div>
            <% } else if (activeConversation.isSaved) { %>
              <div class="msg-saved-avatar sm">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              </div>
            <% } else if (activeConversation.displayPicture) { %>
              <% const _hdrProfileHref = (!activeConversation.is_group && activeConversation.otherUser) ? ('/user/' + activeConversation.otherUser.username) : null; %>
              <% if (_hdrProfileHref) { %><a href="<%= _hdrProfileHref %>" class="msg-chat-header-avatar-link" title="<%= lang === 'ru' ? 'Открыть профиль' : 'Open profile' %>"><% } %>
              <span class="avatar-presence">
                <img class="msg-chat-header-avatar"
                     src="<%= activeConversation.displayPicture || '/img/profile_images/Default_placeholder.svg' %>" alt="" />
                <% if (activeConversation.isOnline) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %>
              </span>
              <% if (_hdrProfileHref) { %></a><% } %>
            <% } %>
            <div>
              <% const _dmRank = activeConversation.otherRank && activeConversation.otherUser ? activeConversation.otherRank : null; %>
              <div class="msg-chat-header-name">
                <button type="button" class="msg-chat-header-open<%= _dmRank ? ' ss-rank-' + _dmRank.key + ' ss-rank-c-' + _dmRank.key : '' %>" id="chatInfoOpen" title="<%= lang === 'ru' ? 'О чате' : 'Chat info' %>"><%= _dmRank ? activeConversation.otherUser.username : activeConversation.displayName %></button>
              </div>
              <% if (_dmRank && activeConversation.otherUser.full_name && activeConversation.otherUser.full_name !== activeConversation.otherUser.username) { %>
                <div class="msg-chat-header-members msg-chat-header-fullname"><%= activeConversation.otherUser.full_name %></div>
              <% } %>
              <% if (activeConversation.is_group && activeConversation.memberCount > 0) { %>
                <div class="msg-chat-header-members" id="toggleMembers">
                  <%= activeConversation.memberCount %> <%= pluralWord(activeConversation.memberCount, lang === 'ru' ? ['участник', 'участника', 'участников'] : ['member', 'members', 'members']) %><% if (activeConversation.communityLang) { %> · <%= activeConversation.communityLang === 'ru' ? (lang === 'ru' ? 'на русском' : 'in Russian') : (lang === 'ru' ? 'на английском' : 'in English') %><% } %>
                </div>
              <% } %>
            </div>
            <div class="msg-header-spacer"></div>
            <button class="msg-header-btn" id="searchToggle" title="<%= lang === 'ru' ? 'Поиск' : 'Search' %>">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
            <button class="msg-header-btn<%= (typeof muted !== 'undefined' && muted) ? ' active' : '' %>" id="muteToggle" title="<%= lang === 'ru' ? 'Уведомления' : 'Notifications' %>">
              <svg id="muteIconOn" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="<%= (typeof muted !== 'undefined' && muted) ? 'display:none' : '' %>"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              <svg id="muteIconOff" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="<%= (typeof muted !== 'undefined' && muted) ? '' : 'display:none' %>"><path d="M13.73 21a2 2 0 0 1-3.46 0"/><path d="M18.63 13A17.89 17.89 0 0 1 18 8"/><path d="M6.26 6.26A5.86 5.86 0 0 0 6 8c0 7-3 9-3 9h14"/><path d="M18 8a6 6 0 0 0-9.33-5"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <% if (activeConversation.is_group && typeof membersList !== 'undefined' && membersList.length > 0) { %>
          <div class="msg-members-panel" id="membersPanel">
            <%# Community chats already hold every account, and leaving one has no way back
                (the bell mutes it instead), so they get neither Add nor Leave. %>
            <% const _isCommunity = !!activeConversation.communityLang; %>
            <% if (isAdmin) { %>
            <div class="msg-group-admin-row">
              <button class="msg-group-btn" id="groupRenameBtn"><%= lang === 'ru' ? 'Переименовать' : 'Rename' %></button>
              <% if (!_isCommunity) { %>
              <button class="msg-group-btn" id="groupAddBtn"><%= lang === 'ru' ? 'Добавить' : 'Add members' %></button>
              <button class="msg-group-btn danger" id="groupLeaveBtn"><%= lang === 'ru' ? 'Выйти' : 'Leave' %></button>
              <% } %>
            </div>
            <% } %>
            <% const initialShow = 20; %>
            <% membersList.forEach(function(mem, idx) { %>
              <div class="msg-member-item" data-user-id="<%= mem.id %>" data-role="<%= mem.role %>" <% if (idx >= initialShow) { %>style="display:none" data-extra-member<% } %>>
                <span class="avatar-presence"><img class="msg-member-avatar" src="<%= mem.profile_picture || '/img/profile_images/Default_placeholder.svg' %>" alt="" /><% if (mem.isOnline) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %></span>
                <span class="msg-member-name">
                  <a href="/user/<%= mem.username %>"><%= mem.full_name || mem.username %></a>
                  <% if (mem.role === 'admin') { %><span class="msg-admin-badge"><%= lang === 'ru' ? 'модератор' : 'mod' %></span><% } %>
                </span>
                <% if (isAdmin && mem.id !== userId) { %>
                <span class="msg-member-actions">
                  <button class="msg-member-act" data-act="role" data-user="<%= mem.id %>" data-newrole="<%= mem.role === 'admin' ? 'member' : 'admin' %>"><%= mem.role === 'admin' ? (lang === 'ru' ? 'Снять' : 'Demote') : (lang === 'ru' ? 'Модер' : 'Promote') %></button>
                  <button class="msg-member-act danger" data-act="remove" data-user="<%= mem.id %>"><%= lang === 'ru' ? 'Удалить' : 'Remove' %></button>
                </span>
                <% } %>
              </div>
            <% }); %>
            <% if (!isAdmin && !_isCommunity) { %>
            <div class="msg-group-admin-row">
              <button class="msg-group-btn danger" id="groupLeaveBtn"><%= lang === 'ru' ? 'Выйти из группы' : 'Leave group' %></button>
            </div>
            <% } %>
            <% if (membersList.length > initialShow) { %>
              <button class="msg-members-show-more" id="showMoreMembers">
                <%= lang === 'ru' ? 'Показать ещё' : 'Show more' %> (<%= membersList.length - initialShow %>)
              </button>
            <% } %>
          </div>
          <% } %>
        </div>

        <!-- In-conversation search bar -->
        <div class="msg-search-bar" id="msgSearchBar">
          <input type="text" id="msgSearchInput" placeholder="<%= lang === 'ru' ? 'Поиск в переписке...' : 'Search this conversation...' %>" />
          <span class="msg-search-results" id="msgSearchCount"></span>
          <button class="msg-header-btn" id="msgSearchClose">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="msg-search-results-list" id="msgSearchList" style="display:none;"></div>

        <!-- Pinned message bar -->
        <% const canPin = activeConversation && (!activeConversation.is_group || isAdmin); %>
        <div class="msg-pinned-bar<%= pinnedMessage ? ' show' : '' %>" id="pinnedBar" data-target="<%= pinnedMessage ? pinnedMessage.id : '' %>">
          <span class="msg-pinned-bar-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14l-1.6-3.2V6a2 2 0 0 0-2-2H8.6a2 2 0 0 0-2 2v7.8z"/></svg>
          </span>
          <div class="msg-pinned-bar-body">
            <div class="msg-pinned-bar-title"><%= lang === 'ru' ? 'Закреплённое сообщение' : 'Pinned message' %></div>
            <div class="msg-pinned-bar-text tex2jax_ignore" id="pinnedBarText"><%= pinnedMessage ? (pinnedMessage.sender + ': ' + pinnedMessage.preview) : '' %></div>
          </div>
          <% if (canPin) { %><button class="msg-pinned-unpin" id="pinnedUnpin" title="<%= lang === 'ru' ? 'Открепить' : 'Unpin' %>">&times;</button><% } %>
        </div>

        <!-- Messages -->
        <%# The list is invisible until the inline script below has scrolled it to its end, which
            happens before the first paint, so a chat opens on its last messages instead of showing
            the top and jumping (the owner, 2026-09-21); MathJax's pageReady re-pins the end. %>
        <div class="msg-chat-messages msg-chat-loading" id="chatMessages">
          <div class="msg-history-loader" id="historyLoader"><%= lang === 'ru' ? 'Загрузка…' : 'Loading…' %></div>
          <%
            let lastDate = '';
            messages.filter(function(m) { return !m.deleted_at; }).forEach(function(m, i, filtered) {
              const dayKey = dayKeyOf(m.created_at);
              if (dayKey !== lastDate) {
                lastDate = dayKey;
          %>
            <div class="msg-date-sep" data-date="<%= dayKey %>"><%= daySepText(m.created_at) %></div>
          <%  }
              const isSent = m.sender_id === userId;
              const showAvatar = !isSent && activeConversation.is_group;
              const showName = !isSent && activeConversation.is_group &&
                (i === 0 || filtered[i-1].sender_id !== m.sender_id);
              const senderDisplayName = isSent
                ? username
                : (activeConversation.is_group
                    ? m.sender_username
                    : (activeConversation.otherUser ? activeConversation.otherUser.username : m.sender_username));
          %>
            <% if (typeof firstUnreadId !== 'undefined' && firstUnreadId && m.id === firstUnreadId) { %>
            <div class="msg-new-divider" id="newMessagesDivider"><%= lang === 'ru' ? 'Новые сообщения' : 'New messages' %></div>
            <% } %>
            <% const mediaKind = mediaKindOf(m); const hasText = !!(m.contentHtml || m.content); const mediaOnly = !!mediaKind && !hasText && !m.poll;
               const editedHtml = `<span class="msg-bubble-edited">${lang === 'ru' ? ' (ред.)' : ' (edited)'}</span>`;
               const timeHtml = `<div class="msg-bubble-time" data-iso="${new Date(m.created_at).toISOString()}">${formatMessageTime(m.created_at)}${(showReceipts && isSent) ? checkHTML(!!readCutoff && new Date(m.created_at) <= new Date(readCutoff)) : ''}</div>`; %>
            <div class="msg-bubble-row <%= isSent ? 'sent' : 'received' %><%= mediaKind ? ' has-media' : '' %>" data-msg-id="<%= m.id %>" data-created="<%= new Date(m.created_at).toISOString() %>" data-sender-role="<%= m.sender_role || 'member' %>" data-sender-name="<%= senderDisplayName %>" data-pinned="<%= m.pinned_at ? '1' : '' %>">
              <% if (showAvatar) { %>
                <span class="avatar-presence">
                  <a href="/user/<%= m.sender_username %>"><img class="msg-bubble-avatar"
                       src="<%= m.sender_picture || '/img/profile_images/Default_placeholder.svg' %>" alt="" /></a>
                  <% if (m.senderOnline) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %>
                </span>
              <% } %>
              <div>
                <% if (showName) { %>
                  <div class="msg-bubble-sender"><a href="/user/<%= m.sender_username %>" class="<%= rankClass(m.sender_username) %>"><%= m.sender_username %></a><% if (m.sender_role === 'admin') { %><span class="msg-admin-badge"><%= lang === 'ru' ? 'мод' : 'mod' %></span><% } %><% if (m.senderSuspendedForGood) { %><span class="msg-suspended-badge"><%= lang === 'ru' ? 'не может писать' : 'cannot post' %></span><% } else if (m.senderSuspendedUntil) { %><span class="msg-suspended-badge"><%= lang === 'ru' ? 'не может писать до' : 'cannot post until' %> <%- localTime(m.senderSuspendedUntil, 'daytime', lang) %></span><% } %></div>
                <% } %>
                <div class="msg-bubble <%= isSent ? 'sent' : 'received' %><%= mediaKind ? ' has-media' : '' %><%= m.attachment_status === 'sticker' ? ' is-sticker' : '' %>"><% if (m.forwarded_from_username) { %><div class="msg-forwarded tex2jax_ignore"><%= lang === 'ru' ? 'Переслано от' : 'Forwarded from' %> <a href="/user/<%= m.forwarded_from_username %>"><%= m.forwarded_from_username %></a></div><% } %><% if (m.reply) { %><div class="msg-reply-quote tex2jax_ignore" data-target="<%= m.reply.id %>"><div class="msg-reply-quote-name"><%= m.reply.sender %></div><div class="msg-reply-quote-text"><%= m.reply.isImage ? (lang === 'ru' ? 'Фото' : 'Photo') : m.reply.preview %></div></div><% } %><% if (mediaKind) { %><%- mediaHTML(m, mediaKind, mediaOnly ? timeHtml : '') %><% } %><% if (m.poll) { %><div class="msg-poll" data-poll="<%= JSON.stringify(m.poll) %>"></div><% } %><% if (hasText) { %><% if (mediaKind) { %><span class="msg-caption"><% } %><%- m.contentHtml || m.content %><% if (mediaKind) { %><%- m.edited_at ? editedHtml : '' %><%- timeHtml %></span><% } %><% } else if (mediaKind && m.poll) { %><%- timeHtml %><% } %><% if (m.file_url && !mediaKind && isAudioName(m.file_name) && !m.attachment_status) { %><%- audioHTML(m) %><% } else if (m.file_url && !mediaKind) { %><a class="msg-bubble-file tex2jax_ignore" href="<%= m.file_url %>" download="<%= m.file_name %>"><span class="msg-bubble-file-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span><span class="msg-bubble-file-meta"><span class="msg-bubble-file-name"><%= m.file_name %></span><span class="msg-bubble-file-size"><%= formatBytes(m.file_size) %><%= m.attachment_status === 'converting' ? (lang === 'ru' ? ' · конвертируем видео…' : ' · converting the video…') : '' %></span></span></a><% } %><% if (!mediaKind) { %><%- m.edited_at ? editedHtml : '' %><%- timeHtml %><% } %><div class="msg-reaction-add" data-msg-id="<%= m.id %>"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg><div class="msg-reaction-picker"></div></div></div>
                <% if (m.reactions && m.reactions.length > 0) { %>
                <div class="msg-reactions" data-msg-id="<%= m.id %>"><% m.reactions.forEach(function(r) { %><span class="msg-reaction<%= r.me ? ' me' : '' %>" data-emoji="<%= r.emoji %>" data-msg-id="<%= m.id %>"><% if (rxGlyph) { %><%- rxGlyph(r.emoji) %><% } else { %><%= r.emoji %><% } %><span class="msg-reaction-count"><%= r.count %></span></span><% }); %></div>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>

        <script>
          (function() {
            var c = document.getElementById('chatMessages');
            if (!c) return;
            var hash = (location.hash.match(/^#msg-(\d+)$/) || [])[1];
            var el = hash ? c.querySelector('.msg-bubble-row[data-msg-id="' + hash + '"]') : document.getElementById('newMessagesDivider');
            if (el) el.scrollIntoView({ block: 'center' }); else c.scrollTop = c.scrollHeight;
            /* Shown right away, already at its end; MathJax's pass re-pins the end when it is done. */
            c.classList.remove('msg-chat-loading');
          })();
        </script>
        <%# Scrolled up: a round button in the corner takes the reader back down (Telegram's). %>
        <button type="button" class="msg-scroll-down" id="scrollDownBtn" hidden aria-label="<%= lang === 'ru' ? 'К последним сообщениям' : 'To the latest messages' %>">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <!-- Typing indicator -->
        <div class="msg-typing" id="typingBar">
          <span id="typingText"></span>
          <span class="msg-typing-dots"><i></i><i></i><i></i></span>
        </div>

        <!-- Edit bar (shown when editing) -->
        <div class="msg-edit-bar" id="editBar" style="display:none;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span id="editBarText"></span>
          <button class="msg-edit-cancel" id="editCancel">&times;</button>
        </div>

        <!-- Reply bar (shown when replying to a message) -->
        <div class="msg-reply-bar" id="replyBar" style="display:none;">
          <span class="msg-reply-bar-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
          </span>
          <div class="msg-reply-bar-quote">
            <div class="msg-reply-bar-name" id="replyBarName"></div>
            <div class="msg-reply-bar-text" id="replyBarText"></div>
          </div>
          <button class="msg-reply-cancel" id="replyCancel" title="<%= lang === 'ru' ? 'Отменить' : 'Cancel' %>">&times;</button>
        </div>

        <%# Community chats: a draft in the other chat's language gets a pointer to the chat
            that speaks it, written in the language of the draft. Advice only, never a gate:
            js/chat-language.js decides, and sendMessage() never asks. %>
        <% if (activeConversation.communityLang) { %>
        <% const _hintInRussian = activeConversation.communityLang === 'en'; %>
        <div class="msg-lang-hint" id="langHintBar" hidden>
          <span class="msg-lang-hint-text"><%= _hintInRussian ? 'Это чат на английском. Для сообщений на русском есть отдельный чат.' : 'This chat is in Russian. English messages have their own chat.' %></span>
          <% if (typeof otherCommunity !== 'undefined' && otherCommunity) { %>
          <a class="msg-lang-hint-link" id="langHintLink" href="/<%= lang %>/messages/<%= otherCommunity.id %>" data-conv-id="<%= otherCommunity.id %>"><%= _hintInRussian ? 'Открыть русский чат' : 'Open the English chat' %></a>
          <% } %>
          <button type="button" class="msg-lang-hint-close" id="langHintClose" title="<%= _hintInRussian ? 'Скрыть' : 'Dismiss' %>" aria-label="<%= _hintInRussian ? 'Скрыть' : 'Dismiss' %>">&times;</button>
        </div>
        <% } %>

        <%# A member kept from writing here (conversation_members.posting_blocked_until) gets this
            in place of the composer. The composer stays in the DOM, hidden, because the script
            wires its controls without guards. %>
        <% if (typeof postingBlocked === 'string' && postingBlocked) { %>
        <div class="msg-posting-blocked" id="postingBlocked" role="status"><%= postingBlocked %></div>
        <% } %>
        <!-- Input bar -->
        <div class="msg-input-bar"<%- (typeof postingBlocked === 'string' && postingBlocked) ? ' hidden' : '' %>>
          <input type="file" id="imageFileInput" accept="<%= attachmentAccept %>" multiple style="display:none" />
          <%# The attach button opens a small menu (photo or video, document, poll), Telegram's. %>
          <div class="msg-attach-menu" id="attachMenu" hidden>
            <button type="button" class="msg-attach-menu-item" data-attach="media"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><%= lang === 'ru' ? 'Фото или видео' : 'Photo or video' %></button>
            <button type="button" class="msg-attach-menu-item" data-attach="file"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><%= lang === 'ru' ? 'Документ' : 'Document' %></button>
            <button type="button" class="msg-attach-menu-item" data-attach="poll"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg><%= lang === 'ru' ? 'Опрос' : 'Poll' %></button>
          </div>
          <%# The stickers already used in this member's chats, sent again with one click. %>
          <div class="msg-sticker-panel" id="stickerPanel" hidden>
            <div class="msg-sticker-panel-title"><%= lang === 'ru' ? 'Стикеры' : 'Stickers' %></div>
            <div class="msg-sticker-grid" id="stickerGrid"></div>
          </div>
          <button class="msg-sticker-btn" id="stickerBtn" title="<%= lang === 'ru' ? 'Стикеры' : 'Stickers' %>" aria-label="<%= lang === 'ru' ? 'Стикеры' : 'Stickers' %>">
            <%# A peeling sticker (SVG Repo, CC0), filled with the button's colour. %>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10.0653519,3.20844432 C6.0245904,4.09358572 3,7.69357739 3,12 C3,16.9705627 7.02943725,21 12,21 C16.3064226,21 19.9064143,17.9754096 20.7915557,13.9346481 C20.0701655,14.124108 19.3199641,14.2222222 18.5555556,14.2222222 C13.7077228,14.2222222 9.77777778,10.2922772 9.77777778,5.44444444 C9.77777778,4.68003592 9.87589197,3.9298345 10.0653519,3.20844432 Z M12.066347,3.48056053 C11.8765083,4.10911934 11.7777778,4.76909243 11.7777778,5.44444444 C11.7777778,9.18770775 14.8122923,12.2222222 18.5555556,12.2222222 C19.2309076,12.2222222 19.8908807,12.1234917 20.5194395,11.933653 L12.066347,3.48056053 Z M12,23 C5.92486775,23 1,18.0751322 1,12 C1,5.92486775 5.92486775,1 12,1 L12.4142136,1 L23,11.5857864 L23,12 C23,18.0751322 18.0751322,23 12,23 Z"/></svg>
          </button>
          <button class="msg-attach-btn" id="attachBtn" title="<%= lang === 'ru'
            ? `Прикрепить файл (до ${Math.round(attachmentRules.maxBytes / 1048576)} МБ, видео до ${Math.round(attachmentRules.videoMaxBytes / 1048576)} МБ)`
            : `Attach a file (up to ${Math.round(attachmentRules.maxBytes / 1048576)} MB, a video up to ${Math.round(attachmentRules.videoMaxBytes / 1048576)} MB)` %>">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
          </button>
          <%
            // A community chat's composer says which language the chat is in.
            const _placeholder = activeConversation.communityLang === 'en'
              ? (lang === 'ru' ? 'Сообщение на английском...' : 'Message in English...')
              : activeConversation.communityLang === 'ru'
                ? (lang === 'ru' ? 'Сообщение на русском...' : 'Message in Russian...')
                : (lang === 'ru' ? 'Написать сообщение...' : 'Type a message...');
          %>
          <textarea class="msg-input" id="msgInput" rows="1"
                    placeholder="<%= _placeholder %>"
                    maxlength="5000"></textarea>
          <button class="msg-send-btn" id="sendBtn" disabled>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
            </svg>
          </button>
        </div>
      <% } else { %>
        <!-- Empty state -->
        <div class="msg-empty">
          <svg class="msg-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <div class="msg-empty-text"><%= lang === 'ru' ? 'Выберите диалог' : 'Select a conversation' %></div>
          <div class="msg-empty-sub"><%= lang === 'ru' ? 'или начните новый' : 'or start a new one' %></div>
        </div>
      <% } %>
    </div>
  </div>

<%# New poll (lib/polls.js has the rules; POST /messages/:id/poll). %>
<div class="msg-modal-backdrop" id="pollModal">
  <div class="msg-modal msg-poll-modal">
    <div class="msg-modal-header">
      <h3><%= lang === 'ru' ? 'Новый опрос' : 'New poll' %></h3>
      <button type="button" class="msg-modal-close" id="pollModalClose" aria-label="<%= lang === 'ru' ? 'Закрыть' : 'Close' %>">&times;</button>
    </div>
    <div class="msg-modal-body">
      <label class="msg-poll-label" for="pollQuestion"><%= lang === 'ru' ? 'Вопрос' : 'Question' %></label>
      <input type="text" class="msg-poll-input" id="pollQuestion" maxlength="500" placeholder="<%= lang === 'ru' ? 'Задайте вопрос' : 'Ask a question' %>" />
      <div class="msg-poll-label"><%= lang === 'ru' ? 'Варианты ответа' : 'Poll options' %></div>
      <div id="pollOptions" class="msg-poll-options-edit"></div>
      <div class="msg-poll-hint" id="pollOptionsHint"></div>
      <div class="msg-poll-label"><%= lang === 'ru' ? 'Настройки' : 'Settings' %></div>
      <label class="msg-poll-setting"><span><b><%= lang === 'ru' ? 'Анонимный опрос' : 'Anonymous poll' %></b><small><%= lang === 'ru' ? 'Никто не видит, кто как ответил.' : 'Nobody sees who chose what.' %></small></span><input type="checkbox" id="pollAnonymous" checked /></label>
      <label class="msg-poll-setting"><span><b><%= lang === 'ru' ? 'Несколько ответов' : 'Allow multiple answers' %></b><small><%= lang === 'ru' ? 'Можно выбрать больше одного варианта.' : 'Voters can select more than one option.' %></small></span><input type="checkbox" id="pollMultiple" /></label>
      <label class="msg-poll-setting"><span><b><%= lang === 'ru' ? 'Можно переголосовать' : 'Allow revoting' %></b><small><%= lang === 'ru' ? 'Голос можно отозвать и отдать заново.' : 'Voters can change their vote.' %></small></span><input type="checkbox" id="pollRevote" checked /></label>
      <label class="msg-poll-setting"><span><b><%= lang === 'ru' ? 'Перемешать варианты' : 'Shuffle options' %></b><small><%= lang === 'ru' ? 'Каждый видит варианты в своём порядке.' : 'Answers appear in a different order for each voter.' %></small></span><input type="checkbox" id="pollShuffle" /></label>
      <label class="msg-poll-setting"><span><b><%= lang === 'ru' ? 'Викторина' : 'Quiz mode' %></b><small><%= lang === 'ru' ? 'Один правильный ответ, отметьте его слева от варианта. Один ответ, без переголосования.' : 'One right answer, marked to the left of an option. One vote, no revoting.' %></small></span><input type="checkbox" id="pollQuiz" /></label>
      <label class="msg-poll-setting"><span><b><%= lang === 'ru' ? 'Ограничить по времени' : 'Limit duration' %></b><small><%= lang === 'ru' ? 'Опрос закроется сам.' : 'The poll closes by itself.' %></small></span>
        <select id="pollDuration" class="msg-poll-select">
          <option value=""><%= lang === 'ru' ? 'Без ограничения' : 'No limit' %></option>
          <option value="60"><%= lang === 'ru' ? '1 час' : '1 hour' %></option>
          <option value="360"><%= lang === 'ru' ? '6 часов' : '6 hours' %></option>
          <option value="1440"><%= lang === 'ru' ? '1 день' : '1 day' %></option>
          <option value="4320"><%= lang === 'ru' ? '3 дня' : '3 days' %></option>
          <option value="10080"><%= lang === 'ru' ? '7 дней' : '7 days' %></option>
        </select></label>
      <div class="msg-poll-error" id="pollError" hidden></div>
    </div>
    <div class="msg-poll-footer">
      <button type="button" class="btn btn-outline-dark" id="pollCancel"><%= lang === 'ru' ? 'Отмена' : 'Cancel' %></button>
      <button type="button" class="btn btn-primary" id="pollCreate"><%= lang === 'ru' ? 'Создать' : 'Create' %></button>
    </div>
  </div>
</div>

<!-- New message modal -->
<div class="msg-modal-backdrop" id="newMsgModal">
  <div class="msg-modal">
    <div class="msg-modal-header">
      <h3><%= lang === 'ru' ? 'Новое сообщение' : 'New message' %></h3>
      <button class="msg-modal-close" id="closeModal">&times;</button>
    </div>
    <div class="msg-modal-body">
      <input type="text" class="msg-modal-search" id="userSearch"
             placeholder="<%= lang === 'ru' ? 'Поиск пользователей...' : 'Search users...' %>" />
      <div id="userResults"></div>

      <div class="msg-group-section">
        <button class="msg-group-toggle" id="groupToggle">
          <%= lang === 'ru' ? 'Создать групповой чат' : 'Create group chat' %>
        </button>
        <div class="msg-group-form" id="groupForm">
          <input type="text" class="msg-modal-search" id="groupSearch"
                 placeholder="<%= lang === 'ru' ? 'Добавить участников...' : 'Add members...' %>" />
          <div class="msg-selected-users" id="selectedUsers"></div>
          <div id="groupResults"></div>
          <div style="margin-top: var(--ss-space-3);">
