<%# «Последняя задача»: cards under messages that link to the app, the app's sheet, locked premium reactions. %>
<script src="<%= av('/js/apps/launcher.js') %>" defer></script>
<script>
(function() {
  const CONV_ID =<%= activeConversation ? activeConversation.id : 'null' %>;
  const COMMUNITY_LANG = <%- JSON.stringify(activeConversation && activeConversation.communityLang ? activeConversation.communityLang : null) %>;
  // Versioned URLs of the community emoji, keyed by :shortcode: (js/reactions.js).
  const REACTION_URLS = <%- JSON.stringify(rxUrls || {}).replace(/</g, '\\u003c') %>;
  const RX = window.Reactions || null;
  const USER_ID = <%= userId %>;
  const IS_GROUP = <%= activeConversation ? activeConversation.is_group : false %>;
  const IS_ADMIN = <%= typeof isAdmin !== 'undefined' ? isAdmin : false %>;
  const LANG = '<%= typeof lang !== "undefined" ? lang : "en" %>';
  const TIME_LOCALE = LANG === 'ru' ? 'ru-RU' : 'en-US';
  // The zone the server wrote the page's times in ('' when it did not know one), and this browser's.
  const SERVER_TZ = <%- JSON.stringify((typeof timeZone === 'string' && timeZone) ? timeZone : '') %>;
  let LOCAL_TZ = '';
  try { LOCAL_TZ = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
  const TIMES_ARE_LOCAL = !!SERVER_TZ && SERVER_TZ === LOCAL_TZ;
  const USERNAME = <%- JSON.stringify(username || '') %>;
  // A username's rank classes from the map the header inlined (js/user-ranks.js paints the
  // rest of the page; the chat writes them itself so nothing flashes on a chat switch).
  function rankClassFor(name) { const k = (window.__USER_RANKS__ || {})[name] || 'newbie'; return 'ss-rank-c-' + k + ' ss-rank-' + k; }
  // What may be attached and how large (lib/messageAttachments.js, the same rules the upload applies).
  const ATTACH_RULES = <%- JSON.stringify(attachmentRules) %>;
  const OTHER_NAME = <%- JSON.stringify(activeConversation && activeConversation.otherUser ? activeConversation.otherUser.username : '') %>;
  const SHOW_RECEIPTS = <%= (typeof showReceipts !== 'undefined' && showReceipts) ? 'true' : 'false' %>;
  const CAN_PIN = <%= (activeConversation && (!activeConversation.is_group || (typeof isAdmin !== 'undefined' && isAdmin))) ? 'true' : 'false' %>;
  // The open chat, for its info panel: the avatar as drawn in the header, name, kind, who else.
  const CHAT_INFO = <%- activeConversation ? JSON.stringify({
    name: activeConversation.displayName || '',
    isGroup: !!activeConversation.is_group,
    isSaved: !!activeConversation.isSaved,
    community: activeConversation.communityLang || null,
    picture: activeConversation.displayPicture || null,
    avatarSvg: activeConversation.is_group ? groupAvatarSVG(activeConversation.id, activeConversation.displayName, 88, activeConversation.communityLang) : null,
    memberCount: activeConversation.memberCount || 0,
    other: (!activeConversation.is_group && activeConversation.otherUser) ? activeConversation.otherUser.username : null,
    otherFull: (!activeConversation.is_group && activeConversation.otherUser) ? (activeConversation.otherUser.full_name || '') : '',
    otherId: (!activeConversation.is_group && activeConversation.otherUser) ? activeConversation.otherUser.id : null,
    otherRankKey: activeConversation.otherRank ? activeConversation.otherRank.key : null,
    blockedByMe: !!activeConversation.blockedByMe,
    isOnline: !!activeConversation.isOnline,
    muted: !!(typeof muted !== 'undefined' && muted),
    isAdmin: !!(typeof isAdmin !== 'undefined' && isAdmin),
  }).replace(/</g, '\\u003c') : 'null' %>;
  let readCutoff = <%- JSON.stringify(typeof readCutoff !== 'undefined' ? readCutoff : null) %>;
  let hasMoreHistory = <%= (typeof hasMoreHistory !== 'undefined' && hasMoreHistory) ? 'true' : 'false' %>;
  window.__MSG__ = { CONV_ID, COMMUNITY_LANG, REACTION_URLS, RX, USER_ID, IS_GROUP, IS_ADMIN, LANG, TIME_LOCALE, SERVER_TZ, LOCAL_TZ, TIMES_ARE_LOCAL, USERNAME, ATTACH_RULES, OTHER_NAME, SHOW_RECEIPTS, CAN_PIN, CHAT_INFO, readCutoff, hasMoreHistory, rankClassFor };
})();
</script>
<script src="<%= av('/js/messages-page.js') %>"></script>

<!-- Shared header behaviour: Bootstrap (dropdowns/mobile collapse) + site search -->
<script src="/js/vendor/bootstrap.bundle.min.js"></script>

