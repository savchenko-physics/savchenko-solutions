<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= docTitle(lang === 'ru' ? [tagMeta.labelRu, 'Задачи Савченко'] : tagMeta.labelEn + ' problems', 'Savchenko Solutions') %></title>
    <meta name="description" content="<%= lang === 'ru' ? tagMeta.description : tagMeta.description %> <%= total %> <%= lang === 'ru' ? 'задач.' : 'problems.' %>" />
    <link rel="canonical" href="https://savchenkosolutions.com/<%= lang %>/problems/topic/<%= tagMeta.key %>" />

    <%- include('../default/site_styles') %>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <script src="/js/vendor/bootstrap.bundle.min.js"></script>

    <style>
        html, body { height: auto; }
        body { display: flex; flex-direction: column; min-height: 100vh; margin: 0; }
        body > footer { flex-shrink: 0; margin-top: auto; }
        .pft-wrap { width: 100%; max-width: 900px; margin: 0 auto; padding: var(--ss-space-5) var(--ss-space-6) var(--ss-space-8); flex: 1 0 auto; }
        .pft-crumb { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-2); }
        .pft-crumb a { color: var(--ss-link); text-decoration: none; }
        .pft-h1 { font-family: var(--ss-font-ui); font-size: var(--ss-fs-24); font-weight: var(--ss-fw-strong); color: var(--ss-navy); margin: 0 0 var(--ss-space-1); }
        .pft-desc { font-size: var(--ss-fs-14); color: var(--ss-text-secondary); margin: var(--ss-space-2) 0 var(--ss-space-1); max-width: 640px; }
        .pft-count { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-4); }
        .pft-count a { color: var(--ss-link); text-decoration: none; }
        .pft-table { width: 100%; border-collapse: collapse; font-size: var(--ss-fs-13); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg); overflow: hidden; }
        .pft-table th { text-align: left; font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); text-transform: uppercase; letter-spacing: 0.02em; color: var(--ss-text-secondary); background: var(--ss-surface-alt); padding: var(--ss-space-2) var(--ss-space-3); border-bottom: 1px solid var(--ss-rule); }
        .pft-table td { padding: var(--ss-space-2) var(--ss-space-3); border-bottom: 1px solid var(--ss-rule-soft); }
        .pft-table tr:last-child td { border-bottom: none; }
        .pft-pname { font-weight: var(--ss-fw-strong); color: var(--ss-link); text-decoration: none; }
        .pft-pname:hover { color: var(--ss-link-hover); text-decoration: underline; }
        .pft-badge { display: inline-block; min-width: 28px; text-align: center; font-weight: var(--ss-fw-strong); font-size: var(--ss-fs-12); padding: 2px var(--ss-space-2); border-radius: var(--ss-radius-sm); background: #eceff1; color: var(--ss-text); }
        .pft-none { color: var(--ss-text-secondary); }
        .pft-pager { display: flex; gap: var(--ss-space-2); margin-top: var(--ss-space-4); }
        .pft-pager a { font-size: var(--ss-fs-13); padding: var(--ss-space-2) var(--ss-space-3); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); color: var(--ss-link); text-decoration: none; }
        .pft-pager a:hover { background: var(--ss-surface-alt); }
        .pft-empty { padding: var(--ss-space-7) 0; text-align: center; color: var(--ss-text-secondary); }
    </style>
</head>
<body>
<%- include('../default/main_site_header') %>

<div class="pft-wrap">
    <div class="pft-crumb">
        <a href="/<%= lang %>/problems"><%= lang === 'ru' ? 'Задачи по сложности' : 'Problems by difficulty' %></a>
        &nbsp;/&nbsp;<%= lang === 'ru' ? tagMeta.labelRu : tagMeta.labelEn %>
    </div>
    <h1 class="pft-h1"><%= lang === 'ru' ? tagMeta.labelRu : tagMeta.labelEn %></h1>
    <p class="pft-desc"><%= tagMeta.description %></p>
    <div class="pft-count">
        <%= total %> <%= lang === 'ru' ? 'задач' : 'problems' %>
        &middot; <a href="/<%= lang %>/problems?tag=<%= tagMeta.key %>"><%= lang === 'ru' ? 'открыть в конструкторе фильтров' : 'open in the interactive finder' %></a>
    </div>

    <% if (!rows.length) { %>
    <div class="pft-empty"><%= lang === 'ru' ? 'Задачи не найдены.' : 'No problems found.' %></div>
    <% } else { %>
    <table class="pft-table">
        <thead><tr>
            <th><%= lang === 'ru' ? 'Задача' : 'Problem' %></th>
            <th><%= lang === 'ru' ? 'Сложность' : 'Difficulty' %></th>
        </tr></thead>
        <tbody>
            <% rows.forEach(function(r) { %>
            <tr>
                <td><a class="pft-pname" href="/<%= lang %>/<%= r[0] %>"><%= r[0] %></a><% if (r[4] === 1) { %><sup class="ss-star">&#8727;</sup><% } %></td>
                <td><% if (r[5] != null) { %><span class="pft-badge"><%= toRating(r[5]) %></span><% } else { %><span class="pft-none">—</span><% } %></td>
            </tr>
            <% }); %>
        </tbody>
    </table>
    <% if (totalPages > 1) { %>
    <div class="pft-pager">
        <% if (page > 1) { %><a href="?page=<%= page - 1 %>">&larr; <%= lang === 'ru' ? 'Назад' : 'Previous' %></a><% } %>
        <span style="font-size:var(--ss-fs-13);color:var(--ss-text-secondary);padding:var(--ss-space-2) 0;"><%= page %> / <%= totalPages %></span>
        <% if (page < totalPages) { %><a href="?page=<%= page + 1 %>"><%= lang === 'ru' ? 'Далее' : 'Next' %> &rarr;</a><% } %>
    </div>
    <% } %>
    <% } %>
</div>

<%- include('../default/modern_footer') %>
</body>
</html>
