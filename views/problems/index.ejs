<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <% const searchQuery = query && typeof query.q === 'string' ? query.q.trim() : ''; %>
    <% if (searchQuery) { %>
    <title><%= docTitle(titleText(searchQuery), lang === 'ru' ? 'Поиск задач' : 'Problem search', 'Savchenko Solutions') %></title>
    <%# A results page for one query is not a page worth indexing; the finder itself is. %>
    <meta name="robots" content="noindex, follow" />
    <% } else { %>
    <title><%= docTitle(lang === 'ru' ? 'База задач Савченко' : 'Savchenko problem database', 'Savchenko Solutions') %></title>
    <% } %>
    <meta name="description" content="<%= lang === 'ru'
        ? 'Фильтруйте и сортируйте все 2023 задачи Савченко по сложности, теме и отдельным навыкам — идея, математика, вычисления, красота решения и другие.'
        : 'Filter and sort all 2,023 Savchenko problems by difficulty, topic and individual skill axes — insight, mathematics, computation, elegance and more.' %>" />
    <link rel="canonical" href="https://savchenkosolutions.com/<%= lang %>/problems" />

    <%- include('../default/site_styles', { ssStyles: { math: true, prose: true } }) %>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <!-- Card statement previews arrive pre-rendered as SVG math from
         GET /api/problem/:name/statement (index.js — the same endpoint the upload page
         uses), fetched per card after it renders. This stylesheet styles that SVG output;
         no client-side MathJax is loaded on this page. -->
    <script src="/js/vendor/bootstrap.bundle.min.js"></script>

    <style>
        html, body { height: auto; }
        body { display: flex; flex-direction: column; min-height: 100vh; margin: 0; }
        body > footer { flex-shrink: 0; margin-top: auto; }

        /* Edge to edge: the problem text is the point of the page, so the chrome around it is
           kept to a few pixels. */
        .pf-wrap { width: 100%; margin: 0; padding: var(--ss-space-2) var(--ss-space-2) var(--ss-space-6); flex: 1 0 auto; box-sizing: border-box; }
        /* One line above the columns: the title, the record presets and the methodology link.
           There were four (crumb, title, tabs, presets), 130px before the first statement on the
           owner's screen, which the statements are the point of (2026-09-19). */
        .pf-top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ss-space-2); margin-bottom: var(--ss-space-2); }
        .pf-h1 { font-family: var(--ss-font-ui); font-size: var(--ss-fs-20); font-weight: var(--ss-fw-strong); color: var(--ss-navy); margin: 0 var(--ss-space-2) 0 0; }
        .pf-method { margin-left: auto; font-size: var(--ss-fs-13); color: var(--ss-text-secondary); text-decoration: none; white-space: nowrap; }
        .pf-method:hover { color: var(--ss-link); text-decoration: underline; }
        .pf-stat-line { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin: var(--ss-space-3) 0 var(--ss-space-4); }

        .pf-records { display: contents; }
        .pf-record-chip {
            font-size: var(--ss-fs-13); padding: var(--ss-space-1) var(--ss-space-3); border-radius: var(--ss-radius);
            border: 1px solid var(--ss-rule); background: var(--ss-surface-alt); color: var(--ss-link); text-decoration: none; cursor: pointer;
        }
        .pf-record-chip:hover { background: var(--ss-surface-hover); color: var(--ss-link-hover); }

        .pf-layout { display: flex; gap: var(--ss-space-3); align-items: flex-start; }
        .pf-filters {
            flex: 0 0 236px; border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg); background: var(--ss-surface-alt);
            padding: var(--ss-space-3); position: sticky; top: 6px; max-height: calc(100vh - 12px); overflow-y: auto;
        }
        .pf-filter-group { margin-bottom: var(--ss-space-3); }
        .pf-filter-group:last-child { margin-bottom: 0; }
        .pf-filter-label { font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); letter-spacing: 0.03em; text-transform: uppercase; color: var(--ss-text-secondary); margin-bottom: var(--ss-space-2); }
        .pf-search-input {
            height: 40px; width: 100%; border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); padding: 0 var(--ss-space-3); font-size: var(--ss-fs-16); box-sizing: border-box;
        }
        .pf-search-input:focus { outline: none; border-color: var(--ss-navy); }
        @media (min-width: 768px) { .pf-search-form { display: none; } }

        .pf-range-head { display: flex; justify-content: space-between; align-items: baseline; font-size: var(--ss-fs-13); color: var(--ss-text); margin-bottom: 2px; }
        .pf-range-val { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); font-variant-numeric: tabular-nums; }
        /* The whole track is the drag surface (not just the native thumb pixel) — a plain
           input[type=range]'s hit-testing is too small/fragile for two overlapping handles,
           so dragging is handled manually in problems-finder.js via pointer capture on this
           element; the <input>s underneath are purely visual (pointer-events: none). */
        .pf-range-track { position: relative; height: 26px; cursor: pointer; touch-action: none; }
        .pf-range-track::before {
            content: ''; position: absolute; top: 11px; left: 0; right: 0; height: 4px;
            background: #dee2e6; border-radius: var(--ss-radius-sm);
        }
        .pf-range-fill {
            position: absolute; top: 11px; height: 4px; background: var(--ss-navy, #1a1a2e);
            border-radius: var(--ss-radius-sm); pointer-events: none; left: 0; right: 100%;
        }
        .pf-range-input {
            position: absolute; width: 100%; height: 14px; top: 6px; left: 0; margin: 0; padding: 0;
            -webkit-appearance: none; appearance: none; background: transparent; pointer-events: none;
        }
        .pf-range-input::-webkit-slider-thumb {
            -webkit-appearance: none; pointer-events: none; width: 16px; height: 16px;
            border-radius: 50%; background: var(--ss-navy); margin-top: calc(-1 * var(--ss-space-2)); box-shadow: 0 0 0 2px #fff;
        }
        .pf-range-input::-moz-range-thumb { pointer-events: none; width: 16px; height: 16px; border-radius: 50%; background: var(--ss-navy); border: none; box-shadow: 0 0 0 2px #fff; }
        .pf-range-input::-webkit-slider-runnable-track { width: 100%; height: 4px; background: transparent; }
        .pf-range-input::-moz-range-track { width: 100%; height: 4px; background: transparent; }

        .pf-check-row { display: flex; align-items: center; gap: var(--ss-space-2); font-size: var(--ss-fs-13); color: var(--ss-text); padding: var(--ss-space-1) 0; }
        .pf-seg { display: flex; border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); overflow: hidden; }
        .pf-seg button {
            flex: 1; border: none; background: var(--ss-surface); padding: var(--ss-space-2) var(--ss-space-1); font-size: var(--ss-fs-12); color: var(--ss-text-secondary); cursor: pointer;
            border-right: 1px solid var(--ss-rule);
        }
        .pf-seg button:last-child { border-right: none; }
        .pf-seg button.on { background: var(--ss-navy); color: var(--ss-on-navy); }
        .pf-seg button:disabled { color: var(--ss-text-tertiary); cursor: default; }

        .pf-chapter-list { max-height: 160px; overflow-y: auto; border: 1px solid var(--ss-rule-soft); border-radius: var(--ss-radius); padding: var(--ss-space-2) var(--ss-space-2); background: var(--ss-surface); }

        .pf-tag-toggle { display: flex; gap: var(--ss-space-1); margin-bottom: var(--ss-space-2); }
        .pf-tag-toggle button { flex: 1; font-size: var(--ss-fs-12); padding: var(--ss-space-1) var(--ss-space-2); border: 1px solid var(--ss-rule); background: var(--ss-surface); color: var(--ss-text-secondary); cursor: pointer; border-radius: var(--ss-radius-sm); }
        .pf-tag-toggle button.on { background: var(--ss-link); color: var(--ss-on-navy); border-color: var(--ss-link); }
        .pf-tag-search { height: 40px; width: 100%; border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); padding: 0 var(--ss-space-3); font-size: var(--ss-text-input); margin-bottom: var(--ss-space-2); box-sizing: border-box; }
        .pf-tag-list { max-height: 220px; overflow-y: auto; border: 1px solid var(--ss-rule-soft); border-radius: var(--ss-radius); padding: var(--ss-space-2) var(--ss-space-2); background: var(--ss-surface); }
        .pf-tag-row { display: flex; align-items: center; gap: var(--ss-space-2); font-size: var(--ss-fs-13); padding: 2px 0; }
        .pf-tag-row .n { margin-left: auto; color: var(--ss-text-secondary); font-size: var(--ss-fs-12); }

        .pf-advanced summary { cursor: pointer; font-size: var(--ss-fs-13); color: var(--ss-link); list-style: none; padding: var(--ss-space-1) 0; }
        .pf-advanced summary::-webkit-details-marker { display: none; }
        .pf-advanced summary::before { content: '\2192  '; }
        .pf-advanced[open] summary::before { content: '\2193  '; }
        .pf-advanced h4 { font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); letter-spacing: 0.03em; text-transform: uppercase; color: var(--ss-text-secondary); margin: var(--ss-space-3) 0 var(--ss-space-1); }

        .pf-clear-btn {
            width: 100%; margin-top: var(--ss-space-4); height: 34px; border-radius: var(--ss-radius); border: 1px solid var(--ss-rule);
            background: var(--ss-surface); color: var(--ss-text-secondary); font-size: var(--ss-fs-13); cursor: pointer;
        }
        .pf-clear-btn:hover { background: var(--ss-surface-hover); }

        .pf-results { flex: 1 1 auto; min-width: 0; }
        /* The active filters, the count and the sort share one row. */
        .pf-bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ss-space-2) var(--ss-space-3); margin-bottom: var(--ss-space-2); font-size: var(--ss-fs-13); color: var(--ss-text-secondary); }
        .pf-chips { display: contents; }
        .pf-chips[hidden] { display: none; }
        .pf-chip {
            display: inline-flex; align-items: center; gap: var(--ss-space-1); max-width: 100%;
            padding: 2px var(--ss-space-2) 2px var(--ss-space-3); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius);
            background: var(--ss-surface-alt); color: var(--ss-text); font-size: var(--ss-fs-13); line-height: 1.6; cursor: pointer;
            overflow-wrap: anywhere; text-align: left;
        }
        .pf-chip:hover { border-color: var(--ss-navy); background: var(--ss-surface-hover); }
        .pf-chip-x { color: var(--ss-text-secondary); font-size: var(--ss-fs-16); line-height: 1; }
        .pf-chip:hover .pf-chip-x { color: var(--ss-error); }
        .pf-chip-action { border: none; background: none; padding: 2px var(--ss-space-1); font-size: var(--ss-fs-13); color: var(--ss-link); cursor: pointer; }
        .pf-chip-action:hover { color: var(--ss-link-hover); text-decoration: underline; }
        .pf-sort { margin-left: auto; white-space: nowrap; }
        .pf-sort-label { color: var(--ss-text-secondary); }
        .pf-sort-select {
            height: 34px; border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); padding: 0 var(--ss-space-2); font-size: var(--ss-fs-13);
            color: var(--ss-text); background: var(--ss-surface);
        }

        /* ── Result cards: heat-coloured accent border, one head line (number, rating, the
           tags as clickable filter buttons — active ones green — the solution languages and
           the way in), then the rendered problem statement.
           No section/time badges: the chapter.section is already the leading two segments
           of the problem number, and the AI's minute estimate reads as more precise than it
           is once you're looking at the actual problem instead of a table cell.
           The card is not a link (it was until 2026-09-19): selecting or copying a line of the
           statement used to open the problem. Only the number and the link or button at the
           right lead anywhere. ── */
        .pf-card {
            border: 1px solid var(--ss-rule); border-left-width: 5px; border-radius: var(--ss-radius-lg); background: var(--ss-surface);
            padding: var(--ss-space-2) var(--ss-space-3); margin-bottom: var(--ss-space-2);
        }
        .pf-card-tags { display: contents; }
        .pf-card-tag {
            font-size: var(--ss-fs-12); padding: 2px var(--ss-space-2); border-radius: var(--ss-radius); border: 1px solid var(--ss-rule);
            background: var(--ss-surface-alt); color: var(--ss-text-secondary); cursor: pointer; white-space: nowrap;
        }
        .pf-card-tag:hover { border-color: var(--ss-link); color: var(--ss-link); }
        .pf-card-tag.active { background: var(--ss-success); color: var(--ss-on-navy); border-color: var(--ss-success); }
        .pf-card-head { display: flex; align-items: center; gap: var(--ss-space-2); margin-bottom: var(--ss-space-1); flex-wrap: wrap; }
        .pf-card-name { font-family: var(--ss-font-ui); font-weight: var(--ss-fw-strong); font-size: var(--ss-fs-16); color: var(--ss-link); text-decoration: none; }
        a.pf-card-name:hover { color: var(--ss-link-hover); text-decoration: underline; }
        span.pf-card-name { color: var(--ss-navy); }
        /* Raised like a footnote marker (LaTeX's $^*$), not sitting on the baseline — a
           centred asterisk at body size reads as a bullet, not Savchenko's own mark. */
        .pf-card-rating {
            font-family: var(--ss-font-ui); font-weight: var(--ss-fw-strong); font-size: var(--ss-fs-13); padding: 2px var(--ss-space-2);
            border-radius: var(--ss-radius-sm); color: var(--ss-on-navy);
        }
        .pf-card-status { display: flex; gap: var(--ss-space-1); margin-left: auto; font-size: var(--ss-fs-12); }
        .pf-card-vote { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); }
        /* The way in, at the right of the head line: a button, not a link with an arrow, which
           was missed (the owner, 2026-09-20). The solution in the primary style; an unsolved
           problem has no page, so its button is the upload form. */
        .pf-card-open, .pf-card-upload { white-space: nowrap; }
        .pf-card-status span { display: inline-block; width: 20px; height: 20px; line-height: 20px; text-align: center; border-radius: var(--ss-radius-sm); }
        .pf-card-status .en { background: var(--ss-surface-hover); color: var(--ss-link); }
        .pf-card-status .ru { background: var(--ss-warning-soft); color: var(--ss-warning); }
        /* The statement is set like the book (.ss-prose--compact): SS Text at 18px. */
        .pf-card-statement { min-height: 1.4em; }
        .pf-card-statement img { max-width: 100%; height: auto; }
        /* Book figures come in through statementRender.js as <figure>; the UA default
           margin (1em 40px) would indent them like a blockquote. Centred under the text. */
        .pf-card-statement figure { margin: var(--ss-space-2) 0 0; text-align: center; }
        .pf-card-statement figure img { display: inline-block; }
        .pf-card-statement p:last-child { margin-bottom: 0; }
        .pf-card-statement.is-loading { color: var(--ss-text-secondary); font-family: var(--ss-font-ui); font-size: var(--ss-fs-13); }
        .pf-none { color: var(--ss-text-secondary); font-size: var(--ss-fs-12); }

        .pf-load-more { display: block; width: 100%; margin-top: var(--ss-space-1); height: 42px; border-radius: var(--ss-radius-lg); border: 1px solid var(--ss-rule); background: var(--ss-surface-alt); color: var(--ss-navy); font-size: var(--ss-fs-13); font-weight: var(--ss-fw-regular); cursor: pointer; }
        .pf-load-more:hover { background: var(--ss-surface-hover); }
        .pf-load-more[hidden] { display: none; }

        .pf-empty { padding: var(--ss-space-8) 0; text-align: center; color: var(--ss-text-secondary); font-size: var(--ss-fs-13); }
        .pf-unavailable { padding: var(--ss-space-8); text-align: center; color: var(--ss-text-secondary); font-size: var(--ss-fs-14); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg); }
        .pf-load-error { padding: var(--ss-space-6); text-align: center; border: 1px solid var(--ss-error-rule); border-radius: var(--ss-radius-lg); background: var(--ss-error-soft); }
        .pf-load-error p { margin: 0 0 var(--ss-space-3); color: var(--ss-error); font-size: var(--ss-fs-13); }
        .pf-load-error button { height: 36px; padding: 0 var(--ss-space-5); border-radius: var(--ss-radius); border: none; background: var(--ss-navy); color: var(--ss-on-navy); font-size: var(--ss-fs-13); cursor: pointer; }
        .pf-load-error button:hover { background: #0d3b54; }
        .pf-load-error[hidden] { display: none; }

        .pf-heat-1 { border-left-color: var(--ss-heat-1); }
        .pf-heat-2 { border-left-color: var(--ss-heat-2); }
        .pf-heat-3 { border-left-color: var(--ss-heat-3); }
        .pf-heat-4 { border-left-color: var(--ss-heat-4); }
        .pf-heat-5 { border-left-color: var(--ss-heat-5); }
        .pf-heat-6 { border-left-color: var(--ss-heat-6); }
        .pf-heat-7 { border-left-color: var(--ss-heat-7); }
        .pf-heat-8 { border-left-color: var(--ss-heat-8); }
        .pf-heat-9 { border-left-color: var(--ss-heat-9); }
        .pf-heat-bg-1 { background: var(--ss-heat-1); color: var(--ss-heat-1-ink); }
        .pf-heat-bg-2 { background: var(--ss-heat-2); color: var(--ss-heat-2-ink); }
        .pf-heat-bg-3 { background: var(--ss-heat-3); color: var(--ss-heat-3-ink); }
        .pf-heat-bg-4 { background: var(--ss-heat-4); color: var(--ss-heat-4-ink); }
        .pf-heat-bg-5 { background: var(--ss-heat-5); color: var(--ss-heat-5-ink); }
        .pf-heat-bg-6 { background: var(--ss-heat-6); color: var(--ss-heat-6-ink); }
        .pf-heat-bg-7 { background: var(--ss-heat-7); color: var(--ss-heat-7-ink); }
        .pf-heat-bg-8 { background: var(--ss-heat-8); color: var(--ss-heat-8-ink); }
        .pf-heat-bg-9 { background: var(--ss-heat-9); color: var(--ss-heat-9-ink); }
        .pf-heat-none { background: #adb5bd; color: #fff; }

        /* Long formulas and unbreakable tokens must wrap or scroll inside the card, never
           push the card past the viewport. An inline formula is an inline box, which max-width
           and overflow cannot touch (a 42em one reached 776px on a 390px phone), so the
           statement itself scrolls as well. */
        .pf-card-statement { overflow-wrap: anywhere; overflow-x: auto; overflow-y: hidden; }
        /* Where a query was found when it was not in the statement: a line of the solution. */
        .pf-card-snippet { margin: 0 0 var(--ss-space-2); font-size: var(--ss-fs-13); line-height: var(--ss-lh-snug); color: var(--ss-text-secondary); overflow-wrap: anywhere; }
        .pf-card-statement mjx-container { max-width: 100%; overflow-x: auto; overflow-y: hidden; }

        @media (max-width: 900px) {
            /* Column layout: align-items must be stretch here, or the results column
               shrink-wraps to its widest line and the cards overflow the screen. */
            .pf-layout { flex-direction: column; align-items: stretch; }
            .pf-filters { position: static; flex: 1 1 auto; max-height: none; width: 100%; box-sizing: border-box; }
            .pf-results { width: 100%; }
            .pf-wrap { padding: var(--ss-space-1) var(--ss-space-1) var(--ss-space-5); }
            .pf-card { padding: var(--ss-space-2) var(--ss-space-2); border-left-width: 4px; }
        }
    </style>
</head>
<body>
<%- include('../default/main_site_header', { finderSearch: true }) %>

<div class="pf-wrap">
    <% if (!dataset) { %>
    <h1 class="pf-h1"><%= lang === 'ru' ? 'База задач' : 'Problem database' %></h1>
    <div class="pf-unavailable"><%= lang === 'ru' ? 'Данные о сложности временно недоступны.' : 'Difficulty data is temporarily unavailable.' %></div>
    <% } else { %>

    <div class="pf-top">
    <h1 class="pf-h1"><%= lang === 'ru' ? 'База задач' : 'Problem database' %></h1>
    <div class="pf-records">
        <button class="pf-record-chip" data-preset="hardest"><%= lang === 'ru' ? 'Сложнее всего' : 'Hardest' %></button>
        <button class="pf-record-chip" data-preset="easiest"><%= lang === 'ru' ? 'Легче всего' : 'Easiest' %></button>
        <button class="pf-record-chip" data-preset="quickest"><%= lang === 'ru' ? 'Быстрее всего' : 'Quickest' %></button>
        <button class="pf-record-chip" data-preset="elegant"><%= lang === 'ru' ? 'Красивее всего' : 'Most elegant' %></button>
        <button class="pf-record-chip" data-preset="starred"><%= lang === 'ru' ? 'Задачи со звёздочкой ∗' : 'Asterisked problems' %></button>
        <button class="pf-record-chip" data-preset="unsolved"><%= lang === 'ru' ? 'Нерешённые' : 'Unsolved' %></button>
    </div>
    <a class="pf-method" href="/<%= lang %>/problems/methodology"><%= lang === 'ru' ? 'Как считается сложность' : 'How difficulty is scored' %></a>
    </div>

    <div class="pf-layout">
        <aside class="pf-filters" id="pfFilters">
            <%# The site's search lands here (the header, /find, links to the old results page): a query
                matches problem numbers, topics, statements and solutions. From 768px the header's
                box is this page's search, so this one only shows on a phone, where the header has
                none. A plain GET form, so it works before the script loads. %>
            <form class="pf-filter-group pf-search-form" id="pfSearchForm" action="/<%= lang %>/problems" method="get" role="search">
                <label class="pf-filter-label" for="pfSearch"><%= lang === 'ru' ? 'Поиск' : 'Search' %></label>
                <input type="search" class="pf-search-input" id="pfSearch" name="q" value="<%= searchQuery %>" autocomplete="off" placeholder="<%= lang === 'ru' ? 'Номер, тема или слова из условия' : 'Number, topic or words from the problem' %>" />
            </form>

            <div class="pf-filter-group">
                <div class="pf-range-head"><span><%= lang === 'ru' ? 'Сложность' : 'Difficulty' %></span><span class="pf-range-val" id="pfCalibVal"><%= ratingFloor %>–<%= ratingCeil %></span></div>
                <div class="pf-range-track">
                    <div class="pf-range-fill"></div>
                    <input type="range" min="<%= ratingFloor %>" max="<%= ratingCeil %>" value="<%= ratingFloor %>" step="<%= ratingStep %>" class="pf-range-input" id="pfCalibLo" />
                    <input type="range" min="<%= ratingFloor %>" max="<%= ratingCeil %>" value="<%= ratingCeil %>" step="<%= ratingStep %>" class="pf-range-input" id="pfCalibHi" />
                </div>
            </div>


            <div class="pf-filter-group">
                <label class="pf-check-row"><input type="checkbox" id="pfStarred" /> <%= lang === 'ru' ? 'Задачи со звёздочкой ∗' : 'Asterisked problems' %></label>
                <% if (userId) { %>
                <label class="pf-check-row"><input type="checkbox" id="pfBookmarked" /> <%= lang === 'ru' ? 'Мои закладки' : 'My bookmarks' %></label>
                <% } %>
            </div>

            <div class="pf-filter-group">
                <div class="pf-filter-label"><%= lang === 'ru' ? 'Язык решения' : 'Solution language' %></div>
                <div class="pf-seg" id="pfLangSeg">
                    <button data-val="any" class="on"><%= lang === 'ru' ? 'Все' : 'Any' %></button>
                    <button data-val="en">EN</button>
                    <button data-val="ru">RU</button>
                </div>
                <%# The problems nobody has written up in either language (solved=none in the URL).
                    It used to be a fourth button of the segment above; a problem with no solution
                    has no solution language, so while this is ticked the segment is disabled. %>
                <label class="pf-check-row"><input type="checkbox" id="pfUnsolved" /> <%= lang === 'ru' ? 'Ещё не решены' : 'Not yet solved' %></label>
            </div>

            <div class="pf-filter-group">
                <div class="pf-filter-label"><%= lang === 'ru' ? 'Главы' : 'Chapters' %></div>
                <div class="pf-chapter-list" id="pfChapterList">
                    <% for (const num of Object.keys(dataset.chapters)) { %>
                    <label class="pf-check-row"><input type="checkbox" class="pf-chapter-cb" value="<%= num %>" /> <%= num %>. <%= dataset.chapters[num] %></label>
                    <% } %>
                </div>
            </div>

            <div class="pf-filter-group">
                <div class="pf-filter-label"><%= lang === 'ru' ? 'Темы' : 'Topics' %></div>
                <div class="pf-tag-toggle" id="pfTagMode">
                    <button data-val="or" class="on"><%= lang === 'ru' ? 'ЛЮБАЯ из тем' : 'ANY of these' %></button>
                    <button data-val="and"><%= lang === 'ru' ? 'ВСЕ темы' : 'ALL of these' %></button>
                </div>
                <input type="text" class="pf-tag-search" id="pfTagSearch" placeholder="<%= lang === 'ru' ? 'Фильтр списка тем...' : 'Filter topic list...' %>" />
                <div class="pf-tag-list" id="pfTagList"></div>
            </div>

            <details class="pf-advanced">
                <summary><%= lang === 'ru' ? 'Отдельные навыки' : 'Individual skill axes' %></summary>
                <div id="pfAxisFilters">
                    <h4><%= lang === 'ru' ? 'Чего стоит' : 'What it costs' %></h4>
                    <% axisMeta.cost.forEach(function(a) { %>
                    <div class="pf-range-head"><span><%= lang === 'ru' ? a.labelRu : a.labelEn %></span><span class="pf-range-val" data-axis-val="<%= a.key %>">0–100</span></div>
                    <div class="pf-range-track">
                        <div class="pf-range-fill"></div>
                        <input type="range" min="0" max="100" value="0" class="pf-range-input pf-axis-lo" data-axis="<%= a.key %>" />
                        <input type="range" min="0" max="100" value="100" class="pf-range-input pf-axis-hi" data-axis="<%= a.key %>" />
                    </div>
                    <% }); %>
                    <h4><%= lang === 'ru' ? 'Форма задачи' : 'Shape of the problem' %></h4>
                    <% axisMeta.shape.forEach(function(a) { %>
                    <div class="pf-range-head"><span><%= lang === 'ru' ? a.labelRu : a.labelEn %></span><span class="pf-range-val" data-axis-val="<%= a.key %>">0–100</span></div>
                    <div class="pf-range-track">
                        <div class="pf-range-fill"></div>
                        <input type="range" min="0" max="100" value="0" class="pf-range-input pf-axis-lo" data-axis="<%= a.key %>" />
                        <input type="range" min="0" max="100" value="100" class="pf-range-input pf-axis-hi" data-axis="<%= a.key %>" />
                    </div>
                    <% }); %>
                    <h4><%= lang === 'ru' ? 'Что даёт' : 'What it repays' %></h4>
                    <% axisMeta.reward.forEach(function(a) { %>
                    <div class="pf-range-head"><span><%= lang === 'ru' ? a.labelRu : a.labelEn %></span><span class="pf-range-val" data-axis-val="<%= a.key %>">0–100</span></div>
                    <div class="pf-range-track">
                        <div class="pf-range-fill"></div>
                        <input type="range" min="0" max="100" value="0" class="pf-range-input pf-axis-lo" data-axis="<%= a.key %>" />
                        <input type="range" min="0" max="100" value="100" class="pf-range-input pf-axis-hi" data-axis="<%= a.key %>" />
                    </div>
                    <% }); %>
                </div>
            </details>

            <button class="pf-clear-btn" id="pfClearBtn"><%= lang === 'ru' ? 'Сбросить фильтры' : 'Clear filters' %></button>
        </aside>

        <main class="pf-results">
            <div class="pf-bar">
                <%# What is selected, each removable, with a link that reproduces it (js/problems-finder.js,
                    which also draws the link to /unsolved when the unsolved filter is on). %>
                <div class="pf-chips" id="pfChips" aria-live="polite"<% if (!hasFilters) { %> hidden<% } %>><% if (query && query.solved === 'none') { %><a class="pf-chip-action" href="/<%= lang %>/unsolved"><%= lang === 'ru' ? 'Нерешённые по главам' : 'Unsolved by chapter' %></a><% } %></div>
                <span id="pfResultCount"><%= lang === 'ru' ? 'Показано' : 'Showing' %> <%= ssrRows.length %> <%= lang === 'ru' ? 'из' : 'of' %> <%= total %><% if (searchQuery) { %> <%= lang === 'ru' ? 'по запросу' : 'for' %> «<%= searchQuery %>»<% } %></span>
                <span class="pf-sort">
                    <span class="pf-sort-label"><%= lang === 'ru' ? 'Сортировка:' : 'Sort:' %></span>
                    <select class="pf-sort-select" id="pfSortSelect">
                        <option value="" id="pfSortDefault" data-label="<%= lang === 'ru' ? 'По номеру' : 'Problem order' %>" data-label-search="<%= lang === 'ru' ? 'Лучшие совпадения' : 'Best match' %>"><%= searchQuery ? (lang === 'ru' ? 'Лучшие совпадения' : 'Best match') : (lang === 'ru' ? 'По номеру' : 'Problem order') %></option>
                        <option value="calibrated:desc"><%= lang === 'ru' ? 'Сложнее сначала' : 'Hardest first' %></option>
                        <option value="calibrated:asc"><%= lang === 'ru' ? 'Легче сначала' : 'Easiest first' %></option>
                        <option value="elegance:desc"><%= lang === 'ru' ? 'Красивее сначала' : 'Most elegant first' %></option>
                        <option value="vote_avg:desc"><%= lang === 'ru' ? 'Выше оценка читателей' : "Highest readers' rating" %></option>
                    </select>
                </span>
            </div>
            <%
            const heatOf = (c) => c == null ? null : Math.min(9, Math.max(1, Math.ceil((c / 100) * 9) || 1));
            // dataset.tags is [key, labelEn, labelRu] — SSR cards need the same localized
            // label the client JS shows after hydration, not the raw snake_case key.
            const tagLabelMap = {};
            dataset.tags.forEach(function(t) { tagLabelMap[t[0]] = lang === 'ru' ? t[2] : t[1]; });
            %>
            <div id="pfCards">
                <% ssrRows.forEach(function(r) {
                    const heat = heatOf(r[5]); const rating = toRating(r[5]);
                    const isCanonical = r[8].length > 0;
                    const tagSource = isCanonical ? r[8] : r[7];
                    // No solution in either language: /<lang>/<name> would only redirect to
                    // /unsolved, so the only way in is the upload button; a solved problem's number
                    // and "Solution" link open it (js/problems-finder.js cardHtml renders the same
                    // card after hydration).
                    const unsolvedCard = !r[11] && !r[12];
                    const href = unsolvedCard ? `/${lang}/upload?problem=${encodeURIComponent(r[0])}` : `/${lang}/${r[0]}`;
                    const statementHtml = statements[r[0]];
                %>
                <div class="pf-card <%= heat ? 'pf-heat-' + heat : '' %>" data-name="<%= r[0] %>">
                    <div class="pf-card-head">
                        <% if (unsolvedCard) { %><span class="pf-card-name"><%= r[0] %></span><% } else { %><a class="pf-card-name" href="<%= href %>"><%= r[0] %></a><% } %>
                        <% if (r[4] === 1) { %><sup class="ss-star" title="<%= lang === 'ru' ? 'Отмечена ∗ Савченко' : 'Asterisked by Savchenko' %>">&#8727;</sup><% } %>
                        <% if (rating != null) { %><span class="pf-card-rating <%= heat ? 'pf-heat-bg-' + heat : 'pf-heat-none' %>"><%= rating %></span><% } %>
                        <% if (tagSource.length) { %>
                        <div class="pf-card-tags">
                            <% tagSource.forEach(function(t) { %><button type="button" class="pf-card-tag" data-tag="<%= t %>"><%= isCanonical ? (tagLabelMap[t] || t) : t %></button><% }); %>
                        </div>
                        <% } %>
                        <span class="pf-card-status">
                            <% if (r[11]) { %><span class="en" title="English solution">EN</span><% } %>
                            <% if (r[12]) { %><span class="ru" title="Russian solution">RU</span><% } %>
                        </span>
                        <% if (r[10]) { %><span class="pf-card-vote"><%= r[9] %>/10 (<%= r[10] %>)</span><% } %>
                        <% if (unsolvedCard) { %><a class="btn btn-sm btn-outline-dark pf-card-upload" href="<%= href %>"><%= lang === 'ru' ? 'Загрузить решение' : 'Upload a solution' %></a><% } else { %><a class="btn btn-sm btn-dark pf-card-open" href="<%= href %>"><%= lang === 'ru' ? 'Решение' : 'Solution' %></a><% } %>
                    </div>
                    <% if (snippets && snippets[r[0]]) { %><p class="pf-card-snippet"><%= snippets[r[0]] %></p><% } %>
                    <%# The statement is rendered into the page (problems.js, one query and the shared
                        cache), not fetched afterwards: the batch request alone was ~0.85 s of round trip
                        on every visit. The script reads these into its cache (js/problems-finder.js). %>
                    <% if (statementHtml) { %>
                    <div class="pf-card-statement ss-prose ss-prose--compact" data-statement-for="<%= r[0] %>"><%- statementHtml %></div>
                    <% } else { %>
                    <div class="pf-card-statement ss-prose ss-prose--compact is-loading" data-statement-for="<%= r[0] %>"><%= lang === 'ru' ? 'Загрузка условия…' : 'Loading statement…' %></div>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <div class="pf-empty" id="pfEmpty" hidden><%= lang === 'ru' ? 'Ни одна задача не соответствует фильтрам.' : 'No problems match these filters.' %></div>
            <div class="pf-load-error" id="pfLoadError" hidden>
                <p><%= lang === 'ru' ? 'Не удалось загрузить список задач.' : 'Could not load the problem list.' %></p>
                <button type="button" id="pfRetryBtn"><%= lang === 'ru' ? 'Повторить' : 'Retry' %></button>
            </div>
            <button type="button" class="pf-load-more" id="pfLoadMore" hidden><%= lang === 'ru' ? 'Показать ещё' : 'Load more' %></button>
        </main>
    </div>

    <!-- The filterable dataset is fetched (js/problems-finder.js), not embedded here — see
         problems.js's GET /data comment for why. Only small values are inlined. -->
    <script type="application/json" id="pfBookmarked"><%- JSON.stringify(bookmarked).replace(/</g, '\\u003c') %></script>
    <script>
        window.__PF_QUERY__ = <%- JSON.stringify(query || {}).replace(/</g, '\\u003c') %>;
        window.__PF_LANG__ = <%- JSON.stringify(lang) %>;
        window.__PF_DATA_URL__ = <%- JSON.stringify(`/${lang}/problems/data`) %>;
        // Server-authoritative, so the number of cards rendered here, the client's page
        // size and the statement-batch size can never drift apart again.
        window.__PF_PAGE_SIZE__ = <%- JSON.stringify(pageSize) %>;
    </script>
    <script src="<%= asset('/js/problems-finder.js') %>" defer></script>
    <% } %>
</div>

<%- include('../default/modern_footer') %>
</body>
</html>
