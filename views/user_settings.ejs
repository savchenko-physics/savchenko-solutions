<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="content-language" content="<%= lang %>">
    <title><%= docTitle(__('settings.title'), __('title')) %></title>
    <%- include('default/site_styles', { ssStyles: { icons: 'fa6', bootstrap: false } }) %>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
    <link rel="icon" type="image/png" href="/img/logo.png">
    <style>
        :root {
            --text-primary: #2d2d2d;
            --text-secondary: #6c757d;
            --text-muted: #999;
            --heading: #1a1a2e;
            --border: #dee2e6;
            --focus: #1a5276;
            --btn: #1a1a2e;
            --btn-hover: #2c2c4a;
            --error: #c0392b;
            --success: #27ae60;
            --bg: #ffffff;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: var(--ss-font-ui);
            background: var(--bg);
            color: var(--text-primary);
            line-height: 1.5;
        }
        a { color: var(--text-secondary); transition: color 150ms ease, opacity 150ms ease; }
        a:hover { color: var(--heading); }

        .settings-page { min-height: 100vh; padding-bottom: var(--ss-space-9); }
        .settings-topbar {
            display: flex;
            align-items: center;
            gap: var(--ss-space-3);
            padding: var(--ss-space-4) var(--ss-space-5);
            border-bottom: 1px solid var(--border);
            max-width: 920px;
            margin: 0 auto;
        }
        .settings-back {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            color: var(--heading);
            text-decoration: none;
            border-radius: var(--ss-radius);
            transition: background 150ms ease;
        }
        .settings-back:hover { background: #f4f4f4; color: var(--heading); }
        .settings-topbar h1 {
            margin: 0;
            font-size: var(--ss-fs-20);
            font-weight: var(--ss-fw-strong);
            color: var(--heading);
        }

        .settings-layout {
            display: flex;
            max-width: 920px;
            margin: 0 auto;
            padding: var(--ss-space-6) var(--ss-space-5) 0;
            gap: var(--ss-space-7);
            align-items: flex-start;
        }
        .settings-sidebar {
            width: 200px;
            flex-shrink: 0;
        }
        .settings-nav-btn {
            display: block;
            width: 100%;
            text-align: left;
            padding: var(--ss-space-3) var(--ss-space-3);
            margin-bottom: var(--ss-space-1);
            border: none;
            border-left: 4px solid transparent;
            background: none;
            font-size: var(--ss-fs-14);
            color: var(--text-secondary);
            cursor: pointer;
            transition: color 150ms ease, border-color 150ms ease, font-weight 150ms ease;
            font-family: inherit;
        }
        .settings-nav-btn:hover { color: var(--heading); }
        .settings-nav-btn.is-active {
            color: var(--heading);
            font-weight: var(--ss-fw-strong);
            border-left-color: var(--heading);
        }

        .settings-main { flex: 1; max-width: 640px; min-width: 0; }

        .tab-panel { display: none; }
        .tab-panel.is-active { display: block; }

        .alert {
            padding: var(--ss-space-3) var(--ss-space-4);
            margin-bottom: var(--ss-space-5);
            border-radius: var(--ss-radius);
            font-size: var(--ss-fs-14);
        }
        .alert-success { background: var(--ss-success-soft); color: var(--ss-success-strong); border: 1px solid #b8e6c8; }
        .alert-error { background: var(--ss-error-soft); color: var(--ss-error); border: 1px solid #f5c4c0; }

        .section-heading {
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            color: var(--heading);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: var(--ss-space-7) 0 var(--ss-space-4);
        }
        .section-heading:first-child { margin-top: 0; }

        .field { margin-bottom: var(--ss-space-4); }
        .field-label {
            display: block;
            font-size: var(--ss-fs-13);
            color: var(--text-secondary);
            margin-bottom: var(--ss-space-2);
        }
        .field-hint { font-size: var(--ss-fs-12); color: var(--text-muted); margin-top: var(--ss-space-2); }
        .field-error { font-size: var(--ss-fs-12); color: var(--error); margin-top: var(--ss-space-2); display: none; }
        .field-error.is-visible { display: block; }

        .input, .textarea, .select {
            width: 100%;
            height: 40px;
            padding: 0 var(--ss-space-3);
            border: 1px solid var(--border);
            border-radius: var(--ss-radius);
            font-size: var(--ss-text-input);
            color: var(--text-primary);
            font-family: inherit;
            transition: border-color 150ms ease, box-shadow 150ms ease;
        }
        .textarea { height: auto; min-height: 96px; padding: var(--ss-space-3) var(--ss-space-3); resize: vertical; }
        .input:focus, .textarea:focus, .select:focus {
            outline: none;
            border-color: var(--focus);
            box-shadow: 0 0 0 2px rgba(26, 82, 118, 0.25);
        }
        .input.input-invalid, .textarea.input-invalid { border-color: var(--error); }

        .input-with-icon { position: relative; }
        .input-with-icon .input { padding-left: var(--ss-space-8); padding-right: var(--ss-space-8); }
        .input-with-icon .icon-left {
            position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
            font-size: var(--ss-fs-16); color: var(--text-muted); pointer-events: none;
        }
        .pw-toggle {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: var(--text-muted); cursor: pointer;
            padding: var(--ss-space-1); font-size: var(--ss-fs-16);
        }
        .pw-toggle:focus { outline: none; box-shadow: 0 0 0 2px var(--focus); border-radius: var(--ss-radius-sm); }

        .bio-wrap { position: relative; }
        .bio-counter {
            position: absolute; bottom: 8px; right: 10px;
            font-size: var(--ss-fs-12); color: var(--text-muted);
            pointer-events: none;
        }

        .avatar-block { text-align: center; margin-bottom: var(--ss-space-6); }
        .avatar-wrap {
            position: relative;
            width: 96px; height: 96px;
            margin: 0 auto 8px;
            border-radius: 50%;
            overflow: hidden;
            cursor: pointer;
        }
        .avatar-wrap img {
            width: 100%; height: 100%; object-fit: cover;
            display: block;
        }
        .avatar-overlay {
            position: absolute; inset: 0;
            background: rgba(0,0,0,0.55);
            color: var(--ss-on-navy);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: var(--ss-fs-12);
            font-weight: var(--ss-fw-regular);
            opacity: 0;
            transition: opacity 150ms ease;
        }
        .avatar-wrap:hover .avatar-overlay { opacity: 1; }
        .avatar-overlay i { font-size: var(--ss-fs-20); margin-bottom: var(--ss-space-1); }
        /* The two things you can do with the photo are buttons, not a hover overlay: on a phone
           there is no hover, and until 2026-09-21 nothing on the page said the picture could be
           changed at all. */
        .avatar-file-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
        .avatar-actions {
            display: flex; flex-wrap: wrap; justify-content: center;
            gap: var(--ss-space-2);
            margin-top: var(--ss-space-2);
        }
        .avatar-actions .btn-secondary { font-size: var(--ss-fs-13); }
        .avatar-hint {
            margin: var(--ss-space-2) 0 0;
            font-size: var(--ss-fs-12);
            color: var(--text-secondary);
        }
        /* Shown once a new photo is chosen or removal asked for: what will happen, and the
           button that makes it happen. The form's Save at the bottom does the same, but the
           photo sits at the top of a long form and its own button leaves nothing to look for. */
        .avatar-pending {
            display: none;
            margin: var(--ss-space-3) auto 0;
            max-width: 420px;
            padding: var(--ss-space-3) var(--ss-space-4);
            border: 1px solid var(--border);
            border-radius: var(--ss-radius);
            background: var(--ss-surface-alt);
            text-align: left;
        }
        .avatar-pending.is-visible { display: block; }
        .avatar-pending p { margin: 0 0 var(--ss-space-2); font-size: var(--ss-fs-14); }
        .avatar-pending .avatar-file { color: var(--text-secondary); font-size: var(--ss-fs-13); overflow-wrap: anywhere; }
        .avatar-pending-actions { display: flex; gap: var(--ss-space-2); align-items: center; }
        /* The crop stage (js/avatar-crop.js): the frame with the picture, then the controls. */
        .avatar-stage { display: none; margin: 0 0 var(--ss-space-3); }
        .avatar-stage.is-visible { display: block; }
        .avatar-stage-frame { display: flex; justify-content: center; }
        .avatar-stage canvas {
            display: block;
            border-radius: var(--ss-radius);
            background: var(--ss-surface-hover);
            cursor: grab;
            touch-action: none;
            max-width: 100%;
        }
        .avatar-stage canvas:active { cursor: grabbing; }
        .avatar-stage-hint { margin: var(--ss-space-2) 0 var(--ss-space-3); font-size: var(--ss-fs-12); color: var(--text-secondary); text-align: center; }
        .avatar-stage-row {
            display: flex; align-items: center; gap: var(--ss-space-3);
            margin-bottom: var(--ss-space-2);
        }
        .avatar-stage-row > label, .avatar-stage-row > .avatar-stage-label {
            flex: 0 0 72px; font-size: var(--ss-fs-13); color: var(--text-secondary);
        }
        .avatar-stage-row .select { flex: 1 1 auto; width: auto; min-width: 0; }
        .avatar-stage-row input[type="range"] { flex: 1 1 auto; min-width: 0; accent-color: var(--btn); }
        .avatar-stage-row .btn-secondary { padding: var(--ss-space-2) var(--ss-space-3); font-size: var(--ss-fs-13); line-height: 1.2; }
        .avatar-stage-row .btn-secondary.is-active { background: var(--btn); color: var(--ss-on-navy); border-color: var(--btn); }
        .avatar-segment { display: flex; gap: var(--ss-space-1); }
        .avatar-pending .btn-primary { width: auto; height: 40px; margin: 0; padding: 0 var(--ss-space-4); }
        .avatar-error { display: none; margin: var(--ss-space-2) 0 0; font-size: var(--ss-fs-13); color: var(--error); }
        .avatar-error.is-visible { display: block; }

        .username-status { font-size: var(--ss-fs-12); margin-top: var(--ss-space-2); min-height: 18px; }
        .username-status.ok { color: var(--success); }
        .username-status.bad { color: var(--error); }

        .btn-primary {
            width: 100%;
            height: 44px;
            margin-top: var(--ss-space-2);
            border: none;
            border-radius: var(--ss-radius);
            background: var(--btn);
            color: var(--ss-on-navy);
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            font-family: inherit;
            cursor: pointer;
            transition: background 150ms ease, color 150ms ease;
        }
        .btn-primary:hover:not(:disabled) { background: var(--btn-hover); }
        .btn-primary:disabled {
            background: #e0e0e0;
            color: var(--text-muted);
            cursor: not-allowed;
        }
        /* The button is still disabled while "Saved" shows, and :disabled's #999 was 1.0:1 on green. */
        .btn-primary.flash-success { background: var(--success); color: var(--ss-on-navy); }

        .toggle-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: var(--ss-space-4);
            margin-bottom: var(--ss-space-6);
        }
        .toggle-text {
            flex: 1;
        }
        .toggle-text strong { display: block; font-size: var(--ss-fs-14); color: var(--text-primary); font-weight: var(--ss-fw-regular); }
        .toggle-text span { font-size: var(--ss-fs-12); color: var(--text-muted); }

        .toggle {
            position: relative;
            width: 44px;
            height: 24px;
            flex-shrink: 0;
        }
        .toggle input {
            position: absolute;
            opacity: 0;
            width: 44px;
            height: 24px;
            margin: 0;
            z-index: 3;
            cursor: pointer;
        }
        .toggle-track {
            position: absolute;
            inset: 0;
            background: var(--border);
            border-radius: var(--ss-radius-lg);
            transition: background 150ms ease;
        }
        .toggle-thumb {
            position: absolute;
            top: 2px;
            left: 2px;
            width: 20px;
            height: 20px;
            background: var(--ss-surface);
            border-radius: 50%;
            box-shadow: var(--ss-shadow);
            transition: transform 150ms ease;
            z-index: 2;
            pointer-events: none;
        }
        .toggle input:checked ~ .toggle-track { background: var(--btn); }
        .toggle input:checked ~ .toggle-thumb { transform: translateX(20px); }
        .toggle input:focus ~ .toggle-track {
            box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--focus);
        }

        .danger-link {
            color: var(--error);
            font-size: var(--ss-fs-14);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            font-family: inherit;
            text-decoration: underline;
        }

        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: var(--ss-space-4);
        }
        .modal-backdrop.is-open { display: flex; }
        .modal-box {
            background: var(--ss-surface);
            max-width: 400px;
            width: 100%;
            padding: var(--ss-space-6);
            border-radius: var(--ss-radius);
            border: 1px solid var(--border);
        }
        .modal-box h2 { margin: 0 0 var(--ss-space-3); font-size: var(--ss-fs-18); color: var(--heading); }
        .modal-box p { margin: 0 0 var(--ss-space-4); font-size: var(--ss-fs-14); color: var(--text-secondary); }
        .modal-actions { display: flex; gap: var(--ss-space-3); justify-content: flex-end; margin-top: var(--ss-space-4); }
        .btn-secondary {
            padding: var(--ss-space-2) var(--ss-space-4);
            border: 1px solid var(--border);
            background: var(--ss-surface);
            border-radius: var(--ss-radius);
            cursor: pointer;
            font-family: inherit;
            font-size: var(--ss-fs-14);
        }
        .btn-danger {
            padding: var(--ss-space-2) var(--ss-space-4);
            border: none;
            background: var(--error);
            color: var(--ss-on-navy);
            border-radius: var(--ss-radius);
            cursor: pointer;
            font-family: inherit;
            font-size: var(--ss-fs-14);
        }

        @media (max-width: 768px) {
            .settings-layout { flex-direction: column; }
            .settings-sidebar {
                width: 100%;
                display: flex;
                flex-wrap: wrap;
                gap: var(--ss-space-1);
            }
            .settings-nav-btn {
                flex: 1 1 auto;
                min-width: calc(50% - 4px);
                border-left: none;
                border-bottom: 3px solid transparent;
                text-align: center;
            }
            .settings-nav-btn.is-active {
                border-left: none;
                border-bottom-color: var(--heading);
            }
        }
    </style>
</head>
<body>
    <div class="settings-page">
        <header class="settings-topbar">
            <a href="/user/<%= username %>" class="settings-back" aria-label="<%= __('settings.backToProfile') %>">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </a>
            <h1><%= __('settings.title') %></h1>
        </header>

        <div class="settings-layout">
            <nav class="settings-sidebar" aria-label="<%= __('settings.title') %>">
                <button type="button" class="settings-nav-btn is-active" data-tab="profile"><%= __('settings.nav.profile') %></button>
                <button type="button" class="settings-nav-btn" data-tab="account"><%= __('settings.nav.account') %></button>
                <button type="button" class="settings-nav-btn" data-tab="privacy"><%= __('settings.nav.privacy') %></button>
                <button type="button" class="settings-nav-btn" data-tab="password"><%= __('settings.nav.password') %></button>
            </nav>

            <div class="settings-main">
                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>
                <% if (success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>

                <!-- Profile -->
                <div id="panel-profile" class="tab-panel is-active">
                    <form id="form-profile" action="/<%= lang %>/settings/profile" method="POST" enctype="multipart/form-data" autocomplete="off">
                        <input type="hidden" name="removeProfilePicture" id="removeProfilePicture" value="0">

                        <div class="avatar-block">
                            <div class="avatar-wrap" id="avatarWrap" role="button" tabindex="0" aria-label="<%= __('settings.profile.changePhoto') %>">
                                <img id="avatarPreview" src="<%= profilePicture || '/img/profile_images/Default_placeholder.svg' %>" alt="">
                                <span class="avatar-overlay">
                                    <i class="fas fa-camera" aria-hidden="true"></i>
                                    <%= __('settings.profile.changePhoto') %>
                                </span>
                            </div>
                            <input type="file" id="profilePicture" name="profilePicture" accept="image/png,image/jpeg,image/webp,image/gif" class="avatar-file-input" tabindex="-1" data-max-bytes="<%= avatarMaxUploadBytes %>">
                            <div class="avatar-actions">
                                <button type="button" class="btn-secondary" id="btnChangePhoto"><%= __('settings.profile.changePhoto') %></button>
                                <button type="button" class="btn-secondary" id="btnRemovePhoto"<%= profilePicture === '/img/profile_images/Default_placeholder.svg' ? ' hidden' : '' %>><%= __('settings.profile.removePhoto') %></button>
                            </div>
                            <p class="avatar-hint"><%= __('settings.profile.photoHint', { mb: String(Math.round(avatarMaxUploadBytes / 1048576)) }) %></p>
                            <p class="avatar-error" id="avatarError" role="alert"></p>
                            <div class="avatar-pending" id="avatarPending">
                                <p id="avatarPendingText"></p>
                                <div class="avatar-stage" id="avatarStage">
                                    <div class="avatar-stage-frame">
                                        <canvas data-crop-canvas tabindex="0" aria-label="<%= __('settings.profile.crop.adjust') %>"></canvas>
                                    </div>
                                    <p class="avatar-stage-hint"><%= __('settings.profile.crop.hint') %></p>
                                    <div class="avatar-stage-row">
                                        <span class="avatar-stage-label"><%= __('settings.profile.crop.shape') %></span>
                                        <div class="avatar-segment" role="group" aria-label="<%= __('settings.profile.crop.shape') %>">
                                            <button type="button" class="btn-secondary" data-crop-shape="circle" aria-pressed="true"><%= __('settings.profile.crop.circle') %></button>
                                            <button type="button" class="btn-secondary" data-crop-shape="square" aria-pressed="false"><%= __('settings.profile.crop.square') %></button>
                                        </div>
                                    </div>
                                    <div class="avatar-stage-row">
                                        <label for="cropGrid"><%= __('settings.profile.crop.grid') %></label>
                                        <select class="select" id="cropGrid" data-crop-grid>
                                            <option value="none"><%= __('settings.profile.crop.gridNone') %></option>
                                            <option value="thirds" selected><%= __('settings.profile.crop.gridThirds') %></option>
                                            <option value="golden"><%= __('settings.profile.crop.gridGolden') %></option>
                                            <option value="diagonals"><%= __('settings.profile.crop.gridDiagonals') %></option>
                                            <option value="spiral"><%= __('settings.profile.crop.gridSpiral') %></option>
                                        </select>
                                    </div>
                                    <div class="avatar-stage-row">
                                        <label for="cropZoom"><%= __('settings.profile.crop.zoom') %></label>
                                        <input type="range" id="cropZoom" data-crop-zoom min="0" max="100" value="0">
                                        <button type="button" class="btn-secondary" data-crop-rotate="-1" title="<%= __('settings.profile.crop.rotateLeft') %>" aria-label="<%= __('settings.profile.crop.rotateLeft') %>"><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
                                        <button type="button" class="btn-secondary" data-crop-rotate="1" title="<%= __('settings.profile.crop.rotateRight') %>" aria-label="<%= __('settings.profile.crop.rotateRight') %>"><i class="fas fa-rotate-right" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                                <div class="avatar-pending-actions">
                                    <button type="submit" class="btn-primary" id="btnSavePhoto"><%= __('settings.profile.savePhoto') %></button>
                                    <button type="button" class="btn-secondary" id="btnCancelPhoto"><%= __('settings.profile.cancelPhoto') %></button>
                                </div>
                            </div>
                        </div>

                        <h2 class="section-heading"><%= __('settings.profile.personalInfo') %></h2>

                        <div class="field">
                            <label class="field-label" for="fullName"><%= __('settings.profile.fullName') %></label>
                            <input class="input" type="text" id="fullName" name="fullName" value="<%= fullName || '' %>" placeholder="<%= lang === 'ru' ? 'Ваше полное имя' : 'Your full name' %>">
                        </div>

                        <div class="field">
                            <label class="field-label" for="username"><%= __('settings.profile.username') %></label>
                            <input class="input" type="text" id="username" name="username" value="<%= username %>" data-original="<%= username %>" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="32">
                            <p class="field-hint"><%= __('settings.profile.usernameHelp') %></p>
                            <div class="username-status" id="usernameStatus" aria-live="polite"></div>
                        </div>

                        <div class="field">
                            <label class="field-label" for="emailDisplay">
                                <%= __('settings.profile.email') %>
                                <i class="fas fa-lock" style="font-size:var(--ss-fs-12);color:var(--text-muted);" aria-hidden="true"></i>
                            </label>
                            <input class="input" type="email" id="emailDisplay" value="<%= email || '' %>" readonly disabled style="background:var(--ss-surface-alt);color:var(--text-secondary);">
                            <p class="field-hint"><%= __('settings.profile.emailPrivate') %></p>
                        </div>

                        <div class="field">
                            <label class="field-label" for="countryLocation"><%= __('settings.profile.country') %></label>
                            <select class="select input" id="countryLocation" name="countryLocation" style="height:40px;">
                                <option value=""><%= __('settings.profile.countryPreferNot') %></option>
                                <% if (countryLocation && countryNames.indexOf(countryLocation) === -1) { %>
                                    <option value="<%= countryLocation %>" selected><%= countryLocation %></option>
                                <% } %>
                                <% countryNames.forEach(function(c) { %>
                                    <option value="<%= c %>" <%= countryLocation === c ? 'selected' : '' %>><%= c %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="field">
                            <label class="field-label" for="institution"><%= __('settings.profile.institution') %></label>
