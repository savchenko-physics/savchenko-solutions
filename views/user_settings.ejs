    <script src="<%= asset('/js/avatar-crop.js') %>"></script>
    <script>
(function () {
    var lang = '<%= lang %>';
    var MSG = {
        usernameOk: <%- JSON.stringify(__('settings.profile.usernameAvailable')) %>,
        usernameTaken: <%- JSON.stringify(__('settings.profile.usernameTaken')) %>,
        usernameRules: <%- JSON.stringify(__('settings.errors.invalidUsername')) %>,
        saved: <%- JSON.stringify(__('settings.profile.saved')) %>,
        saving: <%- JSON.stringify(__('settings.profile.saving')) %>,
        photoChosen: <%- JSON.stringify(__('settings.profile.photoChosen')) %>,
        photoRemoval: <%- JSON.stringify(__('settings.profile.photoRemoval')) %>,
        photoTooLarge: <%- JSON.stringify(__('settings.errors.photoTooLarge', { mb: String(Math.round(avatarMaxUploadBytes / 1048576)) })) %>,
        photoNotImage: <%- JSON.stringify(__('settings.errors.photoNotImage')) %>
    };
    var initialSnapshot = '';

    function tab(name) {
        document.querySelectorAll('.settings-nav-btn').forEach(function (b) {
            b.classList.toggle('is-active', b.getAttribute('data-tab') === name);
        });
        document.querySelectorAll('.tab-panel').forEach(function (p) {
            p.classList.toggle('is-active', p.id === 'panel-' + name);
        });
        if (history.replaceState) {
            var u = new URL(window.location.href);
            u.searchParams.set('tab', name);
            history.replaceState({}, '', u.toString());
        }
    }

    var qp = new URLSearchParams(window.location.search);
    var startTab = qp.get('tab') || '<%= activeTab || "profile" %>';
    if (['profile','account','privacy','password'].indexOf(startTab) >= 0) tab(startTab);

    document.querySelectorAll('.settings-nav-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { tab(btn.getAttribute('data-tab')); });
    });

    // Avatar. Choosing a file or asking for removal is a change like any other: it shows
    // in the preview, is named in the pending box with its own Save button, and enables the
    // form's Save. Before 2026-09-21 the file was left out of the form's change detection,
    // so a chosen photo left Save disabled and there was no way to submit it.
    var PLACEHOLDER = '/img/profile_images/Default_placeholder.svg';
    var fileInput = document.getElementById('profilePicture');
    var avatarPreview = document.getElementById('avatarPreview');
    var avatarOriginalSrc = avatarPreview.getAttribute('src');
    var removeField = document.getElementById('removeProfilePicture');
    var avatarWrap = document.getElementById('avatarWrap');
    var avatarPending = document.getElementById('avatarPending');
    var avatarPendingText = document.getElementById('avatarPendingText');
    var avatarError = document.getElementById('avatarError');
    var btnRemovePhoto = document.getElementById('btnRemovePhoto');
    var maxBytes = parseInt(fileInput.getAttribute('data-max-bytes'), 10) || (12 * 1024 * 1024);
    function openPicker() { fileInput.click(); }
    avatarWrap.addEventListener('click', openPicker);
    avatarWrap.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPicker(); }
    });
    document.getElementById('btnChangePhoto').addEventListener('click', openPicker);
    function showAvatarError(text) {
        avatarError.textContent = text || '';
        avatarError.classList.toggle('is-visible', Boolean(text));
    }
    function fileSizeText(bytes) {
        return bytes >= 1048576 ? (bytes / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(bytes / 1024)) + ' KB';
    }
    function showPending(text) {
        avatarPendingText.textContent = text;
        avatarPending.classList.add('is-visible');
    }
    function resetPhotoChoice() {
        closeStage();
        fileInput.value = '';
        removeField.value = '0';
        avatarPreview.src = avatarOriginalSrc;
        avatarPending.classList.remove('is-visible');
        showAvatarError('');
        markProfileDirty();
    }
    // The crop stage. The chosen file is shown in the frame; on save the frame's contents,
    // always the full square (the circle is a preview of the round surfaces), replace the file
    // in the input (a browser that cannot rewrite a file input sends the original, which the
    // server centre-crops as before).
    var avatarStage = document.getElementById('avatarStage');
    var crop = (window.AvatarCrop && avatarStage) ? window.AvatarCrop.mount(avatarStage) : null;
    var cropSource = null;    // the File in the stage, or null when the stage is closed
    var cropExported = false; // the input already holds the crop of cropSource
    function closeStage() {
        cropSource = null;
        cropExported = false;
        avatarStage.classList.remove('is-visible');
        if (crop) crop.unload();
    }
    function openStage(f) {
        closeStage();
        if (!crop) return;
        avatarStage.classList.add('is-visible');
        crop.load(f).then(function () {
            cropSource = f;
        }).catch(function () {
            // Not decodable here (a format the browser lacks): the server still gets the file.
            closeStage();
        });
    }
    function canRewriteInput() {
        try { return typeof DataTransfer === 'function' && 'files' in new DataTransfer(); } catch (e) { return false; }
    }
    // Put the crop into the input and resolve; on any failure leave the original file.
    function exportCropIntoInput() {
        if (!crop || !cropSource || cropExported || !canRewriteInput()) return Promise.resolve();
        return crop.export().then(function (out) {
            var dt = new DataTransfer();
            dt.items.add(new File([out.blob], out.name, { type: out.type }));
            fileInput.files = dt.files;
            cropExported = true;
        }).catch(function () {});
    }
    fileInput.addEventListener('change', function () {
        var f = fileInput.files && fileInput.files[0];
        if (!f) return;
        // The same two rules the server applies, checked here so a phone photo over the
        // limit is refused before it is sent.
        if (f.size > maxBytes) {
            resetPhotoChoice();
            showAvatarError(MSG.photoTooLarge);
            return;
        }
        if (!/\.(jpe?g|png|gif|webp)$/i.test(f.name) || (f.type && !/^image\/(jpeg|pjpeg|png|gif|webp)$/i.test(f.type))) {
            resetPhotoChoice();
            showAvatarError(MSG.photoNotImage);
            return;
        }
        showAvatarError('');
        removeField.value = '0';
        var r = new FileReader();
        r.onload = function (ev) { avatarPreview.src = ev.target.result; };
        r.readAsDataURL(f);
        showPending(MSG.photoChosen + ': ' + f.name + ' (' + fileSizeText(f.size) + ')');
        openStage(f);
        markProfileDirty();
    });
    btnRemovePhoto.addEventListener('click', function () {
        closeStage();
        removeField.value = '1';
        avatarPreview.src = PLACEHOLDER;
        fileInput.value = '';
        showAvatarError('');
        showPending(MSG.photoRemoval);
        markProfileDirty();
    });
    document.getElementById('btnCancelPhoto').addEventListener('click', resetPhotoChoice);

    // Bio counter
    var bio = document.getElementById('bio');
    var bioCounter = document.getElementById('bioCounter');
    function updBio() {
        bioCounter.textContent = (bio.value.length) + '/300';
    }
    bio.addEventListener('input', updBio);
    updBio();

    // Profile dirty + save button
    var btnSaveProfile = document.getElementById('btnSaveProfile');
    var formProfile = document.getElementById('form-profile');
    function profileState() {
        var fd = new FormData(formProfile);
        var parts = [];
        fd.forEach(function (v, k) { if (k !== 'profilePicture') parts.push(k + '=' + v); });
        // A chosen file is a change too; its name, size and date stand in for its bytes.
        var f = fileInput.files && fileInput.files[0];
        parts.push('profilePicture=' + (f ? f.name + ':' + f.size + ':' + f.lastModified : ''));
        parts.sort();
        return parts.join('&');
    }
    function markProfileDirty() { btnSaveProfile.disabled = profileState() === initialSnapshot; }
    initialSnapshot = profileState();
    formProfile.addEventListener('input', markProfileDirty);
    formProfile.addEventListener('change', markProfileDirty);
    markProfileDirty();

    formProfile.addEventListener('submit', function (e) {
        // One submit only: the picture goes up once, however the form was sent.
        var btn = document.getElementById('btnSaveProfile');
        var btnPhoto = document.getElementById('btnSavePhoto');
        btn.disabled = true;
        btnPhoto.disabled = true;
        btnPhoto.textContent = MSG.saving;
        btn.textContent = MSG.saving;
        if (crop && cropSource && !cropExported && canRewriteInput()) {
            // Render the frame's contents into the input first, then send.
            e.preventDefault();
            exportCropIntoInput().then(function () {
                if (formProfile.requestSubmit) formProfile.requestSubmit(); else formProfile.submit();
            });
        }
    });

    // Username availability
    var unameInput = document.getElementById('username');
    var unameStatus = document.getElementById('usernameStatus');
    var unameOriginal = unameInput.getAttribute('data-original');
    var unameRe = new RegExp('^<%= usernamePattern %>$');
    var t;
    function checkU() {
        var v = unameInput.value.trim();
        unameStatus.textContent = '';
        unameStatus.className = 'username-status';
        clearTimeout(t);
        // An unchanged username is always kept (older ones may have capitals or Cyrillic);
        // a new one follows lib/usernames.js.
        if (v === unameOriginal.trim()) { unameInput.setCustomValidity(''); return; }
        if (!unameRe.test(v)) {
            unameInput.setCustomValidity(MSG.usernameRules);
            unameStatus.textContent = MSG.usernameRules;
            unameStatus.className = 'username-status bad';
            return;
        }
        unameInput.setCustomValidity('');
        t = setTimeout(function () {
            fetch('/' + lang + '/api/username-available?u=' + encodeURIComponent(v), { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d.available) {
                        unameStatus.textContent = '\u2713 ' + MSG.usernameOk;
                        unameStatus.className = 'username-status ok';
                    } else {
                        unameStatus.textContent = MSG.usernameTaken;
                        unameStatus.className = 'username-status bad';
                    }
                }).catch(function () {});
        }, 500);
    }
    unameInput.addEventListener('input', function () { checkU(); markProfileDirty(); });

    // URL blur validation
    function looksLikeUrl(s) {
        if (!s || !String(s).trim()) return true;
        var t = String(s).trim();
        if (!/^https?:\/\//i.test(t)) t = 'https://' + t;
        try { new URL(t); return true; } catch (e) { return false; }
    }
    document.querySelectorAll('.url-field').forEach(function (el) {
        el.addEventListener('blur', function () {
            var err = document.getElementById('err-' + el.id);
            if (!looksLikeUrl(el.value)) {
                el.classList.add('input-invalid');
                if (err) { err.textContent = (lang === 'ru' ? 'Некорректный адрес' : 'Invalid URL'); err.classList.add('is-visible'); }
            } else {
                el.classList.remove('input-invalid');
                if (err) { err.textContent = ''; err.classList.remove('is-visible'); }
            }
        });
    });

    // Save flash
    var params = new URLSearchParams(window.location.search);
    if (params.get('success') && params.get('tab') === 'profile') {
        var b = document.getElementById('btnSaveProfile');
        if (b) {
            var orig = b.textContent;
            b.textContent = MSG.saved;
            b.classList.add('flash-success');
            setTimeout(function () {
                b.textContent = orig;
                b.classList.remove('flash-success');
            }, 2000);
        }
    }

    // Password form
    var fp = document.getElementById('form-password');
    var bp = document.getElementById('btnSavePassword');
    function pwSnap() {
        return document.getElementById('currentPassword').value + '|' +
            document.getElementById('newPassword').value + '|' +
            document.getElementById('confirmPassword').value;
    }
    var initialPw = pwSnap();
    fp.addEventListener('input', function () {
        bp.disabled = pwSnap() === initialPw || document.getElementById('newPassword').value.length < 8;
    });

    // Password toggles
    document.querySelectorAll('.pw-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-target');
            var inp = document.getElementById(id);
            if (!inp) return;
            inp.type = inp.type === 'password' ? 'text' : 'password';
            btn.querySelector('i').className = inp.type === 'password' ? 'far fa-eye' : 'far fa-eye-slash';
        });
    });

    // Delete modal
    var delModal = document.getElementById('deleteModal');
    document.getElementById('openDeleteModal').addEventListener('click', function () {
        delModal.classList.add('is-open');
        delModal.setAttribute('aria-hidden', 'false');
    });
    document.getElementById('closeDeleteModal').addEventListener('click', function () {
        delModal.classList.remove('is-open');
        delModal.setAttribute('aria-hidden', 'true');
    });
    delModal.addEventListener('click', function (e) {
        if (e.target === delModal) {
            delModal.classList.remove('is-open');
            delModal.setAttribute('aria-hidden', 'true');
        }
    });
})();
    </script>
</body>
</html>
