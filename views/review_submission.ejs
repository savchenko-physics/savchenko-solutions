<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="content-language" content="en">
    <meta name="keywords" content="<%= __('meta.keywords') %>">
    <meta name="description" content="<%= __('meta.description') %>">
    <meta name="author" content="<%= __('meta.author') %>">
    <meta name="date" content="<%= __('meta.date') %>" scheme="YYYY-MM">
    <meta property="og:title" content="<%= titleText(__('profile.title')) %>">
    <meta property="og:image" content="https://savchenkosolutions.com/img/logo.png">
    <meta property="og:description" content="<%= __('meta.ogDescription') %>">
    <meta name="yandex-verification" content="6cfda41f74038368">
    <title>Submission Review</title>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
    <link rel="icon" type="image/png" href="/img/logo.png">
    <link rel="apple-touch-icon" href="/img/logo.png">
    <%- include('default/main_site_header_head') %>
    <style>
        body {
            font-family: var(--ss-font-ui);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: var(--ss-surface-hover);
            color: var(--ss-text);
            overflow-x: hidden;
        }

        .container {
            flex: 1;
            padding: var(--ss-space-8);
            max-width: 800px;
            margin: 40px auto;
            box-sizing: border-box;
            background-color: var(--ss-surface);
            box-shadow: var(--ss-shadow);
            border-radius: var(--ss-radius-lg);
        }

        h1 {
            color: var(--ss-text);
            margin-bottom: var(--ss-space-6);
            font-size: var(--ss-fs-32);
        }

        a {
            color: var(--ss-link);
            text-decoration: none;
            transition: color 0.3s;
        }

        a:hover {
            text-decoration: underline;
            color: var(--ss-link);
        }

        .btn {
            display: inline-block;
            padding: var(--ss-space-4) var(--ss-space-7);
            margin-top: var(--ss-space-6);
            background: var(--ss-navy);
            color: var(--ss-on-navy) !important;
            border-radius: var(--ss-radius);
        }

        .btn:hover {
            background: var(--ss-navy-hover);
        }

    </style>
    <script src="/js/analytics.js"></script>
</head>

<body>
    <%- include('default/header.ejs') %>

    <div class="container">
        <h1>
            <%= message %>
        </h1>
        <p>We appreciate your contribution. Our team is currently reviewing your submission and will address it
            promptly.</p>
        <p>If you wish to make instant changes, please log in to your account.</p>
        <p>To learn more about our project, visit our official page at <a
                href="https://savchenkosolutions.com/study-guide"
                target="_blank">savchenkosolutions.com/study-guide</a>.</p>
        <p>If you have any questions or suggestions, feel free to reach out to us at <a
                href="mailto:alex@savchenkosolutions.com">alex@savchenkosolutions.com</a>.</p>
        <a href="/<%= lang %>/register" class="btn btn-primary">Create account</a>
    </div>

    <%- include('default/modern_footer', { lang }) %>
    <%- include('default/main_site_footer_scripts') %>
</body>

</html>