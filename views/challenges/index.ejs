<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= lang === 'ru' ? 'Еженедельные задачи по физике — проверьте навыки и соревнуйтесь в рейтинге.' : 'Weekly physics challenges — test your problem-solving skills and compete on the leaderboard.' %>" />
  <title><%= docTitle(__('challengesPage.currentChallenge'), __('title')) %></title>
  <%- include('../default/site_styles', { ssStyles: { icons: 'fa6' } }) %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <script>
  MathJax = {
    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],
      processEscapes: true
    },
    options: {
      skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
    }
  };
  </script>
  <script id="MathJax-script" async src="/vendor/mathjax/tex-chtml.js"></script>
  <style>
    body { font-family: var(--ss-font-ui); background: var(--ss-surface); color: var(--ss-text); }
    .challenges-container { max-width: 1100px; margin: 0 auto; padding: var(--ss-space-5) var(--ss-space-4); }
    .challenges-layout { display: grid; grid-template-columns: 1fr 280px; gap: var(--ss-space-6); }
    @media (max-width: 768px) { .challenges-layout { grid-template-columns: 1fr; } }

    .page-title { font-size: var(--ss-fs-24); font-weight: var(--ss-fw-strong); font-family: var(--ss-font-ui); margin-bottom: 0.15rem; }
    .page-subtitle { font-size: var(--ss-fs-14); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-5); }

    .challenge-hero { background: var(--ss-surface-alt); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg); padding: var(--ss-space-5) var(--ss-space-6); margin-bottom: var(--ss-space-6); }
    .challenge-hero-label { font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); text-transform: uppercase; letter-spacing: 0.5px; color: var(--ss-navy); margin-bottom: var(--ss-space-1); }
    .challenge-hero-title { font-size: var(--ss-fs-20); font-weight: var(--ss-fw-strong); margin-bottom: var(--ss-space-2); }
    .challenge-meta { display: flex; gap: var(--ss-space-3); align-items: center; margin-bottom: var(--ss-space-3); flex-wrap: wrap; }
    .difficulty-badge { display: inline-block; padding: 2px var(--ss-space-3); border-radius: var(--ss-radius); font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); background: var(--ss-navy); color: var(--ss-on-navy); }
    .countdown { font-size: var(--ss-fs-14); font-weight: var(--ss-fw-strong); color: var(--ss-text-secondary); }
    .countdown-value { color: var(--ss-navy); font-weight: var(--ss-fw-strong); }
    .submission-count { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); }
    .challenge-statement { font-size: var(--ss-fs-16); line-height: 1.8; margin: var(--ss-space-3) 0; padding: var(--ss-space-5) var(--ss-space-6); background: var(--ss-surface); border: 1px solid var(--ss-rule-soft); border-radius: var(--ss-radius); }
    .challenge-actions { margin-top: var(--ss-space-4); display: flex; gap: var(--ss-space-3); flex-wrap: wrap; }
    .btn-challenge { display: inline-block; padding: var(--ss-space-2) var(--ss-space-5); border-radius: var(--ss-radius); font-size: var(--ss-fs-14); font-weight: var(--ss-fw-strong); text-decoration: none; border: none; cursor: pointer; }
    .btn-challenge-primary { background: var(--ss-navy); color: var(--ss-on-navy) !important; }
    .btn-challenge-primary:hover { background: var(--ss-navy); color: var(--ss-on-navy) !important; }
    .btn-challenge-outline { background: transparent; border: 1px solid var(--ss-rule); color: var(--ss-text); }
    .btn-challenge-outline:hover { background: var(--ss-surface-alt); }

    .no-challenge { text-align: center; padding: var(--ss-space-7) var(--ss-space-4); color: var(--ss-text-secondary); }

    .past-section { margin-top: var(--ss-space-5); }
    .past-title { font-size: var(--ss-fs-16); font-weight: var(--ss-fw-strong); margin-bottom: var(--ss-space-3); }
    .past-list { list-style: none; padding: 0; margin: 0; }
    .past-item { padding: var(--ss-space-2) 0; border-bottom: 1px solid var(--ss-rule-soft); display: flex; align-items: center; justify-content: space-between; gap: var(--ss-space-3); }
    .past-item:last-child { border-bottom: none; }
    .past-item-left { flex: 1; min-width: 0; }
    .past-item-title { font-size: var(--ss-fs-14); font-weight: var(--ss-fw-strong); color: var(--ss-link); text-decoration: none; }
    .past-item-title:hover { color: var(--ss-link-hover); }
    .past-item-meta { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); margin-top: 2px; }
    .past-item-right { font-size: var(--ss-fs-13); color: var(--ss-success-strong); font-weight: var(--ss-fw-regular); white-space: nowrap; }

    .sidebar-card { background: var(--ss-surface-alt); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg); padding: var(--ss-space-4); margin-bottom: var(--ss-space-5); }
    .sidebar-card-title { font-size: var(--ss-fs-14); font-weight: var(--ss-fw-strong); margin-bottom: var(--ss-space-3); display: flex; align-items: center; justify-content: space-between; }
    .leaderboard-list { list-style: none; padding: 0; margin: 0; }
    .leaderboard-row { display: flex; align-items: center; gap: var(--ss-space-2); padding: var(--ss-space-1) 0; font-size: var(--ss-fs-13); }
    .lb-rank { width: 22px; text-align: center; font-weight: var(--ss-fw-strong); color: var(--ss-text-secondary); }
    .lb-avatar { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; }
    .lb-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lb-name a { color: var(--ss-link); text-decoration: none; }
    .lb-name a:hover { color: var(--ss-link-hover); }
    .lb-score { font-weight: var(--ss-fw-strong); color: var(--ss-text); }
    .lb-streak { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); }

    .submitted-banner { background: var(--ss-success-soft); border: 1px solid #c3e6cb; border-radius: var(--ss-radius); padding: var(--ss-space-2) var(--ss-space-3); font-size: var(--ss-fs-14); color: var(--ss-success-strong); margin-top: var(--ss-space-3); }

    /* Submission form */
    .submission-form { margin-top: var(--ss-space-4); }
    .submission-form textarea { width: 100%; min-height: 200px; padding: var(--ss-space-3); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); font-family: var(--ss-font-mono); font-size: var(--ss-fs-16); resize: vertical; }
    .submission-form textarea:focus { outline: none; border-color: var(--ss-navy); }
  </style>
</head>
<body>
  <%- include('../default/main_site_header') %>

  <%
    function localTitle(t, id) {
      if (!t) return (lang === 'ru' ? 'Задача #' : 'Challenge #') + id;
      const parts = t.split('|');
      return lang === 'ru' && parts.length > 1 ? parts[1] : parts[0];
    }
  %>
  <div class="challenges-container">
    <h1 class="page-title"><%= __('challengesPage.title') %></h1>
    <p class="page-subtitle"><%= __('challengesPage.subtitle') %></p>

    <% if (currentChallenge) { %>
    <div class="challenge-hero">
      <div class="challenge-hero-label"><%= __('challengesPage.currentChallenge') %></div>
      <h2 class="challenge-hero-title"><%= localTitle(currentChallenge.title, currentChallenge.id) %></h2>
      <div class="challenge-meta">
        <% if (currentChallenge.difficulty) { %>
          <span class="difficulty-badge"><%= __('challengesPage.difficulty') %>: <%= currentChallenge.difficulty %>/10</span>
        <% } %>
        <span class="countdown" id="challengeCountdown" data-end="<%= new Date(currentChallenge.week_end).toISOString().slice(0, 10) %>"></span>
        <span class="submission-count"><%= submissionCount %> <%= __('challengesPage.submissionsSoFar') %></span>
      </div>
      <div class="challenge-statement">
        <%- currentChallenge.problem_statement %>
      </div>
      <div class="challenge-actions">
        <% if (typeof username !== 'undefined' && username) { %>
          <a href="/compete/<%= currentChallenge.id %>" class="btn-challenge btn-challenge-primary">
            <%= userSubmission ? __('challengesPage.viewEditSubmission') : __('challengesPage.submitSolution') %>
          </a>
        <% } else { %>
          <a href="/<%= lang %>/login?error=<%= lang === 'ru' ? 'Войдите для отправки решения' : 'Log in to submit challenge solutions' %>" class="btn-challenge btn-challenge-primary"><%= __('challengesPage.loginToSubmit') %></a>
        <% } %>
        <a href="/compete/<%= currentChallenge.id %>" class="btn-challenge btn-challenge-outline"><%= __('challengesPage.viewDetails') %></a>
      </div>
      <% if (userSubmission) { %>
      <div class="submitted-banner">
        <%= __('challengesPage.submittedBanner') %>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <div class="no-challenge">
      <p style="font-size: var(--ss-fs-16); font-weight: var(--ss-fw-regular);"><%= __('challengesPage.noActiveChallenge') %></p>
      <p><%= __('challengesPage.checkBackSoon') %></p>
    </div>
    <% } %>

    <div class="challenges-layout">
      <!-- LEFT: Past Challenges -->
      <div>
        <% if (pastChallenges.length > 0) { %>
        <div class="past-section">
          <h3 class="past-title"><%= __('challengesPage.pastChallenges') %></h3>
          <ul class="past-list">
            <% const dateLocale = lang === 'ru' ? 'ru-RU' : 'en-US'; %>
            <% pastChallenges.forEach(function(ch) { %>
            <li class="past-item">
              <div class="past-item-left">
                <a href="/compete/<%= ch.id %>" class="past-item-title"><%= localTitle(ch.title, ch.id) %></a>
                <div class="past-item-meta">
                  <%= new Date(ch.week_start).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric' }) %> &ndash;
                  <%= new Date(ch.week_end).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  <% if (ch.difficulty) { %> &middot; <%= __('challengesPage.difficulty') %> <%= ch.difficulty %>/10<% } %>
                </div>
              </div>
              <div class="past-item-right">
                <%= ch.correct_count %> <%= __('challengesPage.correct') %>
                <% if (ch.solution) { %>&middot; <a href="/compete/<%= ch.id %>" style="color: var(--ss-link); font-size: var(--ss-fs-12);"><%= __('challengesPage.viewSolution') %></a><% } %>
              </div>
            </li>
            <% }); %>
          </ul>
        </div>
        <% } %>
      </div>

      <!-- RIGHT: Leaderboard Sidebar -->
      <div>
        <div class="sidebar-card">
          <div class="sidebar-card-title">
            <span><%= __('challengesPage.leaderboardTitle') %></span>
            <a href="/compete/leaderboard" style="font-size: var(--ss-fs-12); color: var(--ss-link); text-decoration: none;"><%= __('challengesPage.viewAll') %></a>
          </div>
          <% if (leaderboard.length > 0) { %>
          <ul class="leaderboard-list">
            <% leaderboard.slice(0, 20).forEach(function(entry, idx) { %>
            <li class="leaderboard-row">
              <span class="lb-rank"><%= idx + 1 %></span>
              <span class="avatar-presence">
                <img src="<%= entry.profile_picture || '/img/profile_images/Default_placeholder.svg' %>"
                     alt="" class="lb-avatar" />
                <% if (entry.isOnline && entry.username !== (typeof username !== 'undefined' ? username : null)) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %>
              </span>
              <span class="lb-name"><a href="/user/<%= entry.username %>"><%= entry.username %></a></span>
              <span class="lb-score"><%= entry.total_score %></span>
              <span class="lb-streak" title="<%= __('challengesPage.streak') %>"><%= entry.current_streak %>w</span>
            </li>
            <% }); %>
          </ul>
          <% } else { %>
          <p style="font-size: var(--ss-fs-13); color: var(--ss-text-secondary); text-align: center; padding: var(--ss-space-4) 0;"><%= __('challengesPage.noScoresYet') %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../default/modern_footer') %>

  <script>
  // Countdown timer
  (function() {
    const el = document.getElementById('challengeCountdown');
    if (!el) return;
    const endDate = new Date(el.dataset.end + 'T23:59:59');
    const remainingLabel = "<%= __('challengesPage.remaining') %>";
    const expiredLabel = "<%= __('challengesPage.expired') %>";
    function update() {
      const now = new Date();
      const diff = endDate - now;
      if (diff <= 0) {
        el.innerHTML = '<span class="countdown-value">' + expiredLabel + '</span>';
        return;
      }
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const lang = '<%= lang %>';
      const dLabel = lang === 'ru' ? 'д' : 'd';
      const hLabel = lang === 'ru' ? 'ч' : 'h';
      const mLabel = lang === 'ru' ? 'м' : 'm';
      el.innerHTML = '<span class="countdown-value">' + days + dLabel + ' ' + hours + hLabel + ' ' + mins + mLabel + '</span> ' + remainingLabel;
    }
    update();
    setInterval(update, 60000);
  })();
  </script>
  <script src="/js/analytics.js"></script>
</body>
</html>
