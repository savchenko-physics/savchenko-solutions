<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= docTitle(__('challengesPage.leaderboardTitle'), __('title')) %></title>
  <%- include('../default/site_styles', { ssStyles: { icons: 'fa6' } }) %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <style>
    body { font-family: var(--ss-font-ui); background: var(--ss-surface); color: var(--ss-text); }
    .lb-container { max-width: 700px; margin: 0 auto; padding: var(--ss-space-7) var(--ss-space-6); }
    .back-link { font-size: var(--ss-fs-13); color: var(--ss-link); text-decoration: none; display: inline-flex; align-items: center; gap: var(--ss-space-1); margin-bottom: var(--ss-space-6); }
    .back-link:hover { color: var(--ss-link-hover); }
    .page-title { font-size: var(--ss-fs-28); font-weight: var(--ss-fw-strong); font-family: var(--ss-font-ui); margin-bottom: var(--ss-space-1); }
    .page-subtitle { font-size: var(--ss-fs-16); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-7); }

    .lb-table { width: 100%; border-collapse: collapse; }
    .lb-table th { font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); text-transform: uppercase; letter-spacing: 0.5px; color: var(--ss-text-secondary); padding: var(--ss-space-2) var(--ss-space-3); border-bottom: 2px solid var(--ss-rule); text-align: left; }
    .lb-table td { padding: var(--ss-space-2) var(--ss-space-3); border-bottom: 1px solid var(--ss-rule-soft); font-size: var(--ss-fs-14); }
    .lb-table tr:hover { background: var(--ss-surface-alt); }
    .rank-cell { width: 40px; text-align: center; font-weight: var(--ss-fw-strong); }
    .rank-gold { color: #d4a017; }
    .rank-silver { color: #8a8a8a; }
    .rank-bronze { color: #a0522d; }
    .user-cell { display: flex; align-items: center; gap: var(--ss-space-2); }
    .user-cell img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
    .user-cell a { color: var(--ss-link); text-decoration: none; font-weight: var(--ss-fw-regular); }
    .user-cell a:hover { color: var(--ss-link-hover); }
    .score-cell { font-weight: var(--ss-fw-strong); }
    .streak-cell { color: var(--ss-text-secondary); }
    .empty-state { text-align: center; padding: var(--ss-space-9) var(--ss-space-4); color: var(--ss-text-secondary); }
  </style>
</head>
<body>
  <%- include('../default/main_site_header') %>

  <div class="lb-container">
    <a href="/compete" class="back-link">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= __('challengesPage.challenges') %>
    </a>

    <h1 class="page-title"><%= __('challengesPage.leaderboardTitle') %></h1>
    <p class="page-subtitle"><%= __('challengesPage.leaderboardSubtitle') %></p>

    <% if (leaderboard.length > 0) { %>
    <table class="lb-table">
      <thead>
        <tr>
          <th class="rank-cell">#</th>
          <th><%= __('challengesPage.user') %></th>
          <th><%= __('challengesPage.solved') %></th>
          <th><%= __('challengesPage.score') %></th>
          <th><%= __('challengesPage.streak') %></th>
          <th><%= __('challengesPage.bestStreak') %></th>
        </tr>
      </thead>
      <tbody>
        <% leaderboard.forEach(function(entry, idx) { %>
        <tr>
          <td class="rank-cell <%= idx === 0 ? 'rank-gold' : idx === 1 ? 'rank-silver' : idx === 2 ? 'rank-bronze' : '' %>">
            <%= idx + 1 %>
          </td>
          <td>
            <div class="user-cell">
              <span class="avatar-presence">
                <img src="<%= entry.profile_picture || '/img/profile_images/Default_placeholder.svg' %>" alt="" />
                <% if (entry.isOnline && entry.username !== (typeof username !== 'undefined' ? username : null)) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %>
              </span>
              <a href="/user/<%= entry.username %>"><%= entry.username %></a>
            </div>
          </td>
          <td><%= entry.total_solved %></td>
          <td class="score-cell"><%= entry.total_score %></td>
          <td class="streak-cell"><%= entry.current_streak %>w</td>
          <td class="streak-cell"><%= entry.longest_streak %>w</td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="empty-state">
      <p style="font-size: var(--ss-fs-16); font-weight: var(--ss-fw-regular);"><%= __('challengesPage.noScoresLeaderboard') %></p>
      <p><%= __('challengesPage.completeChallengesToAppear') %></p>
      <a href="/compete" style="color: var(--ss-link);"><%= __('challengesPage.viewCurrentChallenge') %></a>
    </div>
    <% } %>
  </div>

  <%- include('../default/modern_footer') %>
  <script src="/js/analytics.js"></script>
</body>
</html>
