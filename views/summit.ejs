<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="content-language" content="ru" />
  <meta name="keywords" content="Savchenko Solutions Summit, саммит, встреча, Москва, физика, образование, networking, итоги" />
  <meta name="description" content="Итоги первого исторического Savchenko Solutions Summit в Москве 11 июня 2025. Успешная встреча сообщества физиков и энтузиастов образования!" />
  <meta property="og:title" content="<%= titleText(__('summit.title')) %>" />
  <meta property="og:image" content="https://savchenkosolutions.com/img/logo.png" />
  <meta property="og:description" content="Итоги первого официального саммита Savchenko Solutions в Москве" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <%- include('default/site_styles') %>
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <title><%= titleText(__('summit.title')) %></title>
  <style>
    /* The summit report: a navy title band, then plain sections on the text grid. */
    .summit-hero {
      background-color: var(--ss-navy);
      color: var(--ss-on-navy);
      padding-block: var(--ss-space-9);
    }
    .summit-hero .ss-kicker { color: var(--ss-on-navy-muted); }
    .summit-hero .ss-display { color: var(--ss-on-navy); margin-bottom: var(--ss-space-3); }
    .summit-hero .ss-lead { color: var(--ss-on-navy-muted); margin: 0 0 var(--ss-space-6); }
    .summit-done {
      display: inline-block;
      margin: 0 0 var(--ss-space-7);
      padding: var(--ss-space-1) var(--ss-space-3);
      font-size: var(--ss-text-ui);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-on-navy);
      border: 1px solid var(--ss-on-navy-rule);
      border-radius: var(--ss-radius);
    }
    .summit-stats { display: flex; flex-wrap: wrap; gap: var(--ss-space-7); margin: 0; }
    .summit-stats div { min-width: 96px; }
    .summit-stats dt {
      font-family: var(--ss-font-display);
      font-weight: 600;
      font-synthesis: none;
      font-size: var(--ss-text-display);
      line-height: var(--ss-lh-tight);
      color: var(--ss-on-navy);
    }
    .summit-stats dd { margin: 0; font-size: var(--ss-text-meta); color: var(--ss-on-navy-muted); }

    .summit-section { padding-block: var(--ss-space-8) 0; }
    .summit-section > h2 { margin-bottom: var(--ss-space-5); }
    .summit-section > p { max-width: 42em; }
    .summit-grid { display: grid; gap: var(--ss-space-5); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .summit-grid .ss-card h3 { font-size: var(--ss-text-h3); margin-bottom: var(--ss-space-3); }
    .summit-grid ul { margin: 0; padding-left: 1.2em; }
    .summit-grid li + li { margin-top: var(--ss-space-2); }
    .summit-guests { display: grid; gap: var(--ss-space-3); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); list-style: none; padding: 0; margin: 0; }
    .summit-guests li { padding: var(--ss-space-3) var(--ss-space-4); border-left: 3px solid var(--ss-navy); background: var(--ss-surface-alt); }
    .summit-gallery { display: grid; gap: var(--ss-space-5); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .summit-gallery figure { margin: 0; }
    .summit-gallery img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--ss-radius); }
    .summit-gallery figcaption { margin-top: var(--ss-space-2); font-size: var(--ss-text-meta); color: var(--ss-text-secondary); }
    .summit-quotes { display: grid; gap: var(--ss-space-5); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin: 0; padding: 0; list-style: none; }
    .summit-quotes blockquote { margin: 0; padding-left: var(--ss-space-4); border-left: 3px solid var(--ss-rule); font-family: var(--ss-font-text); font-size: var(--ss-text-lead); line-height: var(--ss-lh-prose); }
    .summit-list { margin: 0; padding-left: 1.4em; max-width: 42em; }
    .summit-list li + li { margin-top: var(--ss-space-2); }
    .summit-cta { margin-top: var(--ss-space-6); }
  </style>
  <script src="/js/analytics.js"></script>
</head>

<body>
  <%# This page exists in Russian only, so EN goes to the English homepage rather than to a
      /en/summit that would 404 (lib/langSwitch.js). %>
  <%- include('default/main_site_header', { langSwitchEnUrl: '/en', langSwitchRuUrl: '/ru/summit' }) %>

  <main>
    <section class="summit-hero">
      <div class="ss-container">
        <div class="ss-kicker"><%= __('summit.date') %> · <%= __('summit.location') %></div>
        <h1 class="ss-display"><%= __('summit.shortTitle') %></h1>
        <p class="ss-lead"><%= __('summit.subtitle') %></p>
        <div class="summit-done"><%= __('summit.completed.title') %></div>
        <dl class="summit-stats">
          <div><dt>40+</dt><dd>Участников</dd></div>
          <div><dt>3</dt><dd>Часа</dd></div>
          <div><dt>100%</dt><dd>Успех</dd></div>
        </dl>
      </div>
    </section>

    <div class="ss-container ss-page">
      <section class="summit-section">
        <h2><%= __('summit.completed.subtitle') %></h2>
        <p class="ss-lead"><%= __('summit.completed.duration') %></p>
        <p><%= __('summit.completed.attendance') %></p>
      </section>

      <section class="summit-section">
        <h2><%= __('summit.completed.highlights') %></h2>
        <div class="summit-grid">
          <div class="ss-card">
            <h3>Технологические Инновации</h3>
            <ul>
              <% __('summit.completed.topics').slice(0, 4).forEach(topic => { %><li><%= topic %></li><% }); %>
            </ul>
          </div>
          <div class="ss-card">
            <h3>Образовательные Инициативы</h3>
            <ul>
              <% __('summit.completed.topics').slice(4).forEach(topic => { %><li><%= topic %></li><% }); %>
            </ul>
          </div>
        </div>
      </section>

      <section class="summit-section">
        <h2><%= __('summit.completed.specialGuests') %></h2>
        <ul class="summit-guests">
          <% __('summit.completed.guests').forEach(guest => { %><li><%= guest %></li><% }); %>
        </ul>
      </section>

      <section class="summit-section">
        <h2><%= __('summit.gallery.title') %></h2>
        <p class="ss-meta"><%= __('summit.gallery.subtitle') %></p>
        <div class="summit-gallery">
          <figure>
            <img src="/img/summit/summit_1.avif" alt="Summit Group Photo" loading="lazy" width="800" height="600">
            <figcaption>Общая фотография участников саммита у входа в парк</figcaption>
          </figure>
          <figure>
            <img src="/img/summit/summit_2.avif" alt="Summit Discussions" loading="lazy" width="800" height="600">
            <figcaption>Активные дискуссии о будущем физического образования</figcaption>
          </figure>
          <figure>
            <img src="/img/summit/summit_3.avif" alt="Networking" loading="lazy" width="800" height="600">
            <figcaption>Networking и обмен контактами между участниками</figcaption>
          </figure>
          <figure>
            <img src="/img/summit/summit_4.avif" alt="Park Walk" loading="lazy" width="800" height="600">
            <figcaption>Прогулка по живописному парку "Крылатские холмы"</figcaption>
          </figure>
        </div>
      </section>

      <section class="summit-section">
        <h2><%= __('summit.completed.activities') %></h2>
        <ul class="summit-list">
          <% __('summit.completed.activitiesList').forEach(activity => { %><li><%= activity %></li><% }); %>
        </ul>
      </section>

      <section class="summit-section">
        <h2><%= __('summit.completed.feedback') %></h2>
        <ul class="summit-quotes">
          <% __('summit.completed.testimonials').forEach(testimonial => { %><li><blockquote><%= testimonial %></blockquote></li><% }); %>
        </ul>
      </section>

      <section class="summit-section">
        <h2><%= __('summit.impact.title') %></h2>
        <p><%= __('summit.impact.description') %></p>
        <ol class="summit-list">
          <% __('summit.impact.achievements').forEach(achievement => { %><li><%= achievement %></li><% }); %>
        </ol>
      </section>

      <section class="summit-section">
        <h2><%= __('summit.completed.futureEvents') %></h2>
        <ul class="summit-list">
          <% __('summit.completed.futurePlans').forEach(plan => { %><li><%= plan %></li><% }); %>
        </ul>
        <a href="https://t.me/savchenko_summit_2025" target="_blank" rel="noopener" class="btn btn-dark btn-lg summit-cta">Присоединиться к сообществу</a>
      </section>
    </div>
  </main>

  <%- include('default/modern_footer', { lang: 'ru' }) %>
</body>
</html>
