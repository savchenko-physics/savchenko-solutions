<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('default/site_styles') %>
    <%- include('default/head_en.ejs') %>
        <title>File List</title>
        <style>
            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: var(--ss-space-5);
                margin: 0 auto;
            }

            th,
            td {
                padding: var(--ss-space-3);
                /* Add padding inside cells */
                text-align: left;
                border: 1px solid var(--ss-rule);
                /* Border for cells */
            }

            tr:nth-child(even) {
                background-color: var(--ss-surface-alt);
                /* Optional: different background for even rows */
            }

            th {
                background-color: var(--ss-surface-hover);
                font-weight: var(--ss-fw-strong);
            }
        </style>
    <script src="/js/analytics.js"></script>
</head>

<body style="max-width: 80%;">
    <header style="text-align: center;">
        <a href="../../" style="text-decoration: none;">
            <div id="logo">
                <span><img src="https://savchenkosolutions.com/img/logo.svg" alt="" height="32" width="32" style="height:32px;width:auto;vertical-align:middle;" /></span><span>Savchenko Solutions</span>
            </div>
        </a>
        <p class="author">
            Solutions&nbsp;of&nbsp;Savchenko Problems&nbsp;in&nbsp;Physics <br />
            <i><b>knowledge must be free</b></i>
        </p>
    </header>

    <h1 style="text-align: center;">List of Files in Directory</h1>
    <table>
        <thead>
            <tr>
                <th>File Name</th>
                <th>Language</th>
                <th>Number</th>
                <th>IP Address</th>
                <th>Size (Bytes)</th>
                <th>Date</th>
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            <% fileDetails.forEach(file=> { %>
                <tr>
                    <td>
                        <%= file.name %>
                    </td>
                    <td>
                        <%= file.language %>
                    </td>
                    <td>
                        <%= file.version %>
                    </td>
                    <td>
                        <%= file.ipAddress !=='Unknown IP' ? file.ipAddress : 'Invalid or Missing IP' %>
                    </td>
                    <td>
                        <%= file.size %>
                    </td>
                    <td>
                        <%= file.date %>
                    </td>
                    <td>
                        <%= file.time %>
                    </td>
                </tr>
                <% }); %>
        </tbody>
    </table>

    <%- include('default/modern_footer') %>
</body>

</html>