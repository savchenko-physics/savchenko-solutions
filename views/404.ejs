<!DOCTYPE html>
<% const pageLang = typeof lang !== 'undefined' ? lang : 'en'; %>
<html lang="<%= pageLang %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="content-language" content="<%= pageLang %>" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <title><%= docTitle(__('page404.title'), __('title')) %></title>

  <%- include('default/site_styles') %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include('default/main_site_header', {
    langSwitchEnUrl: '/en',
    langSwitchRuUrl: '/ru'
  }) %>

  <main class="flex-grow-1 d-flex align-items-center">
    <div style="max-width: 480px; margin: 80px auto; text-align: center; padding: 0 var(--ss-space-5);">
      <h1 style="font-size: var(--ss-fs-40); font-weight: var(--ss-fw-strong); color: var(--ss-navy); margin-bottom: var(--ss-space-2);">404</h1>
      <p style="font-size: var(--ss-fs-18); color: var(--ss-text); margin-bottom: var(--ss-space-6);">
        <%= pageLang === 'ru' ? 'Этой задачи пока не существует.' : "This problem doesn't exist yet." %>
      </p>
      <div style="margin-bottom: var(--ss-space-4);">
        <input type="text" id="search404" placeholder="<%= pageLang === 'ru' ? 'Поиск задачи...' : 'Search for a problem...' %>"
          style="width: 100%; max-width: 360px; height: 40px; padding: 0 var(--ss-space-4);
          border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); font-size: var(--ss-fs-16);">
      </div>
      <p style="font-size: var(--ss-fs-14); color: var(--ss-text-secondary);">
        <a href="/<%= pageLang %>/" style="color: var(--ss-link);"><%= pageLang === 'ru' ? 'Все главы' : 'Browse all chapters' %></a> &middot;
        <a href="/upload" style="color: var(--ss-link);"><%= pageLang === 'ru' ? 'Загрузить решение' : 'Upload a solution' %></a> &middot;
        <a href="/<%= pageLang %>/unsolved" style="color: var(--ss-link);"><%= pageLang === 'ru' ? 'Нерешённые задачи' : 'View unsolved problems' %></a>
      </p>
      <%# A 404 is usually somebody else's broken link, and the person who landed on it is
          the only one who can say where it came from. The referrer is captured silently. %>
      <div class="fb-inline" style="justify-content: center; text-align: left;">
        <span><%= pageLang === 'ru' ? 'Пришли по ссылке, которая не работает?' : 'Followed a link that does not work?' %></span>
        <button type="button" class="fb-inline-cta" data-fb-open data-fb-category="broken">
          <%= pageLang === 'ru' ? 'Сообщить об этом' : 'Report it' %>
        </button>
      </div>
    </div>
  </main>

  <%- include('default/modern_footer', { lang: pageLang }) %>

  <script
    src="/js/vendor/bootstrap.bundle.min.js"
  ></script>
  <script>
    document.getElementById('search404').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const q = this.value.trim();
        if (q) window.location.href = '/find?lang=<%= pageLang %>&search=' + encodeURIComponent(q);
      }
    });
  </script>
</body>
</html>
