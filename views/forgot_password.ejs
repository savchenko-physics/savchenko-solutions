<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta name="robots" content="noindex, nofollow" />
    <%- include(`default/head_${lang}.ejs`) %>
    <%- include('default/main_site_header_head') %>
    <title><%= titleText(lang === 'ru' ? 'Сброс пароля' : 'Forgot Password') %></title>
    <script src="/js/analytics.js"></script>
</head>
<body class="auth-page">
    <%- include('default/header.ejs') %>
    <div class="container1">
        <h2><%= lang === 'ru' ? 'Сброс пароля' : 'Forgot Password' %></h2>
        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>
        <% if (success) { %>
            <p class="success"><%= success %></p>
        <% } %>
        <% if (!success) { %>
        <p style="font-size: var(--ss-fs-14); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-4);">
            <%= lang === 'ru'
                ? 'Введите адрес электронной почты, связанный с вашим аккаунтом.'
                : 'Enter the email address associated with your account.' %>
        </p>
        <form action="/forgot-password" method="POST">
            <input type="hidden" name="lang" value="<%= lang %>">
            <div class="form-group">
                <label for="email"><%= lang === 'ru' ? 'Электронная почта' : 'Email' %></label>
                <input type="email" id="email" name="email" required />
            </div>
            <button type="submit" class="submit-button"><%= lang === 'ru' ? 'Отправить ссылку для сброса' : 'Send Reset Link' %></button>
        </form>
        <% } %>
        <p style="margin-top: var(--ss-space-4);">
            <a href="/<%= lang %>/login"><%= lang === 'ru' ? 'Вернуться к входу' : 'Back to login' %></a>
        </p>
        <p style="margin-top: var(--ss-space-3); font-size: var(--ss-fs-13); color: var(--ss-text-secondary);">
            <%= lang === 'ru' ? 'Не получили письмо или потеряли доступ к почте?' : "Didn't get the email or lost access to it?" %>
            <a href="/recover-account?lang=<%= lang %>"><%= lang === 'ru' ? 'Восстановить аккаунт' : 'Recover your account' %></a>
        </p>
    </div>
    <%- include('default/modern_footer') %>
    <%- include('default/main_site_footer_scripts') %>
</body>
</html>
