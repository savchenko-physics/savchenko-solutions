<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta name="robots" content="noindex, nofollow" />
    <%- include(`default/head_${lang}.ejs`) %>
    <%- include('default/main_site_header_head') %>
    <title><%= titleText(t.forgotTitle) %></title>
    <script src="/js/analytics.js"></script>
</head>
<body class="auth-page">
    <%- include('default/header.ejs') %>
    <div class="container1">
        <% if (state === 'sent') { %>
            <h2><%= t.sentTitle %></h2>
            <p class="success" role="status"><%= t.sentLead %></p>
            <p><%= t.sentSpam %> <%= t.sentOtherAddress %> <a href="/forgot-password?lang=<%= lang %>"><%= t.sentRetry %></a>.</p>
        <% } else { %>
            <h2><%= t.forgotTitle %></h2>
            <% if (error) { %>
                <p class="error" role="alert"><%= error %></p>
            <% } %>
            <p class="mt-0 mb-3"><%= t.forgotIntro %></p>
            <form action="/forgot-password" method="POST">
                <input type="hidden" name="lang" value="<%= lang %>">
                <div class="form-group">
                    <label for="identifier"><%= t.identifierLabel %></label>
                    <input type="text" id="identifier" name="identifier" value="<%= identifier %>" required maxlength="<%= limits.identifierMaxLength %>"
                           autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" />
                </div>
                <button type="submit" class="submit-button"><%= t.forgotSubmit %></button>
            </form>
        <% } %>
        <p><%= t.noAccess %> <a href="/recover-account?lang=<%= lang %>"><%= t.recover %></a></p>
        <p><a href="/<%= lang %>/login"><%= t.backToLogin %></a></p>
    </div>
    <%- include('default/modern_footer') %>
    <%- include('default/main_site_footer_scripts') %>
</body>
</html>
