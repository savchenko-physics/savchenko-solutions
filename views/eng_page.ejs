<!DOCTYPE html>
<% var pageLang = (typeof lang !== 'undefined' && lang) ? lang : 'en'; %>
<html lang="<%= pageLang %>">
<head>
  <!-- Meta -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="content-language" content="<%= pageLang %>" />
  <link rel="canonical" href="https://savchenkosolutions.com/<%= pageLang %>/" />
  <link rel="alternate" hreflang="en" href="https://savchenkosolutions.com/en/" />
  <link rel="alternate" hreflang="ru" href="https://savchenkosolutions.com/ru/" />
  <link rel="alternate" hreflang="x-default" href="https://savchenkosolutions.com/en/" />
  <meta property="og:url" content="https://savchenkosolutions.com/<%= pageLang %>/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Savchenko Solutions" />
  <meta name="keywords" content="<%= __('meta.keywords') %>" />
  <meta name="description" content="<%= __('meta.description') %>" />
  <meta name="author" content="<%= __('meta.author') %>" />
  <meta name="date" content="<%= __('meta.date') %>" scheme="YYYY-MM" />
  <meta property="og:title" content="<%= titleText(__('title')) %>" />
  <meta property="og:image" content="https://savchenkosolutions.com/img/logo.png" />
  <meta property="og:description" content="<%= __('meta.ogDescription') %>" />
  <meta name="yandex-verification" content="6cfda41f74038368" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <!-- PWA -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#1a1a2e" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Savchenko" />
  <%# The service worker is retired: in Firefox it made every image reload on each navigation (public/sw.js). This removes it from browsers that still have it. %>
  <script>try{navigator.serviceWorker&&navigator.serviceWorker.getRegistrations().then(function(rs){rs.forEach(function(r){r.unregister();});}).catch(function(){});}catch(e){}</script>

  <!-- Site stylesheets (self-hosted): Bootstrap, the bundle, and the statement-popup maths CSS -->
  <%- include('default/site_styles', { ssStyles: { math: true } }) %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>

  <title><%= titleText(__('title')) %></title>

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Savchenko Solutions",
    "url": "https://savchenkosolutions.com",
    "description": "<%= solutionProgress.totalUniqueSolutions.toLocaleString('en-US') %> peer-reviewed solutions to Savchenko's Problems in Physics. Free under Creative Commons.",
    "inLanguage": "<%= pageLang %>",
    "publisher": {
      "@type": "Organization",
      "name": "Savchenko Solutions",
      "url": "https://savchenkosolutions.com",
      "logo": {"@type": "ImageObject", "url": "https://savchenkosolutions.com/img/logo.png"}
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {"@type": "EntryPoint", "urlTemplate": "https://savchenkosolutions.com/<%= lang %>/problems?q={search_term_string}"},
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Savchenko Solutions",
    "alternateName": ["Решения Савченко", "Решебник Савченко"],
    "url": "https://savchenkosolutions.com",
    "logo": "https://savchenkosolutions.com/img/logo.png",
    "description": "Peer-reviewed solutions to Savchenko's Problems in Physics — free under Creative Commons."
  }
  </script>

  <script src="/js/analytics.js"></script>
</head>

<body class="grid-heat">
  <%- include('default/main_site_header', { pageHasOwnH1: true, hideHeaderSearch: true }) %>

  <!-- ============================
       MAIN CONTENT (FULL WIDTH)
  ============================ -->
  <main class="container-fluid mt-1 mb-4 px-3 px-md-4">
    <!-- ============================================================
         PRACTICUM 2026 ANNOUNCEMENT BANNER
         Server-driven via res.locals.practicumBanner (practicum.js).
         Auto-hides once registration closes (26 Jul 2026) — no manual takedown.
    ============================================================ -->
    <% if (typeof practicumBanner !== 'undefined' && practicumBanner) { %>
    <% const pb = practicumBanner; %>
    <% const prChips = pb.lang === 'ru'
         ? [ { l: 'RUS', u: pb.links.ru }, { l: 'UKR', u: pb.links.ukr }, { l: 'ENG', u: pb.links.eng } ]
         : [ { l: 'ENG', u: pb.links.eng }, { l: 'UKR', u: pb.links.ukr }, { l: 'RUS', u: pb.links.ru } ]; %>
    <style>
      .pr-banner{position:relative;background:var(--ss-navy);color:var(--ss-on-navy);border-radius:var(--ss-radius-lg);padding:var(--ss-space-6) var(--ss-space-6);margin-bottom:var(--ss-space-6);box-shadow:var(--ss-shadow);overflow:hidden;container-type:inline-size;}
      .pr-banner::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:#d7a63b;}
      .pr-inner{display:grid;grid-template-columns:1fr;gap:var(--ss-space-5);}
      @container (min-width:720px){.pr-banner{padding:var(--ss-space-6) var(--ss-space-7);}.pr-inner{grid-template-columns:minmax(0,1fr) 300px;gap:var(--ss-space-8);align-items:center;}}
      .pr-eyebrow{display:flex;align-items:center;gap:var(--ss-space-3);font-size:var(--ss-fs-12);font-weight:var(--ss-fw-strong);letter-spacing:.11em;text-transform:uppercase;color:var(--ss-warning);margin-bottom:var(--ss-space-3);}
      .pr-tick{width:6px;height:6px;border-radius:50%;background:#d7a63b;flex-shrink:0;}
      .pr-banner .pr-h2{margin:0 0 var(--ss-space-3);font-size:var(--ss-fs-24);line-height:1.15;font-weight:var(--ss-fw-strong);letter-spacing:-.015em;color:var(--ss-on-navy);text-wrap:balance;}
      @container (min-width:720px){.pr-banner .pr-h2{font-size:var(--ss-fs-28);}}
      .pr-sub{margin:0 0 var(--ss-space-4);font-size:var(--ss-fs-16);line-height:1.55;color:rgba(255,255,255,.80);max-width:62ch;}
      .pr-facts{display:flex;flex-wrap:wrap;gap:var(--ss-space-2);margin-bottom:var(--ss-space-4);}
      .pr-fact{display:inline-flex;align-items:center;font-size:var(--ss-fs-13);font-weight:var(--ss-fw-regular);color:rgba(255,255,255,.9);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);padding:var(--ss-space-1) var(--ss-space-3);border-radius:var(--ss-radius);font-variant-numeric:tabular-nums;}
      .pr-note{font-size:var(--ss-fs-13);line-height:1.5;color:rgba(255,255,255,.66);margin:0;padding-left:var(--ss-space-3);border-left:2px solid rgba(255,255,255,.18);}
      .pr-cta{display:flex;flex-direction:column;gap:var(--ss-space-3);}
      .pr-deadline{display:inline-flex;align-items:center;gap:var(--ss-space-2);align-self:flex-start;font-size:var(--ss-fs-13);font-weight:var(--ss-fw-strong);color:var(--ss-navy);background:#d7a63b;padding:var(--ss-space-1) var(--ss-space-3);border-radius:var(--ss-radius-lg);white-space:nowrap;font-variant-numeric:tabular-nums;}
      .pr-pulse{width:7px;height:7px;border-radius:50%;background:var(--ss-navy);flex-shrink:0;}
      .pr-banner a.pr-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--ss-space-2);background:var(--ss-surface);font-size:var(--ss-fs-14);font-weight:var(--ss-fw-strong);text-decoration:none;padding:var(--ss-space-3) var(--ss-space-5);border-radius:var(--ss-radius);border:1px solid #fff;transition:background .15s;}
      .pr-banner a.pr-btn:link,.pr-banner a.pr-btn:visited{color:var(--ss-navy);}
      .pr-banner a.pr-btn:hover{background:#ececef;color:var(--ss-navy);}
      .pr-btn svg{width:16px;height:16px;}
      .pr-reg{font-size:var(--ss-fs-12);line-height:1.5;color:rgba(255,255,255,.6);margin:0;}
      .pr-reg code{background:rgba(255,255,255,.09);padding:1px var(--ss-space-1);border-radius:var(--ss-radius-sm);font-size:var(--ss-fs-12);color:var(--ss-on-navy);}
      .pr-links{display:flex;flex-direction:column;gap:var(--ss-space-2);padding-top:var(--ss-space-3);border-top:1px solid rgba(255,255,255,.12);}
      .pr-links-row{display:flex;align-items:center;gap:var(--ss-space-2);flex-wrap:wrap;font-size:var(--ss-fs-13);color:rgba(255,255,255,.62);}
      .pr-chip{display:inline-flex;align-items:center;font-weight:var(--ss-fw-strong);font-size:var(--ss-fs-12);border:1px solid rgba(255,255,255,.28);padding:var(--ss-space-1) var(--ss-space-3);border-radius:var(--ss-radius);text-decoration:none;}
      .pr-banner a.pr-chip:link,.pr-banner a.pr-chip:visited{color:var(--ss-on-navy);}
      .pr-banner a.pr-chip:hover{color:var(--ss-on-navy);background:rgba(255,255,255,.08);}
      .pr-textlink{border-bottom:1px solid rgba(255,255,255,.25);font-size:var(--ss-fs-13);text-decoration:none;}
      .pr-banner a.pr-textlink:link,.pr-banner a.pr-textlink:visited{color:rgba(255,255,255,.78);}
      .pr-banner a.pr-textlink:hover{color:var(--ss-on-navy);border-bottom-color:#fff;}
      .pr-proof{margin:0;grid-column:1/-1;padding-top:var(--ss-space-4);border-top:1px solid rgba(255,255,255,.10);font-size:var(--ss-fs-13);font-style:italic;color:rgba(255,255,255,.6);}
      .pr-proof a{border-bottom:1px solid rgba(215,166,59,.4);font-style:normal;white-space:nowrap;text-decoration:none;}
      .pr-banner a.pr-proof-link:link,.pr-banner a.pr-proof-link:visited{color:var(--ss-warning);}
      .pr-banner a.pr-proof-link:hover{color:var(--ss-warning);border-bottom-color:#d7a63b;}
    </style>
    <section class="pr-banner" aria-label="<%= pb.headline %>">
      <div class="pr-inner">
        <div class="pr-main">
          <div class="pr-eyebrow"><span class="pr-tick"></span><%= pb.eyebrow %></div>
          <h2 class="pr-h2"><%= pb.headline %></h2>
          <p class="pr-sub"><%= pb.sub %></p>
          <div class="pr-facts">
            <% pb.facts.forEach(function(f){ %><span class="pr-fact"><%= f %></span><% }); %>
          </div>
          <p class="pr-note"><%= pb.eligibility %></p>
        </div>
        <div class="pr-cta">
          <span class="pr-deadline"><span class="pr-pulse"></span><span id="prBannerCountdown" data-ends-at="<%= pb.closeInstant %>"><%= pb.deadline %></span></span>
          <a class="pr-btn" href="<%= pb.mailto %>">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 3h13A1.5 1.5 0 0 1 16 4.5v7A1.5 1.5 0 0 1 14.5 13h-13A1.5 1.5 0 0 1 0 11.5v-7A1.5 1.5 0 0 1 1.5 3Zm.4 1.7 6.1 3.9 6.1-3.9Z"/></svg>
            <%= pb.ctaLabel %>
          </a>
          <p class="pr-reg"><%= pb.regDetail %></p>
          <div class="pr-links">
            <div class="pr-links-row"><%= pb.detailsLabel %>
              <% prChips.forEach(function(c){ %><a class="pr-chip" href="<%= c.u %>" target="_blank" rel="noopener"><%= c.l %></a><% }); %>
            </div>
            <div class="pr-links-row">
              <a class="pr-textlink" href="<%= pb.rulesUrl %>" target="_blank" rel="noopener"><%= pb.rulesLabel %></a>
              <a class="pr-textlink" href="<%= pb.links.practice %>" target="_blank" rel="noopener"><%= pb.practiceLabel %></a>
            </div>
          </div>
        </div>
        <p class="pr-proof"><%= pb.proofText %> <a class="pr-proof-link" href="<%= pb.proofUrl %>" target="_blank" rel="noopener"><%= pb.proofCta %></a></p>
      </div>
    </section>
    <script>
      (function () {
        var el = document.getElementById('prBannerCountdown');
        if (!el || !el.dataset.endsAt) return;
        var end = new Date(el.dataset.endsAt).getTime();
        var isRu = <%- pb.lang === 'ru' ? 'true' : 'false' %>;
        function tick() {
          var diff = end - Date.now();
          if (diff <= 0) { el.textContent = isRu ? 'Регистрация закрыта' : 'Registration closed'; return; }
          var d = Math.floor(diff / 86400000), h = Math.floor(diff % 86400000 / 3600000),
              m = Math.floor(diff % 3600000 / 60000), s = Math.floor(diff % 60000 / 1000);
          el.textContent = isRu
            ? ('Осталось ' + d + 'д ' + h + 'ч ' + m + 'м ' + s + 'с')
            : ('Closes in ' + d + 'd ' + h + 'h ' + m + 'm ' + s + 's');
        }
        tick(); setInterval(tick, 1000);
      })();
    </script>
    <% } %>

    <!-- Hero: one headline, one byline, one call to action.
         The single action is "get me to my problem" — nine in ten human visitors arrive
         from Google or Yandex having searched a problem number, and the on-site searches
         people type are numbers (4.2.22, 2.7.10, 6.2.14). So the search field is the
         primary object on the page, not a field in the header. -->
      <section class="hero-primary mb-2" aria-labelledby="heroHeadline">
        <div class="hero-main">
        <h1 class="hero-headline" id="heroHeadline"><%= __({ phrase: 'description.heroHeadline', locale: lang }) %></h1>
        <p class="hero-byline">
          <%- __({ phrase: 'description.introFirst', locale: lang }, { uniqueSolutions: solutionProgress.totalUniqueSolutions.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US') }) %>
        </p>
        <!-- Plain GET to /find, which resolves a problem number to whichever language
             actually has that solution (English covers only about a third of the
             collection, so a naive jump to /en/<n> would 404 most of the time) and falls
             back to full-text search otherwise. No JavaScript required. -->
        <form class="hero-search" action="/find" method="get" id="heroSearchForm" role="search">
          <label class="hero-search-label" for="heroSearchInput"><%= __({ phrase: 'description.heroSearchLabel', locale: lang }) %></label>
          <div class="hero-search-row">
            <input
              type="text"
              id="heroSearchInput"
              name="search"
              class="hero-search-input"
              placeholder="2.2.12"
              autocomplete="off"
              inputmode="text"
              aria-describedby="heroSearchHint"
            />
            <input type="hidden" name="lang" value="<%= lang %>" />
            <button type="submit" class="hero-search-button"><%= __({ phrase: 'description.heroSearchButton', locale: lang }) %></button>
          </div>
          <span class="hero-search-hint" id="heroSearchHint"><%= __({ phrase: 'description.heroSearchHint', locale: lang }) %></span>
        </form>

        <%# Evidence that other people are here, placed where a first-time visitor looks. %>
        <% if (typeof proofNumbers !== 'undefined' && proofNumbers) { %>
        <div class="hero-proof">
          <span><strong><%= solutionProgress.totalUniqueSolutions.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US') %></strong> <%= lang === 'ru' ? ruPlural(solutionProgress.totalUniqueSolutions, 'решение', 'решения', 'решений') : 'solutions' %></span>
          <span><strong><%= proofNumbers.contributors.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US') %></strong> <%= lang === 'ru' ? ruPlural(proofNumbers.contributors, 'автор', 'автора', 'авторов') : 'contributors' %></span>
          <span><strong><%= proofNumbers.edits.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US') %></strong> <%= lang === 'ru' ? ruPlural(proofNumbers.edits, 'правка', 'правки', 'правок') : 'edits' %></span>
          <a href="/<%= lang %>/contributors"><%= lang === 'ru' ? 'Кто их написал' : 'Who wrote them' %></a>
        </div>
        <% } %>
        </div>

        <%# The worklist, second thing on the page after the search. Ranked by unmet
            demand — people who came looking for this solution and found nothing.
            On a wide screen it sits beside the search rather than under it, which is
            what fills the right-hand half instead of leaving it blank. %>
        <% if (typeof mostWanted !== 'undefined' && mostWanted && mostWanted.length) { %>
        <div class="most-wanted">
          <div class="most-wanted-head">
            <span class="most-wanted-title"><%= lang === 'ru' ? 'Больше всего ждут' : 'Most wanted' %></span>
            <a class="most-wanted-all" href="/<%= lang %>/unsolved"><%= lang === 'ru' ? 'Все нерешённые' : 'All unsolved' %></a>
          </div>
          <ul class="most-wanted-list">
            <% mostWanted.forEach(w => { %>
            <li>
              <a href="/<%= lang %>/problems?q=<%= encodeURIComponent(w.problem_name) %>" class="most-wanted-item">
                <span class="mw-num"><%= w.problem_name %></span>
                <span class="mw-demand">
                  <%= w.total_views.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US') %>
                  <%= lang === 'ru' ? 'искали · не решено' : 'looked · unsolved' %>
                </span>
              </a>
            </li>
            <% }); %>
          </ul>
        </div>
        <% } %>
      </section>

    <!-- Two-column layout -->
    <%
      const _totalProblems = solutionProgress.totalProblems;
      const _totalSolved = solutionProgress.totalUniqueSolutions;
      const _totalUnsolved = _totalProblems - _totalSolved;
      const _overallPct = _totalProblems > 0 ? ((_totalSolved / _totalProblems) * 100).toFixed(1) : '0';
    %>
    <div class="home-layout">
      <!-- LEFT COLUMN: Progress + Chapters -->
      <div class="home-main">
        <!-- Overall Progress Bar -->
        <div class="overall-progress mb-4">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span style="font-size: var(--ss-fs-14); font-weight: var(--ss-fw-strong); color: var(--ss-text);">
              <%= _totalSolved.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US') %> / <%= _totalProblems.toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US') %>
              <%= lang === 'ru' ? 'задач решено' : 'problems solved' %>
              (<%= _overallPct %>%)
            </span>
            <div class="d-flex align-items-center gap-3">
              <a href="<%= lang === 'en' ? '/en/savchenko_en.pdf' : '/savchenko.pdf' %>"
                 class="text-decoration-none" style="font-size: var(--ss-fs-13); color: var(--ss-link);">
                <%= lang === 'ru' ? 'Скачать учебник' : 'Download Textbook' %>
              </a>
            </div>
          </div>
          <div style="height: 8px; border-radius: var(--ss-radius-sm); background: var(--ss-surface-hover); overflow: hidden;">
            <div style="height: 100%; width: <%= _overallPct %>%; background: var(--ss-navy); border-radius: var(--ss-radius-sm); transition: width 0.6s ease;"></div>
          </div>
          <%# The count above is solved in either language; how many each language has, from the same
              listing (unsolved.js: currentLangSolutions is this page's language). %>
          <%
            const _n = (x) => Number(x || 0).toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US');
            const _ruSolved = lang === 'ru' ? solutionProgress.currentLangSolutions : solutionProgress.otherLangSolutions;
            const _enSolved = lang === 'ru' ? solutionProgress.otherLangSolutions : solutionProgress.currentLangSolutions;
          %>
          <p style="font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin: var(--ss-space-2) 0 0;">
            <%= lang === 'ru' ? `На русском ${_n(_ruSolved)}, на английском ${_n(_enSolved)}.` : `${_n(_enSolved)} in English, ${_n(_ruSolved)} in Russian.` %>
            <%= _totalUnsolved %> <%= lang === 'ru' ? 'задач ещё не решены.' : 'problems still unsolved.' %>
            <%# The easiest unsolved problems first, so the first one shown is one a reader can take. %>
            <a href="/<%= lang %>/problems?sort=calibrated&amp;dir=asc&amp;solved=none" style="color: var(--ss-link);"><%= lang === 'ru' ? 'Сможете решить одну?' : 'Can you solve one?' %></a>
          </p>
        </div>

        <!-- Legend: the difficulty scale, which is what the dots are coloured by (2026-09-19; the
             language colouring and the switch between the two went with the owner's decision).
             A dashed dot is unsolved; a heavy border is Savchenko's own ∗. -->
        <% const hasDifficultyKey = typeof difficultyGrid !== 'undefined' && difficultyGrid; %>
        <div class="grid-legend">
          <% if (hasDifficultyKey) { %>
          <span class="legend-set legend-set--heat" id="heatLegend">
            <span class="legend-item"><%= lang === 'ru' ? 'Легче' : 'Easier' %></span>
            <span class="heat-ramp">
              <% for (let i = 1; i <= 9; i++) { %><span class="heat-chip heat-<%= i %>"></span><% } %>
            </span>
            <span class="legend-item"><%= lang === 'ru' ? 'Труднее' : 'Harder' %></span>
            <span class="legend-item legend-item--apart">
              <span class="legend-swatch legend-star"></span>
              <%= lang === 'ru' ? 'Отмечена ∗ Савченко' : 'Marked ∗ by Savchenko' %>
            </span>
            <span class="legend-item legend-item--apart">
              <span class="legend-swatch legend-faded"></span>
              <%= lang === 'ru' ? 'Нет решения на русском' : 'No English solution' %>
            </span>
            <span class="legend-item">
              <span class="legend-swatch legend-unsolved"></span>
              <%= lang === 'ru' ? 'Не решено' : 'Unsolved' %>
            </span>
          </span>
          <% } %>
        </div>

        <!-- Chapter Grid -->
        <div class="chapter-grid">
          <% const otherLang = lang === 'ru' ? 'en' : 'ru'; %>
          <% const gridStates = {}; %>
          <% chapters.forEach((chapter, chapterIndex) => {
            const chNum = chapterIndex + 1;
            let chSolved = 0;
            let chTotal = 0;
            const chSections = [];
            chapter.sections.forEach(section => {
              const sMax = parseInt(section.maximum) || 0;
              const allProbs = section.problems.flat();
              const sSolved = allProbs.length;
              chTotal += sMax;
              chSolved += sSolved;
              // One character per problem instead of a full <a> element. Every dot's
              // href, class and title is derivable from this state plus the problem
              // number, so shipping 2,023 anchors in the HTML was pure waste: it made the
              // homepage 522 KB with 2,121 links, all but ~98 of them inside collapsed
              // chapters nobody had opened. The dots are now built on first expand.
              //   3 = solved in both languages, 2 = English only, 1 = Russian only, 0 = unsolved
              let states = '';
              for (let p = 1; p <= sMax; p++) {
                const probName = section.number + '.' + p;
                const isEn = enSolvedSet.has(probName);
                const isRu = ruSolvedSet.has(probName);
                states += (isEn && isRu) ? '3' : isEn ? '2' : isRu ? '1' : '0';
              }
              gridStates[section.number] = states;
              chSections.push({ number: section.number, title: section.title, solved: sSolved, total: sMax, count: sMax });
            });
            const chPct = chTotal > 0 ? ((chSolved / chTotal) * 100).toFixed(0) : '0';
          %>
          <div class="chapter-card<%= chapterIndex === chapters.length - 1 ? ' chapter-card--last' : '' %><%= chapterIndex === chapters.length - 2 ? ' chapter-card--penultimate' : '' %>" id="ch-<%= chNum %>">
            <div class="chapter-card-header" data-chapter="<%= chNum %>" role="button" tabindex="0" aria-expanded="false" aria-controls="ch-<%= chNum %>-panel">
              <div class="chapter-card-row">
                <span class="chapter-num"><%= chNum %></span>
                <div class="chapter-card-text">
                  <div class="chapter-card-name" id="ch-<%= chNum %>-name"><%= chapter.title %></div>
                  <% if (lang === 'ru') { %>
                    <%
                      const enChapterNames = ['Kinematics','Dynamics','Oscillations and Waves','Fluid Mechanics','Molecular Physics','Electrostatics','Motion of charged particles in an electric field','Electric current','Constant magnetic field','Motion of charged particles in complex fields','Electromagnetic induction','Electromagnetic waves','Geometrical optics. Photometry. Quantum nature of light','Special theory of relativity'];
                    %>
                    <div class="chapter-card-name-alt" title="<%= enChapterNames[chapterIndex] || '' %>"><%= enChapterNames[chapterIndex] || '' %></div>
                  <% } %>
                  <div class="chapter-card-progress">
                    <div class="chapter-mini-bar">
                      <div class="chapter-mini-bar-fill" style="width: <%= chPct %>%;"></div>
                    </div>
                    <span class="chapter-card-count"><%= chSolved %> / <%= chTotal %> <%= lang === 'ru' ? 'решено' : 'solved' %></span>
                    <svg class="chapter-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M4 6l4 4 4-4" stroke="#6c757d" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <%# The open chapter's sections: a sibling of the card, one full-width row. With
              grid-auto-flow: dense the cards after it close up the row the card sits in, so
              opening a chapter never leaves the rest of its row empty (it used to span the
              whole row itself and pushed its neighbours down, 2026-09-14). %>
          <div class="chapter-content" id="ch-<%= chNum %>-panel" role="region" aria-labelledby="ch-<%= chNum %>-name">
              <% chSections.forEach(sec => { %>
              <div class="section-block">
                <div class="section-header" id="<%= sec.number %>">
                  <span class="section-name">&sect; <%= sec.number %> &mdash; <%= sec.title %></span>
                  <span class="section-count"><%= sec.solved %> / <%= sec.total %></span>
                </div>
                <!-- Populated on first expand from the state payload below. -->
                <div class="problem-dots" data-section="<%= sec.number %>" data-count="<%= sec.count %>"></div>
              </div>
              <% }); %>
          </div>
          <% }); %>
        </div>
        <script type="application/json" id="gridStates"><%- JSON.stringify(gridStates) %></script>
        <% if (typeof difficultyGrid !== 'undefined' && difficultyGrid) { %>
        <script type="application/json" id="gridDifficulty"><%- JSON.stringify(difficultyGrid) %></script>
        <% } %>

    <!-- Secondary: team, actions, video. Moved below the grid so the
         first screen is the problem index rather than decoration. -->
    <!-- Compact Introduction -->
      <div class="compact-intro mb-2">
        <div class="intro-band">
          <div class="intro-team-col">
            <figure class="intro-team-figure mb-0">
              <img
                src="/img/team.webp"
                alt="<%= lang === 'en' ? 'Savchenko Solutions team' : 'Команда Savchenko Solutions' %>"
                class="intro-team-img img-fluid"
                width="450"
                height="450"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="intro-team-caption">
                <%= __({ phrase: 'description.teamPhotoCaption', locale: lang }) %>
              </figcaption>
            </figure>
          </div>
          <div class="compact-intro-main">
            <%# Two actions and the core team. The progress panel that sat under them repeated
                the bar above the chapter grid and the hero's count, a third time, and made this
                column the band's tallest, which left empty strips under the photo and the video
                (removed 2026-09-14). %>
            <div class="intro-actions">
              <a href="/<%= lang %>/study-guide" class="action-link primary-action">
                <span class="action-content">
                  <strong class="action-title d-inline-flex align-items-center gap-2">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="17" height="17" fill="currentColor">
                      <path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z"></path>
                    </svg>
                    <span>
                      <%# A card without a verb does not read as something you can do.
                          "Upload Solution" survived only because it happens to contain one. %>
                      <% if (lang === 'en') { %>Read the contributing guide<% } else { %>Читать руководство по участию<% } %>
                    </span>
                  </strong>
                  <span class="action-desc">
                    <% if (lang === 'en') { %>Learn how to submit solutions, edit problems, and earn recognition<% } else { %>Узнайте, как отправлять решения, редактировать задачи и получать признание<% } %>
                  </span>
                </span>
              </a>
              <a href="/<%= lang %>/upload" class="action-link secondary-action">
                <span class="action-content">
                  <strong class="action-title d-inline-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M12 3v14" />
                      <path d="M6 9l6-6 6 6" />
                      <path d="M5 19h14" />
                    </svg>
                    <span>
                      <% if (lang === 'en') { %>Upload Solution<% } else { %>Загрузить решение<% } %>
                    </span>
                  </strong>
                  <span class="action-desc">
                    <% if (lang === 'en') { %>Quick upload - no registration needed<% } else { %>Быстрая загрузка - регистрация не требуется<% } %>
                  </span>
                </span>
              </a>
            </div>
            <p class="info-team-members">
              <% if (lang === 'en') { %>
                <span class="info-team-label-inline">Core Team:</span>
                <a href="/user/astrosander/" class="<%= rankClass('astrosander') %>">astrosander</a>,
                <a href="/user/emixter/" class="<%= rankClass('emixter') %>">emixter</a>,
                <a href="/user/igor/" class="<%= rankClass('igor') %>">igor</a>,
                <a href="/user/Ismail" class="<%= rankClass('Ismail') %>">Ismail</a>
                <a href="<%= lang === 'en' ? '/about#team' : '/ru/about#team' %>" class="info-more">+more</a>
              <% } else { %>
                <span class="info-team-label-inline">Команда:</span>
                <a href="/user/astrosander/" class="<%= rankClass('astrosander') %>">astrosander</a>,
                <a href="/user/emixter/" class="<%= rankClass('emixter') %>">emixter</a>,
                <a href="/user/igor/" class="<%= rankClass('igor') %>">igor</a>,
                <a href="/user/Ismail" class="<%= rankClass('Ismail') %>">Ismail</a>
                <a href="<%= lang === 'en' ? '/about#team' : '/ru/about#team' %>" class="info-more">+ещё</a>
              <% } %>
            </p>
          </div>
          <div class="intro-youtube-col">
            <%# The LEX News segment about the project, served from our own /video and
                played by the browser — YouTube refuses to embed it (LEX has embedding off,
                so any <iframe> renders "Playback on other websites has been disabled by
                the video owner"). The YouTube link-out below is the fallback if the file
                is ever missing; the poster is a frame of the segment itself, keeping LEX's
                own lower-third and attribution on screen. The how-to walkthrough that used
                to sit here now lives on the study guide. %>
            <div class="intro-video">
              <%- include('default/video_embed', {
                videoId: 'cNSQZJMJFZs',
                videoFile: (typeof assetIfPresent === 'function') ? assetIfPresent('/video/lex-news.mp4') : null,
                videoPoster: '/img/lex-news-poster.webp',
                videoTitle: lang === 'ru'
                  ? '«Настоящее влияние»: студент Berea College создаёт бесплатные платформы для науки'
                  : '‘Real impact’: Berea College student builds free science education platforms',
                videoSource: 'LEX News',
                videoEmbeddable: false
              }) %>
              <%# A press credit, not decoration: naming the outlet and its network is
                  what makes the segment read as coverage rather than a self-made clip.
                  LEX 18 is WLEX-TV, the NBC affiliate for Lexington, Kentucky since 1968
                  (E. W. Scripps) — "(NBC)" is the affiliation, so it stays parenthetical
                  rather than implying the network itself reported this. %>
              <p class="video-credit">
                <span class="video-credit-outlet">LEX 18 <span class="video-credit-network">(NBC)</span>,</span>
                <a class="video-credit-link" href="https://www.lex18.com/news/covering-kentucky/real-impact-berea-college-student-builds-free-science-education-platforms"
                   target="_blank" rel="noopener">
                  <%= lang === 'ru' ? 'Читать оригинальный репортаж' : 'Read the original story' %>
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>


        <!-- Problempedia callout removed for now -->

        <!-- Latest from the Blog (in main column) -->
        <div id="blogWidgetMain" style="display:none; margin-top: var(--ss-space-3);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--ss-space-3);">
            <h3 style="font-size: var(--ss-fs-16); font-weight: var(--ss-fw-strong); color: var(--ss-text); margin: 0;">
              <%= lang === 'ru' ? 'Блог' : 'Latest from the Blog' %>
            </h3>
            <a href="/blog" style="font-size: var(--ss-fs-13); color: var(--ss-link); text-decoration: none; font-weight: var(--ss-fw-regular);">
              <%= lang === 'ru' ? 'Все' : 'View all' %>
            </a>
          </div>
          <div id="blogWidgetMainList" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--ss-space-4);"></div>
        </div>

        <%# Feedback prompt + poll. Kept in the main column, under the blog, so they fill
            the space beside the taller sidebar instead of leaving an empty band below the
            grid. Copy is reused verbatim from locales; the poll is the same once-ever queue
            as the solution pages, so a reader who answered there is never asked again. %>
        <div class="fb-inline">
          <span><%= __({ phrase: 'description.platformUpdate.message', locale: lang }) %></span>
          <button type="button" class="fb-inline-cta" data-fb-open data-fb-category="idea">
            <%= __({ phrase: 'description.platformUpdate.feedbackLink', locale: lang }) %>
          </button>
        </div>
        <div data-fb-poll></div>
      </div>

      <!-- RIGHT COLUMN: Sticky Sidebar -->
      <div class="home-sidebar">
        <div class="sidebar-sticky">

          <!-- Challenge of the Week Widget -->
          <% if (typeof challengeWidget !== 'undefined' && challengeWidget) { %>
          <div class="sidebar-section" style="margin-bottom: var(--ss-space-5);">
            <div style="padding: var(--ss-space-4); background: var(--ss-surface-alt); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg);">
              <div style="font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); text-transform: uppercase; letter-spacing: 0.5px; color: var(--ss-navy); margin-bottom: var(--ss-space-2);">
                <%= lang === 'ru' ? 'Задача недели' : 'Challenge of the Week' %>
              </div>
              <p style="font-size: var(--ss-fs-14); color: var(--ss-text); margin: 0 0 var(--ss-space-2) 0; line-height: 1.4;">
                <%
                  const challengePreview = (challengeWidget.problem_statement || '')
                    .replace(/\$([^$]+)\$/g, '$1')
                    .replace(/\s+/g, ' ')
                    .trim();
                %>
                <%= challengePreview.length > 100 ? challengePreview.substring(0, 100) + '...' : challengePreview %>
              </p>
              <div style="font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-2);">
                <span id="homeWidgetCountdown" data-end="<%= challengeWidget.week_end %>"></span>
                &middot; <%= challengeWidget.submission_count %> <%= lang === 'ru' ? 'решений' : 'submissions' %>
              </div>
              <a href="/compete/<%= challengeWidget.id %>" style="display: inline-block; background: var(--ss-navy); color: var(--ss-on-navy); padding: var(--ss-space-1) var(--ss-space-4); border-radius: var(--ss-radius); font-size: var(--ss-fs-13); font-weight: var(--ss-fw-regular); text-decoration: none;">
                <%= lang === 'ru' ? 'Попробовать' : 'Try it' %>
              </a>
            </div>
          </div>
          <% } %>

          <!-- Top Authors -->
          <div class="sidebar-section">
            <%# A top-ten leaderboard means nothing to someone who has never been here —
                they don't know any of the names. What a first-time visitor needs is
                evidence that other humans use this. Logged-in contributors get the
                leaderboard, because for them it is the competitive mechanic it is
                supposed to be. %>
            <div class="sidebar-section-header">
              <h3 class="sidebar-title"><%= lang === 'ru' ? 'Лучшие авторы' : 'Top Authors' %></h3>
              <a href="/<%= lang %>/contributors" class="sidebar-view-all"><%= lang === 'ru' ? 'Все' : 'View All' %></a>
            </div>
            <div class="top-authors-list">
              <div class="top-authors-header">
                <span class="ta-rank-col">#</span>
                <span class="ta-user-col"><%= lang === 'ru' ? 'Пользователь' : 'User' %></span>
                <span class="ta-score-col"><%= lang === 'ru' ? 'Балл' : 'Score' %></span>
              </div>
              <% topAuthors.forEach((author, index) => { %>
              <div class="top-author-row">
                <span class="ta-rank-col">
                  <% if (index === 0) { %>
                    <span class="rank-badge rank-gold">1</span>
                  <% } else if (index === 1) { %>
                    <span class="rank-badge rank-silver">2</span>
                  <% } else if (index === 2) { %>
                    <span class="rank-badge rank-bronze">3</span>
                  <% } else { %>
                    <span class="rank-num"><%= index + 1 %></span>
                  <% } %>
                </span>
                <span class="ta-user-col">
                  <span class="ta-avatar-wrap">
                    <img src="<%= author.profile_picture || '/img/profile_images/Default_placeholder.svg' %>"
                         alt="<%= author.username %>"
                         class="ta-avatar" width="32" height="32" loading="lazy" />
                    <% if (author.is_online) { %>
                      <span class="ta-online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>" aria-label="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span>
                    <% } %>
                  </span>
                  <% const _tier = rankTierFor(Number(author.rank)); %>
                  <a href="/user/<%= author.username %>" class="ta-username ss-rank-<%= _tier.key %> ss-rank-c-<%= _tier.key %>" data-no-rank><%= author.username %></a>
                </span>
                <span class="ta-score-col ta-score-value"><%= author.rank %></span>
              </div>
              <% }); %>
            </div>
          </div>

          <!-- Recently Joined -->
          <% if (typeof recentContributors !== 'undefined' && recentContributors && recentContributors.length) { %>
          <div class="sidebar-section mt-4">
            <div class="sidebar-section-header">
              <h3 class="sidebar-title"><%= lang === 'ru' ? 'Новые участники' : 'Recently Joined' %></h3>
            </div>
            <div style="display:flex; flex-wrap:wrap; gap:var(--ss-space-3); padding-top:var(--ss-space-1);">
              <% recentContributors.forEach(function(rc) { %>
                <a href="/user/<%= rc.username %>" title="<%= rc.full_name || rc.username %>" class="<%= rankClass(rc.username) %>" style="display:inline-flex; align-items:center; gap:var(--ss-space-2); text-decoration:none; font-size:var(--ss-fs-13);">
                  <img src="<%= rc.profile_picture || '/img/profile_images/Default_placeholder.svg' %>" alt="" width="24" height="24" style="border-radius:50%; object-fit:cover; flex-shrink:0;" />
                  <span><%= rc.username %></span>
                </a>
              <% }); %>
            </div>
          </div>
          <% } %>

          <!-- Recent Changes (GitHub commit thread style) -->
          <div class="sidebar-section mt-4">
            <div class="sidebar-section-header">
              <h3 class="sidebar-title"><%= lang === 'ru' ? 'Последние изменения' : 'Recent Changes' %></h3>
            </div>
            <div class="commit-thread">
              <% recentContributions.slice(0, 8).forEach(contribution => { %>
              <% const isComment = contribution.kind === 'comment'; %>
              <div class="commit-entry<%= contribution.isNew ? ' new-solution' : '' %><%= isComment ? ' comment-entry' : '' %>">
                <div class="commit-dot-wrapper">
                  <span class="commit-hline"></span>
                  <span class="commit-dot"></span>
                  <span class="commit-hline"></span>
                </div>
                <div class="commit-entry-body">
                  <div class="commit-entry-main">
                    <a href="/<%= contribution.lang %>/<%= contribution.version %>" class="commit-problem"><%= contribution.version %></a>
                    <%# Same grammatical shape as the edit actions ("добавлена", "изменена"),
                        so the three read as one list rather than two kinds of phrase. %>
                    <span class="commit-action"><%
                      if (isComment) { %><%= lang === 'ru' ? 'прокомментировано' : 'commented' %><%
                      } else if (contribution.isNew) { %><%= lang === 'ru' ? 'добавлена' : 'new' %><%
                      } else { %><%= lang === 'ru' ? 'изменена' : 'edited' %><% } %></span>
                    <span class="commit-by"><%= lang === 'ru' ? '' : 'by' %></span>
                    <% if (contribution.hasUser) { %>
                      <a href="/user/<%= contribution.editor %>" class="commit-author <%= rankClass(contribution.editor) %>"><%= contribution.editor %></a>
                    <% } else { %>
                      <span class="commit-author-anon"><%= lang === 'ru' ? 'Аноним' : 'Anonymous' %></span>
                    <% } %>
                  </div>
                  <div class="commit-entry-footer">
                    <%- localTime(contribution.relativeTime, 'daytime', lang, { className: 'commit-time' }) %>
                    <a href="<%= contribution.href %>" class="commit-id"><%= isComment ? (lang === 'ru' ? 'к обсуждению' : 'thread') : '#' + contribution.id %></a>
                  </div>
                </div>
              </div>
              <% }); %>
            </div>
            <a href="/<%= lang %>/contributions/all" class="sidebar-view-all" style="display: inline-block; margin-top: var(--ss-space-2);">
              <%= lang === 'ru' ? 'Посмотреть все' : 'View all' %>
            </a>
          </div>

          <!-- Blog widget moved to main column -->

        </div>
      </div>
    </div>

  </main>

  <!-- ============================
       POP-UP & OVERLAY
  ============================ -->
  <div id="edit-popup">
    <h3><%= __('popup.title') %></h3>
    <input
      type="text"
      id="problem-name"
      placeholder="<%= __('popup.placeholder') %>"
    />
    <div id="popup-statement" class="ss-statement" aria-live="polite">
      <div class="ss-statement-head"><span id="popup-statement-label"></span></div>
      <div id="popup-statement-body" class="ss-statement-body"></div>
    </div>
    <button id="submit-problem"><%= __('popup.submit') %></button>
    <button id="cancel-edit"><%= __('popup.cancel') %></button>
  </div>
  <div id="popup-overlay"></div>

  <!-- ============================
       FOOTER
  ============================ -->
  <%- include('default/modern_footer') %>

  <!-- ============================
       SCRIPTS
  ============================ -->
  <style>
    .search-results {
        text-align: left;
        font-size: var(--ss-fs-13);
    }
    .search-results ul {
        padding: 0;
        margin: 0;
    }
    .search-results li {
        padding: var(--ss-space-2) var(--ss-space-3);
        cursor: pointer;
    }
    .search-results li:hover {
        background-color: var(--ss-surface-hover);
    }
    .bg-dark {
      animation: fadeInFooter 0.8s ease-in-out;
    }
    @keyframes fadeInFooter {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Add these mobile-specific styles */
    @media (max-width: 768px) {
        .site-title {
            font-size: var(--ss-fs-18);
        }
        .site-motto {
            font-size: var(--ss-fs-12);
        }
        .hero-subtitle {
            font-size: var(--ss-fs-24);
        }
        .hero-tagline {
            font-size: var(--ss-fs-14);
        }
        .logo-img {
            width: 32px;
            height: 32px;
            object-fit: contain;
        }
        .searchbar-input {
            font-size: var(--ss-fs-16);
            padding: var(--ss-space-2) var(--ss-space-8);
        }
        .chapter-title, .chapter-name {
            font-size: var(--ss-fs-18);
        }
        .section-title {
            font-size: var(--ss-fs-16);
        }
        .problem-item {
            font-size: var(--ss-fs-14);
        }
    }

    @media (max-width: 768px) {
      .problems-grid {
        display: grid;
        gap: var(--ss-space-2);
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      }
    }

    /* Header Summit Link */
    .summit-header-link {
      color: rgba(255, 255, 255, 0.8) !important;
      transition: opacity 0.3s ease;
    }

    .summit-header-link:hover {
      opacity: 1 !important;
      color: var(--ss-on-navy) !important;
    }

    /* Hero — one headline, one byline, one action. Mobile-first. */
    .hero-primary {
      padding: var(--ss-space-3) var(--ss-space-5) var(--ss-space-4);
      border-bottom: 1px solid var(--border, #dee2e6);
      background: var(--ss-surface);
    }
    /* The one display title on the site: the condensed sans of the 3rd edition's title page
       ("ЗАДАЧИ ПО ФИЗИКЕ"), SS Display at the display size (32 → 40px). */
    .hero-headline {
      font-family: var(--ss-font-display);
      font-weight: 600;
      font-synthesis: none;
      font-size: var(--ss-text-display);
      line-height: var(--ss-lh-tight);
      letter-spacing: 0;
      color: var(--ss-navy);
      margin: 0 0 var(--ss-space-3);
      max-width: 24ch;
    }
    .hero-byline {
      font-size: var(--ss-fs-16);
      color: var(--text-secondary, #6c757d);
      margin: 0 0 var(--ss-space-5);
      max-width: 56ch;
    }
    .hero-search-label {
      display: block;
      font-size: var(--ss-fs-13);
      font-weight: var(--ss-fw-strong);
      color: var(--text, #2d2d2d);
      margin-bottom: var(--ss-space-2);
    }
    .hero-search-row {
      display: flex;
      gap: var(--ss-space-2);
      max-width: 30rem;
    }
    .hero-search-input {
      flex: 1 1 auto;
      min-width: 0;
      height: 44px;
      padding: 0 var(--ss-space-3);
      font-size: var(--ss-fs-16);
      color: var(--text, #2d2d2d);
      border: 1px solid var(--border, #dee2e6);
      border-radius: var(--ss-radius);
      background: var(--ss-surface);
    }
    .hero-search-input:focus {
      outline: none;
      border-color: var(--ss-navy);
      box-shadow: 0 0 0 3px rgba(26, 26, 46, 0.08);
    }
    .hero-search-button {
      flex: 0 0 auto;
      height: 44px;
      padding: 0 var(--ss-space-5);
      font-size: var(--ss-fs-14);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-on-navy);
      background: var(--ss-navy);
      border: 1px solid var(--ss-navy);
      border-radius: var(--ss-radius);
      cursor: pointer;
    }
    .hero-search-button:hover { background: var(--ss-navy); }
    .hero-search-hint {
      display: block;
      margin-top: var(--ss-space-2);
      font-size: var(--ss-fs-13);
      color: var(--text-secondary, #6c757d);
    }
    .hero-proof {
      display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--ss-space-1) var(--ss-space-6);
      margin-top: var(--ss-space-5); font-size: var(--ss-fs-16); color: var(--text-secondary, #6c757d);
    }
    .hero-proof strong {
      font-family: var(--ss-font-ui); font-size: var(--ss-fs-20); font-weight: var(--ss-fw-strong);
      color: var(--text, #2d2d2d);
    }
    .hero-proof a { color: var(--ss-link); text-decoration: none; font-size: var(--ss-fs-14); }
    .hero-proof a:hover { text-decoration: underline; }

    .most-wanted { margin-top: var(--ss-space-6); max-width: 44rem; }
    .most-wanted-head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: var(--ss-space-4); margin-bottom: var(--ss-space-2);
    }
    .most-wanted-title {
      font-size: var(--ss-fs-13); font-weight: var(--ss-fw-strong); letter-spacing: 0.02em;
      text-transform: uppercase; color: var(--text-secondary, #6c757d);
    }
    .most-wanted-all { font-size: var(--ss-fs-13); color: var(--ss-link); text-decoration: none; }
    .most-wanted-all:hover { text-decoration: underline; }
    .most-wanted-list {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: var(--ss-space-2);
    }
    .most-wanted-item {
      display: inline-flex; align-items: baseline; gap: var(--ss-space-2);
      padding: var(--ss-space-2) var(--ss-space-3); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius);
      background: var(--ss-surface); text-decoration: none; transition: border-color 0.15s ease;
    }
    .most-wanted-item:hover { border-color: var(--ss-navy); background: var(--ss-surface-alt); }
    .mw-num { font-weight: var(--ss-fw-strong); font-size: var(--ss-fs-16); color: var(--text, #2d2d2d); }
    .mw-demand { font-size: var(--ss-fs-12); color: var(--text-secondary, #6c757d); }

    .hero-search-input.is-problem-number {
      border-color: var(--ss-success);
      box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.10);
    }
    @media (min-width: 768px) {
      .hero-primary { padding: var(--ss-space-4) var(--ss-space-6) var(--ss-space-3); }
      .hero-headline { max-width: 22ch; }
      .hero-byline { font-size: var(--ss-fs-16); }
      .hero-search-input { height: 48px; font-size: var(--ss-fs-16); }
      .hero-search-button { height: 48px; }
    }
    /* Wide screens: the headline and its byline on the left, the search on the right beside
       them, and the numbers and the worklist on one line underneath. The previous split put the
       whole intro in the left column and only the worklist on the right, so with one or two
       problems in the list the right half of the first screen stood empty under a three-line
       headline (2026-09-14). Phones keep the source order: headline, byline, search, numbers. */
    @media (min-width: 992px) {
      .hero-primary {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        grid-template-areas:
          "headline search"
          "byline   search"
          "proof    wanted";
        grid-template-rows: auto 1fr auto;
        column-gap: var(--ss-space-8);
        align-items: start;
        padding-bottom: var(--ss-space-4);
      }
      .hero-main { display: contents; }
      .hero-headline { grid-area: headline; max-width: none; margin-bottom: var(--ss-space-2); }
      .hero-byline { grid-area: byline; max-width: 62ch; margin-bottom: 0; }
      .hero-search { grid-area: search; align-self: center; }
      .hero-search-row { max-width: none; }
      .hero-proof { grid-area: proof; margin-top: var(--ss-space-4); }
      .most-wanted { grid-area: wanted; margin-top: var(--ss-space-4); max-width: none; }
      .most-wanted-list { gap: var(--ss-space-2); }
    }
    @media (min-width: 1400px) {
    }

    /* Compact Introduction */
    .compact-intro {
      background: var(--ss-surface);
      border-radius: 0;
      padding: var(--ss-space-4) var(--ss-space-5);
      box-shadow: none;
    }

    /* Team photo, the two actions and the press video. A grid whose arrangement follows the
       band's own width (a container query: the sidebar beside it takes a different share at
       each screen width), so each width gets the layout that leaves no empty strip (2026-09-14):
         under 480px   photo, actions, video, one under another;
         480-899px     photo beside the video, the two actions side by side under them;
         900px up      one row: photo, actions, video.
       Wherever the photo shares a row it takes that row's height (the video's, or the
       actions'), less its caption: the image has flex-basis 0, so it asks for no height. */
    .compact-intro { container-type: inline-size; }
    .intro-band {
      --intro-team-photo-max: min(100%, 239px);
      --intro-team-figure-max: min(100%, 23.3rem);
      display: grid;
      gap: var(--ss-space-4);
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "team" "main" "video";
    }
    .intro-team-col { grid-area: team; display: flex; flex-direction: column; min-width: 0; }
    .compact-intro-main { grid-area: main; display: flex; flex-direction: column; min-width: 0; }
    .intro-youtube-col { grid-area: video; min-width: 0; }
    .intro-band .info-team-members { margin-top: var(--ss-space-2); }

    @container (min-width: 480px) {
      .intro-band {
        --intro-team-photo-max: 100%;
        --intro-team-figure-max: 100%;
        grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
        grid-template-areas: "team video" "main main";
      }
      .intro-band .intro-actions { flex-direction: row; }
      .intro-band .intro-actions .action-link { flex: 1 1 0; }
      .intro-band .intro-team-figure { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
      .intro-band .intro-team-img { flex: 1 1 0; min-height: 0; aspect-ratio: auto; object-fit: contain; }
    }
    @container (min-width: 900px) {
      .intro-band {
        grid-template-columns: minmax(0, 22fr) minmax(0, 40fr) minmax(0, 38fr);
        grid-template-areas: "team main video";
      }
      .intro-band .intro-actions { flex: 1 1 auto; flex-direction: column; }
      .intro-band .intro-actions .action-link { flex: 1 1 auto; }
    }

    .intro-team-figure {
      max-width: var(--intro-team-figure-max);
      margin-left: auto;
      margin-right: auto;
      width: 100%;
    }

    .intro-team-img {
      display: block;
      width: 100%;
      max-width: var(--intro-team-photo-max);
      height: auto;
      margin-left: auto;
      margin-right: auto;
      aspect-ratio: 1;
      object-fit: cover;
    }

    .intro-team-caption {
      margin-top: var(--ss-space-2);
      font-size: var(--ss-fs-14);
      font-weight: var(--ss-fw-strong);
      line-height: 1.42;
      color: var(--ss-text-secondary);
      letter-spacing: 0.01em;
      text-align: center;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .intro-text {
      color: var(--ss-text-secondary);
      font-size: var(--ss-fs-16);
      line-height: 1.5;
      margin-bottom: var(--ss-space-3);
    }

    .intro-actions {
      display: flex;
      flex-direction: column;
      gap: var(--ss-space-3);
      width: 100%;
    }

    .intro-actions .action-link {
      width: 100%;
      box-sizing: border-box;
      gap: var(--ss-space-2);
      padding: var(--ss-space-3) var(--ss-space-3);
    }

    .intro-actions .action-content {
      gap: var(--ss-space-1);
    }

    .intro-actions .action-title {
      font-size: var(--ss-fs-14);
    }

    .intro-actions .action-desc {
      font-size: var(--ss-fs-13);
      line-height: 1.38;
    }

    /* These read as flat text until you hover them, so nobody knows they are clickable.
       A visible border, a real hover state and a cursor fix that. */
    .action-link {
      display: flex;
      align-items: center;
      gap: var(--ss-space-3);
      padding: var(--ss-space-4) var(--ss-space-4);
      border-radius: var(--ss-radius);
      text-decoration: none;
      transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      border: 1px solid var(--ss-rule);
      background: var(--ss-surface);
      cursor: pointer;
    }
    .action-link:hover {
      border-color: var(--ss-navy);
      background: var(--ss-surface-alt);
      box-shadow: var(--ss-shadow);
    }
    .action-link:focus-visible {
      outline: 2px solid var(--ss-navy);
      outline-offset: 2px;
    }

    .action-link.primary-action {
      background: #e9f2ff;
      color: var(--ss-link);
      border-color: #bcd4ff;
    }

    .action-link.primary-action:hover {
      box-shadow: none;
      background: #dbe8ff;
      color: var(--ss-link-hover);
    }

    .action-link.secondary-action {
      background: #f8f9fb;
      color: var(--ss-text-secondary);
      border-color: #dde2ea;
    }

    .action-link.secondary-action:hover {
      background: #eef2f8;
      border-color: #bcd4ff;
      color: var(--ss-link);
    }

    .action-icon {
      font-size: var(--ss-fs-28);
      flex-shrink: 0;
    }

    .action-content {
      display: flex;
      flex-direction: column;
      gap: var(--ss-space-1);
      flex: 1;
    }

    .action-title {
      font-size: var(--ss-fs-16);
      font-weight: var(--ss-fw-strong);
    }

    .action-desc {
      font-size: var(--ss-fs-14);
      line-height: 1.45;
      opacity: 0.9;
    }

    .info-team-label {
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text-secondary);
      margin: 0 0 var(--ss-space-1) 0;
      font-size: var(--ss-fs-12);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .info-team-label-inline {
      font-weight: var(--ss-fw-strong);
      margin-right: var(--ss-space-1);
    }

    .info-team-members {
      color: var(--ss-text-secondary);
      margin: 0;
      line-height: 1.3;
      font-size: var(--ss-fs-13);
    }

    .info-team-members a {
      color: var(--ss-link);
      text-decoration: none;
      font-weight: var(--ss-fw-regular);
      transition: color 0.2s ease;
    }

    .info-team-members a:hover {
      text-decoration: none;
    }

    .info-more {
      color: var(--ss-text-secondary) !important;
      font-weight: 400 !important;
      font-style: italic;
      margin-left: var(--ss-space-1);
    }

    .info-more:hover {
      color: var(--ss-text-secondary) !important;
    }

    @media (max-width: 768px) {
      .compact-intro {
        padding: var(--ss-space-4) var(--ss-space-4);
      }

      .intro-actions {
        gap: var(--ss-space-2);
      }

      .intro-actions .action-link {
        padding: var(--ss-space-3) var(--ss-space-3);
      }

      .intro-actions .action-title {
        font-size: var(--ss-fs-14);
      }

      .intro-actions .action-desc {
        font-size: var(--ss-fs-12);
      }

      .action-link {
        padding: var(--ss-space-3) var(--ss-space-4);
      }

      .action-icon {
        font-size: var(--ss-fs-24);
      }

      .action-title {
        font-size: var(--ss-fs-16);
      }

      .action-desc {
        font-size: var(--ss-fs-13);
      }

      .intro-band {
        --intro-team-photo-max: min(100%, 209px);
        --intro-team-figure-max: min(100%, 21.85rem);
      }

      .intro-team-caption {
        font-size: var(--ss-fs-13);
        text-align: center;
      }

      .info-team-members {
        font-size: var(--ss-fs-13);
      }

      .video-embed-play svg {
        width: 46px;
        height: 32px;
      }
    }

    /* Press credit under the segment: outlet, its network, and the way through to
       the written story — one line, since it is an attribution, not a section. */
    .video-credit {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--ss-space-2);
      margin: var(--ss-space-2) 0 0;
      font-size: var(--ss-fs-12);
      line-height: 1.5;
    }

    .video-credit-outlet {
      font-weight: var(--ss-fw-strong);
      color: var(--ss-navy);
      letter-spacing: 0.01em;
      white-space: nowrap;
    }

    .video-credit-network {
      color: var(--ss-link);
    }

    .video-credit-link {
      color: var(--ss-link);
      text-decoration: none;
    }

    .video-credit-link:hover {
      text-decoration: underline;
    }


    /* ===== Chapter Grid ===== */
    .chapter-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--ss-space-2);
      /* dense: an open chapter's panel takes the next full row and the cards after it fill
         the rest of the card's own row. */
      grid-auto-flow: row dense;
      /* No container background: with 14 chapters the trailing cells of the last row
         would otherwise show as grey voids. Each card carries its own border. */
    }
    @media (min-width: 768px) {
      .chapter-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1200px) {
      .chapter-grid { grid-template-columns: repeat(3, 1fr); }
      /* 14 items over 3 columns leaves 2 in the last row; widen the final card. */
      .chapter-card--last { grid-column: span 2; }
    }
    @media (min-width: 1600px) {
      .chapter-grid { grid-template-columns: repeat(4, 1fr); }
      /* 14 over 4 leaves 2; widen both so the row is full. */
      .chapter-card--last,
      .chapter-card--penultimate { grid-column: span 2; }
    }
    /* The open card stays in its cell, marked; its sections open in the row below. */
    .chapter-card.open { border-color: var(--ss-navy); }
    .chapter-card.open .chapter-card-header { background: var(--ss-surface-alt); }
    /* Cards in a row share one height and their progress bars sit on one line at the
       bottom; the chevron rides in that bar row, so the title gets the card's full width —
       at four columns (a 1600px window) "Движение заряженных частиц в электрическом поле"
       took three lines beside a top-right chevron, and every other card in its row showed
       the difference as empty space. */
    .chapter-card {
      display: flex;
      flex-direction: column;
      background: var(--ss-surface);
      border: 1px solid var(--ss-rule);
      border-radius: var(--ss-radius-lg);
      overflow: hidden;
    }
    .chapter-card-header {
      flex: 1 0 auto;
      display: flex;
      flex-direction: column;
      padding: var(--ss-space-4) var(--ss-space-4);
      cursor: pointer;
      user-select: none;
      transition: background-color 0.15s ease;
    }
    .chapter-card-row {
      flex: 1 0 auto;
      display: flex;
      align-items: flex-start;
      gap: var(--ss-space-3);
    }
    .chapter-card-text {
      flex: 1 1 auto;
      min-width: 0;
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }
    .chapter-card-header:hover {
      background: var(--ss-surface-alt);
    }
    .chapter-num {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: var(--ss-radius);
      background: var(--ss-navy);
      color: var(--ss-on-navy);
      font-weight: var(--ss-fw-strong);
      font-size: var(--ss-fs-14);
      flex-shrink: 0;
    }
    .chapter-card-name {
      font-size: var(--ss-fs-14);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text);
      line-height: 1.3;
    }
    /* One line: the translation is secondary, and a two-line one made its whole row taller. */
    .chapter-card-name-alt {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .chapter-card-progress {
      display: flex;
      align-items: center;
      gap: var(--ss-space-2);
      margin-top: auto;
      padding-top: var(--ss-space-2);
    }
    .chapter-mini-bar {
      flex: 1;
      height: 4px;
      background: var(--ss-surface-hover);
      border-radius: var(--ss-radius-sm);
      overflow: hidden;
    }
    .chapter-mini-bar-fill {
      height: 100%;
      background: var(--ss-success);
      border-radius: var(--ss-radius-sm);
      transition: width 0.6s ease;
    }
    .chapter-card-count {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
      white-space: nowrap;
    }
    .chapter-chevron {
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }
    .chapter-card.open .chapter-chevron {
      transform: rotate(180deg);
    }
    .chapter-content {
      display: none;
      grid-column: 1 / -1;
      background: var(--ss-surface);
      border: 1px solid var(--ss-navy);
      border-radius: var(--ss-radius-lg);
      padding: var(--ss-space-3) var(--ss-space-4) var(--ss-space-4);
    }
    .chapter-content.open {
      display: block;
    }

    .section-block {
      margin-bottom: var(--ss-space-3);
    }
    .section-block:last-child {
      margin-bottom: 0;
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: var(--ss-space-2);
    }
    .section-name {
      font-size: var(--ss-fs-13);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text);
    }
    .section-count {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
      white-space: nowrap;
    }
    .proof-numbers {
      display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--ss-space-5);
      padding: var(--ss-space-1) 0 var(--ss-space-3);
    }
    .proof-item { display: flex; flex-direction: column; }
    .proof-value {
      font-family: var(--ss-font-ui);
      font-size: var(--ss-fs-20); font-weight: var(--ss-fw-strong); line-height: 1.1; color: var(--text, #2d2d2d);
    }
    .proof-label {
      font-size: var(--ss-fs-12); color: var(--text-secondary, #6c757d);
      text-transform: uppercase; letter-spacing: 0.02em;
    }
    .proof-all {
      flex-basis: 100%; font-size: var(--ss-fs-13); color: var(--ss-link); text-decoration: none;
    }
    .proof-all:hover { text-decoration: underline; }

    .grid-legend {
      display: flex; flex-wrap: wrap; gap: var(--ss-space-4);
      margin-bottom: var(--ss-space-3); font-size: var(--ss-fs-12); color: var(--ss-text-secondary);
    }
    .legend-item { display: flex; align-items: center; gap: var(--ss-space-2); }
    .legend-set { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ss-space-2) var(--ss-space-4); }
    .legend-set--heat { gap: var(--ss-space-2); }
    .legend-set--heat .legend-item--apart { margin-left: var(--ss-space-3); }
    .legend-swatch {
      display: inline-block; width: 16px; height: 14px; border-radius: var(--ss-radius-sm); flex: 0 0 auto;
    }
    .legend-unsolved { background: #ffffff; border: 1px dashed #c6ccd2; }

    .problem-dots {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ss-space-1);
    }
    /* ── Difficulty heatmap ──────────────────────────────────────────────────
       Opt-in, off by default. Colour takes over the FILL only; the borders set by the
       solved-* rules below are left alone, so language status still reads in heat mode
       (purple = both, blue = English, green = Russian, dashed = unsolved) while the fill
       carries difficulty. Both facts stay visible at once.

       The ramp is ColorBrewer YlOrRd, chosen because its lightness decreases monotonically
       across all nine steps: it survives greyscale and red-green colour deficiency, which
       matters here for the same reason set out under the dot shapes below. */
    /* Layout only — the control itself is .ss-switch in design-system.css. */

    /* The ramp itself now lives in design-system.css, shared with the section grid
       on every solution page so the two read as one scale. */

    .problem-dot {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 24px;
      border-radius: var(--ss-radius-sm);
      font-size: var(--ss-fs-12);
      text-decoration: none;
      line-height: 1;
      transition: opacity 0.15s ease;
    }
    /* The fill is the difficulty (design-system.css, body.grid-heat .heat-N); here only what
       is not colour: a link, a hover, and the dashed outline of a problem with no solution. */
    .problem-dot { border: 1px solid rgba(26, 26, 46, 0.18); font-weight: var(--ss-fw-strong); }
    a.problem-dot:hover { opacity: 0.8; }
    .problem-dot.unsolved { border: 1px dashed rgba(26, 26, 46, 0.45); }

    /* Overall progress bar */
    .overall-progress {
      margin-bottom: var(--ss-space-5);
    }

    /* ===== Two-Column Layout ===== */
    .home-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: var(--ss-space-7);
      align-items: start;
    }
    @media (max-width: 991px) {
      .home-layout {
        grid-template-columns: 1fr;
      }
    }

    .home-sidebar {
      min-width: 0;
    }
    .sidebar-sticky {
      position: sticky;
      top: 80px;
    }
    @media (max-width: 991px) {
      .sidebar-sticky {
        position: static;
      }
    }

    /* Sidebar sections */
    .sidebar-section {
      background: var(--ss-surface);
      border: 1px solid var(--ss-rule);
      border-radius: var(--ss-radius-lg);
      padding: var(--ss-space-4);
    }
    .sidebar-section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--ss-space-3);
    }
    .sidebar-title {
      font-size: var(--ss-fs-16);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text);
      margin: 0;
    }
    .sidebar-view-all {
      font-size: var(--ss-fs-13);
      color: var(--ss-link);
      text-decoration: none;
      font-weight: var(--ss-fw-regular);
    }
    .sidebar-view-all:hover {
      color: var(--ss-link-hover);
      text-decoration: underline;
    }

    /* ===== Top Authors ===== */
    .top-authors-list {
      font-size: var(--ss-fs-14);
    }
    .top-authors-header {
      display: flex;
      align-items: center;
      padding: 0 0 var(--ss-space-2);
      border-bottom: 1px solid var(--ss-rule);
      margin-bottom: var(--ss-space-1);
      font-size: var(--ss-fs-12);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .top-author-row {
      display: flex;
      align-items: center;
      padding: var(--ss-space-2) 0;
    }
    .ta-rank-col {
      width: 32px;
      flex-shrink: 0;
      text-align: center;
    }
    .ta-user-col {
      flex: 1;
      display: flex;
      align-items: center;
      gap: var(--ss-space-3);
      min-width: 0;
    }
    .ta-score-col {
      width: 48px;
      flex-shrink: 0;
      text-align: right;
    }
    .ta-avatar-wrap {
      position: relative;
      display: inline-flex;
      flex-shrink: 0;
    }
    .ta-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      display: block;
    }
    .ta-online-dot {
      position: absolute;
      bottom: -1px;
      right: -1px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--ss-success);
      border: 2px solid #ffffff;
      box-sizing: content-box;
    }
    /* In the rank's colour since 2026-09-21 (.ss-rank-c-*, design-system.css); inline-block for
       the legendary tier's ::first-letter. */
    .ta-username {
      display: inline-block;
      color: var(--ss-link);
      text-decoration: none;
      font-weight: var(--ss-fw-strong);
      font-size: var(--ss-fs-14);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* Hover darkens the name but draws no underline (owner's request, 2026-09-14). */
    .ta-username:hover {
      color: var(--ss-link-hover);
      text-decoration: none;
    }
    .ta-score-value {
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text);
      font-size: var(--ss-fs-14);
    }

    /* Rank badges (top 3) */
    .rank-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      font-size: var(--ss-fs-12);
      font-weight: var(--ss-fw-strong);
      color: #fff;
    }
    .rank-gold {
      background: #FFD700;
      color: #5c4a00;
    }
    .rank-silver {
      background: #C0C0C0;
      color: #3d3d3d;
    }
    .rank-bronze {
      background: #CD7F32;
      color: #fff;
    }
    .rank-num {
      font-size: var(--ss-fs-13);
      font-weight: var(--ss-fw-strong);
      color: #6c757d;
    }

    /* ===== Commit Thread (Recent Changes) ===== */
    .commit-thread {
      position: relative;
      padding-left: 0;
    }
    /* Continuous vertical line through dot centers */
    .commit-thread::before {
      content: '';
      position: absolute;
      left: 13px;
      top: 12px;
      bottom: 12px;
      width: 2px;
      background: #dee2e6;
    }
    .commit-entry {
      display: flex;
      align-items: flex-start;
      gap: var(--ss-space-3);
      padding: var(--ss-space-1) 0;   /* tighter since 2026-09-21 (the owner) */
      position: relative;
    }
    .commit-dot-wrapper {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      width: 28px;
      margin-top: 2px;
      position: relative;
      z-index: 1;
    }
    .commit-hline {
      flex: 1;
      height: 2px;
      background: #dee2e6;
    }
    .commit-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--ss-navy);
      border: 2px solid #fff;
      flex-shrink: 0;
      box-sizing: border-box;
      aspect-ratio: 1;
    }
    .commit-entry.new-solution .commit-dot {
      background: var(--ss-success);
    }
    /* A comment is a different kind of event from an edit, so its marker is hollow —
       distinguishable at a glance without adding another colour to the sidebar. */
    .commit-entry.comment-entry .commit-dot {
      background: var(--ss-surface);
      border-color: var(--ss-link);
      box-shadow: inset 0 0 0 1px #1a5276;
    }
    .commit-entry-body {
      display: flex;
      flex-direction: column;
      gap: 0;
      flex: 1;
      min-width: 0;
    }
    .commit-entry-main {
      font-size: var(--ss-fs-13);
      line-height: 1.3;
      color: var(--ss-text);
    }
    .commit-problem {
      font-weight: var(--ss-fw-strong);
      color: var(--ss-link);
      text-decoration: none;
    }
    .commit-problem:hover {
      color: var(--ss-link-hover);
      text-decoration: underline;
    }
    .commit-action {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
      margin: 0 2px;
    }
    .commit-by {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
    }
    .commit-author {
      font-size: var(--ss-fs-13);
      font-weight: var(--ss-fw-regular);
      color: var(--ss-link);
      text-decoration: none;
    }
    .commit-author:hover {
      text-decoration: underline;
    }
    .commit-author-anon {
      font-size: var(--ss-fs-13);
      color: var(--ss-text-secondary);
      font-style: italic;
    }
    .commit-entry-footer {
      display: flex;
      align-items: center;
      gap: var(--ss-space-2);
      line-height: 1.3;
    }
    .commit-time {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
    }
    .commit-id {
      font-size: var(--ss-fs-12);
      font-family: var(--ss-font-mono);
      color: var(--ss-link);
      text-decoration: none;
      background: var(--ss-surface-hover);
      padding: 1px var(--ss-space-2);
      border-radius: var(--ss-radius-sm);
      border: 1px solid var(--ss-rule);
    }
    .commit-id:hover {
      background: #e1e7ed;
      text-decoration: none;
    }

  </style>
  

  <script>
  // Navigation is entirely server-side (GET /find). This only adds the affordance that
  // the field recognised a problem number, so the input confirms itself as you type.
  (function () {
    const input = document.getElementById('heroSearchInput');
    if (!input) return;
    const PROBLEM = /^(\d{1,2})[.,](\d{1,2})[.,](\d{1,3})$/;
    input.addEventListener('input', () => {
      const m = PROBLEM.exec(input.value.trim().replace(/\s+/g, ''));
      const ok = Boolean(m) && Number(m[1]) >= 1 && Number(m[1]) <= 14;
      input.classList.toggle('is-problem-number', ok);
    });
  })();
  </script>

  <!-- Pop-up handling -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
        // Add preload class to body initially
        document.body.classList.add('preload');
        
        // Remove preload class after a delay
        setTimeout(() => {
            document.body.classList.remove('preload');
        }, 500);

        const popup = document.getElementById("edit-popup");
        const overlay = document.getElementById("popup-overlay");
        const problemInput = document.getElementById("problem-name");
        let currentChapter;

        function showPopup() {
            popup.style.display = "block";
            overlay.style.display = "block";
            // Force reflow
            popup.offsetHeight;
            overlay.offsetHeight;
            // Add active class to trigger animations
            popup.classList.add("active");
            overlay.classList.add("active");
        }

        function hidePopup() {
            popup.classList.remove("active");
            overlay.classList.remove("active");
            // Wait for animations to complete before hiding elements
            setTimeout(() => {
                popup.style.display = "none";
                overlay.style.display = "none";
                problemInput.value = "";
                popupStatement.classList.remove("is-visible");
                popupStatementBody.innerHTML = "";
            }, 300);
        }

        // Show the problem under the input, the same as /upload does. This popup had no
        // debounce or validation of any kind, so it gets its own.
        const popupStatement = document.getElementById("popup-statement");
        const popupStatementBody = document.getElementById("popup-statement-body");
        const popupStatementLabel = document.getElementById("popup-statement-label");
        let popupStatementTimer, popupStatementTicket = 0;

        problemInput.addEventListener("input", () => {
            clearTimeout(popupStatementTimer);
            popupStatementTimer = setTimeout(async () => {
                const name = problemInput.value.trim();
                const ticket = ++popupStatementTicket;
                if (!/^\d+\.\d+\.\d+$/.test(name)) {
                    popupStatement.classList.remove("is-visible");
                    popupStatementBody.innerHTML = "";
                    return;
                }
                try {
                    const res = await fetch(`/api/problem/${name}/statement?lang=<%= lang %>`);
                    if (ticket !== popupStatementTicket) return;   // stale reply
                    if (!res.ok) {
                        popupStatement.classList.remove("is-visible");
                        return;
                    }
                    const data = await res.json();
                    if (ticket !== popupStatementTicket) return;
                    popupStatementLabel.innerHTML = `<%= __('upload.statementHeading') %> ${data.name}` +
                        (data.starred ? '<sup class="ss-star" title="<%= __("upload.statementStarred") %>">&#8727;</sup>' : '');
                    popupStatementBody.innerHTML = data.html +
                        (data.needsReview ? `<div class="ss-statement-note"><%= __('upload.statementUnverified') %></div>` : '');
                    popupStatement.classList.add("is-visible");
                } catch (err) {
                    if (ticket === popupStatementTicket) popupStatement.classList.remove("is-visible");
                }
            }, 350);
        });

        document.querySelectorAll(".chapter-upload-pill").forEach(button => {
            button.addEventListener("click", (event) => {
                // Remove this event handler since we want the link to work normally
                // event.preventDefault();
                // window.location.href = `/${lang}/upload`;
            });
        });

        document.getElementById("cancel-edit").addEventListener("click", () => {
            hidePopup();
        });

        document.getElementById("submit-problem").addEventListener("click", () => {
            const problemName = problemInput.value.trim();
            if (problemName) {
                fetch("/create-problem", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ 
                        problemName, 
                        chapter: currentChapter,
                        lang: '<%= lang %>'
                    })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.redirectUrl) {
                            window.location.href = data.redirectUrl;
                        } else {
                            alert(data.message);
                            hidePopup();
                        }
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        alert("An error occurred. Please try again.");
                    });
            } else {
                alert('<%= lang === "ru" ? "Пожалуйста, введите корректное название задачи." : "Please enter a valid problem name." %>');
            }
        });
    });
  </script>

  <script>
    // Fade-in animations for action links
    document.addEventListener('DOMContentLoaded', () => {
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }
        });
      }, observerOptions);

      // Animate action links
      document.querySelectorAll('.action-link').forEach((el, index) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(10px)';
        el.style.transition = `opacity 0.5s ease ${index * 0.15}s, transform 0.5s ease ${index * 0.15}s`;
        observer.observe(el);
      });
    });
  </script>

  <!-- Chapter card expand/collapse -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Chapter dots are built on first expand rather than shipped in the HTML. The four
      // states below carry everything a dot needs; href, class and label all derive from
      // the state plus the problem number.
      const LANG = <%- JSON.stringify(lang) %>;
      const STATES = (() => {
        try { return JSON.parse(document.getElementById('gridStates').textContent); }
        catch (_) { return {}; }
      })();
      const DOT = {
        '3': { cls: 'solved-both', label: LANG === 'ru' ? 'Оба языка' : 'Both languages' },
        '2': { cls: 'solved-en',   label: LANG === 'ru' ? 'Только английский' : 'English only' },
        '1': { cls: 'solved-ru',   label: LANG === 'ru' ? 'Только русский' : 'Russian only' },
        '0': { cls: 'unsolved',    label: LANG === 'ru' ? 'Не решено' : 'Unsolved' },
      };
      const PROBLEM_WORD = LANG === 'ru' ? 'Задача ' : 'Problem ';

      function hrefFor(state, problem) {
        if (state === '3') return '/' + LANG + '/' + problem;   // both — stay in this language
        if (state === '2') return '/en/' + problem;             // English only
        if (state === '1') return '/ru/' + problem;             // Russian only
        return '/' + LANG + '/problems?q=' + problem;          // unsolved — its statement and the upload button
      }

      // One character per problem again, this time difficulty: '0' unknown, '1'-'9' the
      // bucket, 'a'-'i' the same nine buckets for a problem Savchenko marked with a ∗.
      const HEAT = (() => {
        const el = document.getElementById('gridDifficulty');
        if (!el) return null;
        try { return JSON.parse(el.textContent); } catch (_) { return null; }
      })();
      const HEAT_WORD = LANG === 'ru' ? 'сложность' : 'difficulty';
      const STAR_WORD = LANG === 'ru' ? 'отмечена ∗ Савченко' : 'marked ∗ by Savchenko';

      function heatFor(section, i) {
        const row = HEAT && HEAT[section];
        const ch = row && row[i];
        if (!ch || ch === '0') return null;
        const starred = ch >= 'a' && ch <= 'i';
        return { bucket: starred ? ch.charCodeAt(0) - 96 : Number(ch), starred };
      }

      function fillSection(container) {
        if (container.dataset.filled) return;
        const section = container.dataset.section;
        const states = STATES[section] || '';
        const frag = document.createDocumentFragment();
        for (let i = 0; i < states.length; i++) {
          const state = states[i];
          const number = String(i + 1);
          const problem = section + '.' + number;
          const meta = DOT[state] || DOT['0'];
          const a = document.createElement('a');
          a.href = hrefFor(state, problem);
          // Difficulty rides as a SECOND class, so the solved-status class keeps working
          // and the two readings never fight: colour carries difficulty in heat mode, the
          // filled/half/hollow shapes keep carrying solved status in both modes.
          const heat = heatFor(section, i);
          a.className = 'problem-dot ' + meta.cls
            + (heat ? ' heat-' + heat.bucket + (heat.starred ? ' heat-starred' : '') : ' heat-none');
          a.title = PROBLEM_WORD + problem + ' · ' + meta.label
            + (heat ? ' · ' + HEAT_WORD + ' ' + heat.bucket + '/9' + (heat.starred ? ', ' + STAR_WORD : '') : '');
          a.textContent = number;
          frag.appendChild(a);
        }
        container.appendChild(frag);
        container.dataset.filled = '1';
      }

      // One chapter open at a time (the owner, 2026-09-20): opening one closes the one
      // that was open, so the grid never shows two chapters' sections stacked.
      function setChapterOpen(card, open) {
        const panel = document.getElementById(card.id + '-panel');
        if (!panel) return;
        if (open) {
          document.querySelectorAll('.chapter-card.open').forEach((other) => {
            if (other !== card) setChapterOpen(other, false);
          });
          panel.querySelectorAll('.problem-dots').forEach(fillSection);
        }
        card.classList.toggle('open', open);
        panel.classList.toggle('open', open);
        const header = card.querySelector('.chapter-card-header');
        if (header) header.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      document.querySelectorAll('.chapter-card-header').forEach(header => {
        const card = header.closest('.chapter-card');
        const toggle = () => setChapterOpen(card, !card.classList.contains('open'));
        header.addEventListener('click', toggle);
        header.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
        });
      });

      // Deep links like /ru/#2.1 must still land on the right section, so open the
      // chapter that contains it and fill it before scrolling.
      function openFromHash() {
        const target = decodeURIComponent(location.hash.replace(/^#/, ''));
        if (!target) return;
        const el = document.getElementById(target);
        if (!el) return;
        const panel = el.closest('.chapter-content');
        const card = panel ? document.getElementById(panel.id.replace(/-panel$/, '')) : null;
        if (card) setChapterOpen(card, true);
        el.scrollIntoView({ block: 'start' });
      }
      openFromHash();
      window.addEventListener('hashchange', openFromHash);

      // Blog widget (main column cards)
      fetch('/blog/api/posts?limit=3')
        .then(r => r.json())
        .then(posts => {
          if (!posts.length) return;
          const widget = document.getElementById('blogWidgetMain');
          const list = document.getElementById('blogWidgetMainList');
          const lang = '<%= lang %>';
          let html = '';
          posts.forEach(p => {
            const date = new Date(p.published_at).toLocaleDateString(
              lang === 'ru' ? 'ru-RU' : 'en-US',
              { month: 'short', day: 'numeric', year: 'numeric' }
            );
            const excerpt = (p.excerpt || '').length > 120 ? p.excerpt.slice(0, 120) + '...' : (p.excerpt || '');
            const author = p.author_username || '';
            html += '<a href="/blog/' + p.slug + '" style="display: block; padding: var(--ss-space-4); background: var(--ss-surface-alt); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg); text-decoration: none; transition: border-color 0.15s;">' +
              '<div style="font-weight: var(--ss-fw-strong); color: var(--ss-text); font-size: var(--ss-fs-14); margin-bottom: var(--ss-space-1); line-height: 1.4;">' + (p.title_html || p.title) + '</div>' +
              '<div style="color: var(--ss-text-secondary); font-size: var(--ss-fs-13); line-height: 1.5; margin-bottom: var(--ss-space-2);">' + (p.excerpt_html || excerpt) + '</div>' +
              '<div style="color: var(--ss-text-secondary); font-size: var(--ss-fs-12);">' + (author ? author + ' · ' : '') + date + '</div>' +
              '</a>';
          });
          list.innerHTML = html;
          widget.style.display = 'block';
        })
        .catch(() => {});

      // Challenge widget countdown
      const cwEl = document.getElementById('homeWidgetCountdown');
      if (cwEl) {
        const rawEnd = (cwEl.dataset.end || '').trim();
        let cwEnd = null;
        if (/^\d{4}-\d{2}-\d{2}$/.test(rawEnd)) {
          const parts = rawEnd.split('-').map(Number);
          cwEnd = new Date(parts[0], parts[1] - 1, parts[2], 23, 59, 59);
        } else if (rawEnd) {
          cwEnd = new Date(rawEnd);
        }
        if (!cwEnd || Number.isNaN(cwEnd.getTime())) {
          cwEl.textContent = '—';
          return;
        }
        function cwUpdate() {
          const diff = cwEnd - new Date();
          if (diff <= 0) { cwEl.textContent = 'Expired'; return; }
          const d = Math.floor(diff / 86400000);
          const h = Math.floor((diff % 86400000) / 3600000);
          cwEl.textContent = d + 'd ' + h + 'h left';
        }
        cwUpdate();
        setInterval(cwUpdate, 60000);
      }
    });
  </script>
