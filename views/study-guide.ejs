<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <%- include('default/head_en.ejs') %>
    <%- include('default/main_site_header_head') %>
    <title><%= titleText(__('studyGuide.title')) %></title>
    <script src="/js/analytics.js"></script>
</head>

<body>
    <%- include('default/header.ejs') %>
    <main class="ss-container ss-container--text ss-page ss-doc">
        <nav class="ss-doc-bar">
            <a href="../<%= lang %>#description" class="ss-back"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg><%= __('studyGuide.backToMain') %></a>
        </nav>
        <header class="ss-page-head">
            <h1 class="ss-title"><%= __('studyGuide.title') %></h1>
        </header>

        <%# The walkthrough. Loaded on click, not on page load, so the guide itself is
            never held up by (or broken behind a filter blocking) youtube.com. %>
        <%- include('default/video_embed', {
            videoId: 'd-x7Lk-mfTs',
            videoPoster: '/img/yt_preview.webp',
            videoTitle: lang === 'ru' ? 'Как пользоваться сайтом' : 'How to use the site'
        }) %>

        <div class="ss-prose">
            <h2><%= __('studyGuide.eligibility.title') %></h2>
            <p><%= __('studyGuide.eligibility.content') %></p>

            <h2><%= __('studyGuide.howToContribute.title') %></h2>
            <p><%= __('studyGuide.howToContribute.intro') %></p>
            <ol>
                <li>
                    <strong><%= __('studyGuide.howToContribute.methods.edit.title') %>:</strong>
                    <%= __('studyGuide.howToContribute.methods.edit.beforeButton') %>
                    <span class="ss-inline-control"><img src="/img/edit.svg" alt="" width="14" height="14"><%= __('studyGuide.howToContribute.methods.edit.editButton') %></span>
                    <%= __('studyGuide.howToContribute.methods.edit.beforeUpload') %>
                    <span class="ss-inline-control"><%= __('studyGuide.howToContribute.methods.edit.uploadButton') %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"></path></svg></span>
                    <%= __('studyGuide.howToContribute.methods.edit.afterButton') %>
                </li>
                <li>
                    <strong><%= __('studyGuide.howToContribute.methods.email.title') %>:</strong>
                    <%= __('studyGuide.howToContribute.methods.email.content') %>
                    <a href="mailto:alex@savchenkosolutions.com" target="_blank">alex@savchenkosolutions.com</a>.
                </li>
            </ol>
            <p><%= __('studyGuide.howToContribute.valueStatement') %></p>

            <h2><%= __('studyGuide.registration.title') %></h2>
            <p><%= __('studyGuide.registration.content') %></p>
            <ul>
                <% __('studyGuide.registration.benefits').forEach(function(benefit) { %>
                <li><%= benefit %></li>
                <% }); %>
            </ul>
            <p><%= __('studyGuide.registration.conclusion') %></p>
        </div>

        <section class="ss-card ss-card--alt ss-doc-aside">
            <h2><%= lang === 'ru' ? 'Учебные пути' : 'Study Paths' %></h2>
            <p><%= lang === 'ru'
              ? 'Не знаете, с чего начать? Выберите один из наших тщательно подобранных учебных путей, которые проведут вас от простого к сложному.'
              : 'Not sure where to start? Follow one of our curated study paths that guide you from easy to hard problems.' %></p>
            <a href="/paths" class="btn btn-dark"><%= lang === 'ru' ? 'Смотреть учебные пути' : 'Browse Study Paths' %></a>
        </section>
    </main>

    <%- include('default/modern_footer') %>
    <%- include('default/main_site_footer_scripts') %>
    <script defer src="<%= (typeof asset === 'function') ? asset('/js/video-embed.js') : '/js/video-embed.js' %>"></script>
</body>

</html>
