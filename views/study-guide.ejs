<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <%- include('default/head_en.ejs') %>
    <%- include('default/main_site_header_head') %>
        <title>
            <%= titleText(__('studyGuide.title')) %>
        </title>
        <style>
            /* css-latex/style.css sets body max-width: 80ch — breaks full-width .hero-section */
            body.study-guide-page {
                font-family: var(--ss-font-ui);
                line-height: 1.6;
                color: var(--ss-text);
                max-width: none !important;
                margin: 0 !important;
                padding: 0 !important;
                background-color: var(--ss-surface);
            }

            .study-guide-inner {
                max-width: 960px;
                margin: 0 auto;
                padding: 0 var(--ss-space-5) var(--ss-space-8);
            }

            .study-guide-inner .back-link {
                display: inline-flex;
                align-items: center;
                gap: var(--ss-space-1);
                text-decoration: none;
                color: var(--ss-link);
                font-size: 1em;
                font-weight: var(--ss-fw-regular);
                padding: var(--ss-space-2) var(--ss-space-4);
                background: var(--ss-surface-alt);
                border-radius: var(--ss-radius-lg);
                border: 1px solid var(--ss-rule);
                transition: all 0.3s ease;
            }

            .study-guide-inner .back-link:hover {
                background: #e2e6ea;
                border-color: var(--ss-link);
                color: var(--ss-link);
            }

            .study-guide-inner .submit-button {
                font-family: var(--ss-font-ui);
                width: 100%;
                padding: var(--ss-space-3) var(--ss-space-5);
                background-color: var(--ss-link);
                color: var(--ss-on-navy);
                border: none;
                border-radius: var(--ss-radius-lg);
                font-size: var(--ss-fs-16);
                font-weight: var(--ss-fw-strong);
                cursor: pointer;
                box-shadow: var(--ss-shadow);
                transition: background-color 0.3s ease;
            }

            .study-guide-inner .submit-button:hover {
                background-color: #0056b3;
            }

            .study-guide-inner .video-container {
                position: relative;
                padding-bottom: 56.25%;
                height: 0;
                overflow: hidden;
                max-width: 100%;
                background: #000;
                margin: var(--ss-space-5) 0;
            }

            .study-guide-inner .video-container iframe {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
            }

            .study-guide-inner h1,
            .study-guide-inner h3 {
                font-family: var(--ss-font-ui); 
            }

            @media screen and (max-width: 768px) {
                .study-guide-inner h1 {
                    font-size: var(--ss-fs-20) !important;
                    margin: var(--ss-space-4) 0;
                    line-height: 1.2;
                }

                .study-guide-inner h3 {
                    font-size: var(--ss-fs-18);
                }

                .study-guide-inner h3 strong {
                    font-size: var(--ss-fs-18);
                }
            }

            /* Scoped so main_page .edit-button / .upload-icon in .hero-section are not overridden */
            .study-guide-inner .edit-button {
                display: flex;
                align-items: center;
                gap: var(--ss-space-2);
                padding: var(--ss-space-2) var(--ss-space-3);
                font-size: var(--ss-fs-14);
                background: var(--ss-surface);
                border: 1px solid var(--ss-rule);
                border-radius: var(--ss-radius);
                transition: all 0.2s ease;
                cursor: pointer;
            }

            .study-guide-inner .edit-button:hover {
                color: hsla(0, 100%, 33%, 1);
                border-color: hsla(0, 100%, 33%, 0.4);
                background: hsla(0, 100%, 33%, 0.01);
            }

            .study-guide-inner .external-link-icon,
            .study-guide-inner .upload-icon {
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            /* Reset css-latex serif/justify leaking into header and footer */
            body.study-guide-page > header,
            body.study-guide-page > header *,
            body.study-guide-page > footer,
            body.study-guide-page > footer * {
                font-family: var(--ss-font-ui);
                text-align: left;
                hyphens: none;
            }
        </style>
    <script src="/js/analytics.js"></script>
</head>

<body class="study-guide-page">
    <%- include('default/header.ejs') %>
    <div class="study-guide-inner">
        <div style="margin-top: var(--ss-space-7);">
            <a href="../<%= lang %>#description" class="back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke="#36c"
                    fill="none">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"
                        d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <%= __('studyGuide.backToMain') %>
            </a>
        </div>

        <h1 style="text-align: center; font-size: var(--ss-fs-28);">
            <strong>
                <%= __('studyGuide.title') %>
            </strong>
        </h1>
        
        <%# The walkthrough. Loaded on click, not on page load, so the guide itself is
            never held up by (or broken behind a filter blocking) youtube.com. %>
        <div style="margin: var(--ss-space-5) 0;">
            <%- include('default/video_embed', {
                videoId: 'd-x7Lk-mfTs',
                videoPoster: '/img/yt_preview.webp',
                videoTitle: lang === 'ru' ? 'Как пользоваться сайтом' : 'How to use the site'
            }) %>
        </div>
        
        <h3 style="margin-top: var(--ss-space-7); display: flex; align-items: center;">
            <strong style="display: flex; align-items: center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke="#36c"
                    fill="none" style="margin-right: var(--ss-space-1);">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <%= __('studyGuide.eligibility.title') %>
            </strong>
        </h3>
        <p>
            <%= __('studyGuide.eligibility.content') %>
        </p>

        <h3>
            <strong style="display: flex; align-items: center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke="#36c"
                    fill="none" style="margin-right: var(--ss-space-1);">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
                <%= __('studyGuide.howToContribute.title') %>
            </strong>
        </h3>
        <p>
            <%= __('studyGuide.howToContribute.intro') %>
        </p>
        <ol>
            <li><strong>
                    <%= __('studyGuide.howToContribute.methods.edit.title') %>:
                </strong>
                <%= __('studyGuide.howToContribute.methods.edit.beforeButton') %>
                    <a style="text-decoration: none; display: inline-block;">
                        <button type="button" class="submit-button"
                            style="margin: 0 0px; display: inline-flex; align-items: center; padding: var(--ss-space-1) var(--ss-space-2); gap: var(--ss-space-1); min-width: unset; transition: background-color 0.2s">
                            <img src="/img/edit.svg" alt="Edit" width="16" height="16">
                            <span style="font-size: var(--ss-fs-14);">
                                <%= __('studyGuide.howToContribute.methods.edit.editButton') %>
                            </span>
                        </button>
                    </a>
                    <%= __('studyGuide.howToContribute.methods.edit.beforeUpload') %>
                        <a class="edit-button"
                            style="display: inline-flex; margin: 0 var(--ss-space-1); text-decoration: none !important; padding: 2px var(--ss-space-2);">
                            <span class="upload-text" style="color: hsl(0, 100%, 33%); font-size: var(--ss-fs-14);">
                                <%= __('studyGuide.howToContribute.methods.edit.uploadButton') %>
                            </span>
                            <svg class="upload-icon" viewBox="0 0 24 24" width="14" height="14"
                                style="stroke: hsl(0, 100%, 33%);">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"></path>
                            </svg>
                        </a>
                        <%= __('studyGuide.howToContribute.methods.edit.afterButton') %>
            </li>
            <li><strong>
                    <%= __('studyGuide.howToContribute.methods.email.title') %>:
                </strong>
                <%= __('studyGuide.howToContribute.methods.email.content') %>
                    <a href="mailto:alex@savchenkosolutions.com" target="_blank">alex@savchenkosolutions.com</a>.
            </li>
        </ol>

        <p>
            <%= __('studyGuide.howToContribute.valueStatement') %>
        </p>

        <h3>
            <strong style="display: flex; align-items: center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke="#36c"
                    fill="none" style="margin-right: var(--ss-space-1);">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <%= __('studyGuide.registration.title') %>
            </strong>
        </h3>
        <p>
            <%= __('studyGuide.registration.content') %>
        </p>
        <ul>
            <% __('studyGuide.registration.benefits').forEach(function(benefit) { %>
                <li>
                    <%= benefit %>
                </li>
                <% }); %>
        </ul>
        <p>
            <%= __('studyGuide.registration.conclusion') %>
        </p>

        <div style="margin-top: var(--ss-space-7); padding: var(--ss-space-6); background: var(--ss-surface-alt); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg);">
          <h3 style="font-size: var(--ss-fs-18); font-weight: var(--ss-fw-strong); margin: 0 0 var(--ss-space-2) 0;">
            <%= lang === 'ru' ? 'Учебные пути' : 'Study Paths' %>
          </h3>
          <p style="font-size: var(--ss-fs-14); color: var(--ss-text-secondary); margin: 0 0 var(--ss-space-4) 0;">
            <%= lang === 'ru'
              ? 'Не знаете, с чего начать? Выберите один из наших тщательно подобранных учебных путей, которые проведут вас от простого к сложному.'
              : 'Not sure where to start? Follow one of our curated study paths that guide you from easy to hard problems.' %>
          </p>
          <a href="/paths" style="display: inline-block; background: var(--ss-navy); color: var(--ss-on-navy); padding: var(--ss-space-2) var(--ss-space-5); border-radius: var(--ss-radius); font-size: var(--ss-fs-14); font-weight: var(--ss-fw-regular); text-decoration: none;">
            <%= lang === 'ru' ? 'Смотреть учебные пути' : 'Browse Study Paths' %>
          </a>
        </div>

    </div>

    <%- include('default/modern_footer') %>
    <%- include('default/main_site_footer_scripts') %>
    <script defer src="<%= (typeof asset === 'function') ? asset('/js/video-embed.js') : '/js/video-embed.js' %>"></script>
</body>

</html>