<%#
  Why adding a solution waits on a birth-year turn (lib/founderYear.js), on /upload.
  `founderYear` is founderYearFor(...) or null.
%><% if (typeof founderYear !== 'undefined' && founderYear) { %>
<div id="founder-year-notice" class="ss-alert ss-alert--info mb-4" role="status">
  <span><strong><%= founderYear.copy.heading %>.</strong> <% founderYear.copy.body.forEach(function (part) { %><% if (typeof part === 'string') { %><%= part %><% } else { %><a href="<%= part.href %>"><%= part.text %></a><% } %><% }); %></span>
</div>
<% } %>
