<%#
  site_styles — the only place that emits the site's stylesheets. Every full page includes it
  once in <head>, before its own <style>, so every page gets the same fonts, tokens and
  components (tests/site-styles.test.js):

    include('default/site_styles', { ssStyles: { math: true, prose: true, icons: 'fa6' } })
    (from a subfolder: include('../default/site_styles', …), with the raw-output tag)

  ssStyles (all optional):
    bootstrap   false only for pages whose own .card/.btn would collide with Bootstrap 5
    math        true on pages with server-rendered formulas → /css/mathjax.css (content-versioned)
                and js/math-select.js (a selected formula is painted as selected text is)
    prose       true when SS Text is in the first screen → preload its latin (+cyrillic) subsets
    icons       'fa6' | 'fa6-subset' | 'fa4' | 'bi', or an array of them. 'fa6-subset' is the
                twenty solid glyphs the solution page and the header use (3 KB of font against
                150 KB; scripts/build-fa-subset.py)
    codemirror  true → CodeMirror's stylesheet
    stix        true → STIX Two Math for the editor's symbol palette

  Order is the cascade: vendor stylesheets first, then bundle.css, so the site's tokens win over
  Bootstrap's and CodeMirror's defaults at equal specificity; the maths stylesheet last.
  Local helpers come from app.locals: asset(), siteFonts (lib/siteFonts.json), mathCssVersion.
%><%
  const _ss = (typeof ssStyles !== 'undefined' && ssStyles) ? ssStyles : {};
  const _asset = (typeof asset === 'function') ? asset : function (p) { return p; };
  const _lang = (typeof lang !== 'undefined' && lang) ? lang : ((typeof pageLang !== 'undefined' && pageLang) ? pageLang : 'en');
  const _fonts = (typeof siteFonts !== 'undefined' && siteFonts && siteFonts.preload) ? siteFonts.preload : null;
  let _preload = [];
  if (_fonts) {
    _preload = (_lang === 'ru' ? _fonts.ru : _fonts.en) || [];
    if (_ss.prose) _preload = _preload.concat((_lang === 'ru' ? _fonts.proseRu : _fonts.proseEn) || []);
  }
  const _icons = [].concat(_ss.icons || []);
%><% _preload.forEach(function (href) { %>
<link rel="preload" href="<%= href %>" as="font" type="font/woff2" crossorigin>
<% }); %><% if (_ss.bootstrap !== false) { %>
<link rel="stylesheet" href="/css/vendor/bootstrap.min.css">
<% } %><% if (_ss.codemirror) { %>
<link rel="stylesheet" href="/css/vendor/codemirror/codemirror.min.css">
<%# CodeMirror measures character widths once; when SS Mono arrives after that, the cursor sits
    between letters. Re-measure every editor on the page whenever a font finishes loading. %>
<script>if(document.fonts&&document.fonts.addEventListener){document.fonts.addEventListener('loadingdone',function(){document.querySelectorAll('.CodeMirror').forEach(function(el){if(el.CodeMirror)el.CodeMirror.refresh();});});}</script>
<% } %><% if (_ss.stix) { %>
<link rel="stylesheet" href="<%= _asset('/css/vendor/fonts/stix-two-math.css') %>">
<% } %><% if (_icons.indexOf('fa6') !== -1) { %>
<link rel="stylesheet" href="/css/vendor/fontawesome6/css/all.min.css">
<% } else if (_icons.indexOf('fa6-subset') !== -1) { %>
<link rel="stylesheet" href="<%= _asset('/css/vendor/fontawesome6/css/subset.css') %>">
<% } %><% if (_icons.indexOf('fa4') !== -1) { %>
<link rel="stylesheet" href="/css/vendor/fontawesome4/css/font-awesome.min.css">
<% } %><% if (_icons.indexOf('bi') !== -1) { %>
<link rel="stylesheet" href="/css/vendor/bootstrap-icons/bootstrap-icons.min.css">
<% } %>
<link rel="stylesheet" href="<%= _asset('/css/bundle.css') %>">
<% if (_ss.math) { %>
<link rel="stylesheet" href="/css/mathjax.css?v=<%= (typeof mathCssVersion !== 'undefined' && mathCssVersion) ? mathCssVersion : '1' %>">
<%# Paints a formula that is inside the selection; the SVG is not highlighted by itself. %>
<script src="<%= _asset('/js/math-select.js') %>" defer></script>
<% } %>
