<script>
(function () {
  const searchInput = document.getElementById("searchInput");
  const searchResults = document.getElementById("searchResults");
  const searchResultsList = document.querySelector("#searchResults ul");
  const clearButton = document.getElementById("clearSearch");
  if (!searchInput || !searchResults || !searchResultsList) return;
  if (searchInput.dataset.ssSearchBound) return;
  searchInput.dataset.ssSearchBound = "1";
  // On /<lang>/problems the box is the finder's own query; js/problems-finder.js binds it.
  if (searchInput.hasAttribute("data-finder")) return;

  let lastSearchResults = "";
  let activeIndex = -1;
  let currentResults = [];

  function escSnippet(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function highlightSnippet(text, query) {
    if (!text || !query) return escSnippet(text);
    const escaped = escSnippet(text);
    const terms = query.trim().split(/\s+/).filter(t => t.length > 1);
    if (!terms.length) return escaped;
    const pattern = terms.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
    return escaped.replace(new RegExp('(' + pattern + ')', 'gi'), '<mark class="ss-search-mark">$1</mark>');
  }

  document.addEventListener("click", function (event) {
    if (!searchInput.contains(event.target) && !searchResults.contains(event.target)) {
      searchResults.style.display = "none";
      activeIndex = -1;
    }
  });

  searchInput.addEventListener("focus", () => {
    if (searchInput.value.trim().length > 0 && lastSearchResults) {
      searchResultsList.innerHTML = lastSearchResults;
      searchResults.style.display = "block";
    }
  });

  function updateActiveItem() {
    const items = searchResultsList.querySelectorAll("li.ss-search-item");
    items.forEach((item, i) => {
      item.classList.toggle("is-active", i === activeIndex);
      if (i === activeIndex) item.setAttribute("aria-selected", "true");
      else item.removeAttribute("aria-selected");
    });
  }

  searchInput.addEventListener("keydown", function (e) {
    const items = searchResultsList.querySelectorAll("li.ss-search-item");
    if (!items.length) return;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      updateActiveItem();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, -1);
      updateActiveItem();
    } else if (e.key === "Enter") {
      e.preventDefault();
      if (activeIndex >= 0 && activeIndex < currentResults.length) {
        window.location.href = currentResults[activeIndex].relativePath;
      } else {
        const query = searchInput.value.trim();
        if (query) {
          const currentLang = "<%= typeof lang !== 'undefined' ? lang : 'en' %>";
          // /find opens a problem number in whichever language has it, and hands anything else
          // to the problem finder's search (/<lang>/problems?q=).
          window.location.href = `/find?search=${encodeURIComponent(query)}&lang=${encodeURIComponent(currentLang)}`;
        }
      }
    } else if (e.key === "Escape") {
      searchResults.style.display = "none";
      activeIndex = -1;
    }
  });

  searchInput.addEventListener("input", async function () {
    const query = searchInput.value.trim();
    const currentLang = "<%= typeof lang !== 'undefined' ? lang : 'en' %>";
    activeIndex = -1;

    if (clearButton) clearButton.style.display = this.value ? "block" : "none";

    if (query.length === 0) {
      searchResults.style.display = "none";
      searchResultsList.innerHTML = "";
      lastSearchResults = "";
      currentResults = [];
      return;
    }

    try {
      const response = await fetch(
        `/search?q=${encodeURIComponent(query)}&lang=${encodeURIComponent(currentLang)}`
      );
      const data = await response.json();

      if (data.results.length > 0) {
        const limitedResults = data.results.slice(0, 10);
        currentResults = limitedResults;
        const resultsHTML = limitedResults
          .map(
            (result, index) => `
                    <li id="ss-search-item-${index}" role="option" class="ss-search-item">
                        <a href="${result.relativePath}" class="ss-search-link">
                            <svg class="ss-search-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                            <span class="ss-search-main">
                                <span class="ss-search-title"><strong>${result.name}</strong>${result.section ? ' &mdash; ' + result.section : ''}</span>
                                ${result.snippet ? '<span class="ss-search-snippet">' + highlightSnippet(result.snippet, query) + '</span>' : ''}
                                <span class="ss-search-meta">${result.chapter ? result.chapterNum + '. ' + result.chapter : ''}<span class="ss-search-lang">${result.lang.toUpperCase()}</span></span>
                            </span>
                        </a>
                    </li>
                `
          )
          .join("");

        const fullResultsHTML = `
            <li class="ss-search-more">
                <a href="/${encodeURIComponent(currentLang)}/problems?q=${encodeURIComponent(query)}"><%= typeof lang !== 'undefined' && lang === 'ru' ? 'Enter — все результаты' : 'Press Enter for full results' %></a>
            </li>
        `;

        searchResultsList.innerHTML = resultsHTML + fullResultsHTML;
        lastSearchResults = resultsHTML + fullResultsHTML;
        searchResults.style.display = "block";
      } else {
        currentResults = [];
        const noResultsHTML = `
                    <li class="ss-search-empty">
                        <p><%= typeof lang !== 'undefined' && lang === 'ru' ? 'Ничего не найдено.' : 'No results found.' %></p>
                        <div class="ss-search-empty-actions">
                            <a href="/<%= typeof lang !== 'undefined' ? lang : 'en' %>/upload" class="btn btn-sm btn-dark" data-chapter="1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                <%= __('menu.upload') %>
                            </a>
                            <a href="/${encodeURIComponent(currentLang)}/problems?q=${encodeURIComponent(query)}" class="btn btn-sm btn-outline-dark">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                <%= __('menu.advancedSearch') %>
                            </a>
                        </div>
                    </li>
                `;
        searchResultsList.innerHTML = noResultsHTML;
        lastSearchResults = noResultsHTML;
        searchResults.style.display = "block";
      }
    } catch (error) {
      console.error("Error fetching search results:", error);
    }
  });

  if (clearButton) {
    clearButton.addEventListener("click", function () {
      searchInput.value = "";
      searchResults.style.display = "none";
      searchResultsList.innerHTML = "";
      currentResults = [];
      activeIndex = -1;
      this.style.display = "none";
      searchInput.focus();
    });
  }
})();
</script>
