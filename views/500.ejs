<!DOCTYPE html>
<% const pageLang = typeof lang !== 'undefined' ? lang : 'en'; %>
<html lang="<%= pageLang %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <title><%= docTitle(pageLang === 'ru' ? 'Ошибка сервера' : 'Server error', 'Savchenko Solutions') %></title>
  <%- include('default/site_styles') %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
" />
</head>
<body class="d-flex flex-column min-vh-100">
  <!-- Minimal self-contained header so the error page never depends on request/session state -->
  <header style="border-bottom: 1px solid var(--ss-rule); padding: var(--ss-space-4) var(--ss-space-6);">
    <a href="/<%= pageLang %>/" style="display: inline-flex; align-items: center; gap: var(--ss-space-3); text-decoration: none; color: var(--ss-navy);">
      <img src="/img/logo.svg" alt="" style="height: 32px;" />
      <span style="font-weight: var(--ss-fw-strong); font-size: var(--ss-fs-18);">Savchenko Solutions</span>
    </a>
  </header>

  <main class="flex-grow-1 d-flex align-items-center">
    <div style="max-width: 480px; margin: 80px auto; text-align: center; padding: 0 var(--ss-space-5);">
      <h1 style="font-size: var(--ss-fs-40); font-weight: var(--ss-fw-strong); color: var(--ss-navy); margin-bottom: var(--ss-space-2);">500</h1>
      <p style="font-size: var(--ss-fs-18); color: var(--ss-text); margin-bottom: var(--ss-space-6);">
        <%= pageLang === 'ru'
            ? 'Что-то пошло не так на нашей стороне. Мы уже разбираемся.'
            : "Something went wrong on our end — we're looking into it." %>
      </p>
      <p style="font-size: var(--ss-fs-14); color: var(--ss-text-secondary);">
        <a href="/<%= pageLang %>/" style="color: var(--ss-link);"><%= pageLang === 'ru' ? 'На главную' : 'Go to homepage' %></a>
      </p>
    </div>
  </main>

  <%- include('default/modern_footer', { lang: pageLang }) %>
</body>
</html>
