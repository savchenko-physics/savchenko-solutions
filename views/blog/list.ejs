<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= docTitle(lang === 'ru' ? 'Блог' : 'Blog', 'Savchenko Solutions') %></title>
    <meta name="description" content="<%= lang === 'ru' ? 'Блог Savchenko Solutions: руководства, разборы задач, новости платформы.' : 'Savchenko Solutions blog: study guides, problem deep dives, and platform updates.' %>" />
    <link rel="canonical" href="https://savchenkosolutions.com/blog<%= activeTag ? '/tag/' + activeTag : '' %>" />

    <%- include('../default/site_styles', { ssStyles: { icons: 'fa6' } }) %>
    <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
" />
" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <script src="/js/vendor/bootstrap.bundle.min.js"></script>

    <style>
        .blog-container {
            max-width: 820px;
            margin: 0 auto;
            padding: var(--ss-space-7) var(--ss-space-4);
        }
        .blog-header {
            margin-bottom: var(--ss-space-7);
        }
        .blog-header h1 {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-28);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
            margin: 0;
        }
        .tag-filters {
            display: flex;
            flex-wrap: wrap;
            gap: var(--ss-space-2);
            margin-top: var(--ss-space-4);
        }
        .tag-pill {
            display: inline-block;
            padding: var(--ss-space-1) var(--ss-space-3);
            border-radius: var(--ss-radius);
            font-size: var(--ss-fs-13);
            font-weight: var(--ss-fw-strong);
            text-decoration: none;
            border: 1px solid var(--ss-rule);
            color: var(--ss-text-secondary);
            background: var(--ss-surface-alt);
            transition: all 0.15s;
        }
        /* Need `a.tag-pill` (not bare `.tag-pill`) to outrank the global
           `a:hover:not(.btn)` rule in design-system.css. */
        a.tag-pill:hover,
        a.tag-pill:focus {
            background: var(--ss-navy);
            color: var(--ss-on-navy);
            border-color: var(--ss-navy);
        }
        .tag-pill--active {
            background: var(--ss-navy);
            color: var(--ss-on-navy);
            border-color: var(--ss-navy);
        }
        .tag-pill--active,
        .tag-pill--active:visited,
        .tag-pill--active:hover,
        .tag-pill--active:focus,
        .tag-pill--active:active {
            color: var(--ss-on-navy) !important;
            text-decoration: none;
        }
        .blog-post-card {
            padding: var(--ss-space-6) 0;
            border-bottom: 1px solid var(--ss-rule);
        }
        .blog-post-card:first-child {
            padding-top: 0;
        }
        .blog-post-card:last-child {
            border-bottom: none;
        }
        .blog-post-title {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-20);
            font-weight: var(--ss-fw-strong);
            margin: 0 0 var(--ss-space-2) 0;
        }
        .blog-post-title a {
            color: var(--ss-text);
            text-decoration: none;
        }
        .blog-post-title a:hover {
            color: var(--ss-link);
        }
        .blog-post-excerpt {
            color: var(--ss-text-secondary);
            font-size: var(--ss-fs-16);
            line-height: 1.6;
            margin-bottom: var(--ss-space-3);
        }
        .blog-post-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--ss-space-3);
            font-size: var(--ss-fs-13);
            color: var(--ss-text-secondary);
        }
        .blog-post-meta a {
            color: var(--ss-link);
            text-decoration: none;
        }
        .blog-post-meta a:hover {
            text-decoration: underline;
        }
        .blog-post-tags {
            display: flex;
            gap: var(--ss-space-1);
            flex-wrap: wrap;
            margin-top: var(--ss-space-2);
        }
        .blog-post-tags .tag-pill {
            font-size: var(--ss-fs-12);
            padding: 0.15rem var(--ss-space-2);
        }
        .blog-view-count {
            color: var(--ss-text-secondary);
        }
        .blog-pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--ss-space-6) 0 0;
            border-top: 1px solid var(--ss-rule);
            margin-top: var(--ss-space-4);
        }
        .blog-pagination a {
            display: inline-flex;
            align-items: center;
            gap: var(--ss-space-1);
            padding: var(--ss-space-2) var(--ss-space-4);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius);
            color: var(--ss-text);
            text-decoration: none;
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-regular);
            transition: all 0.15s;
        }
        .blog-pagination a:hover {
            background: var(--ss-surface-alt);
        }
        .blog-pagination-disabled {
            visibility: hidden;
        }
        .blog-empty {
            text-align: center;
            padding: var(--ss-space-9) var(--ss-space-4);
            color: var(--ss-text-secondary);
        }
        @media (max-width: 768px) {
            .blog-container { padding: var(--ss-space-4) var(--ss-space-3); }
            .blog-header h1 { font-size: var(--ss-fs-24); }
            .blog-post-title { font-size: var(--ss-fs-18); }
        }
    </style>
</head>
<body>
    <%
    const tagTranslations = {
        'announcement': 'объявление',
        'beginners': 'для начинающих',
        'community': 'сообщество',
        'guide': 'руководство',
        'history': 'история',
        'meta': 'мета',
        'study-tips': 'советы',
        'physics': 'физика',
        'olympiad': 'олимпиада',
        'solutions': 'решения',
        'tutorial': 'туториал',
        'news': 'новости',
        'update': 'обновление',
        'education': 'образование',
        'mechanics': 'механика',
        'thermodynamics': 'термодинамика',
        'electrodynamics': 'электродинамика',
        'optics': 'оптика',
    };
    function tagLabel(tag) {
        if (lang === 'ru' && tagTranslations[tag]) return tagTranslations[tag];
        return tag;
    }
    %>
    <%- include('../default/main_site_header', { showViewsButton: false }) %>

    <div class="blog-container">
        <div class="blog-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--ss-space-3);">
            <h1><%= lang === 'ru' ? 'Блог' : 'Blog' %></h1>
            <% if (canPost) { %>
            <a href="/blog/new" style="display: inline-flex; align-items: center; gap: var(--ss-space-2); background: var(--ss-navy); color: var(--ss-on-navy); border: none; border-radius: var(--ss-radius); padding: var(--ss-space-2) var(--ss-space-5); font-size: var(--ss-fs-14); font-weight: var(--ss-fw-regular); text-decoration: none; transition: background 0.15s;">
                <i class="fas fa-plus" style="font-size: var(--ss-fs-12);"></i> <%= lang === 'ru' ? 'Новая запись' : 'New Post' %>
            </a>
            <% } %>
            <% if (allTags.length > 0) { %>
            <div class="tag-filters">
                <a href="/blog" class="tag-pill <%= !activeTag ? 'tag-pill--active' : '' %>"><%= lang === 'ru' ? 'Все' : 'All' %></a>
                <% allTags.forEach(tag => { %>
                    <a href="/blog/tag/<%= tag %>" class="tag-pill <%= activeTag === tag ? 'tag-pill--active' : '' %>"><%= tagLabel(tag) %></a>
                <% }); %>
            </div>
            <% } %>
        </div>

        <% if (posts.length === 0) { %>
        <div class="blog-empty">
            <p><%= lang === 'ru' ? 'Пока нет записей.' : 'No posts yet.' %></p>
        </div>
        <% } else { %>
        <div class="blog-post-list">
            <% posts.forEach(post => { %>
            <div class="blog-post-card">
                <h2 class="blog-post-title">
                    <a href="/blog/<%= post.slug %>"><%= post.title %></a>
                </h2>
                <p class="blog-post-excerpt"><%= post.excerpt %></p>
                <div class="blog-post-meta">
                    <span>
                        <a href="/user/<%= post.author_username %>"><%= post.author_username %></a>
                    </span>
                    <span><%= new Date(post.published_at).toLocaleDateString(lang === 'ru' ? 'ru-RU' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    <span class="blog-view-count"><i class="fas fa-eye"></i> <%= post.view_count %></span>
                </div>
                <% if (post.tags && post.tags.length > 0) { %>
                <div class="blog-post-tags">
                    <% post.tags.forEach(tag => { %>
                        <a href="/blog/tag/<%= tag %>" class="tag-pill"><%= tagLabel(tag) %></a>
                    <% }); %>
                </div>
                <% } %>
            </div>
            <% }); %>
        </div>

        <% if (totalPages > 1) { %>
        <div class="blog-pagination">
            <% if (page > 1) { %>
                <a href="/blog<%= activeTag ? '/tag/' + activeTag : '' %>?page=<%= page - 1 %>">
                    &larr; <%= lang === 'ru' ? 'Назад' : 'Previous' %>
                </a>
            <% } else { %>
                <span class="blog-pagination-disabled"></span>
            <% } %>

            <span style="font-size: var(--ss-fs-14); color: var(--ss-text-secondary);"><%= page %> / <%= totalPages %></span>

            <% if (page < totalPages) { %>
                <a href="/blog<%= activeTag ? '/tag/' + activeTag : '' %>?page=<%= page + 1 %>">
                    <%= lang === 'ru' ? 'Далее' : 'Next' %>
                </a>
            <% } else { %>
                <span class="blog-pagination-disabled"></span>
            <% } %>
        </div>
        <% } %>
        <% } %>
    </div>

    <%- include('../default/modern_footer') %>
</body>
</html>
