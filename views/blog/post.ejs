<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= docTitle(post.title, 'Savchenko Solutions Blog') %></title>
    <meta name="description" content="<%= post.excerpt %>" />
    <link rel="canonical" href="https://savchenkosolutions.com/<%= lang %>/blog/<%= post.slug %>" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content="<%= titleText(post.title) %>" />
    <meta property="og:description" content="<%= (post.excerpt || '').substring(0, 200) %>" />
    <meta property="og:url" content="https://savchenkosolutions.com/<%= lang %>/blog/<%= post.slug %>" />
    <meta property="og:site_name" content="Savchenko Solutions" />
    <meta property="og:locale" content="<%= lang === 'ru' ? 'ru_RU' : 'en_US' %>" />
    <meta property="article:published_time" content="<%= post.published_at ? new Date(post.published_at).toISOString() : '' %>" />
    <meta property="article:modified_time" content="<%= new Date(post.updated_at).toISOString() %>" />
    <meta property="article:author" content="<%= post.author_username %>" />
    <% if (post.tags) { post.tags.forEach(tag => { %>
    <meta property="article:tag" content="<%= tag %>" />
    <% }); } %>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= titleText(post.title) %>" />
    <meta name="twitter:description" content="<%= (post.excerpt || '').substring(0, 200) %>" />

    <!-- JSON-LD BlogPosting schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "<%= post.title.replace(/"/g, '\\"') %>",
      "description": "<%= (post.excerpt || '').replace(/"/g, '\\"') %>",
      "author": {
        "@type": "Person",
        "name": "<%= post.author_username %>"
      },
      "datePublished": "<%= post.published_at ? new Date(post.published_at).toISOString() : '' %>",
      "dateModified": "<%= new Date(post.updated_at).toISOString() %>",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://savchenkosolutions.com/<%= lang %>/blog/<%= post.slug %>"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Savchenko Solutions",
        "url": "https://savchenkosolutions.com"
      },
      "wordCount": <%= post.content.split(/\s+/).length %>,
      "inLanguage": "<%= post.language || lang %>"
    }
    </script>

    <%- include('../default/site_styles', { ssStyles: { prose: true, icons: 'fa6' } }) %>
    <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="icon" type="image/png" href="/img/logo.png" />

    <!-- MathJax -->
    <script>
    MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
      }
    };
    </script>
    <script id="MathJax-script" async src="/vendor/mathjax/tex-chtml.js"></script>
    <script src="/js/vendor/bootstrap.bundle.min.js"></script>

    <style>
        /* Two-column layout: sticky TOC sidebar + article body.
           Content column grows with the viewport so portrait images can
           float and the long text reflows around them, using all horizontal
           space (Wikipedia-style). On screens < 1100px the sidebar hides.
           The contents sit at the left edge of the page, as on solution pages, not in a 1320px
           centred block: at 1600px that left 140px empty on either side of a 1012px text column
           (owner's request, 2026-09-14). */
        .blog-page-grid {
            display: grid;
            grid-template-columns: 220px minmax(0, 1fr);
            gap: var(--ss-space-8);
            max-width: 1920px;
            margin: 0 auto;
            padding: 0 var(--ss-space-7);
            align-items: start;
        }
        .blog-toc-sidebar {
            position: sticky;
            top: 84px;
            max-height: calc(100vh - 110px);
            overflow-y: auto;
            padding: var(--ss-space-5) 0 var(--ss-space-4);
            font-size: var(--ss-fs-13);
            line-height: 1.45;
            color: var(--ss-text-secondary);
            border-right: 1px solid #ececec;
            padding-right: var(--ss-space-4);
        }
        .blog-toc-title {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-13);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-navy);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin: 0 0 var(--ss-space-2) var(--ss-space-2);
        }
        .blog-toc-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .blog-toc-list li { margin: 0; }
        .blog-toc-list a {
            display: block;
            padding: var(--ss-space-1) var(--ss-space-2) var(--ss-space-1) var(--ss-space-3);
            color: var(--ss-link);
            text-decoration: none;
            border-left: 2px solid transparent;
            border-radius: 0 var(--ss-radius-sm) var(--ss-radius-sm) 0;
            transition: background 0.1s, color 0.1s, border-color 0.1s;
        }
        .blog-toc-list a:hover {
            background: #f6f7f9;
            color: var(--ss-link-hover);
        }
        .blog-toc-list a.active {
            background: var(--ss-surface-hover);
            border-left-color: var(--ss-navy);
            color: var(--ss-navy);
            font-weight: var(--ss-fw-strong);
        }
        /* Anchor scroll target offset (so sticky page header doesn't cover headings) */
        .blog-content h2 { scroll-margin-top: 80px; }
        .blog-content h3 { scroll-margin-top: 80px; }

        @media (max-width: 1099px) {
            .blog-page-grid {
                display: block;
                max-width: none;
                padding: 0;
            }
            .blog-toc-sidebar { display: none; }
        }

        .blog-post-container {
            max-width: 780px;
            margin: 0 auto;
            padding: var(--ss-space-5) var(--ss-space-4) var(--ss-space-7);
        }
        /* Inside the grid the container is one of two cells, no extra centering needed */
        .blog-page-grid > .blog-post-container {
            max-width: none;
            margin: 0;
            padding: var(--ss-space-5) 0 var(--ss-space-7);
        }
        @media (max-width: 1099px) {
            .blog-page-grid > .blog-post-container {
                max-width: none;
                margin: 0;
                padding: var(--ss-space-5) var(--ss-space-5) var(--ss-space-7);
            }
        }

        /* Post header */
        .blog-post-header {
            margin-bottom: var(--ss-space-6);
        }
        /* The title and its Edit link share a row until there is no room, then Edit drops below:
           without the wrap a long Russian title pushed the link 36px off a 390px phone. */
        .blog-post-title-row {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0 var(--ss-space-4);
        }
        .blog-post-title-row h1 { min-width: 0; overflow-wrap: break-word; }
        .blog-post-edit {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: var(--ss-space-1);
            font-size: var(--ss-fs-13);
            color: var(--ss-text-secondary);
            text-decoration: none;
            padding: var(--ss-space-1) var(--ss-space-3);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius);
            margin: var(--ss-space-1) 0 var(--ss-space-3);
        }
        .blog-post-edit i { font-size: var(--ss-fs-12); }
        /* A post is a typeset article: its title in SS Text Bold, like a knowledge page (.ss-title). */
        .blog-post-header h1 {
            font-family: var(--ss-font-text);
            font-size: var(--ss-text-title);
            font-weight: var(--ss-fw-text-bold);
            color: var(--ss-heading);
            line-height: var(--ss-lh-tight);
            letter-spacing: 0;
            text-wrap: balance;
            margin: 0 0 var(--ss-space-3) 0;
        }
        .blog-author-info {
            display: flex;
            align-items: center;
            gap: var(--ss-space-3);
        }
        .blog-author-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .blog-author-details {
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
        }
        .blog-author-name {
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-link);
            text-decoration: none;
        }
        .blog-author-name:hover {
            text-decoration: underline;
        }
        .blog-author-meta {
            font-size: var(--ss-fs-13);
            color: var(--ss-text-secondary);
        }

        /* Post content — markdown rendering */
        .blog-content {
            max-width: none;
            margin-bottom: var(--ss-space-7);
        }
        /* Headings do NOT clear floats — short sections can be tight, so we
           let the next heading flow next to the floated image and use only
           the section break to break the wrap. Tags / nav still clear. */
        .blog-content h2 {
            font-size: var(--ss-text-h2);
            margin: var(--ss-space-7) 0 var(--ss-space-2);
        }
        .blog-content h3 {
            margin: var(--ss-space-5) 0 var(--ss-space-2);
        }
        /* Interview question paragraphs (bold-only) get a subtle accent.
           Do NOT use display:inline-block here — inline-block treats the
           paragraph as one atomic line-box and breaks float wrapping. */
        .blog-content p > strong:only-child {
            color: var(--ss-navy);
            font-weight: var(--ss-fw-strong);
        }
        .blog-content ul, .blog-content ol {
            margin: 0 0 var(--ss-space-3);
            padding-left: var(--ss-space-6);
        }
        .blog-content li {
            margin-bottom: var(--ss-space-1);
        }
        .blog-content strong {
            color: var(--ss-navy);
        }
        .blog-content blockquote {
            border-left: 3px solid var(--ss-navy);
            background: var(--ss-surface-alt);
            padding: var(--ss-space-2) var(--ss-space-4) var(--ss-space-2) var(--ss-space-4);
            color: var(--ss-text);
            margin: var(--ss-space-4) 0;
            border-radius: 0 var(--ss-radius-sm) var(--ss-radius-sm) 0;
        }
        .blog-content blockquote p { margin: 0 0 var(--ss-space-2); }
        .blog-content blockquote p:last-child { margin-bottom: 0; }

        .blog-content hr {
            border: none;
            border-top: 1px solid var(--ss-rule-soft);
            margin: var(--ss-space-6) 0;
        }
        .blog-content a { color: var(--ss-link); }
        .blog-content a:hover { color: var(--ss-link-hover); }
        .blog-content em { font-style: italic; }

        /* Default centered image (landscape figures, charts) */
        .blog-content img {
            display: block;
            max-width: 100%;
            height: auto;
            margin: var(--ss-space-5) auto;
            border-radius: var(--ss-radius-sm);
        }

        /* Wikipedia-style floated thumbnail for portrait images
           (auto-wrapped at runtime by the script at the bottom of the page). */
        .blog-content figure.blog-thumb {
            float: right;
            clear: right;
            width: 240px;
            max-width: 45%;
            margin: var(--ss-space-1) 0 var(--ss-space-2) var(--ss-space-5);
            padding: var(--ss-space-1);
            background: var(--ss-surface-alt);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius-sm);
            box-sizing: border-box;
        }
        .blog-content figure.blog-thumb.float-left {
            float: left;
            clear: left;
            margin: var(--ss-space-1) var(--ss-space-5) var(--ss-space-2) 0;
        }
        /* Ultra-tall portraits float at a narrower width so the height
           stays manageable while still allowing text to wrap around them. */
        .blog-content figure.blog-thumb.very-tall {
            width: 200px;
        }
        /* Rescue: when the section is too short to wrap a very-tall image,
           shrink the thumbnail further so it doesn't dominate the section. */
        .blog-content figure.blog-thumb.very-tall.section-short {
            width: 160px;
        }
        .blog-content figure.blog-thumb img,
        .blog-content figure.blog-figure-center img {
            display: block;
            width: 100%;
            height: auto;
            margin: 0;
            border-radius: var(--ss-radius-sm);
        }
        .blog-content figure.blog-thumb figcaption,
        .blog-content figure.blog-figure-center figcaption {
            font-size: var(--ss-fs-13);
            line-height: 1.4;
            color: var(--ss-text-secondary);
            padding: var(--ss-space-2) var(--ss-space-1) 2px;
            font-style: normal;
            text-align: left;
        }
        /* Centered framed figure — used for images at the end of short sections
           and for ultra-tall portraits that would dominate as a float. */
        .blog-content figure.blog-figure-center {
            display: block;
            margin: var(--ss-space-5) auto;
            max-width: 360px;
            padding: var(--ss-space-1);
            background: var(--ss-surface-alt);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius-sm);
            box-sizing: border-box;
            clear: both;
        }
        .blog-content figure.blog-figure-center.very-tall {
            max-width: 240px;
        }
        @media (max-width: 720px) {
            .blog-content figure.blog-thumb,
            .blog-content figure.blog-thumb.float-left {
                float: none;
                width: auto;
                max-width: 100%;
                margin: var(--ss-space-5) auto;
            }
            .blog-content figure.blog-figure-center {
                max-width: 100%;
            }
        }

        /* Markdown tables */
        .blog-content table {
            width: 100%;
            border-collapse: collapse;
            margin: var(--ss-space-6) 0;
            font-size: var(--ss-fs-14);
        }
        .blog-content thead th {
            background: var(--ss-surface-alt);
            font-weight: var(--ss-fw-strong);
            text-align: left;
            padding: var(--ss-space-2) var(--ss-space-3);
            border-bottom: 2px solid var(--ss-rule);
        }
        .blog-content tbody td {
            padding: var(--ss-space-2) var(--ss-space-3);
            border-bottom: 1px solid var(--ss-rule-soft);
        }
        .blog-content tbody tr:hover {
            background: var(--ss-surface-alt);
        }

        /* Tags */
        .blog-post-tags {
            display: flex;
            gap: var(--ss-space-2);
            flex-wrap: wrap;
            margin-bottom: var(--ss-space-4);
            clear: both;
        }
        .tag-pill {
            display: inline-block;
            padding: var(--ss-space-1) var(--ss-space-2);
            border-radius: var(--ss-radius);
            font-size: var(--ss-fs-13);
            font-weight: var(--ss-fw-strong);
            text-decoration: none;
            border: 1px solid var(--ss-rule);
            color: var(--ss-text-secondary);
            background: var(--ss-surface-alt);
            transition: all 0.15s;
        }
        /* Need `a.tag-pill` (not bare `.tag-pill`) to outrank the global
           `a:hover:not(.btn)` rule in design-system.css. */
        a.tag-pill:hover,
        a.tag-pill:focus {
            background: var(--ss-navy);
            color: var(--ss-on-navy);
            border-color: var(--ss-navy);
        }

        /* Prev/Next navigation */
        .blog-post-nav {
            display: flex;
            justify-content: space-between;
            gap: var(--ss-space-4);
            padding: var(--ss-space-4) 0;
            border-top: 1px solid var(--ss-rule-soft);
            border-bottom: 1px solid var(--ss-rule-soft);
            margin-bottom: var(--ss-space-6);
            clear: both;
        }
        .blog-post-nav a {
            display: flex;
            flex-direction: column;
            gap: var(--ss-space-1);
            text-decoration: none;
            max-width: 45%;
        }
        .blog-post-nav a:hover .blog-nav-title {
            color: var(--ss-link);
        }
        .blog-nav-label {
            font-size: var(--ss-fs-12);
            color: var(--ss-text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .blog-nav-title {
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
            transition: color 0.15s;
        }
        .blog-post-nav-next {
            text-align: right;
            margin-left: auto;
        }

        /* Comments */
        .blog-comments {
            margin-top: 0;
        }
        .blog-comments-header {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-18);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
            margin-bottom: var(--ss-space-4);
        }
        .blog-comments-header .comment-count {
            color: var(--ss-text-secondary);
            font-weight: 400;
        }
        .blog-comment-item {
            padding: var(--ss-space-4) 0;
            border-bottom: 1px solid #f8f9fa;
        }
        .blog-comment-item:last-child {
            border-bottom: none;
        }
        .comment-author-row {
            display: flex;
            align-items: center;
            gap: var(--ss-space-2);
            margin-bottom: var(--ss-space-1);
        }
        .comment-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .comment-username {
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-link);
            text-decoration: none;
        }
        .comment-username:hover {
            text-decoration: underline;
        }
        .comment-time {
            font-size: var(--ss-fs-12);
            color: var(--ss-text-secondary);
            margin-left: var(--ss-space-2);
        }
        .comment-body {
            font-size: var(--ss-fs-14);
            color: var(--ss-text);
            line-height: 1.6;
        }
        .comment-reply-link {
            font-size: var(--ss-fs-12);
            color: var(--ss-link);
            cursor: pointer;
            text-decoration: none;
            margin-top: var(--ss-space-1);
            display: inline-block;
        }
        .comment-reply-link:hover {
            text-decoration: underline;
        }
        .comment-replies {
            margin-left: var(--ss-space-8);
            padding-left: var(--ss-space-3);
            border-left: 2px solid var(--ss-rule-soft);
        }
        .comment-form-row {
            display: flex;
            gap: var(--ss-space-3);
            align-items: flex-start;
            margin-top: var(--ss-space-4);
        }
        .comment-input {
            /* min-width: 0, or the textarea keeps its intrinsic 20 columns and pushes Send off a 360px phone. */
            flex: 1 1 0;
            min-width: 0;
            min-height: 42px;
            max-height: 160px;
            padding: var(--ss-space-2) var(--ss-space-3);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius);
            font-family: inherit;
            font-size: var(--ss-fs-16);
            resize: vertical;
        }
        .comment-input:focus {
            border-color: var(--ss-link);
            outline: none;
        }
        .comment-submit-btn {
            background: var(--ss-navy);
            color: var(--ss-on-navy);
            border: none;
            border-radius: var(--ss-radius);
            padding: var(--ss-space-2) var(--ss-space-4);
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            cursor: pointer;
            white-space: nowrap;
        }
        .comment-submit-btn:hover {
            background: var(--ss-navy-hover);
        }
        .comment-login-prompt {
            text-align: center;
            color: var(--ss-text-secondary);
            font-size: var(--ss-fs-14);
        }
        .comment-login-prompt a {
            color: var(--ss-link);
        }
        .reply-form {
            margin-top: var(--ss-space-2);
            display: flex;
            gap: var(--ss-space-2);
            align-items: flex-start;
        }
        .reply-input {
            flex: 1;
            min-height: 36px;
            padding: var(--ss-space-1) var(--ss-space-3);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius);
            font-family: inherit;
            font-size: var(--ss-fs-16);
            resize: none;
        }
        .reply-input:focus {
            border-color: var(--ss-link);
            outline: none;
        }
        .reply-submit-btn {
            background: var(--ss-navy);
            color: var(--ss-on-navy);
            border: none;
            border-radius: var(--ss-radius);
            padding: var(--ss-space-1) var(--ss-space-3);
            font-size: var(--ss-fs-13);
            cursor: pointer;
        }
        .reply-submit-btn:hover {
            background: var(--ss-navy-hover);
        }

        .blog-back-link {
            display: inline-flex;
            align-items: center;
            gap: var(--ss-space-1);
            font-size: var(--ss-fs-14);
            color: var(--ss-text-secondary);
            text-decoration: none;
            margin-bottom: var(--ss-space-6);
        }
        .blog-back-link:hover {
            color: var(--ss-link);
        }

        @media (max-width: 768px) {
            .blog-post-container { padding: var(--ss-space-3) var(--ss-space-3) var(--ss-space-6); }
            .blog-content h2 { margin-top: var(--ss-space-6); }
            .blog-content hr { margin: var(--ss-space-5) 0; }
            .blog-post-nav { flex-direction: column; }
            .blog-post-nav a { max-width: 100%; }
            .blog-post-nav-next { text-align: left; }
        }
    </style>
</head>
<body>
    <%
    const tagTranslations = {
        'announcement': 'объявление',
        'beginners': 'для начинающих',
        'community': 'сообщество',
        'guide': 'руководство',
        'history': 'история',
        'meta': 'мета',
        'study-tips': 'советы',
        'physics': 'физика',
        'olympiad': 'олимпиада',
        'solutions': 'решения',
        'tutorial': 'туториал',
        'news': 'новости',
        'update': 'обновление',
        'education': 'образование',
        'mechanics': 'механика',
        'thermodynamics': 'термодинамика',
        'electrodynamics': 'электродинамика',
        'optics': 'оптика',
        'data-analysis': 'анализ данных',
        'statistics': 'статистика',
        'hawkes-process': 'процесс Хокса',
    };
    function tagLabel(tag) {
        if (lang === 'ru' && tagTranslations[tag]) return tagTranslations[tag];
        return tag;
    }
    %>
    <%- include('../default/main_site_header', { showViewsButton: false }) %>

    <%
    // Build TOC from the post markdown's H2 headings.
    const tocItems = [];
    {
        const lines = post.content.split(/\r?\n/);
        let inFence = false;
        for (const line of lines) {
            if (/^```/.test(line)) { inFence = !inFence; continue; }
            if (inFence) continue;
            const m = /^##\s+(.+?)\s*$/.exec(line);
            if (m) {
                let title = m[1].trim();
                // Strip trailing markdown punctuation we don't want in the TOC
                title = title.replace(/[#*]+$/, '').trim();
                tocItems.push({ title, id: 'sec-' + (tocItems.length + 1) });
            }
        }
    }
    %>

    <div class="blog-page-grid">
        <aside class="blog-toc-sidebar" aria-label="<%= lang === 'ru' ? 'Содержание' : 'Contents' %>">
            <div class="blog-toc-title"><%= lang === 'ru' ? 'Содержание' : 'Contents' %></div>
            <ol class="blog-toc-list" id="blogTocList">
                <% tocItems.forEach(it => { %>
                <li><a href="#<%= it.id %>" data-target="<%= it.id %>"><%= it.title %></a></li>
                <% }); %>
            </ol>
        </aside>

    <div class="blog-post-container">
        <a href="/blog" class="blog-back-link">&larr; <%= lang === 'ru' ? 'Все записи' : 'All posts' %></a>

        <div class="blog-post-header">
            <div class="blog-post-title-row">
                <h1><%- paintUsernames(post.title) %></h1>
                <% if (userId && (post.author_id === userId || username === 'astrosander')) { %>
                <a href="/blog/<%= post.slug %>/edit" class="blog-post-edit">
                    <i class="fas fa-pen" aria-hidden="true"></i> <%= lang === 'ru' ? 'Редактировать' : 'Edit' %>
                </a>
                <% } %>
            </div>
            <div class="blog-author-info">
                <span class="avatar-presence">
                    <img
                        src="<%= post.author_avatar || '/img/profile_images/Default_placeholder.svg' %>"
                        alt="<%= post.author_username %>"
                        class="blog-author-avatar"
                        width="40" height="40"
                    />
                    <% if (post.author_is_online) { %><span class="online-dot online-dot--lg" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %>
                </span>
                <div class="blog-author-details">
                    <a href="/user/<%= post.author_username %>" class="blog-author-name"><%= post.author_username %></a>
                    <span class="blog-author-meta">
                        <%- localTime(post.published_at, 'longdate', lang) %>
                        &middot;
                        <%= readingTime %> <%= lang === 'ru' ? 'мин чтения' : 'min read' %>
                    </span>
                </div>
            </div>
        </div>

        <div class="blog-content ss-prose" id="blogContent">
            <%- renderMarkdown(post.content) %>
        </div>

        <% if (post.tags && post.tags.length > 0) { %>
        <div class="blog-post-tags">
            <% post.tags.forEach(tag => { %>
                <a href="/blog/tag/<%= tag %>" class="tag-pill"><%= tagLabel(tag) %></a>
            <% }); %>
        </div>
        <% } %>

        <% if (prevPost || nextPost) { %>
        <div class="blog-post-nav">
            <% if (prevPost) { %>
            <a href="/blog/<%= prevPost.slug %>">
                <span class="blog-nav-label">&larr; <%= lang === 'ru' ? 'Предыдущая' : 'Previous' %></span>
                <span class="blog-nav-title"><%= prevPost.title %></span>
            </a>
            <% } else { %>
            <span></span>
            <% } %>
            <% if (nextPost) { %>
            <a href="/blog/<%= nextPost.slug %>" class="blog-post-nav-next">
                <span class="blog-nav-label"><%= lang === 'ru' ? 'Следующая' : 'Next' %></span>
                <span class="blog-nav-title"><%= nextPost.title %></span>
            </a>
            <% } %>
        </div>
        <% } %>

        <!-- Comments Section -->
        <div class="blog-comments">
            <h3 class="blog-comments-header">
                <%= lang === 'ru' ? 'Комментарии' : 'Comments' %>
                <span class="comment-count">(<%= comments.length + Object.values(childMap).reduce((s, a) => s + a.length, 0) %>)</span>
            </h3>

            <% if (comments.length === 0) { %>
                <p style="color: var(--ss-text-secondary); font-size: var(--ss-fs-14);"><%= lang === 'ru' ? 'Пока нет комментариев. Будьте первым!' : 'No comments yet. Be the first!' %></p>
            <% } %>

            <% comments.forEach(comment => { %>
            <div class="blog-comment-item" id="comment-<%= comment.id %>">
                <div class="comment-author-row">
                    <span class="avatar-presence"><img src="<%= comment.profile_picture || '/img/profile_images/Default_placeholder.svg' %>" alt="" class="comment-avatar" width="32" height="32" /><% if (comment.is_online) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %></span>
                    <a href="/user/<%= comment.username %>" class="comment-username"><%= comment.username %></a>
                    <%- localTime(comment.created_at, 'date', lang, { className: 'comment-time' }) %>
                </div>
                <div class="comment-body"><%= comment.content %></div>
                <% if (userId) { %>
                    <span class="comment-reply-link" onclick="showReplyForm(<%= comment.id %>)"><%= lang === 'ru' ? 'Ответить' : 'Reply' %></span>
                    <div id="reply-form-<%= comment.id %>" style="display:none;"></div>
                <% } %>
                <% if (childMap[comment.id]) { %>
                <div class="comment-replies">
                    <% childMap[comment.id].forEach(reply => { %>
                    <div class="blog-comment-item" id="comment-<%= reply.id %>">
                        <div class="comment-author-row">
                            <span class="avatar-presence"><img src="<%= reply.profile_picture || '/img/profile_images/Default_placeholder.svg' %>" alt="" class="comment-avatar" width="32" height="32" /><% if (reply.is_online) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %></span>
                            <a href="/user/<%= reply.username %>" class="comment-username"><%= reply.username %></a>
                            <%- localTime(reply.created_at, 'date', lang, { className: 'comment-time' }) %>
                        </div>
                        <div class="comment-body"><%= reply.content %></div>
                    </div>
                    <% }); %>
                </div>
                <% } %>
            </div>
            <% }); %>

            <!-- Add Comment -->
            <% if (userId) { %>
            <div class="comment-form-row">
                <textarea class="comment-input" id="commentInput" placeholder="<%= lang === 'ru' ? 'Написать комментарий...' : 'Write a comment...' %>" rows="2"></textarea>
                <button class="comment-submit-btn" id="commentSubmit"><%= lang === 'ru' ? 'Отправить' : 'Post' %></button>
            </div>
            <% } else { %>
            <p class="comment-login-prompt">
                <a href="/<%= lang %>/login"><%= lang === 'ru' ? 'Войдите' : 'Log in' %></a> <%= lang === 'ru' ? 'чтобы оставить комментарий.' : 'to leave a comment.' %>
            </p>
            <% } %>
        </div>
    </div>
    </div><!-- /blog-page-grid -->

    <%- include('../default/modern_footer') %>

    <script>
    const SLUG = '<%= post.slug %>';
    const LANG = '<%= lang %>';
    const DEFAULT_AVATAR = '/img/profile_images/Default_placeholder.svg';

    // Submit top-level comment
    const submitBtn = document.getElementById('commentSubmit');
    const commentInput = document.getElementById('commentInput');
    if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
            const content = commentInput.value.trim();
            if (!content) return;
            submitBtn.disabled = true;
            try {
                const resp = await fetch('/blog/' + SLUG + '/comments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content }),
                });
                const data = await resp.json();
                if (data.success) {
                    appendComment(data.comment, null);
                    commentInput.value = '';
                } else {
                    alert(data.error || 'Error posting comment');
                }
            } catch {
                alert('Network error');
            }
            submitBtn.disabled = false;
        });
    }

    // Reply form
    function showReplyForm(parentId) {
        const container = document.getElementById('reply-form-' + parentId);
        if (!container || container.children.length > 0) return;
        container.style.display = 'block';
        container.innerHTML = `
            <div class="reply-form">
                <textarea class="reply-input" placeholder="${LANG === 'ru' ? 'Ваш ответ...' : 'Your reply...'}" rows="1"></textarea>
                <button class="reply-submit-btn" onclick="submitReply(${parentId})">${LANG === 'ru' ? 'Отправить' : 'Reply'}</button>
            </div>`;
    }

    async function submitReply(parentId) {
        const container = document.getElementById('reply-form-' + parentId);
        const textarea = container.querySelector('textarea');
        const content = textarea.value.trim();
        if (!content) return;
        const btn = container.querySelector('button');
        btn.disabled = true;
        try {
            const resp = await fetch('/blog/' + SLUG + '/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content, parent_id: parentId }),
            });
            const data = await resp.json();
            if (data.success) {
                appendComment(data.comment, parentId);
                container.style.display = 'none';
                container.innerHTML = '';
            } else {
                alert(data.error || 'Error posting reply');
            }
        } catch {
            alert('Network error');
        }
        btn.disabled = false;
    }

    function appendComment(comment, parentId) {
        const dateStr = new Date(comment.created_at).toLocaleDateString(
            LANG === 'ru' ? 'ru-RU' : 'en-US',
            { year: 'numeric', month: 'short', day: 'numeric' }
        );
        const html = `
            <div class="blog-comment-item" id="comment-${comment.id}">
                <div class="comment-author-row">
                    <img src="${comment.profile_picture || DEFAULT_AVATAR}" alt="" class="comment-avatar" width="32" height="32" />
                    <a href="/user/${comment.username}" class="comment-username">${comment.username}</a>
                    <span class="comment-time">${dateStr}</span>
                </div>
                <div class="comment-body">${escapeHtml(comment.content)}</div>
            </div>`;

        if (parentId) {
            const parentEl = document.getElementById('comment-' + parentId);
            let repliesDiv = parentEl.querySelector('.comment-replies');
            if (!repliesDiv) {
                repliesDiv = document.createElement('div');
                repliesDiv.className = 'comment-replies';
                parentEl.appendChild(repliesDiv);
            }
            repliesDiv.insertAdjacentHTML('beforeend', html);
        } else {
            const commentsSection = document.querySelector('.blog-comments');
            const formRow = commentsSection.querySelector('.comment-form-row') || commentsSection.querySelector('.comment-login-prompt');
            if (formRow) {
                formRow.insertAdjacentHTML('beforebegin', html);
            }
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Sticky TOC: assign matching IDs to H2 headings and update active state on scroll.
    (function setupTocScrollSpy() {
        const content = document.getElementById('blogContent');
        const tocList = document.getElementById('blogTocList');
        if (!content || !tocList) return;
        const headings = Array.from(content.querySelectorAll('h2'));
        const tocAnchors = Array.from(tocList.querySelectorAll('a[data-target]'));
        // Assign IDs in the same order as the server-rendered TOC.
        headings.forEach((h, i) => {
            const id = 'sec-' + (i + 1);
            if (!h.id) h.id = id;
        });
        if (headings.length === 0 || tocAnchors.length === 0) return;
        // Smooth-scroll on click; the CSS scroll-margin-top handles the offset.
        tocAnchors.forEach(a => {
            a.addEventListener('click', (e) => {
                const target = document.getElementById(a.dataset.target);
                if (!target) return;
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                history.replaceState(null, '', '#' + a.dataset.target);
            });
        });
        // Active state: the heading whose top is just above a 120 px threshold.
        let ticking = false;
        function updateActive() {
            ticking = false;
            const offset = 120;
            let activeIdx = 0;
            for (let i = 0; i < headings.length; i++) {
                if (headings[i].getBoundingClientRect().top - offset <= 0) {
                    activeIdx = i;
                } else {
                    break;
                }
            }
            tocAnchors.forEach((a, i) => a.classList.toggle('active', i === activeIdx));
        }
        function onScroll() {
            if (!ticking) {
                window.requestAnimationFrame(updateActive);
                ticking = true;
            }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        updateActive();
    })();

    // Auto-wrap portrait images into Wikipedia-style figures.
    // Strategy: every portrait <img> becomes a floated <figure> and is moved
    // to the top of its section (just after the preceding H2) so the entire
    // section's body text wraps around the image. Floats alternate right/left.
    // If a section is too short to wrap around a very-tall image we shrink
    // the thumbnail further; we never center-orphan portrait images.
    (function wrapPortraitImages() {
        const content = document.getElementById('blogContent');
        if (!content) return;

        // Portraits alternate right, left, right in reading order. They used to alternate in the
        // order the images finished loading, so a post's first photo sat on the left on a cold
        // visit and on the right once cached (2026-09-14); each image now waits for the ones
        // before it (drain, below).
        let portraitCount = 0;

        // Find the H2 that opens the section containing `el`, walking backward
        // through siblings. Returns null if no preceding H2 exists.
        function sectionHeading(el) {
            let n = el;
            while (n && n.previousElementSibling) {
                n = n.previousElementSibling;
                if (n.tagName === 'H2' || n.tagName === 'HR') return n;
            }
            return null;
        }

        // Sum the text length of every block in the section starting at
        // `headingOrTop`, stopping at the next H2 or <hr>.
        function sectionTextLength(headingOrTop) {
            const start = headingOrTop ? headingOrTop.nextElementSibling : content.firstElementChild;
            let len = 0;
            let node = start;
            while (node && !(node.tagName === 'H2' || node.tagName === 'HR')) {
                len += (node.textContent || '').trim().length;
                node = node.nextElementSibling;
            }
            return len;
        }

        function wrap(img) {
            if (img.dataset.thumbProcessed) return;
            const w = img.naturalWidth, h = img.naturalHeight;
            if (!w || !h) return;
            const ratio = w / h;
            if (ratio >= 0.95) return; // landscape / square — keep markdown default

            const wrapperP = img.closest('p');
            if (!wrapperP || !wrapperP.parentNode) return;
            const onlyChild = wrapperP.children.length === 1 && wrapperP.firstElementChild === img;
            if (!onlyChild) return;

            // Optional caption (next <p><em>...</em></p>)
            let captionEl = null;
            const nextP = wrapperP.nextElementSibling;
            if (nextP && nextP.tagName === 'P' && nextP.children.length === 1 && nextP.firstElementChild.tagName === 'EM') {
                captionEl = nextP;
            }

            const veryTall = ratio < 0.5;
            const fig = document.createElement('figure');
            const tallClass = veryTall ? ' very-tall' : '';
            fig.className = 'blog-thumb' + tallClass + (portraitCount++ % 2 === 1 ? ' float-left' : '');

            img.dataset.thumbProcessed = '1';
            fig.appendChild(img);
            if (captionEl) {
                const fc = document.createElement('figcaption');
                fc.innerHTML = captionEl.firstElementChild.innerHTML;
                fig.appendChild(fc);
                captionEl.remove();
            }

            // Replace original <p><img></p> with the figure, then move the
            // figure to the very top of its section so the entire section
            // body wraps around it.
            wrapperP.replaceWith(fig);
            const heading = sectionHeading(fig);
            if (heading && heading.nextElementSibling !== fig) {
                heading.insertAdjacentElement('afterend', fig);
            }

            // If the section is too short to wrap a very-tall image, mark the
            // figure so CSS can shrink it further.
            if (veryTall && sectionTextLength(heading) < 1200) {
                fig.classList.add('section-short');
            }
        }

        const imgs = Array.prototype.slice.call(content.querySelectorAll('img'));
        let next = 0;
        function drain() {
            while (next < imgs.length) {
                const img = imgs[next];
                if (!img.complete) return;
                if (img.naturalWidth) wrap(img);
                next++;
            }
        }
        imgs.forEach((img) => {
            if (img.complete) return;
            img.addEventListener('load', drain, { once: true });
            img.addEventListener('error', drain, { once: true });
        });
        drain();
    })();
    </script>
</body>
</html>
