<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
   <meta charset="utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <meta http-equiv="content-language" content="en">
   <meta name="keywords" content="<%= __('meta.keywords') %>">
   <meta name="description" content="<%= __('meta.description') %>">
   <meta name="author" content="<%= __('meta.author') %>">
   <meta name="date" content="<%= __('meta.date') %>" scheme="YYYY-MM">
   <meta property="og:title" content="<%= titleText(__('profile.title')) %>">
   <meta property="og:image" content="https://savchenkosolutions.com/img/logo.png">
   <meta property="og:description" content="<%= __('meta.ogDescription') %>">
   <meta name="yandex-verification" content="6cfda41f74038368">
   <title>
      <%= titleText(__('profile.title')) %>
   </title>
   <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
   <link rel="icon" type="image/png" href="/img/logo.png">
   <link rel="apple-touch-icon" href="/img/logo.png">
   <%- include('default/main_site_header_head') %>

   <style>
      /* Add font-family to body */
      body {
         font-family: var(--ss-font-ui);
         line-height: 1.6;
      }

      /* Update headings font */
      h2 {
         font-family: var(--ss-font-ui);
         font-weight: var(--ss-fw-strong);
      }

      .container1 {
         max-width: 1200px;
         margin: 0 auto;
         padding: var(--ss-space-7);
      }

      .profile-grid {
         display: grid;
         grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
         gap: var(--ss-space-7);
         margin-top: var(--ss-space-7);
      }

      .profile-section {
         background: var(--ss-surface);
         border-radius: var(--ss-radius-lg);
         padding: var(--ss-space-6);
         box-shadow: var(--ss-shadow);
         display: flex;
         flex-direction: column;
      }

      .profile-section h2 {
         color: var(--ss-text);
         margin-top: var(--ss-space-4);
         padding-bottom: var(--ss-space-2);
         border-bottom: 2px solid var(--ss-rule-soft);
         font-weight: var(--ss-fw-strong);
      }

      .contributions-list {
         list-style: none;
         padding: 0;
         padding-right: var(--ss-space-3);
         max-height: 500px;
         overflow-y: auto;
         scrollbar-width: thin;
         scrollbar-color: #c0c4c9 #eef0f2;
      }

      .contributions-list::-webkit-scrollbar {
         width: 8px;
         margin-left: var(--ss-space-3);
      }

      .contributions-list::-webkit-scrollbar-track {
         background: #eef0f2;
         border-radius: var(--ss-radius-sm);
      }

      .contributions-list::-webkit-scrollbar-thumb {
         background: #c0c4c9;
         border-radius: var(--ss-radius-sm);
      }

      .contributions-list::-webkit-scrollbar-thumb:hover {
         background: #a8adb3;
      }

      .contribution-item {
         background: var(--ss-surface-alt);
         border-radius: var(--ss-radius);
         padding: var(--ss-space-4);
         margin-bottom: var(--ss-space-3);
         transition: transform 0.2s;
         display: flex;
         flex-direction: column;
         gap: var(--ss-space-2);
      }

      .contribution-item:hover {
         transform: translateY(-2px);
      }

      .view-button {
         display: inline-block;
         padding: var(--ss-space-2) var(--ss-space-4);
         background: var(--ss-link);
         color: var(--ss-on-navy);
         border-radius: var(--ss-radius-sm);
         text-decoration: none;
         margin-top: var(--ss-space-2);
         transition: background 0.2s;
         font-family: inherit;
         font-weight: var(--ss-fw-strong);
      }

      .view-button:hover {
         background: #0056b3;
      }

      .form-group {
         margin-bottom: var(--ss-space-6);
      }

      .form-group label {
         display: block;
         margin-bottom: var(--ss-space-2);
         color: var(--ss-text);
         font-weight: var(--ss-fw-strong);
      }

      .form-group input {
         width: 100%;
         padding: var(--ss-space-3) 0rem var(--ss-space-3) var(--ss-space-3);
         border: 1px solid var(--ss-rule);
         border-radius: var(--ss-radius-sm);
         transition: border-color 0.2s;
         font-family: inherit;
         font-size: var(--ss-fs-16);
      }

      .form-group input:focus {
         border-color: #3498db;
         outline: none;
      }

      .submit-button {
         background: var(--ss-link);
         color: var(--ss-on-navy);
         padding: var(--ss-space-3) var(--ss-space-6);
         border: none;
         border-radius: var(--ss-radius-sm);
         cursor: pointer;
         transition: background 0.2s;
         font-family: inherit;
         font-weight: var(--ss-fw-strong);
         margin-top: auto;
      }

      .submit-button:hover {
         background: #0056b3;
      }

      .error,
      .success {
         padding: var(--ss-space-4);
         border-radius: var(--ss-radius-sm);
         margin: var(--ss-space-4) 0;
         text-align: center;
      }

      .error {
         background: var(--ss-error-soft);
         color: var(--ss-error);
      }

      .success {
         background: #dcfce7;
         color: var(--ss-success-strong);
      }

      .vector-header-container {
         padding: 0px 0px 0px 0px;
         margin: 0;
         width: 100%;
         position: relative;
         box-sizing: border-box;
      }

      /* Update footer styles */
      .footer {
         background-color: var(--ss-surface-alt);
         padding: var(--ss-space-4) 0;
         margin-top: var(--ss-space-9);
         border-top: 1px solid var(--ss-rule);
      }

      .footer .container {
         max-width: 1200px;
         margin: 0 auto;
         padding: 0 var(--ss-space-7);
         text-align: center;
      }

      .footer p {
         margin: var(--ss-space-2) 0;
         color: var(--ss-text-secondary);
      }

      .footer small {
         font-size: var(--ss-fs-14);
         line-height: 1.4;
      }

      .footer strong {
         color: var(--ss-text);
      }

      .contribution-header {
         display: flex;
         justify-content: space-between;
         align-items: flex-start;
      }

      .contribution-meta {
         color: var(--ss-text-secondary);
         font-size: 0.9em;
      }

      .settings-form,
      .password-form {
         display: flex;
         flex-direction: column;
         flex: 1;
      }

      .password-input-wrapper {
         position: relative;
         display: flex;
         align-items: center;
      }

      .password-toggle {
         position: absolute;
         right: 10px;
         background: none;
         border: none;
         cursor: pointer;
         padding: 0;
         color: var(--ss-text-secondary);
      }

      .password-toggle:hover {
         color: var(--ss-text);
      }

      .eye-icon {
         width: 20px;
         height: 20px;
      }

      .view-changes {
         display: inline-block;
         margin-left: var(--ss-space-3);
         color: var(--ss-link);
         text-decoration: none;
         font-size: 0.9em;
      }

      .view-changes:hover {
         text-decoration: underline;
      }
   </style>
   <script src="/js/analytics.js"></script>
</head>

<body>
   <%- include('default/header.ejs') %>

   <div class="container1">
      <h2 style="text-align: center; font-weight: var(--ss-fw-strong); color: var(--ss-text); margin-bottom: var(--ss-space-7);">
         <%= __('profile.welcome') %>, <%= username %>! 👋
      </h2>

      <% if (error) { %>
         <p class="error">
            <%= error %>
         </p>
         <% } %>
            <% if (success) { %>
               <p class="success">
                  <%= success %>
               </p>
               <% } %>

                  <div class="profile-grid">
                     <div class="profile-section">
                        <h2 style="display: flex; justify-content: space-between; align-items: center;">
                           <%= __('profile.yourContributions') %>
                              <span style="display: flex; align-items: center; font-size: 0.9em; color: var(--ss-text-secondary);">
                                 <img src="/img/contributions.svg" width="18" height="18" style="margin-right: var(--ss-space-1);"
                                    alt="Edit icon">
                                 <%= totalContributions %>
                              </span>
                        </h2>
                        <% if (contributions && contributions.length> 0) { %>
                           <div id="contributions-container">
                              <ul class="contributions-list">
                                 <% contributions.forEach(contribution=> { %>
                                    <li>
                                       <div class="contribution-item">
                                          <div class="contribution-header">
                                             <div>
                                                <strong>
                                                   <%= __('profile.editedProblems') %>
                                                </strong>
                                                <a href="/<%= contribution.language %>/<%= contribution.problem_name %>">
                                                   <%= contribution.problem_name %>
                                                </a>
                                             </div>
                                             <span class="language-tag">
                                                <%= contribution.language.toUpperCase() %>
                                             </span>
                                          </div>
                                          <div class="contribution-meta">
                                             <%= __('profile.lastEdited') %>
                                                <%= new Date(contribution.edited_at).toLocaleString(lang==='ru' ? 'ru-RU'
                                                   : 'en-US' , { year: 'numeric' , month: 'long' , day: 'numeric' ,
                                                   hour: '2-digit' , minute: '2-digit' }) %>
                                                   <% if (contribution.original_content && contribution.new_content) { %>
                                                      <a href="/<%= lang %>/contributions/<%= contribution.id %>"
                                                         class="view-changes">
                                                         <%= __('profile.viewChanges') %>
                                                      </a>
                                                      <% } %>
                                          </div>
                                       </div>
                                    </li>
                                    <% }); %>
                                    <button id="show-more" class="submit-button">Show More</button>
                                 </ul>
                           </div>
                           <% } else { %>
                              <p>
                                 <%= __('profile.noContributions') %>
                              </p>
                              <% } %>
                     </div>

                     <div class="profile-section">
                        <h2 style="display: flex; justify-content: space-between; align-items: center;">
                           <%= __('profile.settings') %>
                              <img src="/img/settings.svg" width="18" height="18" style="margin-left: var(--ss-space-1);"
                                 alt="Settings icon">
                        </h2>
                        <form action="/profile/update" method="POST" class="settings-form">
                           <input type="hidden" name="lang" value="<%= lang %>">

                           <div class="form-group">
                              <label for="fullname">
                                 <%= __('profile.fullName') %>
                              </label>
                              <input type="text" id="fullname" name="fullname" value="<%= fullName %>" required>
                           </div>

                           <div class="form-group">
                              <label for="email">
                                 <%= __('profile.email') %>
                              </label>
                              <input type="email" id="email" name="email" value="<%= email %>" required>
                           </div>

                           <div class="form-group">
                              <label for="username">
                                 <%= __('profile.username') %>
                              </label>
                              <input type="text" id="username" name="username" value="<%= username %>" readonly>
                           </div>

                           <button type="submit" class="submit-button">
                              <%= __('profile.save') %>
                           </button>
                        </form>
                     </div>

                     <div class="profile-section">
                        <h2 style="display: flex; justify-content: space-between; align-items: center;">
                           <%= __('profile.changePassword') %>
                              <img src="/img/lock.svg" width="18" height="18" style="margin-left: var(--ss-space-1);"
                                 alt="Password icon">
                        </h2>
                        <form action="/profile/password" method="POST" class="password-form">
                           <input type="hidden" name="lang" value="<%= lang %>">

                           <div class="form-group">
                              <label for="currentPassword">
                                 <%= __('profile.currentPassword') %>
                              </label>
                              <div class="password-input-wrapper">
                                 <input type="password" id="currentPassword" name="currentPassword" required
                                    oninput="toggleEyeIcon(this)">
                                 <button type="button" class="password-toggle"
                                    onclick="togglePassword('currentPassword')" style="display: none;">
                                    <img src="/img/eye-open.svg" class="eye-icon eye-open" alt="Show password">
                                    <img src="/img/eye-closed.svg" class="eye-icon eye-closed" style="display: none;"
                                       alt="Hide password">
                                 </button>
                              </div>
                           </div>

                           <div class="form-group">
                              <label for="newPassword">
                                 <%= __('profile.newPassword') %>
                              </label>
                              <div class="password-input-wrapper">
                                 <input type="password" id="newPassword" name="newPassword" required
                                    oninput="toggleEyeIcon(this)">
                                 <button type="button" class="password-toggle" onclick="togglePassword('newPassword')"
                                    style="display: none;">
                                    <img src="/img/eye-open.svg" class="eye-icon eye-open" alt="Show password">
                                    <img src="/img/eye-closed.svg" class="eye-icon eye-closed" style="display: none;"
                                       alt="Hide password">
                                 </button>
                              </div>
                           </div>

                           <div class="form-group">
                              <label for="confirmPassword">
                                 <%= __('profile.confirmPassword') %>
                              </label>
                              <div class="password-input-wrapper">
                                 <input type="password" id="confirmPassword" name="confirmPassword" required
                                    oninput="toggleEyeIcon(this)">
                                 <button type="button" class="password-toggle"
                                    onclick="togglePassword('confirmPassword')" style="display: none;">
                                    <img src="/img/eye-open.svg" class="eye-icon eye-open" alt="Show password">
                                    <img src="/img/eye-closed.svg" class="eye-icon eye-closed" style="display: none;"
                                       alt="Hide password">
                                 </button>
                              </div>
                           </div>

                           <button type="submit" class="submit-button">
                              <%= __('profile.updatePassword') %>
                           </button>
                        </form>
                     </div>
                  </div>
   </div>

   <script>
      const lang = '<%= lang %>'; // Define lang variable at the top of your script
      const userId = '<%= userId %>'; // Get the user ID from the session
      
      document.querySelector('.password-form').addEventListener('submit', function (e) {
         const newPassword = document.getElementById('newPassword').value;
         const confirmPassword = document.getElementById('confirmPassword').value;

         if (newPassword !== confirmPassword) {
            e.preventDefault();
            alert('<%= __("auth.register.passwordsNoMatch") %>');
         }
      });

      function togglePassword(inputId) {
         const input = document.getElementById(inputId);
         const button = input.nextElementSibling;
         const openEye = button.querySelector('.eye-open');
         const closedEye = button.querySelector('.eye-closed');

         if (input.type === 'password') {
            input.type = 'text';
            openEye.style.display = 'none';
            closedEye.style.display = 'block';
         } else {
            input.type = 'password';
            openEye.style.display = 'block';
            closedEye.style.display = 'none';
         }
      }

      function toggleEyeIcon(input) {
         const button = input.nextElementSibling;
         button.style.display = input.value ? 'block' : 'none';
         // Always show open eye when toggle button first appears
         const openEye = button.querySelector('.eye-open');
         const closedEye = button.querySelector('.eye-closed');
         openEye.style.display = 'block';
         closedEye.style.display = 'none';
      }

      let offset = 200; // Start after the initial load

      document.getElementById('show-more').addEventListener('click', async () => {
         try {
            const response = await fetch(`/api/contributions/${userId}?offset=${offset}`);
            const newContributions = await response.json();

            if (newContributions.length > 0) {
               const contributionsList = document.querySelector('.contributions-list');
               newContributions.forEach(contribution => {
                  const listItem = document.createElement('li');
                  listItem.innerHTML = `
                  <div class="contribution-item">
                     <div class="contribution-header">
                        <div>
                           <strong><%= __('profile.editedProblems') %></strong>
                           <a href="/${contribution.language}/${contribution.problem_name}">${contribution.problem_name}</a>
                        </div>
                        <span class="language-tag">${contribution.language.toUpperCase()}</span>
                     </div>
                     <div class="contribution-meta">
                        <%= __('profile.lastEdited') %> ${new Date(contribution.edited_at).toLocaleString(lang === 'ru' ? 'ru-RU' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                        ${contribution.original_content && contribution.new_content ? `<a href="/${contribution.language}/contributions/${contribution.id}" class="view-changes"><%= __('profile.viewChanges') %></a>` : ''}
                     </div>
                  </div>
                  `;
                  contributionsList.appendChild(listItem);
               });

               // Move the "show-more" button to the end of the list
               const showMoreButton = document.getElementById('show-more');
               contributionsList.appendChild(showMoreButton);

               offset += newContributions.length;
            } else {
               document.getElementById('show-more').style.display = 'none'; // Hide button if no more contributions
            }
         } catch (error) {
            console.error('Error fetching more contributions:', error);
         }
      });
   </script>

   <%- include('default/main_site_footer_scripts') %>

   <footer class="footer">
      <div class="row container">
         <br />
         <p>
            <small>© <strong>Savchenko Solutions</strong>, 2023-2025<br /></small>
         </p>
         <p>
            <small>
               Solutions are contributed by their authors and based on original textbook content, which remains the property of the textbook authors. Unless stated otherwise, solutions are licensed under CC BY-SA 4.0. Commercial use requires written permission.<br>
               alex@savchenkosolutions.com <br />
            </small>
         </p>
         <br />
      </div>
   </footer>
</body>

</html>