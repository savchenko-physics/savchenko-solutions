<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <title><%= lang === 'ru' ? 'Обширный каталог ресурсов по физике' : 'A comprehensive catalog of physics resources' %> | Savchenko Solutions</title>
    <meta name="description" content="<%= lang === 'ru'
        ? 'Каталог Telegram-каналов и сайтов по олимпиадной физике: задачи, подготовка к экзаменам, теория, астрономия. Порядок — по числу ссылок от других участников каталога.'
        : 'A catalog of physics Telegram channels and websites for olympiad preparation, ordered by how often other catalog members cite them.' %>" />
    <link rel="canonical" href="https://savchenkosolutions.com/recommendations<%= tab === 'websites' ? '/sites' : '' %>" />
    <meta property="og:title" content="<%= lang === 'ru' ? 'Обширный каталог ресурсов по физике' : 'A comprehensive catalog of physics resources' %> — Savchenko Solutions" />
    <meta property="og:url" content="https://savchenkosolutions.com/recommendations" />
    <meta property="og:image" content="https://savchenkosolutions.com/img/logo.png" />
    <%- include('_head') %>
</head>
<body>
<%- include('../default/main_site_header') %>

<div class="rec-wrap">
    <%# Deliberately plain. The catalog is the thing worth looking at — the counts
        and the channel names carry it. Claims about how it was built belong on the
        methodology page, not in front of someone who came here for a link. %>
    <h1 class="rec-h1"><%= lang === 'ru' ? 'Обширный каталог ресурсов по физике' : 'A comprehensive catalog of physics resources' %></h1>
    <p class="rec-sub">
        <% if (lang === 'ru') { %>
            Крупнейший в мире каталог материалов для подготовки к олимпиадам по физике и научной работы.
            Предложения и дополнения: <a href="mailto:alex@savchenkosolutions.com">alex@savchenkosolutions.com</a>
        <% } else { %>
            The world&rsquo;s biggest recommendation source for physics olympiad preparation and research materials.
            For suggestions and completeness, please contact
            <a href="mailto:alex@savchenkosolutions.com">alex@savchenkosolutions.com</a>
        <% } %>
    </p>

    <%- include('_tabs') %>

    <% if (!core.length && !exam.length && !adjacent.length) { %>
        <p class="rec-sub" style="margin-top:20px;">
            <%= lang === 'ru' ? 'Этот раздел каталога пока готовится.' : 'This half of the catalog is still being built.' %>
        </p>
    <% } %>

    <%# One band per purpose, each its own grid so its last row is always full.

        A single "core" band used to carry olympiad archives and ЕГЭ drill sites
        side by side. The page above promises a catalog for olympiad preparation
        and research, and school leaving exams are a different and easier target —
        a reader who came for Savchenko should not meet them first. Nothing is
        removed: a large share of readers do sit these exams, and Belarus and
        Ukraine alone are around 12,000 of them. They just sit behind a heading
        that says what they are. %>
    <% var bands = [
        { rows: core,     cols: coreCols, id: 'core' },
        { rows: exam,     cols: examCols, id: 'exam' },
        { rows: adjacent, cols: adjCols,  id: 'adjacent' }
    ]; %>
    <% bands.forEach(function (band) { %>
        <% if (!band.rows.length) { return; } %>

        <% if (band.id === 'core') { %>
            <div class="rec-count"><%= lang === 'ru' ? 'Для решения задач' : 'For working problems' %></div>
        <% } else if (band.id === 'exam') { %>
            <div class="rec-count"><%= lang === 'ru' ? 'Подготовка к экзаменам' : 'Exam preparation' %></div>
            <p class="rec-band-note">
                <%= lang === 'ru'
                    ? 'Школьные экзамены — ЕГЭ, ЦТ, ЗНО. Задачи там проще олимпиадных, поэтому вынесено отдельно.'
                    : 'School leaving and entrance exams. The problems are easier than olympiad ones, so they are kept apart.' %>
            </p>
        <% } else { %>
            <div class="rec-count"><%= lang === 'ru' ? 'Смежное' : 'Adjacent' %></div>
            <p class="rec-band-note">
                <%= lang === 'ru'
                    ? 'Тоже наука, но не материал для решения задач — вынесено отдельно, чтобы не мешать разделам выше.'
                    : 'Science, but not problem-solving material — kept separate so it does not crowd the sections above.' %>
            </p>
        <% } %>

        <div class="rec-grid rec-grid-main<%= band.id === 'core' ? '' : ' rec-band-soft' %>" style="--cols:<%= band.cols %>">
            <% band.rows.forEach(function (r) { %>
                <% var shown = band.id === 'core' ? r.entries : r.entries.slice(0, 12); %>
                <div class="rec-cell">
                    <div class="rec-rubric-title">
                        <a href="/<%= lang %>/recommendations/<%= r.id %>"><%= lang === 'ru' ? r.ru : r.en %></a><span class="rec-rubric-n">&nbsp;<%= r.count %></span>
                    </div>
                    <div class="rec-rubric-items">
                        <% shown.forEach(function (e, i) { %><a href="<%= e.url %>" rel="noopener nofollow" target="_blank"><%= e.title %></a><%= i < shown.length - 1 ? ', ' : '' %><% }); %><% if (r.count > shown.length) { %>&nbsp;<a class="rec-more" href="/<%= lang %>/recommendations/<%= r.id %>"><%= lang === 'ru' ? 'ещё ' + (r.count - shown.length) : (r.count - shown.length) + ' more' %></a><% } %>
                    </div>
                </div>
            <% }); %>
        </div>
    <% }); %>

    <div class="rec-note">
        <a class="rec-dl" href="/physics-telegram-catalog.pdf" download><%= lang === 'ru' ? 'Скачать PDF' : 'Download PDF' %></a>
        <span class="rec-note-text">
            <%= lang === 'ru'
                ? 'Весь каталог одним файлом, 68 страниц. Собран обходом 200 434 узлов Telegram и 1 299 403 веб-страниц.'
                : 'The whole catalog in one file, 68 pages. Assembled from a crawl of 200,434 Telegram nodes and 1,299,403 web pages.' %>
            <a href="/<%= lang %>/recommendations/methodology"><%= lang === 'ru' ? 'Как это устроено' : 'How this was built' %></a>.
            <% if (generated) { %><%= lang === 'ru' ? 'Срез от' : 'Snapshot' %> <%= generated %>.<% } %>
        </span>
    </div>
</div>

<%- include('../default/modern_footer') %>
</body>
</html>
