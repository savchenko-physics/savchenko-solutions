<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
<link rel="icon" type="image/png" href="/img/logo.png" />
<script src="/js/vendor/bootstrap.bundle.min.js"></script>
<style>
    /* Dense academic directory. Reference points: Yandex.Katalog's numbered rows
       and the score bars in the original PageRank paper. Design system: no
       gradients, no shadow above 0 1px 3px, no radius above 8px, no emoji. */
    /* Sticky footer: short pages otherwise leave white space BELOW the footer,
       because body stops at content height. Flex column + min-height:100vh puts
       the footer at the bottom of the viewport and flush to the page end. */
    html, body { height: auto; }
    body { display: flex; flex-direction: column; min-height: 100vh; margin: 0; }
    body > footer { flex-shrink: 0; margin-top: auto; }

    /* Use the width. A 1180px column in a 1900px viewport wastes a third of the
       screen on a directory whose whole job is showing many rows at once. */
    .rec-wrap { width: 100%; max-width: 1660px; margin: 0 auto;
                padding: var(--ss-space-4) var(--ss-space-7) var(--ss-space-6); flex: 1 0 auto; }
    .rec-crumb { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-2); }
    .rec-crumb a { color: var(--ss-link); text-decoration: none; }
    .rec-crumb a:hover { color: var(--ss-link-hover); text-decoration: underline; }
    .rec-h1 { font-family: var(--ss-font-ui); font-weight: var(--ss-fw-strong); color: var(--ss-navy);
              font-size: var(--ss-fs-24); margin: 0 0 var(--ss-space-1); }
    /* High specificity + every link state: the site-wide `a` colour would
       otherwise paint this blue-on-navy and make the label unreadable. */
    .rec-wrap a.rec-dl,
    .rec-wrap a.rec-dl:link,
    .rec-wrap a.rec-dl:visited,
    .rec-wrap a.rec-dl:hover,
    .rec-wrap a.rec-dl:active,
    .rec-wrap a.rec-dl:focus {
        display: inline-block; background: var(--ss-navy); color: var(--ss-on-navy) !important;
        text-decoration: none; font-size: var(--ss-fs-14); font-weight: var(--ss-fw-regular);
        padding: var(--ss-space-2) var(--ss-space-4); border-radius: var(--ss-radius); border: 1px solid var(--ss-navy);
    }
    .rec-wrap a.rec-dl:hover { background: var(--ss-navy-hover); border-color: #2d2d4a; }
    .rec-wrap a.rec-dl:focus-visible { outline: 2px solid var(--ss-link); outline-offset: 2px; }
    .rec-sub { color: var(--ss-text-secondary); font-size: var(--ss-fs-13); line-height: 1.55; margin: 0 0 var(--ss-space-3); max-width: 900px; }
    .rec-sub a { color: var(--ss-link); text-decoration: none; }
    .rec-sub a:hover { text-decoration: underline; }

    /* Tabs — the two corpora are separate collections, and the page has to say so. */
    .rec-tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--ss-rule); margin-bottom: var(--ss-space-1); }
    .rec-tab { padding: var(--ss-space-2) var(--ss-space-4); font-size: var(--ss-fs-14); color: var(--ss-text-secondary); text-decoration: none;
               border: 1px solid transparent; border-bottom: none; border-radius: var(--ss-radius) var(--ss-radius) 0 0;
               position: relative; top: 1px; }
    .rec-tab:hover { color: var(--ss-link); }
    .rec-tab.on { color: var(--ss-navy); font-weight: var(--ss-fw-strong); background: var(--ss-surface);
                  border-color: var(--ss-rule); }
    .rec-tab .n { color: var(--ss-text-secondary); font-weight: 400; font-size: var(--ss-fs-13); margin-left: var(--ss-space-1); }
    .rec-tabnote { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin: var(--ss-space-2) 0 var(--ss-space-3); }

    .rec-count { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); text-transform: uppercase;
                 letter-spacing: .05em; font-weight: var(--ss-fw-strong); margin: var(--ss-space-4) 0 var(--ss-space-3); }

    /* Four columns so four core rubrics fill one row instead of leaving a gap. */
    .rec-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: var(--ss-space-5) var(--ss-space-7); align-items: start; }
    /* The rubric grid is the centrepiece — cells get real presence rather than
       reading as a footnote under a paragraph of explanation. */
    /* Column count comes from the rubric count (see gridColumns in
       recommendations.js) so the final row is always full. auto-fit would fit as
       many as the width allows and leave the remainder as a hole. */
    .rec-grid-main { gap: var(--ss-space-7) var(--ss-space-8); margin-bottom: var(--ss-space-3); align-items: start;
        grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); }
    @media (max-width: 1240px) { .rec-grid-main { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 900px)  { .rec-grid-main { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 620px)  { .rec-grid-main { grid-template-columns: minmax(0, 1fr); } }
    .rec-grid-main .rec-cell { border-left: 2px solid var(--ss-rule); padding-left: var(--ss-space-4); }
    .rec-grid-main .rec-rubric-title { font-size: var(--ss-fs-18); margin-bottom: var(--ss-space-2); }
    .rec-grid-main .rec-rubric-items { font-size: var(--ss-fs-16); line-height: 1.8; color: var(--ss-text-secondary); }
    /* Bands below the first one: same structure, one step down in weight. They
       are secondary, not invisible — an earlier version set them in 13.5px
       inline text and readers went whole sessions without noticing them. */
    .rec-band-soft { gap: var(--ss-space-6) var(--ss-space-8); }
    .rec-band-soft .rec-cell { border-left-color: var(--ss-rule-soft) !important; }
    .rec-band-soft .rec-rubric-title { font-size: var(--ss-fs-16) !important; margin-bottom: var(--ss-space-1); }
    .rec-band-soft .rec-rubric-items { font-size: var(--ss-fs-14) !important; line-height: 1.7 !important; color: var(--ss-text-secondary); }
    .rec-also { margin-top: var(--ss-space-6); padding-top: var(--ss-space-1); border-top: 1px solid var(--ss-rule-soft); }
    .rec-also-items { font-size: var(--ss-fs-14); line-height: 1.9; }
    .rec-also-where { color: var(--ss-text-secondary); font-size: var(--ss-fs-13); }
    .rec-also-where a { color: var(--ss-text-secondary) !important; }
    .rec-band-note { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin: 0 0 var(--ss-space-3); max-width: 66ch; }
    .rec-more { white-space: nowrap; color: var(--ss-text-secondary) !important; font-size: var(--ss-fs-14); }
    .rec-more:hover { color: var(--ss-link) !important; }
    .rec-rubric-title { font-size: var(--ss-fs-16); font-weight: var(--ss-fw-strong); margin: 0 0 var(--ss-space-1); line-height: 1.3; }
    .rec-rubric-title a { color: var(--ss-link); text-decoration: none; }
    .rec-rubric-title a:hover { text-decoration: underline; }
    /* white-space:nowrap keeps the count on the same line as the last word of
       the rubric name; the non-breaking space in the markup does the joining. */
    .rec-rubric-n { color: var(--ss-text-secondary); font-weight: 400; font-size: var(--ss-fs-13); white-space: nowrap; }
    .rec-rubric-items { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); line-height: 1.6; }
    .rec-rubric-items a { color: var(--ss-link); text-decoration: none; }
    .rec-rubric-items a:hover { text-decoration: underline; }

    .rec-layout { display: grid; grid-template-columns: 190px 1fr; gap: var(--ss-space-8); align-items: start; }
    .rec-rail h3 { font-size: var(--ss-fs-12); text-transform: uppercase; letter-spacing: .04em;
                   color: var(--ss-text-secondary); font-weight: var(--ss-fw-strong); margin: 0 0 var(--ss-space-1); }
    .rec-rail ul { list-style: none; padding: 0; margin: 0 0 var(--ss-space-5); font-size: var(--ss-fs-14); }
    .rec-rail li { margin-bottom: 2px; }
    .rec-rail a { color: var(--ss-link); text-decoration: none; }
    .rec-rail a:hover { text-decoration: underline; }
    .rec-rail a.on { font-weight: var(--ss-fw-strong); color: var(--ss-navy); }
    .rec-rail .n { color: var(--ss-text-secondary); }

    .rec-list { list-style: none; counter-reset: rec; padding: 0; margin: 0; }
    .rec-item { counter-increment: rec; position: relative; padding: 0 0 var(--ss-space-4) var(--ss-space-7);
                margin-bottom: var(--ss-space-4); border-bottom: 1px solid var(--ss-rule-soft); }
    .rec-item::before { content: counter(rec) "."; position: absolute; left: 0; top: 1px;
                        color: var(--ss-text-tertiary); font-size: var(--ss-fs-13); }
    .rec-title { font-size: var(--ss-fs-16); font-weight: var(--ss-fw-strong); margin: 0 0 2px; line-height: 1.35; }
    .rec-title a { color: var(--ss-link); text-decoration: none; }
    .rec-title a:hover { text-decoration: underline; }
    .rec-badge { display: inline-block; font-size: var(--ss-fs-12); color: var(--ss-text-secondary);
                 border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-sm); padding: 0 var(--ss-space-1); margin-left: var(--ss-space-1);
                 vertical-align: 2px; font-weight: 400; }
    .rec-summary { font-size: var(--ss-fs-14); color: var(--ss-text); line-height: 1.55; margin: 0 0 var(--ss-space-1); }
    .rec-quote { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); line-height: 1.45; margin: 0 0 var(--ss-space-1);
                 border-left: 2px solid var(--ss-rule); padding-left: var(--ss-space-2); }
    .rec-meta { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); display: flex; flex-wrap: wrap;
                gap: var(--ss-space-3); align-items: center; }
    .rec-url { color: var(--ss-success-strong); }
    .rec-bar { font-family: var(--ss-font-mono); letter-spacing: -1px;
               color: var(--ss-navy); }
    .rec-bar .off { color: #dee2e6; }
    .rec-tags { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-top: var(--ss-space-1); }

    .rec-chips { margin-bottom: var(--ss-space-3); font-size: var(--ss-fs-13); }
    .rec-chip { display: inline-block; border: 1px solid var(--ss-rule); border-radius: var(--ss-radius);
                padding: 1px var(--ss-space-2); margin-right: var(--ss-space-1); color: var(--ss-text); }
    .rec-chip a { color: var(--ss-error); text-decoration: none; margin-left: var(--ss-space-1); }

    .rec-note { background: var(--ss-surface-alt); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg);
                padding: var(--ss-space-4) var(--ss-space-4); font-size: var(--ss-fs-13); color: var(--ss-text-secondary); line-height: 1.6;
                margin: var(--ss-space-6) 0 0; max-width: 1000px;
                display: flex; gap: var(--ss-space-4); align-items: center; flex-wrap: wrap; }
    .rec-note-text { flex: 1 1 320px; }
    .rec-note a { color: var(--ss-link); }

    @media (max-width: 820px) {
        .rec-wrap { padding: var(--ss-space-4) var(--ss-space-4) var(--ss-space-6); }
        .rec-layout { grid-template-columns: 1fr; gap: var(--ss-space-4); }
        .rec-rail { display: flex; flex-wrap: wrap; gap: 0 var(--ss-space-5); }
        .rec-rail ul { margin-bottom: var(--ss-space-2); }
    }
</style>
