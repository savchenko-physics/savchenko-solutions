<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta name="robots" content="noindex, nofollow" />
    <%- include(`default/head_${lang}.ejs`) %>
    <%- include('default/main_site_header_head') %>
    <title><%= titleText(t.resetTitle) %></title>
    <script src="/js/analytics.js"></script>
</head>
<body class="auth-page">
    <%- include('default/header.ejs') %>
    <div class="container1">
        <h2><%= t.resetTitle %></h2>
        <% if (state === 'form') { %>
            <% if (error) { %>
                <p class="error" role="alert"><%= error %></p>
            <% } %>
            <p class="mt-0 mb-3"><%= t.resetIntro %> <strong><%= accountName %></strong>.</p>
            <form action="/reset-password" method="POST">
                <input type="hidden" name="lang" value="<%= lang %>">
                <%# Lets a password manager file the new password under the right username. %>
                <input type="text" name="username" value="<%= accountName %>" autocomplete="username" hidden>
                <div class="form-group">
                    <label for="password"><%= t.passwordLabel %></label>
                    <input type="password" id="password" name="password" required minlength="<%= limits.passwordMinLength %>" autocomplete="new-password" />
                    <div class="ss-field-hint"><%= t.passwordHint %></div>
                </div>
                <div class="form-group">
                    <label for="confirmPassword"><%= t.confirmLabel %></label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required minlength="<%= limits.passwordMinLength %>" autocomplete="new-password" />
                </div>
                <button type="submit" class="submit-button"><%= t.resetSubmit %></button>
            </form>
        <% } else { %>
            <p class="error" role="alert"><%= error || t.linkInvalid %></p>
            <p><%= t.linkInvalidHint %> <a href="/forgot-password?lang=<%= lang %>"><%= t.requestNew %></a></p>
        <% } %>
        <p><a href="/<%= lang %>/login"><%= t.backToLogin %></a></p>
    </div>
    <%- include('default/modern_footer') %>
    <%- include('default/main_site_footer_scripts') %>
</body>
</html>
