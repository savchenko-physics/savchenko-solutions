  <style>
    :root {
      --primary-color: #1e3a8a;       /* Dark Blue */
      --secondary-color: #3b82f6;     /* Light Blue */
      --text-color: #1f2937;          /* Dark Gray */
      --diff-bg: #f3f4f6;             /* Subtle gray background for code diffs */
      --navbar-bg-gradient: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
      --bg-light: #f9fafb;
      --border-color: #e2e8f0;
    }

    body {
      font-family: var(--ss-font-ui);
      color: var(--text-color);
      background-color: var(--ss-surface);
      margin: 0;
      padding: 0;
    }

    /* Navbar */
    .navbar-custom {
      background: var(--navbar-bg-gradient);
      border-bottom: 1px solid var(--border-color);
      box-shadow: var(--ss-shadow);
    }
    .navbar-custom .navbar-brand,
    .navbar-custom .nav-link {
      color: var(--text-color) !important;
      font-weight: var(--ss-fw-strong);
    }
    .navbar-custom .navbar-toggler-icon {
      color: var(--text-color) !important;
    }
    .navbar-brand-container {
      background: var(--ss-surface);
      padding: var(--ss-space-2) var(--ss-space-3);
      border-radius: var(--ss-radius-sm);
      display: flex;
      align-items: center;
      transition: background-color 0.3s ease;
    }
    .navbar-brand-container:hover {
      background-color: #f1f5f9;
    }
    .logo-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
      border-radius: 0;
    }

    /* Search dropdown example styling */
    .search {
      position: relative;
    }
    .modern-search {
      width: 250px;
      border-radius: var(--ss-radius);
      border: 1px solid #cad2df;
      padding: var(--ss-space-1) var(--ss-space-4);
      transition: border-color 0.2s;
    }
    .modern-search:focus {
      outline: none;
      border-color: var(--secondary-color);
    }
    .search-results {
      max-height: 200px;
      overflow-y: auto;
      display: none; /* hidden by default */
    }
    .search-result-item:hover {
      background-color: var(--ss-surface-alt);
    }

    /* Hero Example (Optional) */
    .hero-profile {
      background: linear-gradient(to bottom,
          rgba(255, 255, 255, 0.9),
          rgba(255, 255, 255, 0.95)),
        url('https://savchenkosolutions.com/img/logo.png') no-repeat center / 20%;
      padding: var(--ss-space-9) 0;
      margin-bottom: var(--ss-space-7);
    }
    .hero-profile .hero-content {
      text-align: center;
    }
    .hero-profile h1 {
      font-size: var(--ss-fs-40);
      font-weight: var(--ss-fw-strong);
      color: var(--primary-color);
    }
    .hero-profile p {
      font-size: var(--ss-fs-18);
      color: #4b5563;
      margin-bottom: var(--ss-space-4);
    }

    /* Main heading */
    .page-title {
      color: var(--primary-color);
      margin-top: var(--ss-space-4);
      margin-bottom: var(--ss-space-2);
      text-align: center;
      font-weight: var(--ss-fw-strong);
    }

    /* Subheader style */
    .undertitle {
      font-family: var(--ss-font-mono);
      font-size: var(--ss-fs-16);
      color: #49597b;
      background-color: var(--ss-surface-alt);
      display: inline-block;
      padding: var(--ss-space-1) var(--ss-space-3);
      border-radius: var(--ss-radius-sm);
      margin-bottom: var(--ss-space-4);
    }

    /* Card for changes info */
    .changes-card {
      margin-top: var(--ss-space-7);
      margin-bottom: var(--ss-space-7);
      border: 1px solid var(--border-color);
      border-radius: var(--ss-radius);
    }
    .changes-card:hover {
      box-shadow: var(--ss-shadow);
    }

    /* Diff container styling */
    #outputdiv {
      background-color: var(--diff-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--ss-radius);
      padding: var(--ss-space-4);
      overflow-x: auto;
      margin-bottom: var(--ss-space-9);
    }
    #outputdiv code {
      background: transparent;
      color: var(--text-color);
    }

    /* Commit link styling */
    .commit-link svg {
      margin-right: var(--ss-space-1);
    }

    /* Stats colors */
    .added-stat {
      color: var(--ss-success-strong); /* green */
      font-weight: var(--ss-fw-strong);
    }
    .removed-stat {
      color: var(--ss-error); /* red */
      font-weight: var(--ss-fw-strong);
    }

    /* Footer styling */
    .footer {
      border-top: 1px solid var(--border-color);
      padding: var(--ss-space-6) 0;
      text-align: center;
      background-color: var(--bg-light);
    }
    .footer p {
      margin: var(--ss-space-1) 0;
      color: var(--ss-text-secondary);
    }
    .footer-link {
      color: var(--primary-color);
      text-decoration: none;
      transition: color 0.3s;
    }
    .footer-link:hover {
      color: var(--secondary-color);
    }

    /* Responsive adjustments */
    @media (max-width: 576px) {
      .search {
        width: 100%;
      }
      .page-title {
        font-size: var(--ss-fs-24);
      }
      .undertitle {
        font-size: var(--ss-fs-13);
      }
      .modern-search {
        width: 100%;
        margin-bottom: var(--ss-space-4);
      }
    }

    /* Enhanced search results styling */
    .cdx-menu-item {
        padding: var(--ss-space-2) var(--ss-space-3);
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .cdx-menu-item:hover {
        background-color: var(--bg-light);
    }
    .cdx-menu-item__content {
        display: block;
    }
    .cdx-menu-item__text {
        display: flex;
        flex-direction: column;
    }
    .cdx-search-result-title {
        font-weight: var(--ss-fw-strong);
        margin-bottom: 2px;
    }
    .cdx-menu-item__text__description {
        font-size: var(--ss-fs-14);
        color: var(--ss-text-secondary);
    }
  </style>

  <script>
    // Initialize the diff match patch library
    var dmp = new diff_match_patch();

    function decodeHtmlEntities(str) {
      var txt = document.createElement("textarea");
      txt.innerHTML = str;
      return txt.value;
    }

    function launchDiff() {
      var text1 = decodeHtmlEntities(
        `<%= originalContent.replace(/\\/g, '\\\\').replace(/\${/g, '\\$\{') %>`
      );
      var text2 = decodeHtmlEntities(
        `<%= newContent.replace(/\\/g, '\\\\').replace(/\${/g, '\\$\{') %>`
      );
      var d = dmp.diff_main(text1, text2);
      dmp.diff_cleanupSemantic(d);
      var ds = dmp.diff_prettyHtml(d);
      document.getElementById("outputdiv").innerHTML = "<code>" + ds + "</code>";
    }

    window.onload = function () {
      launchDiff();
    };
  </script>
  <script src="/js/analytics.js"></script>
</head>

<body>
  <%- include('default/main_site_header', {
    langSwitchEnUrl: '/en/contributions/' + contribution.id,
    langSwitchRuUrl: '/ru/contributions/' + contribution.id
  }) %>

  <!-- Optional Hero Section -->
