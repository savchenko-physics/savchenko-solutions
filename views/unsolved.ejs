<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta http-equiv="content-language" content="<%= lang %>" />
  <meta name="keywords" content="<%= __('meta.keywords') %>" />
  <meta name="description" content="<%= __('meta.description') %>" />
  <meta name="author" content="<%= __('meta.author') %>" />
  <meta property="og:title" content="<%= titleText(__('title')) %>" />
  <meta property="og:image" content="https://savchenkosolutions.com/img/logo.png" />
  <meta property="og:description" content="<%= __('meta.ogDescription') %>" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="icon" type="image/png" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <title><%= titleText(__('unsolved.title')) %></title>

  <%- include('default/site_styles', { ssStyles: { icons: 'bi' } }) %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>

  <style>
    body {
      font-family: var(--ss-font-ui);
      background-color: var(--ss-surface);
    }

    .unsolved-page {
      max-width: none;
      margin: 0;
      padding: var(--ss-space-8) var(--ss-space-7) var(--ss-space-10);
    }

    .unsolved-header {
      margin-bottom: var(--ss-space-8);
    }
    .unsolved-header h1 {
      font-size: var(--ss-fs-28);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-navy);
      margin: 0 0 var(--ss-space-1);
      font-family: var(--ss-font-ui);
    }
    .unsolved-header p {
      font-size: var(--ss-fs-16);
      color: var(--ss-text-secondary);
      margin: 0;
    }

    /* Most Requested */
    .most-wanted {
      margin-bottom: var(--ss-space-8);
    }
    .most-wanted h2 {
      font-size: var(--ss-fs-18);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-navy);
      margin: 0 0 var(--ss-space-4);
      font-family: var(--ss-font-ui);
    }
    .most-wanted-list {
      list-style: none;
      padding: 0;
      margin: 0;
      border: 1px solid var(--ss-rule);
      border-radius: var(--ss-radius-lg);
      overflow: hidden;
    }
    .most-wanted-item {
      display: flex;
      align-items: center;
      gap: var(--ss-space-3);
      padding: var(--ss-space-3) var(--ss-space-4);
      border-bottom: 1px solid var(--ss-rule-soft);
      font-size: var(--ss-fs-14);
    }
    .most-wanted-item:last-child {
      border-bottom: none;
    }
    .most-wanted-item a {
      color: var(--ss-link);
      text-decoration: none;
      font-weight: var(--ss-fw-strong);
      white-space: nowrap;
    }
    .most-wanted-item a:hover {
      color: var(--ss-link-hover);
      text-decoration: underline;
    }
    .most-wanted-context {
      color: var(--ss-text-secondary);
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .most-wanted-views {
      color: var(--ss-text-secondary);
      font-size: var(--ss-fs-13);
      white-space: nowrap;
    }

    /* Accordion */
    .chapter-accordion {
      border: 1px solid var(--ss-rule);
      border-radius: var(--ss-radius-lg);
      overflow: hidden;
    }
    .chapter-row {
      border-bottom: 1px solid var(--ss-rule-soft);
    }
    .chapter-row:last-child {
      border-bottom: none;
    }
    .chapter-header {
      display: flex;
      align-items: center;
      gap: var(--ss-space-3);
      padding: var(--ss-space-3) var(--ss-space-4);
      cursor: pointer;
      user-select: none;
      background: none;
      border: none;
      width: 100%;
      text-align: left;
      font-family: inherit;
      transition: background 100ms ease;
    }
    .chapter-header:hover {
      background: var(--ss-surface-alt);
    }
    .chapter-toggle {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
      transition: transform 200ms ease;
      flex-shrink: 0;
      width: 12px;
      text-align: center;
    }
    .chapter-row.is-open .chapter-toggle {
      transform: rotate(90deg);
    }
    /* Fully-solved chapters get a lock instead of an expand toggle. */
    .chapter-header--static {
      cursor: default;
    }
    .chapter-header--static:hover {
      background: none;
    }
    .chapter-lock {
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
      flex-shrink: 0;
      width: 12px;
      display: inline-flex;
      justify-content: center;
    }
    .chapter-name {
      font-size: var(--ss-fs-16);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text);
      flex: 1;
      min-width: 0;
    }
    .chapter-progress-bar {
      width: 180px;
      height: 6px;
      border-radius: var(--ss-radius-sm);
      background: var(--ss-surface-hover);
      overflow: hidden;
      flex-shrink: 0;
    }
    .chapter-progress-fill {
      display: block;
      height: 100%;
      border-radius: var(--ss-radius-sm);
      background: var(--ss-navy);
      transition: width 300ms ease;
    }
    /* Completed chapters are done — fade them back so the eye lands on the
       chapters that still need work. */
    .chapter-row.is-complete {
      opacity: 0.5;
    }
    .chapter-row.is-complete .chapter-progress-fill {
      background: var(--ss-success);
    }
    .chapter-stats {
      font-size: var(--ss-fs-13);
      color: var(--ss-text-secondary);
      white-space: nowrap;
      min-width: 60px;
      text-align: right;
    }

    .chapter-body {
      display: none;
      padding: 0 var(--ss-space-4) var(--ss-space-4);
    }
    .chapter-row.is-open .chapter-body {
      display: block;
    }

    .section-block {
      margin-top: var(--ss-space-4);
    }
    .section-block:first-child {
      margin-top: var(--ss-space-2);
    }
    .section-info {
      display: flex;
      align-items: center;
      gap: var(--ss-space-2);
      margin-bottom: var(--ss-space-2);
    }
    .section-name {
      font-size: var(--ss-fs-14);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-text);
      flex: 1;
    }
    .section-stats {
      font-size: var(--ss-fs-13);
      color: var(--ss-text-secondary);
      white-space: nowrap;
    }

    .problem-grid {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ss-space-2);
    }
    .problem-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: var(--ss-space-1) var(--ss-space-3);
      font-size: var(--ss-fs-13);
      font-weight: var(--ss-fw-strong);
      color: var(--ss-link);
      background: var(--ss-surface-alt);
      border: 1px solid var(--ss-rule);
      border-radius: var(--ss-radius-sm);
      text-decoration: none;
      transition: border-color 150ms ease, background 150ms ease;
    }
    .problem-chip:hover {
      background: #eef3f7;
      border-color: var(--ss-link);
      color: var(--ss-link-hover);
    }

    /* Difficulty heatmap — the same YlOrRd scale as the homepage. The heat-N /
       heat-none / heat-starred colour rules live in design-system.css and only bite
       under body.grid-heat; grid-mode.js drives the toggle and shares its on/off choice
       with the homepage via localStorage, so the reader's setting follows them here. */
    .unsolved-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--ss-space-3);
      margin-bottom: var(--ss-space-4);
    }
    .grid-legend {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ss-space-4);
      margin: 0;
      font-size: var(--ss-fs-12);
      color: var(--ss-text-secondary);
    }
    .heat-legend { gap: var(--ss-space-2); }
    .legend-item { display: flex; align-items: center; gap: var(--ss-space-2); }
    .legend-swatch {
      display: inline-block;
      width: 16px;
      height: 14px;
      border-radius: var(--ss-radius-sm);
      flex: 0 0 auto;
    }
    .unsolved-heat-toggle { margin-left: auto; }
    body.grid-heat .problem-chip {
      border-color: transparent;
      font-weight: var(--ss-fw-strong);
    }

    @media (max-width: 576px) {
      .unsolved-page {
        padding: var(--ss-space-6) var(--ss-space-4) var(--ss-space-8);
      }
      .unsolved-header h1 {
        font-size: var(--ss-fs-24);
      }
      .chapter-progress-bar {
        width: 80px;
      }
      .chapter-name {
        font-size: var(--ss-fs-14);
      }
      .most-wanted-context {
        display: none;
      }
    }
  </style>
  <script src="/js/analytics.js"></script>
</head>
<body>
  <%- include('default/main_site_header', {
    langSwitchEnUrl: '/en/unsolved',
    langSwitchRuUrl: '/ru/unsolved'
  }) %>

  <div class="unsolved-page">
    <div class="unsolved-header">
      <h1><%= totalProblems - totalUniqueSolutions %> <%= lang === 'ru' ? 'Нерешённых задач' : 'Unsolved Problems' %></h1>
      <p><%= lang === 'ru' ? 'Помогите завершить самый полный сборник решений Савченко.' : 'Help complete the most comprehensive Savchenko solution set.' %></p>
    </div>

    <% if (mostWanted && mostWanted.length > 0) { %>
    <div class="most-wanted">
      <h2><%= lang === 'ru' ? 'Самые запрашиваемые' : 'Most Requested' %></h2>
      <ul class="most-wanted-list">
        <% mostWanted.forEach(function(mw) { %>
        <li class="most-wanted-item">
          <a href="/<%= lang %>/upload?problem=<%= encodeURIComponent(mw.problem) %>"><%= mw.problem %></a>
          <span class="most-wanted-context"><%= mw.chapter %> &mdash; <%= mw.section %></span>
          <span class="most-wanted-views"><%= lang === 'ru' ? 'просмотров: ' + mw.views : 'viewed ' + mw.views + ' times' %></span>
        </li>
        <% }); %>
      </ul>
    </div>
    <% } %>

    <% if (typeof hasDifficulty !== 'undefined' && hasDifficulty) { %>
    <div class="unsolved-toolbar">
      <div class="grid-legend heat-legend" data-grid-mode-when="difficulty" hidden>
        <span class="legend-item"><%= lang === 'ru' ? 'Легче' : 'Easier' %></span>
        <span class="heat-ramp"><% for (let i = 1; i <= 9; i++) { %><span class="heat-chip heat-<%= i %>"></span><% } %></span>
        <span class="legend-item"><%= lang === 'ru' ? 'Труднее' : 'Harder' %></span>
        <span class="legend-item">
          <span class="legend-swatch legend-star"></span>
          <%= lang === 'ru' ? 'Отмечена ∗ Савченко' : 'Marked ∗ by Savchenko' %>
        </span>
      </div>
      <label class="ss-switch unsolved-heat-toggle" for="heatmapToggle">
        <input type="checkbox" id="heatmapToggle" role="switch" data-grid-mode-toggle />
        <span class="ss-switch-track" aria-hidden="true"><span class="ss-switch-knob"></span></span>
        <span class="ss-switch-label"><%= lang === 'ru' ? 'Сложность' : 'Difficulty' %></span>
      </label>
    </div>
    <% } %>

    <div class="chapter-accordion">
      <% chapterData.forEach(function(ch) { %>
      <% var isComplete = ch.solved >= ch.total; %>
      <div class="chapter-row<%= isComplete ? ' is-complete' : ' is-open' %>">
        <% if (isComplete) { %>
        <div class="chapter-header chapter-header--static">
          <span class="chapter-lock" title="<%= lang === 'ru' ? 'Глава полностью решена' : 'Chapter fully solved' %>"><i class="bi bi-lock-fill"></i></span>
          <span class="chapter-name"><%= lang === 'ru' ? 'Глава' : 'Chapter' %> <%= ch.chapterNum %>. <%= ch.title %></span>
          <span class="chapter-progress-bar">
            <span class="chapter-progress-fill" style="width: 100%;"></span>
          </span>
          <span class="chapter-stats"><%= ch.solved %> / <%= ch.total %></span>
        </div>
        <% } else { %>
        <button type="button" class="chapter-header" aria-expanded="true">
          <span class="chapter-toggle">&#9654;</span>
          <span class="chapter-name"><%= lang === 'ru' ? 'Глава' : 'Chapter' %> <%= ch.chapterNum %>. <%= ch.title %></span>
          <span class="chapter-progress-bar">
            <span class="chapter-progress-fill" style="width: <%= ch.total > 0 ? ((ch.solved / ch.total) * 100).toFixed(1) : 0 %>%;"></span>
          </span>
          <span class="chapter-stats"><%= ch.solved %> / <%= ch.total %></span>
        </button>
        <div class="chapter-body">
          <% ch.sections.forEach(function(sec) { %>
          <div class="section-block">
            <div class="section-info">
              <span class="section-name"><%= ch.chapterNum %>.<%= sec.sectionNum %>: <%= sec.title %></span>
              <span class="section-stats"><%= sec.solved %> / <%= sec.total %></span>
            </div>
            <div class="problem-grid">
              <% sec.unsolved.forEach(function(prob) { %>
              <a href="/<%= lang %>/upload?problem=<%= encodeURIComponent(prob.problem) %>" class="problem-chip <%= prob.heat ? 'heat-' + prob.heat + (prob.starred ? ' heat-starred' : '') : 'heat-none' %>" title="<%= (lang === 'ru' ? 'Задача ' : 'Problem ') + prob.problem + (prob.heat ? (lang === 'ru' ? ' · сложность ' : ' · difficulty ') + prob.heat + '/9' + (prob.starred ? (lang === 'ru' ? ', отмечена ∗ Савченко' : ', marked ∗ by Savchenko') : '') : '') %>"><%= prob.problem %></a>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
      <% }); %>
    </div>
  </div>

  <%- include('default/modern_footer') %>

  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <script src="<%= av('/js/grid-mode.js') %>" defer></script>
  <script>
    document.querySelectorAll('button.chapter-header').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const row = btn.closest('.chapter-row');
        const isOpen = row.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  </script>
</body>
</html>
