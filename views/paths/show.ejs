<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= docTitle(studyPath.title, __('pathsPage.title'), __('title')) %></title>

  <script type="application/ld+json">
  {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "<%= studyPath.title.replace(/"/g, '\\"') %>",
      "description": "<%= (studyPath.description || '').replace(/"/g, '\\"') %>",
      "url": "https://savchenkosolutions.com/paths/<%= studyPath.slug %>",
      "provider": {
          "@type": "Organization",
          "name": "Savchenko Solutions",
          "url": "https://savchenkosolutions.com"
      },
      "educationalLevel": "University",
      "hasCourseInstance": {
          "@type": "CourseInstance",
          "courseMode": "Online"
      }
  }
  </script>

  <%- include('../default/site_styles', { ssStyles: { icons: 'fa6' } }) %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
" />
" />
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <style>
    body { font-family: var(--ss-font-ui); background: var(--ss-surface); color: var(--ss-text); }
    .path-container { max-width: 800px; margin: 0 auto; padding: var(--ss-space-7) var(--ss-space-6); }
    .back-link { font-size: var(--ss-fs-13); color: var(--ss-link); text-decoration: none; display: inline-flex; align-items: center; gap: var(--ss-space-1); margin-bottom: var(--ss-space-6); }
    .back-link:hover { color: var(--ss-link-hover); }
    .path-title { font-size: var(--ss-fs-24); font-weight: var(--ss-fw-strong); font-family: var(--ss-font-ui); margin-bottom: var(--ss-space-2); }
    .path-desc { font-size: var(--ss-fs-16); color: var(--ss-text-secondary); line-height: 1.6; margin-bottom: var(--ss-space-4); }
    .path-meta { display: flex; gap: var(--ss-space-5); flex-wrap: wrap; font-size: var(--ss-fs-14); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-6); }
    .path-meta-item { display: inline-flex; align-items: center; gap: var(--ss-space-1); }
    .difficulty-range { font-weight: var(--ss-fw-strong); color: var(--ss-navy); }

    /* Progress bar */
    .path-progress-section { margin-bottom: var(--ss-space-7); }
    .progress-bar-outer { height: 10px; background: var(--ss-surface-hover); border-radius: var(--ss-radius-sm); overflow: hidden; margin-bottom: var(--ss-space-2); }
    .progress-bar-fill { height: 100%; background: var(--ss-success); border-radius: var(--ss-radius-sm); transition: width 0.4s; }
    .progress-text { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); }

    /* Problem list */
    .problem-list { list-style: none; padding: 0; margin: 0; }
    .problem-item { display: flex; align-items: flex-start; gap: var(--ss-space-3); padding: var(--ss-space-3) 0; border-bottom: 1px solid var(--ss-rule-soft); }
    .problem-item:last-child { border-bottom: none; }
    .problem-num { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); flex-shrink: 0; }
    .problem-num--not_started { background: var(--ss-surface-hover); color: var(--ss-text-secondary); }
    .problem-num--attempted { background: var(--ss-warning-soft); color: var(--ss-warning); }
    .problem-num--solved { background: var(--ss-success-soft); color: var(--ss-success-strong); }
    .problem-body { flex: 1; min-width: 0; }
    .problem-ref { font-size: var(--ss-fs-16); font-weight: var(--ss-fw-regular); }
    .problem-ref a { color: var(--ss-link); text-decoration: none; }
    .problem-ref a:hover { color: var(--ss-link-hover); }
    .problem-source { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); margin-left: var(--ss-space-2); }
    .problem-notes { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-top: 2px; font-style: italic; }
    .problem-status { flex-shrink: 0; }

    /* Status toggle button */
    .status-btn { background: none; border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); padding: var(--ss-space-1) var(--ss-space-3); font-size: var(--ss-fs-12); cursor: pointer; color: var(--ss-text-secondary); }
    .status-btn:hover { background: var(--ss-surface-alt); }
    .status-btn--solved { border-color: var(--ss-success); color: var(--ss-success-strong); }
    .status-btn--attempted { border-color: var(--ss-warning-rule); color: var(--ss-warning); }

    .login-prompt { text-align: center; font-size: var(--ss-fs-14); color: var(--ss-text-secondary); padding: var(--ss-space-4); background: var(--ss-surface-alt); border-radius: var(--ss-radius); margin-bottom: var(--ss-space-6); }
    .login-prompt a { color: var(--ss-link); }
  </style>
</head>
<body>
  <%- include('../default/main_site_header') %>

  <div class="path-container">
    <a href="/paths" class="back-link">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= __('pathsPage.allPaths') %>
    </a>

    <h1 class="path-title"><%= studyPath.title %></h1>
    <% if (studyPath.description) { %>
    <p class="path-desc"><%= studyPath.description %></p>
    <% } %>

    <div class="path-meta">
      <% if (studyPath.difficulty_start && studyPath.difficulty_end) { %>
      <span class="path-meta-item">
        <span class="difficulty-range"><%= __('pathsPage.difficulty') %> <%= studyPath.difficulty_start %> &ndash; <%= studyPath.difficulty_end %></span>
      </span>
      <% } %>
      <span class="path-meta-item"><%= problems.length %> <%= __('pathsPage.problems') %></span>
      <% if (studyPath.estimated_hours) { %>
      <span class="path-meta-item">~<%= studyPath.estimated_hours %> <%= __('pathsPage.hours') %></span>
      <% } %>
      <% if (studyPath.author_name) { %>
      <span class="path-meta-item"><%= __('pathsPage.by') %> <a href="/user/<%= studyPath.author_name %>" style="color: var(--ss-link);"><%= studyPath.author_name %></a></span>
      <% } %>
    </div>

    <%
      const solvedCount = Object.values(progressMap).filter(function(p) { return p.status === 'solved'; }).length;
      const totalCount = problems.length;
      const pctDone = totalCount > 0 ? Math.round((solvedCount / totalCount) * 100) : 0;
    %>

    <% if (typeof username !== 'undefined' && username) { %>
    <div class="path-progress-section">
      <div class="progress-bar-outer">
        <div class="progress-bar-fill" id="progressFill" style="width: <%= pctDone %>%;"></div>
      </div>
      <span class="progress-text" id="progressText"><%= solvedCount %> / <%= totalCount %> <%= __('pathsPage.completed') %> (<%= pctDone %>%)</span>
    </div>
    <% } else { %>
    <div class="login-prompt">
      <a href="/<%= lang %>/login"><%= __('pathsPage.loginToTrack') %></a>
    </div>
    <% } %>

    <ul class="problem-list">
      <% problems.forEach(function(prob, idx) {
        const progress = progressMap[prob.problem_ref];
        const status = progress ? progress.status : 'not_started';
        const isLoggedIn = typeof username !== 'undefined' && username;
        const problemUrl = prob.problem_type === 'savchenko'
          ? '/' + lang + '/' + prob.problem_ref
          : prob.problem_type === 'bank'
            ? '/bank/problem/' + prob.problem_ref
            : '#';
        const sourceLabel = prob.problem_type === 'savchenko'
          ? 'Savchenko'
          : prob.problem_type === 'bank'
            ? (lang === 'ru' ? 'Банк задач' : 'Problem Bank')
            : (lang === 'ru' ? 'Задача' : 'Challenge');
      %>
      <li class="problem-item" data-ref="<%= prob.problem_ref %>">
        <span class="problem-num problem-num--<%= status %>"><%= idx + 1 %></span>
        <div class="problem-body">
          <div>
            <span class="problem-ref"><a href="<%= problemUrl %>"><%= prob.problem_ref %></a></span>
            <span class="problem-source"><%= sourceLabel %></span>
          </div>
          <% if (prob.notes) { %>
          <div class="problem-notes"><%= prob.notes %></div>
          <% } %>
        </div>
        <% if (isLoggedIn) { %>
        <div class="problem-status">
          <button class="status-btn status-btn--<%= status %>"
                  data-ref="<%= prob.problem_ref %>"
                  data-status="<%= status %>"
                  onclick="cycleStatus(this)"
                  title="<%= __('pathsPage.' + status.replace('not_started', 'notStarted')) %>">
            <%= status === 'solved' ? __('pathsPage.solved') : status === 'attempted' ? __('pathsPage.attempted') : __('pathsPage.notStarted') %>
          </button>
        </div>
        <% } %>
      </li>
      <% }); %>
    </ul>
  </div>

  <%- include('../default/modern_footer') %>

  <script>
  const statusCycle = ['not_started', 'attempted', 'solved'];
  const statusLabels = {
    not_started: "<%= __('pathsPage.notStarted') %>",
    attempted: "<%= __('pathsPage.attempted') %>",
    solved: "<%= __('pathsPage.solved') %>"
  };
  const completedLabel = "<%= __('pathsPage.completed') %>";
  const slug = '<%= studyPath.slug %>';
  let currentSolved = <%= solvedCount %>;
  const totalProblems = <%= totalCount %>;

  async function cycleStatus(btn) {
    const ref = btn.dataset.ref;
    const current = btn.dataset.status;
    const currentIdx = statusCycle.indexOf(current);
    const next = statusCycle[(currentIdx + 1) % statusCycle.length];

    btn.disabled = true;
    try {
      const resp = await fetch('/paths/' + slug + '/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ problem_ref: ref, status: next }),
      });
      const data = await resp.json();
      if (data.success) {
        btn.dataset.status = next;
        btn.textContent = statusLabels[next];
        btn.className = 'status-btn status-btn--' + next;

        const li = btn.closest('.problem-item');
        const num = li.querySelector('.problem-num');
        num.className = 'problem-num problem-num--' + next;

        if (current === 'solved' && next !== 'solved') currentSolved--;
        if (current !== 'solved' && next === 'solved') currentSolved++;
        const pct = totalProblems > 0 ? Math.round((currentSolved / totalProblems) * 100) : 0;
        const fill = document.getElementById('progressFill');
        const text = document.getElementById('progressText');
        if (fill) fill.style.width = pct + '%';
        if (text) text.textContent = currentSolved + ' / ' + totalProblems + ' ' + completedLabel + ' (' + pct + '%)';
      }
    } catch (err) {
      console.error('Failed to update status:', err);
    }
    btn.disabled = false;
  }
  </script>
  <%- include('../default/main_site_search_script') %>
  <script src="/js/analytics.js"></script>
</body>
</html>
