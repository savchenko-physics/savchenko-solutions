<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= docTitle(__('pathsPage.createTitle'), __('title')) %></title>
  <%- include('../default/site_styles', { ssStyles: { icons: 'fa6' } }) %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <style>
    body { font-family: var(--ss-font-ui); background: var(--ss-surface); color: var(--ss-text); }
    .form-container { max-width: 700px; margin: 0 auto; padding: var(--ss-space-7) var(--ss-space-6); }
    .back-link { font-size: var(--ss-fs-13); color: var(--ss-link); text-decoration: none; display: inline-flex; align-items: center; gap: var(--ss-space-1); margin-bottom: var(--ss-space-6); }
    .back-link:hover { color: var(--ss-link-hover); }
    .page-title { font-size: var(--ss-fs-24); font-weight: var(--ss-fw-strong); font-family: var(--ss-font-ui); margin-bottom: var(--ss-space-6); }
    .form-group { margin-bottom: var(--ss-space-5); }
    .form-group label { display: block; font-size: var(--ss-fs-14); font-weight: var(--ss-fw-strong); margin-bottom: var(--ss-space-1); }
    .form-group input, .form-group textarea, .form-group select {
      width: 100%; height: 40px; padding: 0 var(--ss-space-3); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius); font-size: var(--ss-fs-16);
    }
    .form-group textarea { height: auto; min-height: 100px; padding: var(--ss-space-3); resize: vertical; }
    .form-group .hint { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); margin-top: var(--ss-space-1); }
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ss-space-4); }
    .row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--ss-space-4); }

    .problems-section { margin-top: var(--ss-space-6); padding-top: var(--ss-space-6); border-top: 1px solid var(--ss-rule); }
    .problems-section h3 { font-size: var(--ss-fs-16); font-weight: var(--ss-fw-strong); margin-bottom: var(--ss-space-3); }
    .problem-entry { display: flex; gap: var(--ss-space-2); align-items: center; margin-bottom: var(--ss-space-2); }
    .problem-entry input { flex: 1; }
    .problem-entry select { width: 130px; }
    .problem-entry .remove-btn { background: none; border: none; color: var(--ss-error); cursor: pointer; font-size: var(--ss-fs-18); padding: 0 var(--ss-space-1); }
    .add-problem-btn { display: inline-block; padding: var(--ss-space-2) var(--ss-space-4); border: 1px dashed var(--ss-rule); border-radius: var(--ss-radius); font-size: var(--ss-fs-13); color: var(--ss-text-secondary); cursor: pointer; background: none; margin-top: var(--ss-space-2); }
    .add-problem-btn:hover { border-color: var(--ss-navy); color: var(--ss-navy); }

    .submit-btn { display: inline-block; padding: var(--ss-space-2) var(--ss-space-6); background: var(--ss-navy); color: var(--ss-on-navy); border: none; border-radius: var(--ss-radius); font-size: var(--ss-fs-14); font-weight: var(--ss-fw-strong); cursor: pointer; margin-top: var(--ss-space-6); }
    .submit-btn:hover { background: var(--ss-navy); }
    .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .form-msg { font-size: var(--ss-fs-13); margin-top: var(--ss-space-2); }
    .form-msg.error { color: var(--ss-error); }
    .form-msg.success { color: var(--ss-success-strong); }
  </style>
</head>
<body>
  <%- include('../default/main_site_header') %>

  <div class="form-container">
    <a href="/paths" class="back-link">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= __('pathsPage.allPaths') %>
    </a>

    <h1 class="page-title"><%= __('pathsPage.createTitle') %></h1>

    <div class="form-group">
      <label for="pathTitle"><%= __('pathsPage.titleLabel') %></label>
      <input type="text" id="pathTitle" placeholder="<%= __('pathsPage.titlePlaceholder') %>" maxlength="255" />
    </div>

    <div class="form-group">
      <label for="pathDesc"><%= __('pathsPage.descriptionLabel') %></label>
      <textarea id="pathDesc" placeholder="<%= __('pathsPage.descriptionPlaceholder') %>" maxlength="2000"></textarea>
    </div>

    <div class="row-3">
      <div class="form-group">
        <label for="diffStart"><%= __('pathsPage.difficultyStart') %></label>
        <select id="diffStart">
          <option value="">--</option>
          <% for (let i = 1; i <= 10; i++) { %><option value="<%= i %>"><%= i %></option><% } %>
        </select>
      </div>
      <div class="form-group">
        <label for="diffEnd"><%= __('pathsPage.difficultyEnd') %></label>
        <select id="diffEnd">
          <option value="">--</option>
          <% for (let i = 1; i <= 10; i++) { %><option value="<%= i %>"><%= i %></option><% } %>
        </select>
      </div>
      <div class="form-group">
        <label for="estHours"><%= __('pathsPage.estHours') %></label>
        <input type="number" id="estHours" min="1" max="200" placeholder="e.g. 20" />
      </div>
    </div>

    <div class="problems-section">
      <h3><%= __('pathsPage.problemsSection') %></h3>
      <p style="font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-4);"><%= __('pathsPage.addInOrder') %></p>
      <div id="problemList"></div>
      <button class="add-problem-btn" onclick="addProblem()"><%= __('pathsPage.addProblem') %></button>
    </div>

    <button class="submit-btn" id="createBtn" onclick="createPath()"><%= __('pathsPage.createPath') %></button>
    <div id="formMsg" class="form-msg"></div>
  </div>

  <%- include('../default/modern_footer') %>

  <script>
  const t = {
    noteOptional: "<%= __('pathsPage.noteOptional') %>",
    titleRequired: "<%= __('pathsPage.titleRequired') %>",
    creating: "<%= __('pathsPage.creating') %>",
    createPath: "<%= __('pathsPage.createPath') %>",
    networkError: "<%= __('pathsPage.networkError') %>",
    failedToCreate: "<%= __('pathsPage.failedToCreate') %>",
  };

  let problemCount = 0;

  function addProblem() {
    const list = document.getElementById('problemList');
    const idx = problemCount++;
    const div = document.createElement('div');
    div.className = 'problem-entry';
    div.id = 'prob-' + idx;
    div.innerHTML =
      '<select data-field="type">' +
        '<option value="savchenko">Savchenko</option>' +
        '<option value="bank">Bank</option>' +
        '<option value="challenge">Challenge</option>' +
      '</select>' +
      '<input type="text" data-field="ref" placeholder="e.g. 1.1.1" />' +
      '<input type="text" data-field="notes" placeholder="' + t.noteOptional + '" style="flex: 2;" />' +
      '<button class="remove-btn" onclick="this.parentElement.remove()">&times;</button>';
    list.appendChild(div);
  }

  addProblem(); addProblem(); addProblem();

  async function createPath() {
    const btn = document.getElementById('createBtn');
    const msg = document.getElementById('formMsg');
    const title = document.getElementById('pathTitle').value.trim();
    if (!title) {
      msg.className = 'form-msg error';
      msg.textContent = t.titleRequired;
      return;
    }

    const entries = document.querySelectorAll('.problem-entry');
    const problems = [];
    entries.forEach(function(el) {
      const ref = el.querySelector('[data-field="ref"]').value.trim();
      if (ref) {
        problems.push({
          type: el.querySelector('[data-field="type"]').value,
          ref: ref,
          notes: el.querySelector('[data-field="notes"]').value.trim() || null,
        });
      }
    });

    btn.disabled = true;
    btn.textContent = t.creating;
    msg.textContent = '';

    try {
      const resp = await fetch('/paths', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: title,
          description: document.getElementById('pathDesc').value.trim(),
          difficulty_start: document.getElementById('diffStart').value || null,
          difficulty_end: document.getElementById('diffEnd').value || null,
          estimated_hours: document.getElementById('estHours').value || null,
          problems: problems,
        }),
      });
      const data = await resp.json();
      if (data.success) {
        window.location.href = '/paths/' + data.slug;
      } else {
        msg.className = 'form-msg error';
        msg.textContent = data.error || t.failedToCreate;
      }
    } catch (err) {
      msg.className = 'form-msg error';
      msg.textContent = t.networkError;
    }
    btn.disabled = false;
    btn.textContent = t.createPath;
  }
  </script>
  <script src="/js/analytics.js"></script>
</body>
</html>
