<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= __('pathsPage.subtitle') %>" />
  <title><%= docTitle(__('pathsPage.title'), __('title')) %></title>
  <%- include('../default/site_styles', { ssStyles: { icons: 'fa6' } }) %>
  <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <script src="/js/vendor/bootstrap.bundle.min.js"></script>
  <style>
    body { font-family: var(--ss-font-ui); background: var(--ss-surface); color: var(--ss-text); }
    .paths-container { max-width: 900px; margin: 0 auto; padding: var(--ss-space-7) var(--ss-space-6); }
    .page-title { font-size: var(--ss-fs-28); font-weight: var(--ss-fw-strong); font-family: var(--ss-font-ui); margin-bottom: var(--ss-space-1); }
    .page-subtitle { font-size: var(--ss-fs-16); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-7); }
    .paths-grid { display: grid; gap: var(--ss-space-5); }

    .path-card { background: var(--ss-surface-alt); border: 1px solid var(--ss-rule); border-radius: var(--ss-radius-lg); padding: var(--ss-space-6); transition: box-shadow 0.15s; }
    .path-card:hover { box-shadow: var(--ss-shadow); }
    .path-card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--ss-space-4); margin-bottom: var(--ss-space-3); }
    .path-card-title { font-size: var(--ss-fs-16); font-weight: var(--ss-fw-strong); color: var(--ss-text); margin: 0; }
    .path-card-title a { color: var(--ss-link); text-decoration: none; }
    .path-card-title a:hover { color: var(--ss-link-hover); }
    .path-card-desc { font-size: var(--ss-fs-14); color: var(--ss-text-secondary); line-height: 1.5; margin-bottom: var(--ss-space-3); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .path-card-meta { display: flex; gap: var(--ss-space-4); flex-wrap: wrap; font-size: var(--ss-fs-13); color: var(--ss-text-secondary); align-items: center; }
    .path-meta-item { display: inline-flex; align-items: center; gap: var(--ss-space-1); }
    .difficulty-range { font-weight: var(--ss-fw-strong); color: var(--ss-navy); }
    .path-progress { margin-top: var(--ss-space-3); }
    .path-progress-bar { height: 6px; background: var(--ss-surface-hover); border-radius: var(--ss-radius-sm); overflow: hidden; margin-bottom: var(--ss-space-1); }
    .path-progress-fill { height: 100%; background: var(--ss-success); border-radius: var(--ss-radius-sm); transition: width 0.3s; }
    .path-progress-text { font-size: var(--ss-fs-12); color: var(--ss-text-secondary); }
    .path-card-action { margin-top: var(--ss-space-4); }
    .btn-path { display: inline-block; padding: var(--ss-space-2) var(--ss-space-4); border-radius: var(--ss-radius); font-size: var(--ss-fs-13); font-weight: var(--ss-fw-strong); text-decoration: none; }
    .btn-path,
    .btn-path:visited,
    .btn-path:hover,
    .btn-path:focus,
    .btn-path:active { color: var(--ss-on-navy) !important; text-decoration: none; }
    .btn-path-primary { background: var(--ss-navy); color: var(--ss-on-navy); }
    .btn-path-primary:hover { background: var(--ss-navy); }
    .btn-path-continue { background: var(--ss-success); color: var(--ss-on-navy); }
    .btn-path-continue:hover { background: var(--ss-success); }
    .empty-state { text-align: center; padding: var(--ss-space-9) var(--ss-space-4); color: var(--ss-text-secondary); }
  </style>
</head>
<body>
  <%- include('../default/main_site_header') %>

  <div class="paths-container">
    <h1 class="page-title"><%= __('pathsPage.title') %></h1>
    <p class="page-subtitle"><%= __('pathsPage.subtitle') %></p>

    <% if (paths.length > 0) { %>
    <div class="paths-grid">
      <% paths.forEach(function(p) {
        const progress = userProgress[p.id];
        const solvedCount = progress ? parseInt(progress.solved) : 0;
        const totalCount = p.problem_count || 0;
        const pct = totalCount > 0 ? Math.round((solvedCount / totalCount) * 100) : 0;
        const hasStarted = progress && (parseInt(progress.solved) > 0 || parseInt(progress.attempted) > 0);
      %>
      <div class="path-card">
        <div class="path-card-header">
          <h2 class="path-card-title"><a href="/paths/<%= p.slug %>"><%= p.title %></a></h2>
        </div>
        <p class="path-card-desc"><%= p.description %></p>
        <div class="path-card-meta">
          <% if (p.difficulty_start && p.difficulty_end) { %>
          <span class="path-meta-item">
            <span class="difficulty-range"><%= __('pathsPage.difficulty') %> <%= p.difficulty_start %> &ndash; <%= p.difficulty_end %></span>
          </span>
          <% } %>
          <span class="path-meta-item"><%= totalCount %> <%= __('pathsPage.problems') %></span>
          <% if (p.estimated_hours) { %>
          <span class="path-meta-item">~<%= p.estimated_hours %> <%= __('pathsPage.hours') %></span>
          <% } %>
          <% if (p.author_name) { %>
          <span class="path-meta-item"><%= __('pathsPage.by') %> <a href="/user/<%= p.author_name %>" style="color: var(--ss-link);"><%= p.author_name %></a></span>
          <% } %>
        </div>
        <% if (typeof username !== 'undefined' && username && totalCount > 0) { %>
        <div class="path-progress">
          <div class="path-progress-bar">
            <div class="path-progress-fill" style="width: <%= pct %>%;"></div>
          </div>
          <span class="path-progress-text"><%= solvedCount %> / <%= totalCount %> <%= __('pathsPage.completed') %> (<%= pct %>%)</span>
        </div>
        <% } %>
        <div class="path-card-action">
          <a href="/paths/<%= p.slug %>" class="btn-path <%= hasStarted ? 'btn-path-continue' : 'btn-path-primary' %>">
            <%= hasStarted ? __('pathsPage.continue') : __('pathsPage.start') %>
          </a>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <p style="font-size: var(--ss-fs-16); font-weight: var(--ss-fw-regular);"><%= __('pathsPage.noPathsYet') %></p>
      <p><%= __('pathsPage.checkBackSoon') %></p>
    </div>
    <% } %>
  </div>

  <%- include('../default/modern_footer') %>
  <script src="/js/analytics.js"></script>
</body>
</html>
