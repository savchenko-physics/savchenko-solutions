<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= docTitle(problemName === 'all' ? (lang === 'ru' ? 'Все изменения' : 'All Contributions') : ['History', problemName], __('title')) %></title>
    <meta name="description" content="<%= problemName === 'all' ? (lang === 'ru' ? 'История всех изменений решений задач Савченко' : 'Complete history of all contributions to Savchenko Solutions') : 'Contribution history for problem ' + problemName %>" />

    <%- include('default/site_styles') %>
    <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>

    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <link rel="apple-touch-icon" href="/img/logo.png" />

    <script src="/js/vendor/bootstrap.bundle.min.js"></script>

    <style>
        body {
            font-family: var(--ss-font-ui);
            background: var(--ss-surface);
            color: var(--ss-text);
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .cl-container {
            max-width: 960px;
            margin: 0 auto;
            padding: 0 var(--ss-space-6);
            flex: 1;
        }

        /* Breadcrumb */
        .cl-breadcrumb {
            padding: var(--ss-space-4) 0 0;
            font-size: var(--ss-fs-13);
            color: var(--ss-text-secondary);
        }
        .cl-breadcrumb a {
            color: var(--ss-link);
            text-decoration: none;
        }
        .cl-breadcrumb a:hover {
            text-decoration: underline;
        }
        .cl-breadcrumb-sep {
            margin: 0 var(--ss-space-2);
            color: var(--ss-text-tertiary);
        }

        /* Page header */
        .cl-header {
            padding: var(--ss-space-6) 0 var(--ss-space-5);
            border-bottom: 1px solid var(--ss-rule);
        }
        .cl-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: var(--ss-space-4);
            flex-wrap: wrap;
        }
        .cl-title {
            font-size: var(--ss-fs-24);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-navy);
            margin: 0 0 var(--ss-space-1);
        }
        .cl-subtitle {
            font-size: var(--ss-fs-14);
            color: var(--ss-text-secondary);
            margin: 0;
        }
        .cl-cta {
            display: inline-flex;
            align-items: center;
            gap: var(--ss-space-2);
            padding: var(--ss-space-2) var(--ss-space-4);
            background: var(--ss-navy);
            color: var(--ss-on-navy) !important;
            border-radius: var(--ss-radius);
            text-decoration: none;
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-regular);
            transition: background 0.15s ease;
            flex-shrink: 0;
        }
        .cl-cta:hover {
            background: var(--ss-navy-hover);
            color: var(--ss-on-navy) !important;
        }

        /* Stats bar */
        .cl-stats {
            display: flex;
            gap: var(--ss-space-6);
            padding: var(--ss-space-4) 0;
            border-bottom: 1px solid var(--ss-rule);
            font-size: var(--ss-fs-14);
        }
        .cl-stat {
            display: flex;
            align-items: center;
            gap: var(--ss-space-2);
            color: var(--ss-text-secondary);
        }
        .cl-stat-num {
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
        }

        /* Date group */
        .cl-date-group {
            margin-top: var(--ss-space-6);
        }
        .cl-date-header {
            display: flex;
            align-items: center;
            gap: var(--ss-space-3);
            padding: var(--ss-space-2) 0;
            margin-bottom: 0;
        }
        .cl-date-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            color: var(--ss-text-secondary);
        }
        .cl-date-label {
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
        }

        /* Problem group (consecutive edits to one problem) */
        .cl-group {
            margin-top: 0;
        }
        .cl-group + .cl-group {
            margin-top: 0;
        }

        /* Per-problem header: how long the problem took to solve. */
        .cl-group-header {
            display: flex;
            align-items: center;
            gap: var(--ss-space-2);
            padding: var(--ss-space-2) var(--ss-space-4);
            font-size: var(--ss-fs-12);
            color: var(--ss-text-secondary);
            background: var(--ss-surface-alt);
            border-bottom: 1px solid var(--ss-rule);
        }
        .cl-group-header a {
            color: var(--ss-link);
            text-decoration: none;
            font-weight: var(--ss-fw-strong);
        }
        .cl-group-header a:hover {
            color: var(--ss-link-hover);
            text-decoration: underline;
        }

        /* Dashed separator between problem groups, with the time gap labelled. */
        .cl-group-sep {
            display: flex;
            align-items: center;
            gap: var(--ss-space-3);
            margin: var(--ss-space-4) 0;
        }
        .cl-group-sep::before,
        .cl-group-sep::after {
            content: "";
            flex: 1 1 auto;
            border-top: 1px dashed #c0c7d0;
        }
        .cl-group-sep-label {
            flex: 0 0 auto;
            font-size: var(--ss-fs-12);
            color: var(--ss-text-secondary);
            white-space: nowrap;
        }

        /* Bold divider between contributions on different (local) dates. */
        .cl-date-divider {
            display: flex;
            align-items: center;
            gap: var(--ss-space-3);
            margin: var(--ss-space-6) 0;
        }
        .cl-date-divider::before,
        .cl-date-divider::after {
            content: "";
            flex: 1 1 auto;
            border-top: 3px solid var(--ss-navy);
        }
        .cl-date-divider-label {
            flex: 0 0 auto;
            font-size: var(--ss-fs-13);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-navy);
            white-space: nowrap;
        }

        /* Commit list (GitHub style) */
        .cl-commit-list {
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius-lg);
            overflow: hidden;
        }
        .cl-commit-row {
            display: flex;
            align-items: center;
            padding: var(--ss-space-3) var(--ss-space-4);
            border-bottom: 1px solid var(--ss-rule);
            gap: var(--ss-space-3);
            transition: background 0.1s ease;
        }
        .cl-commit-row:last-child {
            border-bottom: none;
        }
        .cl-commit-row:hover {
            background: var(--ss-surface-alt);
        }

        /* Dot badge (git-commit icon style) */
        .cl-commit-badge {
            display: flex;
            align-items: center;
            flex-shrink: 0;
            width: 32px;
            justify-content: center;
            position: relative;
        }
        /* Vertical line connecting dots */
        .cl-commit-row .cl-commit-badge::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 2px;
            background: #dee2e6;
            transform: translateX(-50%);
        }
        .cl-commit-row:first-child .cl-commit-badge::before {
            top: 50%;
        }
        .cl-commit-row:last-child .cl-commit-badge::before {
            bottom: 50%;
        }
        .cl-commit-row:only-child .cl-commit-badge::before {
            display: none;
        }
        .cl-commit-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--ss-navy);
            border: 2px solid #fff;
            box-sizing: content-box;
            position: relative;
            z-index: 1;
        }
        /* Hollow marker for a comment, matching the homepage feed. */
        .cl-commit-row.is-comment .cl-commit-dot {
            background: var(--ss-surface);
            box-shadow: inset 0 0 0 2px #1a5276;
        }
        .cl-commit-dot::before,
        .cl-commit-dot::after {
            content: '';
            position: absolute;
            top: 50%;
            height: 2px;
            width: 10px;
            background: #dee2e6;
            transform: translateY(-50%);
        }
        .cl-commit-dot::before {
            right: 100%;
        }
        .cl-commit-dot::after {
            left: 100%;
        }
        .cl-commit-row.is-new .cl-commit-dot {
            background: var(--ss-success);
        }

        /* Main content area */
        .cl-commit-main {
            flex: 1;
            min-width: 0;
        }
        .cl-commit-title {
            display: flex;
            align-items: baseline;
            gap: var(--ss-space-2);
            flex-wrap: wrap;
        }
        .cl-commit-problem {
            font-weight: var(--ss-fw-strong);
            font-size: var(--ss-fs-14);
            color: var(--ss-link);
            text-decoration: none;
        }
        .cl-commit-problem:hover {
            color: var(--ss-link-hover);
            text-decoration: underline;
        }
        .cl-commit-label {
            font-size: var(--ss-fs-12);
            font-weight: var(--ss-fw-strong);
            padding: 1px var(--ss-space-2);
            border-radius: var(--ss-radius);
            white-space: nowrap;
        }
        .cl-label-new {
            background: var(--ss-success-soft);
            color: var(--ss-success-strong);
        }
        .cl-label-edit {
            background: var(--ss-surface-hover);
            color: var(--ss-text-secondary);
        }
        /* A comment is a different kind of event from an edit; the link tint keeps it
           legible against the green "new solution" and the grey "edit". */
        .cl-label-comment {
            background: #e8eff5;
            color: var(--ss-link);
        }

        .cl-commit-meta {
            display: flex;
            align-items: center;
            gap: var(--ss-space-1);
            margin-top: 2px;
            font-size: var(--ss-fs-13);
            color: var(--ss-text-secondary);
        }
        .cl-commit-avatar {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .cl-commit-user {
            color: var(--ss-text);
            text-decoration: none;
            font-weight: var(--ss-fw-regular);
        }
        .cl-commit-user:hover {
            text-decoration: underline;
            color: var(--ss-link);
        }
        .cl-commit-anon {
            color: var(--ss-text-secondary);
            font-style: italic;
        }

        /* Right-side metadata */
        .cl-commit-right {
            display: flex;
            align-items: center;
            gap: var(--ss-space-3);
            flex-shrink: 0;
        }
        .cl-commit-hash {
            font-size: var(--ss-fs-12);
            font-family: var(--ss-font-mono);
            color: var(--ss-link);
            text-decoration: none;
            background: var(--ss-surface-hover);
            padding: 2px var(--ss-space-2);
            border-radius: var(--ss-radius-sm);
            border: 1px solid var(--ss-rule);
            white-space: nowrap;
        }
        .cl-commit-hash:hover {
            background: #e1e7ed;
            text-decoration: none;
        }
        .cl-commit-time {
            font-size: var(--ss-fs-13);
            color: var(--ss-text-secondary);
            white-space: nowrap;
        }

        /* Empty state */
        .cl-empty {
            text-align: center;
            padding: var(--ss-space-10) var(--ss-space-6);
        }
        .cl-empty-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 16px;
            color: var(--ss-text-tertiary);
        }
        .cl-empty h3 {
            font-size: var(--ss-fs-20);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
            margin: 0 0 var(--ss-space-2);
        }
        .cl-empty p {
            font-size: var(--ss-fs-14);
            color: var(--ss-text-secondary);
            margin: 0 0 var(--ss-space-5);
        }

        /* CTA banner */
        .cl-contribute-banner {
            margin: var(--ss-space-7) 0;
            padding: var(--ss-space-5) var(--ss-space-6);
            background: var(--ss-surface-alt);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius-lg);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--ss-space-4);
            flex-wrap: wrap;
        }
        .cl-banner-text {
            flex: 1;
            min-width: 200px;
        }
        .cl-banner-text h4 {
            font-size: var(--ss-fs-16);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-navy);
            margin: 0 0 var(--ss-space-1);
        }
        .cl-banner-text p {
            font-size: var(--ss-fs-14);
            color: var(--ss-text-secondary);
            margin: 0;
        }

        .cl-show-more-wrap {
            display: flex;
            justify-content: center;
            margin: var(--ss-space-5) 0 var(--ss-space-2);
        }
        .cl-show-more-btn {
            border: 1px solid var(--ss-rule);
            background: var(--ss-surface);
            color: var(--ss-link);
            border-radius: var(--ss-radius);
            padding: var(--ss-space-2) var(--ss-space-4);
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            cursor: pointer;
        }
        .cl-show-more-btn:hover {
            background: var(--ss-surface-alt);
            color: var(--ss-link-hover);
        }

        /* Responsive */
        @media (max-width: 640px) {
            .cl-header-row {
                flex-direction: column;
            }
            .cl-stats {
                flex-wrap: wrap;
                gap: var(--ss-space-3);
            }
            .cl-commit-row {
                padding: var(--ss-space-3) var(--ss-space-3);
                flex-wrap: wrap;
            }
            .cl-commit-right {
                width: 100%;
                justify-content: flex-end;
                margin-top: var(--ss-space-1);
            }
            .cl-commit-badge {
                display: none;
            }
        }
    </style>
    <script src="/js/analytics.js"></script>
</head>

<body>
    <%- include('default/main_site_header', {
        langSwitchEnUrl: '/en/contributions/' + problemName,
        langSwitchRuUrl: '/ru/contributions/' + problemName
    }) %>

    <div class="cl-container">
        <!-- Breadcrumb -->
        <nav class="cl-breadcrumb" aria-label="breadcrumb">
            <a href="/<%= lang %>/"><%= lang === 'ru' ? 'Главная' : 'Home' %></a>
            <span class="cl-breadcrumb-sep">/</span>
            <% if (problemName === 'all') { %>
                <span><%= lang === 'ru' ? 'Все изменения' : 'All Contributions' %></span>
            <% } else { %>
                <a href="/<%= lang %>/<%= problemName %>"><%= problemName %></a>
                <span class="cl-breadcrumb-sep">/</span>
                <span><%= lang === 'ru' ? 'История' : 'History' %></span>
            <% } %>
        </nav>

        <!-- Header -->
        <div class="cl-header">
            <div class="cl-header-row">
                <div>
                    <h1 class="cl-title">
                        <% if (problemName === 'all') { %>
                            <%= lang === 'ru' ? 'Все изменения' : 'All Contributions' %>
                        <% } else { %>
                            <%= lang === 'ru' ? 'История задачи' : 'History for' %> <%= problemName %>
                        <% } %>
                    </h1>
                    <p class="cl-subtitle">
                        <% if (problemName === 'all') { %>
                            <%= lang === 'ru' ? 'Полная история изменений решений. Каждое изменение проверяется сообществом.' : 'Complete record of every solution change. Each contribution is peer-reviewed.' %>
                        <% } else { %>
                            <%= lang === 'ru' ? 'Все редакции этой задачи' : 'Every revision of this problem\'s solution' %>
                        <% } %>
                    </p>
                </div>
                <a href="/<%= lang %>/upload" class="cl-cta">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M7.75 2a.75.75 0 01.75.75V7h4.25a.75.75 0 110 1.5H8.5v4.25a.75.75 0 11-1.5 0V8.5H2.75a.75.75 0 010-1.5H7V2.75A.75.75 0 017.75 2z"/></svg>
                    <%= lang === 'ru' ? 'Добавить решение' : 'Contribute' %>
                </a>
            </div>
        </div>

        <% if (contributions.length > 0) { %>

        <!-- Stats -->
        <div class="cl-stats">
            <div class="cl-stat">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="color: var(--ss-text-secondary);"><path d="M11.93 8.5a4.002 4.002 0 01-7.86 0H.75a.75.75 0 010-1.5h3.32a4.002 4.002 0 017.86 0h3.32a.75.75 0 010 1.5zM10.5 7.75a2.5 2.5 0 10-5 0 2.5 2.5 0 005 0z"/></svg>
                <span class="cl-stat-num"><%= stats.total %></span>
                <%= lang === 'ru' ? 'изменений' : 'contributions' %>
            </div>
            <div class="cl-stat">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="color: var(--ss-text-secondary);"><path d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 010-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5zm10.5-1h-8a1 1 0 00-1 1v6.708A2.486 2.486 0 014.5 9h8zM5 12.25v3.25a.25.25 0 00.4.2l1.45-1.087a.25.25 0 01.3 0L8.6 15.7a.25.25 0 00.4-.2v-3.25a.25.25 0 00-.25-.25h-3.5a.25.25 0 00-.25.25z"/></svg>
                <span class="cl-stat-num"><%= stats.uniqueProblems %></span>
                <%= lang === 'ru' ? 'задач' : 'problems' %>
            </div>
            <div class="cl-stat">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" style="color: var(--ss-text-secondary);"><path d="M2 5.5a3.5 3.5 0 115.898 2.549 5.507 5.507 0 013.034 4.084.75.75 0 11-1.482.235 4.001 4.001 0 00-7.9 0 .75.75 0 01-1.482-.236A5.507 5.507 0 013.102 8.05 3.49 3.49 0 012 5.5zM11 4a.75.75 0 100 1.5 1.5 1.5 0 01.666 2.844.75.75 0 00-.416.672v.352a.75.75 0 00.574.73c1.2.289 2.162 1.2 2.522 2.372a.75.75 0 101.434-.44 5.01 5.01 0 00-2.56-3.012A3 3 0 0011 4zM5.5 3a2 2 0 100 4 2 2 0 000-4z"/></svg>
                <span class="cl-stat-num"><%= stats.uniqueContributors %></span>
                <%= lang === 'ru' ? 'авторов' : 'contributors' %>
            </div>
        </div>

        <!-- Grouped by problem: consecutive edits to the same problem form one window -->
        <% groups.forEach((group, gi) => { %>
        <% if (gi > 0) { %>
        <div class="cl-group-sep" role="separator">
            <span class="cl-group-sep-label"><%= group.sepLabel %></span>
        </div>
        <% } %>
        <div class="cl-group">
            <div class="cl-commit-list">
                <div class="cl-group-header">
                    <span><%= group.solvedPrefix %></span>
                    <a href="/<%= group.language %>/<%= group.problemName %>"><%= group.problemName %></a>
                    <% if (group.spanDur) { %>
                        <span><%= group.solvedInWord %> <%= group.spanDur %></span>
                    <% } %>
                </div>
                <% group.rows.forEach(contribution => { %>
                <div class="cl-commit-row<%= contribution.isNew ? ' is-new' : '' %><%= contribution.isComment ? ' is-comment' : '' %>">
                    <div class="cl-commit-badge">
                        <div class="cl-commit-dot"></div>
                    </div>
                    <div class="cl-commit-main">
                        <div class="cl-commit-title">
                            <a href="/<%= contribution.language %>/<%= contribution.problem_name %>" class="cl-commit-problem"><%= contribution.problem_name %></a>
                            <% if (contribution.isComment) { %>
                                <span class="cl-commit-label cl-label-comment"><%= lang === 'ru' ? 'комментарий' : 'comment' %></span>
                            <% } else if (contribution.isNew) { %>
                                <span class="cl-commit-label cl-label-new"><%= lang === 'ru' ? 'новое' : 'new solution' %></span>
                            <% } else { %>
                                <span class="cl-commit-label cl-label-edit"><%= lang === 'ru' ? 'правка' : 'edit' %></span>
                            <% } %>
                        </div>
                        <div class="cl-commit-meta">
                            <% if (contribution.username) { %>
                                <span class="avatar-presence">
                                    <img src="<%= contribution.profile_picture || '/img/profile_images/Default_placeholder.svg' %>"
                                         alt="" class="cl-commit-avatar" width="20" height="20" loading="lazy" />
                                    <% if (contribution.isOnline) { %><span class="online-dot" title="<%= lang === 'ru' ? 'В сети' : 'Online' %>"></span><% } %>
                                </span>
                                <a href="/user/<%= contribution.username %>" class="cl-commit-user"><%= contribution.username %></a>
                            <% } else { %>
                                <span class="cl-commit-anon"><%= lang === 'ru' ? 'Аноним' : 'Anonymous' %></span>
                            <% } %>
                            <span><time class="cl-local-time" datetime="<%= new Date(contribution.edited_at).toISOString() %>"><%= formatDate(contribution.edited_at) %></time></span>
                        </div>
                    </div>
                    <div class="cl-commit-right">
                        <% if (contribution.isComment) { %>
                            <%# A comment has no diff to show; go to it in the thread instead. %>
                            <a href="/<%= contribution.language %>/<%= encodeURIComponent(contribution.problem_name) %>#comment-<%= contribution.id %>" class="cl-commit-hash" title="<%= lang === 'ru' ? 'Открыть обсуждение' : 'Open the discussion' %>"><%= lang === 'ru' ? 'к обсуждению' : 'thread' %></a>
                        <% } else { %>
                            <a href="/<%= contribution.language %>/contributions/<%= contribution.id %>" class="cl-commit-hash" title="<%= lang === 'ru' ? 'Посмотреть изменения' : 'View changes' %>">#<%= contribution.id %></a>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
        <% }); %>

        <% if (pagination && pagination.hasMore) { %>
        <div class="cl-show-more-wrap">
            <a
                class="cl-show-more-btn"
                href="/<%= lang %>/contributions/<%= problemName %>?offset=<%= pagination.nextOffset %>&limit=<%= pagination.limit %>">
                <%= lang === 'ru' ? 'Показать ещё' : 'Show more' %>
                (<%= stats.total - pagination.nextOffset %>)
            </a>
        </div>
        <% } %>

        <!-- Contribute banner -->
        <div class="cl-contribute-banner">
            <div class="cl-banner-text">
                <h4><%= lang === 'ru' ? 'Помогите расширить коллекцию' : 'Help expand the collection' %></h4>
                <p><%= lang === 'ru' ? '507 задач ещё не имеют решений. Каждое решение проходит рецензию и лицензируется CC BY-SA 4.0.' : 'Hundreds of problems still need solutions. Every contribution is peer-reviewed and licensed CC BY-SA 4.0.' %></p>
            </div>
            <a href="/<%= lang %>/upload" class="cl-cta">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v14"/><path d="M6 9l6-6 6 6"/><path d="M5 19h14"/></svg>
                <%= lang === 'ru' ? 'Загрузить решение' : 'Upload Solution' %>
            </a>
        </div>

        <% } else { %>

        <!-- Empty state -->
        <div class="cl-empty">
            <div class="cl-empty-icon">
                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M11.93 8.5a4.002 4.002 0 01-7.86 0H.75a.75.75 0 010-1.5h3.32a4.002 4.002 0 017.86 0h3.32a.75.75 0 010 1.5zM10.5 7.75a2.5 2.5 0 10-5 0 2.5 2.5 0 005 0z"/></svg>
            </div>
            <h3><%= lang === 'ru' ? 'Нет записей' : 'No contributions yet' %></h3>
            <p><%= lang === 'ru' ? 'Эта задача ещё не имеет истории изменений.' : 'This problem doesn\'t have any recorded contributions yet.' %></p>
            <% if (problemName !== 'all') { %>
            <a href="/<%= lang %>/edit/<%= problemName %>" class="cl-cta">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M11.013 1.427a1.75 1.75 0 012.474 0l1.086 1.086a1.75 1.75 0 010 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 01-.927-.928l.929-3.25a1.75 1.75 0 01.445-.758l8.61-8.61zm1.414 1.06a.25.25 0 00-.354 0L3.463 11.1a.25.25 0 00-.064.108l-.563 1.97 1.971-.564a.25.25 0 00.108-.064l8.609-8.61a.25.25 0 000-.353l-1.086-1.086z"/></svg>
                <%= lang === 'ru' ? 'Добавить решение' : 'Be the first to contribute' %>
            </a>
            <% } %>
        </div>

        <% } %>
    </div>

    <%- include('default/modern_footer') %>

    <script>
      // Server emits the timestamp in its own timezone (UTC). Reformat to the
      // viewer's local timezone using the ISO value carried on datetime=.
      document.addEventListener('DOMContentLoaded', () => {
        const isRu = document.documentElement.lang === 'ru';
        document.querySelectorAll('.cl-local-time[datetime]').forEach(el => {
          const d = new Date(el.getAttribute('datetime'));
          if (isNaN(d.getTime())) return;
          el.textContent = d.toLocaleString(isRu ? 'ru-RU' : 'en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
        });

        // Separate groups from different (local) dates with a bold divider.
        // Uses each group's representative (newest) timestamp, in the viewer's
        // local timezone, so the boundary matches the dates shown above.
        let prevDateKey = null;
        document.querySelectorAll('.cl-group').forEach(group => {
          const timeEl = group.querySelector('.cl-local-time[datetime]');
          if (!timeEl) return;
          const d = new Date(timeEl.getAttribute('datetime'));
          if (isNaN(d.getTime())) return;
          const dateKey = d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
          if (prevDateKey !== null && dateKey !== prevDateKey) {
            const divider = document.createElement('div');
            divider.className = 'cl-date-divider';
            divider.setAttribute('role', 'separator');
            const label = d.toLocaleDateString(isRu ? 'ru-RU' : 'en-US', {
              day: 'numeric', month: 'long', year: 'numeric'
            });
            divider.innerHTML = '<span class="cl-date-divider-label">' + label + '</span>';
            // Replace the small time-gap separator at this boundary, if present.
            const preceding = group.previousElementSibling;
            if (preceding && preceding.classList.contains('cl-group-sep')) {
              preceding.style.display = 'none';
              preceding.parentNode.insertBefore(divider, preceding);
            } else {
              group.parentNode.insertBefore(divider, group);
            }
          }
          prevDateKey = dateKey;
        });
      });
    </script>
</body>

</html>