    <!-- b — why a neutral grain is pulled inward -->
    <div class="ss-fig-panel ss-fig-panel--b" data-fig-panel="b">
        <canvas class="ss-fig-canvas" data-fig-canvas="b" role="img"
                aria-label="<%= t('Поляризованная пылинка в неоднородном поле: у ближней к нити грани поле сильнее, поэтому равнодействующая направлена внутрь.', 'A polarized grain in a non-uniform field: the field is stronger on the face nearer the wire, so the net force points inward.') %>"></canvas>
    </div>

    <!-- c — the scaling laws, live -->
    <div class="ss-fig-panel ss-fig-panel--c" data-fig-panel="c">
