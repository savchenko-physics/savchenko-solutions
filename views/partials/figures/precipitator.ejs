            <text x="200.0" y="32.0" text-anchor="middle" fill="#e5194b">+V</text>
            <text x="236.2" y="57.1" text-anchor="middle" fill="#1a1a2e" font-weight="500">R<tspan font-size="11" dy="3.5">0</tspan></text>
            <text x="110.0" y="200.0" text-anchor="end" fill="#1a1a2e" font-weight="500">V<tspan font-weight="400"> = 0</tspan></text>
