<%
/*
 * partials/figures/precipitator.ejs — the interactive figure for problem 6.6.15,
 * the electrostatic precipitator. Registered in lib/solutionFigures.js and injected
 * by post.js immediately after the "Решение" / "Solution" heading.
 *
 * Everything mathematical below is written as plain $…$ text: renderMathInHtml runs
 * over the whole rendered page (post.js:543) and turns it into the same server-side
 * MathJax SVG as the rest of the solution, so the figure's labels are real TeX at no
 * cost to the client. Two rules follow from how that pass works (mathRender.js:142):
 *   - inline math must not cross a line break — renderInlineDollar stops at "\n";
 *   - never write a bare "<" or ">" outside a tag, in maths or in prose. protect()
 *     swallows /<[^>]+>/ wholesale, so a stray "<" eats the text up to the next ">"
 *     along with the tag it lands in. Use &lt; / &gt;; decodeEntities gives TeX the
 *     raw character back.
 */
const isRu = lang === 'ru';
const t = function (ru, en) { return isRu ? ru : en; };
const figCfg = {
    lang: isRu ? 'ru' : 'en',
    strings: {
        play: t('Пуск', 'Play'),
        pause: t('Пауза', 'Pause'),
        fine: t('мелкие пылинки', 'small grains'),
        coarse: t('крупные пылинки', 'large grains'),
        wire: t('нить', 'wire'),
        tube: t('труба', 'tube'),
        stronger: t('поле сильнее', 'stronger field'),
        weaker: t('поле слабее', 'weaker field'),
        net: t('равнодействующая', 'net force'),
        axisX: t('радиус', 'radius'),
        axisX: t('расстояние до нити', 'distance from the wire'),
        axisY: t('сила и поле, у стенки = 1', 'force and field, wall = 1'),
        cTitle: t('чем ближе к нити, тем сильнее поле и больше сила',
                  'closer to the wire: stronger field, larger force'),
        slope: t('наклон', 'slope'),
        force: t('сила', 'force'),
        field: t('поле', 'field'),
        airflow: t('воздух', 'air'),
        settled: t('осело', 'settled'),
        ramp: t('поле от слабого к сильному', 'field from weak to strong'),
        downloadName: 'savchenko-6.6.15-precipitator.png',
        creditLine: 'Visualisation: A. Melnichenka & V. Msryan · savchenkosolutions.com · CC BY-SA 4.0',
        figTitle: t('Рис. 1 | Диэлектрофоретический захват пыли в цилиндрическом электрофильтре',
                    'Fig. 1 | Dielectrophoretic collection of dust in a cylindrical precipitator')
    }
};
