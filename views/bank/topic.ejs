<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <% const topicDisplay = topic.charAt(0).toUpperCase() + topic.slice(1).replace(/-/g, ' '); %>
    <title><%= docTitle(topicDisplay, 'Physics Problem Bank', 'Savchenko Solutions') %></title>
    <meta name="description" content="<%= totalProblems %> <%= topicDisplay.toLowerCase() %> problems. Physics Problem Bank at Savchenko Solutions." />
    <link rel="canonical" href="https://savchenkosolutions.com/bank/topic/<%= topic %>" />

    <%- include('../default/site_styles') %>
    <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <script src="/js/vendor/bootstrap.bundle.min.js"></script>

    <style>
        .bank-list-container { max-width: 900px; margin: 0 auto; padding: var(--ss-space-7) var(--ss-space-4); }
        .bank-list-header { margin-bottom: var(--ss-space-6); }
        .bank-list-header h1 {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-28); font-weight: var(--ss-fw-strong); color: var(--ss-text); margin: 0 0 var(--ss-space-1) 0;
        }
        .bank-list-breadcrumb {
            font-size: var(--ss-fs-13); color: var(--ss-text-secondary); margin-bottom: var(--ss-space-4);
        }
        .bank-list-breadcrumb a { color: var(--ss-link); text-decoration: none; }
        .bank-list-breadcrumb a:hover { text-decoration: underline; }
        .bank-list-meta { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); }

        .problem-table { width: 100%; border-collapse: collapse; }
        .problem-table th {
            text-align: left; font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); text-transform: uppercase;
            letter-spacing: 0.3px; color: var(--ss-text-secondary); padding: var(--ss-space-3) var(--ss-space-2);
            border-bottom: 2px solid var(--ss-rule);
        }
        .problem-table td { padding: var(--ss-space-3) var(--ss-space-2); border-bottom: 1px solid var(--ss-rule-soft); font-size: var(--ss-fs-14); }
        .problem-table tr:hover td { background: var(--ss-surface-alt); }
        .problem-table a { color: var(--ss-link); text-decoration: none; font-weight: var(--ss-fw-strong); }
        .problem-table a:hover { text-decoration: underline; }
        .diff-badge {
            display: inline-block; padding: 0.15rem var(--ss-space-2); border-radius: var(--ss-radius-sm);
            font-size: var(--ss-fs-12); font-weight: var(--ss-fw-strong); color: var(--ss-on-navy);
        }
        .diff-easy { background: var(--ss-success); }
        .diff-medium { background: #f39c12; }
        .diff-hard { background: var(--ss-error); }

        .bank-pagination { display: flex; justify-content: center; gap: var(--ss-space-2); margin-top: var(--ss-space-7); }
        .bank-page-link {
            display: inline-block; padding: var(--ss-space-2) var(--ss-space-3); border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius); font-size: var(--ss-fs-14); text-decoration: none; color: var(--ss-text);
        }
        .bank-page-link:hover { background: var(--ss-surface-alt); }
        .bank-page-link.active { background: var(--ss-navy); color: var(--ss-on-navy); border-color: var(--ss-navy); }

        .empty-state { text-align: center; padding: var(--ss-space-9) var(--ss-space-4); color: var(--ss-text-secondary); }
    </style>
    <script src="/js/analytics.js"></script>
</head>

<body>
    <%- include('../default/main_site_header') %>

    <main class="bank-list-container">
        <div class="bank-list-breadcrumb">
            <a href="/bank"><%= lang === 'ru' ? 'Банк задач' : 'Problem Bank' %></a>
            <span> / </span>
            <span><%= topicDisplay %></span>
        </div>

        <div class="bank-list-header">
            <h1><%= topicDisplay %></h1>
            <p class="bank-list-meta"><%= totalProblems %> <%= lang === 'ru' ? 'задач' : 'problems' %></p>
        </div>

        <% if (problems.length === 0) { %>
        <div class="empty-state">
            <p><%= lang === 'ru' ? 'Задач по этой теме пока нет.' : 'No problems on this topic yet.' %></p>
            <a href="/bank/submit" style="color: var(--ss-link);"><%= lang === 'ru' ? 'Добавить первую задачу' : 'Submit the first problem' %></a>
        </div>
        <% } else { %>
        <table class="problem-table">
            <thead>
                <tr>
                    <th><%= lang === 'ru' ? 'Задача' : 'Problem' %></th>
                    <th><%= lang === 'ru' ? 'Источник' : 'Source' %></th>
                    <th><%= lang === 'ru' ? 'Год' : 'Year' %></th>
                    <th><%= lang === 'ru' ? 'Сложность' : 'Difficulty' %></th>
                </tr>
            </thead>
            <tbody>
                <% problems.forEach(function(p) { %>
                <tr>
                    <td><a href="/bank/problem/<%= p.id %>"><%= p.title || (p.source_name + ' #' + (p.problem_number || p.id)) %></a></td>
                    <td><a href="/bank/source/<%= p.source_slug %>"><%= p.source_name %></a></td>
                    <td><%= p.year || '—' %></td>
                    <td>
                        <% if (p.difficulty) { %>
                            <span class="diff-badge <%= p.difficulty <= 3 ? 'diff-easy' : p.difficulty <= 6 ? 'diff-medium' : 'diff-hard' %>"><%= p.difficulty %></span>
                        <% } else { %>—<% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <% if (totalPages > 1) { %>
        <div class="bank-pagination">
            <% for (let pg = 1; pg <= totalPages; pg++) { %>
                <a href="/bank/topic/<%= topic %>?page=<%= pg %>" class="bank-page-link <%= pg === page ? 'active' : '' %>"><%= pg %></a>
            <% } %>
        </div>
        <% } %>
        <% } %>
    </main>

    <%- include('../default/modern_footer') %>
</body>
</html>
