<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= docTitle(lang === 'ru' ? 'Банк задач по физике' : 'Physics Problem Bank', 'Savchenko Solutions') %></title>
    <meta name="description" content="<%= lang === 'ru'
        ? totalProblems + ' задач из ' + sources.length + ' источников: МФО, АФО, ЕФО, USAPhO, BPhO, Иродов и другие.'
        : totalProblems + ' problems from ' + sources.length + ' sources: IPhO, APhO, EuPhO, USAPhO, BPhO, Irodov, and more.' %>" />
    <link rel="canonical" href="https://savchenkosolutions.com/bank" />

    <%- include('../default/site_styles') %>
    <% var av = (typeof asset === 'function') ? asset : function (p) { return p; }; %>
" />
" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <script src="/js/vendor/bootstrap.bundle.min.js"></script>

    <style>
        .bank-container { max-width: 1100px; margin: 0 auto; padding: var(--ss-space-7) var(--ss-space-4); }
        .bank-header { margin-bottom: var(--ss-space-7); }
        .bank-header h1 {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-28);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
            margin: 0 0 var(--ss-space-1) 0;
        }
        .bank-header p { color: var(--ss-text-secondary); font-size: var(--ss-fs-16); margin: 0; }

        /* Search */
        .bank-search { margin-bottom: var(--ss-space-6); }
        .bank-search-input {
            height: 40px;
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius);
            padding: 0 var(--ss-space-4);
            font-size: var(--ss-fs-16);
            width: 100%;
        }
        .bank-search-input:focus { outline: none; border-color: var(--ss-navy); }

        /* Filter row */
        .bank-filters { display: flex; flex-wrap: wrap; gap: var(--ss-space-3); align-items: center; margin-bottom: var(--ss-space-7); }
        .bank-filter-select {
            height: 40px;
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius);
            padding: 0 var(--ss-space-3);
            font-size: var(--ss-fs-13);
            background: var(--ss-surface);
            color: var(--ss-text);
        }
        .topic-pill {
            display: inline-block;
            padding: var(--ss-space-1) var(--ss-space-3);
            border-radius: var(--ss-radius);
            font-size: var(--ss-fs-13);
            font-weight: var(--ss-fw-strong);
            text-decoration: none;
            border: 1px solid var(--ss-rule);
            color: var(--ss-text-secondary);
            background: var(--ss-surface-alt);
            transition: all 0.15s;
        }
        .topic-pill:hover, .topic-pill--active {
            background: var(--ss-navy);
            color: var(--ss-on-navy);
            border-color: var(--ss-navy);
        }

        /* Random button */
        .random-btn {
            display: inline-flex;
            align-items: center;
            gap: var(--ss-space-2);
            background: var(--ss-navy);
            color: var(--ss-on-navy);
            border: none;
            padding: var(--ss-space-2) var(--ss-space-6);
            border-radius: var(--ss-radius);
            font-size: var(--ss-fs-14);
            font-weight: var(--ss-fw-strong);
            text-decoration: none;
            transition: opacity 0.15s;
        }
        .random-btn,
        .random-btn:visited,
        .random-btn:hover,
        .random-btn:focus,
        .random-btn:active {
            color: var(--ss-on-navy) !important;
            text-decoration: none;
        }
        .random-btn:hover { opacity: 0.85; }

        /* Source cards */
        .source-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--ss-space-4); margin-bottom: var(--ss-space-7); }
        .source-card {
            background: var(--ss-surface-alt);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius-lg);
            padding: var(--ss-space-5);
            text-decoration: none;
            color: var(--ss-text);
            transition: box-shadow 0.15s;
        }
        .source-card:hover { box-shadow: var(--ss-shadow); color: var(--ss-text); }
        .source-card-name {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-16);
            font-weight: var(--ss-fw-strong);
            margin: 0 0 var(--ss-space-1) 0;
        }
        .source-card-meta {
            font-size: var(--ss-fs-13);
            color: var(--ss-text-secondary);
            margin: 0;
        }
        .source-card-count {
            font-size: var(--ss-fs-24);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-navy);
            margin-top: var(--ss-space-2);
        }

        /* POTD */
        .potd-card {
            background: var(--ss-surface);
            border: 2px solid var(--ss-navy);
            border-radius: var(--ss-radius-lg);
            padding: var(--ss-space-6);
            margin-bottom: var(--ss-space-7);
        }
        .potd-label {
            font-size: var(--ss-fs-12);
            font-weight: var(--ss-fw-strong);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--ss-navy);
            margin-bottom: var(--ss-space-2);
        }
        .potd-title {
            font-size: var(--ss-fs-18);
            font-weight: var(--ss-fw-strong);
            margin: 0 0 var(--ss-space-2) 0;
        }
        .potd-title a { color: var(--ss-link); text-decoration: none; }
        .potd-title a:hover { text-decoration: underline; }
        .potd-meta { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); }

        /* Recent problems */
        .recent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--ss-space-4); margin-bottom: var(--ss-space-7); }
        .problem-card {
            background: var(--ss-surface);
            border: 1px solid var(--ss-rule);
            border-radius: var(--ss-radius-lg);
            padding: var(--ss-space-4);
            text-decoration: none;
            color: var(--ss-text);
            transition: box-shadow 0.15s;
        }
        .problem-card:hover { box-shadow: var(--ss-shadow); color: var(--ss-text); }
        .problem-card-title {
            font-size: var(--ss-fs-16);
            font-weight: var(--ss-fw-strong);
            margin: 0 0 var(--ss-space-1) 0;
        }
        .problem-card-meta { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); }
        .diff-badge {
            display: inline-block;
            padding: 0.15rem var(--ss-space-2);
            border-radius: var(--ss-radius-sm);
            font-size: var(--ss-fs-12);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-on-navy);
        }
        .diff-easy { background: var(--ss-success); }
        .diff-medium { background: #f39c12; }
        .diff-hard { background: var(--ss-error); }

        /* Section titles */
        .section-title {
            font-family: var(--ss-font-ui);
            font-size: var(--ss-fs-20);
            font-weight: var(--ss-fw-strong);
            color: var(--ss-text);
            margin: var(--ss-space-7) 0 var(--ss-space-4) 0;
        }

        .search-results-area { display: none; margin-bottom: var(--ss-space-7); }
        .search-results-area.active { display: block; }
        .search-result-item {
            padding: var(--ss-space-3) 0;
            border-bottom: 1px solid var(--ss-rule-soft);
        }
        .search-result-item:last-child { border-bottom: none; }
        .search-result-item a { color: var(--ss-link); text-decoration: none; font-weight: var(--ss-fw-regular); }
        .search-result-item a:hover { text-decoration: underline; }
        .search-result-meta { font-size: var(--ss-fs-13); color: var(--ss-text-secondary); }

        @media (max-width: 767px) {
            .source-grid { grid-template-columns: 1fr; }
            .recent-grid { grid-template-columns: 1fr; }
            .bank-filters { gap: var(--ss-space-2); }
        }
    </style>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Physics Problem Bank",
        "description": "<%= totalProblems %> physics olympiad problems from IPhO, USAPhO, Irodov, and more.",
        "url": "https://savchenkosolutions.com/bank",
        "isPartOf": { "@type": "WebSite", "name": "Savchenko Solutions" }
    }
    </script>
    <script src="/js/analytics.js"></script>
</head>

<body>
    <%- include('../default/main_site_header') %>

    <main class="bank-container">
        <!-- Header -->
        <div class="bank-header">
            <h1><%= lang === 'ru' ? 'Банк задач по физике' : 'Physics Problem Bank' %></h1>
            <p><%= totalProblems %> <%= lang === 'ru' ? 'задач из' : 'problems from' %> <%= sources.length %> <%= lang === 'ru' ? 'источников. Фильтруйте по теме, сложности или олимпиаде.' : 'sources. Filter by topic, difficulty, or competition.' %></p>
        </div>

        <!-- Search -->
        <div class="bank-search">
            <input
                type="text"
                id="bankSearchInput"
                class="bank-search-input"
                placeholder="<%= lang === 'ru' ? 'Поиск по ключевому слову, теме или номеру задачи...' : 'Search by keyword, topic, or problem number...' %>"
            />
        </div>

        <!-- Filters -->
        <div class="bank-filters">
            <select id="bankFilterSource" class="bank-filter-select">
                <option value=""><%= lang === 'ru' ? 'Все источники' : 'All sources' %></option>
                <% sources.forEach(function(s) { %>
                    <option value="<%= s.slug %>"><%= s.name %></option>
                <% }); %>
            </select>

            <select id="bankFilterDifficulty" class="bank-filter-select">
                <option value=""><%= lang === 'ru' ? 'Любая сложность' : 'Any difficulty' %></option>
                <% for (let d = 1; d <= 10; d++) { %>
                    <option value="<%= d %>"><%= d %>/10</option>
                <% } %>
            </select>

            <a href="/bank/random" class="random-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
                </svg>
                <%= lang === 'ru' ? 'Случайная задача' : 'Random Problem' %>
            </a>
        </div>

        <!-- Topic pills -->
        <% if (allTopics.length > 0) { %>
        <div style="margin-bottom: var(--ss-space-6); display: flex; flex-wrap: wrap; gap: var(--ss-space-2);">
            <% allTopics.forEach(function(t) { %>
                <a href="/bank/topic/<%= t %>" class="topic-pill"><%= t.charAt(0).toUpperCase() + t.slice(1).replace(/-/g, ' ') %></a>
            <% }); %>
        </div>
        <% } %>

        <!-- Search results (shown dynamically) -->
        <div id="bankSearchResults" class="search-results-area">
            <h3 class="section-title"><%= lang === 'ru' ? 'Результаты поиска' : 'Search Results' %></h3>
            <div id="bankSearchList"></div>
            <p id="bankSearchEmpty" style="display:none; color: var(--ss-text-secondary);">
                <%= lang === 'ru' ? 'Ничего не найдено.' : 'No results found.' %>
            </p>
        </div>

        <!-- Problem of the Day -->
        <% if (potd) { %>
        <div class="potd-card">
            <div class="potd-label"><%= lang === 'ru' ? 'Задача дня' : 'Problem of the Day' %></div>
            <h3 class="potd-title">
                <a href="/bank/problem/<%= potd.id %>"><%= potd.title || (potd.source_name + ' — ' + (potd.problem_number || 'Problem')) %></a>
            </h3>
            <div class="potd-meta">
                <a href="/bank/source/<%= potd.source_slug %>" style="color: var(--ss-link); text-decoration: none;"><%= potd.source_name %></a>
                <% if (potd.year) { %> · <%= potd.year %><% } %>
                <% if (potd.difficulty) { %>
                    · <span class="diff-badge <%= potd.difficulty <= 3 ? 'diff-easy' : potd.difficulty <= 6 ? 'diff-medium' : 'diff-hard' %>"><%= potd.difficulty %>/10</span>
                <% } %>
            </div>
        </div>
        <% } %>

        <!-- Sources -->
        <h2 class="section-title"><%= lang === 'ru' ? 'Источники' : 'Sources' %></h2>
        <div class="source-grid">
            <% sources.forEach(function(s) { %>
            <a href="/bank/source/<%= s.slug %>" class="source-card">
                <h3 class="source-card-name"><%= s.name %></h3>
                <p class="source-card-meta"><%= s.country %></p>
                <div class="source-card-count"><%= s.problem_count %></div>
                <p class="source-card-meta"><%= lang === 'ru' ? 'задач' : 'problems' %></p>
            </a>
            <% }); %>
        </div>

        <!-- Recent problems -->
        <% if (recentProblems.length > 0) { %>
        <h2 class="section-title"><%= lang === 'ru' ? 'Недавно добавленные' : 'Recently Added' %></h2>
        <div class="recent-grid">
            <% recentProblems.forEach(function(p) { %>
            <a href="/bank/problem/<%= p.id %>" class="problem-card">
                <h4 class="problem-card-title"><%= p.title || (p.source_name + ' #' + (p.problem_number || p.id)) %></h4>
                <div class="problem-card-meta">
                    <%= p.source_name %>
                    <% if (p.difficulty) { %>
                        · <span class="diff-badge <%= p.difficulty <= 3 ? 'diff-easy' : p.difficulty <= 6 ? 'diff-medium' : 'diff-hard' %>"><%= p.difficulty %>/10</span>
                    <% } %>
                    <% if (p.topics && p.topics.length) { %>
                        · <%= p.topics.slice(0, 3).join(', ') %>
                    <% } %>
                </div>
            </a>
            <% }); %>
        </div>
        <% } %>

        <!-- Submit CTA -->
        <div style="text-align: center; padding: var(--ss-space-7) 0 var(--ss-space-4);">
            <p style="color: var(--ss-text-secondary); font-size: var(--ss-fs-16); margin-bottom: var(--ss-space-4);">
                <%= lang === 'ru' ? 'Знаете хорошую задачу? Добавьте её в банк.' : 'Know a good problem? Add it to the bank.' %>
            </p>
            <a href="/bank/submit" class="random-btn" style="background: var(--ss-link);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                <%= lang === 'ru' ? 'Добавить задачу' : 'Submit a Problem' %>
            </a>
        </div>
    </main>

    <%- include('../default/modern_footer') %>

    <script>
        (function() {
            const input = document.getElementById('bankSearchInput');
            const sourceFilter = document.getElementById('bankFilterSource');
            const diffFilter = document.getElementById('bankFilterDifficulty');
            const resultsArea = document.getElementById('bankSearchResults');
            const resultsList = document.getElementById('bankSearchList');
            const emptyMsg = document.getElementById('bankSearchEmpty');

            let debounce = null;

            function doSearch() {
                const q = input.value.trim();
                const source = sourceFilter.value;
                const difficulty = diffFilter.value;

                if (!q && !source && !difficulty) {
                    resultsArea.classList.remove('active');
                    return;
                }

                const params = new URLSearchParams();
                if (q) params.set('q', q);
                if (source) params.set('source', source);
                if (difficulty) params.set('difficulty', difficulty);

                fetch('/bank/api/search?' + params.toString())
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        resultsArea.classList.add('active');
                        resultsList.innerHTML = '';
                        emptyMsg.style.display = data.problems.length === 0 ? 'block' : 'none';

                        data.problems.forEach(function(p) {
                            const div = document.createElement('div');
                            div.className = 'search-result-item';

                            let diffHtml = '';
                            if (p.difficulty) {
                                const cls = p.difficulty <= 3 ? 'diff-easy' : p.difficulty <= 6 ? 'diff-medium' : 'diff-hard';
                                diffHtml = ' <span class="diff-badge ' + cls + '">' + p.difficulty + '/10</span>';
                            }

                            div.innerHTML = '<a href="/bank/problem/' + p.id + '">' +
                                (p.title || p.source_name + ' #' + (p.problem_number || p.id)) +
                                '</a>' +
                                '<div class="search-result-meta">' + p.source_name +
                                (p.year ? ' · ' + p.year : '') + diffHtml + '</div>';

                            resultsList.appendChild(div);
                        });
                    })
                    .catch(function() {});
            }

            input.addEventListener('input', function() {
                clearTimeout(debounce);
                debounce = setTimeout(doSearch, 300);
            });
            sourceFilter.addEventListener('change', doSearch);
            diffFilter.addEventListener('change', doSearch);
        })();
    </script>
</body>
</html>
