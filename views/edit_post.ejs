                    <path d="M15 7H3.83L7.41 3.41L6 2L0 8L6 14L7.41 12.59L3.83 9H15V7Z" fill="currentColor" />
                </svg>
                <span>
                    <%= __('post.backLink') %>
                </span>
            </a>
            <% if (userId) { %>
