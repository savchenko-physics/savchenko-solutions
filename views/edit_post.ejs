    <script>
        /* The editor's libraries are `defer`red in <head> so the page can paint before
           ~250 KB of JavaScript has parsed. Deferred scripts run before this event, so
           CodeMirror, marked and DraftState are all defined by the time this begins.
           Everything below stays inside the handler; nothing outside it refers to any of
           these names (checked: the only inline handler in the template is a
           `this.parentElement` one-liner, and the saveError block below is standalone). */
        document.addEventListener('DOMContentLoaded', function () {
        // Define custom mixed mode for Markdown + LaTeX
        CodeMirror.defineMode("markdown-latex", function (config) {
            const markdownMode = CodeMirror.getMode(config, "markdown");

            // Helper function to handle LaTeX commands
            function handleLatexCommand(stream) {
                if (stream.match(/^\\[a-zA-Z]+/)) {
                    return "math-command";
                }
                return null;
            }

            // Helper function to handle brackets in math mode
            function handleBrackets(stream) {
                if (stream.match(/[{}]/)) {
                    return "math-bracket";  // New token type for brackets in math mode
                }
                return null;
            }

            return CodeMirror.multiplexingMode(markdownMode, {
                open: "$$", close: "$$",
                mode: {
                    token: function (stream, state) {
                        // Check for brackets first
                        const bracket = handleBrackets(stream);
                        if (bracket) return bracket;

                        // Check for LaTeX commands
                        const command = handleLatexCommand(stream);
                        if (command) return command;

                        if (stream.match(/^.*?\$\$/)) {
                            return "math";
                        }
                        stream.next();
                        return "math";
                    }
                },
                delimStyle: "delim"
            }, {
                open: "$", close: "$",
                mode: {
                    token: function (stream, state) {
                        // Check for brackets first
                        const bracket = handleBrackets(stream);
                        if (bracket) return bracket;

                        // Check for LaTeX commands
                        const command = handleLatexCommand(stream);
                        if (command) return command;

                        if (stream.match(/^.*?\$/)) {
                            return "math";
                        }
                        stream.next();
                        return "math";
                    }
                },
                delimStyle: "delim"
            }, {
                open: "\\[", close: "\\]",
                mode: {
                    token: function (stream, state) {
                        // Check for brackets first
                        const bracket = handleBrackets(stream);
                        if (bracket) return bracket;

                        // Check for LaTeX commands
                        const command = handleLatexCommand(stream);
                        if (command) return command;

                        if (stream.match(/^.*?\\\]/)) {
                            return "math";
                        }
                        stream.next();
                        return "math";
                    }
                },
                delimStyle: "delim"
            }, {
                open: "\\(", close: "\\)",
                mode: {
                    token: function (stream, state) {
                        // Check for brackets first
                        const bracket = handleBrackets(stream);
                        if (bracket) return bracket;

                        // Check for LaTeX commands
                        const command = handleLatexCommand(stream);
                        if (command) return command;

                        if (stream.match(/^.*?\\\)/)) {
                            return "math";
                        }
                        stream.next();
                        return "math";
                    }
                },
                delimStyle: "delim"
            });
        });

        const editor = CodeMirror(document.getElementById('editor'), {
            value: `<%- content.replace(/\\/g, '\\\\').replace(/\$/g, '\\$') %>`,
            mode: 'markdown-latex',
            lineNumbers: true,
            lineWrapping: true,
            theme: 'neat',
            viewportMargin: Infinity,
            styleActiveLine: true,
            matchBrackets: true,
            autoCloseBrackets: true
        });

        const preview = document.getElementById('preview');
        const resizer = document.getElementById('resizer');

        /* Render Markdown and LaTeX.
           `lastPreviewHtml` matters more than it looks: without it every keystroke
           replaced the whole pane, which threw away and rebuilt any video iframe in it
           (re-downloading the player, megabytes at a time) and re-typeset every formula
           on the page. Cursor movement and selection changes fire 'change' too. */
        let lastPreviewHtml = null;

        function renderPreview(content) {
            /* The same repair mathRender.js applies before the page is published, so a
               formula cannot look broken here and correct there (or the reverse). */
            if (window.TexNormalize) content = window.TexNormalize.normalizeTex(content);

            content = content.replace(/\\\[/g, '\\\\[').replace(/\\\]/g, '\\\\]');
            content = content.replace(/\\\(/g, '\\\\(').replace(/\\\)/g, '\\\\)');

            let html = window.marked.parse(transformImageMarkdown(content.replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\*/g, "\\*").replace(/~/g, "\\~")));
            // Apply custom image and YouTube transformations
            html = html.replace(/<em>/g, "_").replace(/<\/em>/g, "_");
            html = html.replace(/\\\*/g, "*");

            if (html === lastPreviewHtml) return;
            lastPreviewHtml = html;

            preview.innerHTML = html;
            if (typeof MathJax !== 'undefined' && MathJax.typesetPromise) {
                MathJax.typesetPromise([preview]);
            }
        }

        const PREVIEW_DEBOUNCE_MS = 200;
        let previewTimer = null;
        function schedulePreview() {
            clearTimeout(previewTimer);
            previewTimer = setTimeout(() => renderPreview(editor.getValue()), PREVIEW_DEBOUNCE_MS);
        }

        // Add the transformImageMarkdown function
        function transformImageMarkdown(htmlContent) {
            // Regular expression for YouTube URL format
            const youtubeRegex = /!\[\]\((https:\/\/www\.youtube\.com\/embed\/([a-zA-Z0-9_-]+)(\?t=\d+)?)\)/g;

            /* A placeholder, not an iframe. The published page uses the same click-to-play
               approach (views/default/video_embed.ejs), and here it matters twice over:
               nothing is requested from YouTube — no player, no analytics beacons, several
               megabytes — until someone actually presses play, and an editor whose preview
               is rebuilt while you type must never be able to restart a video. */
            htmlContent = htmlContent.replace(youtubeRegex, (match, youtubeUrl, videoId) => {
                return `<div class="video-container">
                            <button type="button" class="video-placeholder" data-video-url="${youtubeUrl}" aria-label="YouTube">
                                <span class="video-placeholder__play" aria-hidden="true">&#9654;</span>
                                <span class="video-placeholder__id">youtube.com &middot; ${videoId}</span>
                            </button>
                        </div>`;
            });

            // Regular expression for custom image markdown
            const regex = /!\[(.*?)?\|(.*?x.*?)?,?(\d+%)?\]\(\.\.\/\.\.\/img\/(.*?)\/(.*?)\)/g;

            return htmlContent.replace(regex, (match, altText = "", dimensions, scale, folder, filename) => {
                let width = "auto", height = "auto";
                let scalePercentage = "100%";

                if (dimensions) {
                    const [w, h] = dimensions.split("x");
                    width = w ? `${w}px` : "auto";
                    height = h ? `${h.replace("\\, ", "")}px` : "auto";
                }
                if (scale) {
                    scalePercentage = scale;
                }

                return `<center>
              <figure>
                <img src="..\\..\\img\\${folder}\\${filename}"
                  loading="lazy" alt="${altText}" width="${scalePercentage}" style="max-width:${width}; max-height:${height};" />
                <figcaption>${altText}</figcaption>
              </figure>
              </center>`;
            });
        }

        // Initial render
        renderPreview(editor.getValue());

        // Live preview update
        editor.on('change', schedulePreview);

        /* Swap the placeholder for the real player only on an explicit click. Delegated,
           because the preview's contents are replaced as the text changes. */
        preview.addEventListener('click', (e) => {
            const trigger = e.target.closest('.video-placeholder[data-video-url]');
            if (!trigger) return;
            const frame = document.createElement('iframe');
            frame.className = 'video';
            frame.setAttribute('allowfullscreen', '');
            frame.setAttribute('frameborder', '0');
            frame.src = trigger.getAttribute('data-video-url') + (trigger.getAttribute('data-video-url').includes('?') ? '&' : '?') + 'autoplay=1';
            trigger.replaceWith(frame);
            /* lastPreviewHtml is deliberately left alone: while the markdown is unchanged
               renderPreview short-circuits, so a playing video is not torn down under
               the person watching it. */
        });

        // Resizable divider logic
        let isResizing = false;

        resizer.addEventListener('mousedown', (e) => {
            isResizing = true;
            document.body.style.cursor = 'col-resize';
        });

        document.addEventListener('mousemove', (e) => {
            if (!isResizing) return;

            const totalWidth = window.innerWidth;
            const editorWidth = e.clientX;

            if (editorWidth > 100 && editorWidth < totalWidth - 100) {
                const previewWidth = totalWidth - editorWidth - 5; // 5px resizer width
                document.getElementById('editor').style.flexBasis = `${editorWidth}px`;
                document.getElementById('preview').style.flexBasis = `${previewWidth}px`;

                // Update symbol palette width to match editor width
                document.querySelector('.symbol-palette-items').style.width = `${editorWidth}px`;
            }
        });

        document.addEventListener('mouseup', () => {
            if (isResizing) {
                isResizing = false;
                document.body.style.cursor = 'default';
            }
        });

        const saveForm = document.getElementById('save-form');
        const saveButton = document.getElementById('save-button');
        const isLoggedIn = !!saveForm;
        const saveModal = document.getElementById('save-message-modal');
        const saveModalText = document.getElementById('save-msg-modal-text');
        const saveModalClose = document.getElementById('save-msg-modal-close');
        const saveModalBackdrop = saveModal.querySelector('.save-msg-modal__backdrop');

        function showSaveModal(message) {
            saveModalText.textContent = message;
            saveModal.style.display = 'flex';
            saveModal.setAttribute('aria-hidden', 'false');
            saveModalClose.focus();
        }

        function hideSaveModal() {
            saveModal.style.display = 'none';
            saveModal.setAttribute('aria-hidden', 'true');
        }

        saveModalClose.addEventListener('click', hideSaveModal);
        saveModalBackdrop.addEventListener('click', hideSaveModal);

        let hasUnsavedChanges = false;

        /* ── Composition clock ────────────────────────────────────────────────────
           Wall-clock time from opening the editor would be a lie: people leave a tab
           open overnight. This counts a second only while the page is visible AND
           there has been a keystroke within the last two minutes, so it measures
           writing rather than the tab existing. The server clamps it besides — the
           number arrives from the browser and is a claim, not a measurement. */
        /* Three things were wrong with the first version, all of them undercounting:

           1. The clock lived in a page variable, so it reset to zero every time the
              editor reloaded — which uploading an image does. One contributor worked on
              6.3.10 from 10:33 to 12:34 and the site recorded 12 minutes, because two
              image uploads wiped the counter twice. It now accumulates in localStorage
              against the problem, and only a successful save clears it.

           2. Only CodeMirror `change` events counted as activity, so reading your own
              derivation, scrolling, or working the toolbar read as idle. Any interaction
              counts now.

           3. Two minutes of silence ended the session. Deriving a physics result means
              thinking for longer than that with nothing typed; five minutes is a fairer
              line for this kind of writing. */
        const COMPOSE_IDLE_MS = 300000;
        const COMPOSE_KEY = 'compose:<%= lang %>:<%= name %>';

        function readComposeSeconds() {
            try {
                const n = parseInt(localStorage.getItem(COMPOSE_KEY), 10);
                return Number.isFinite(n) && n >= 0 && n <= 6 * 3600 ? n : 0;
            } catch (_) { return 0; }
        }
        function writeComposeSeconds(n) {
            try { localStorage.setItem(COMPOSE_KEY, String(n)); } catch (_) {}
        }
        function clearComposeSeconds() {
            try { localStorage.removeItem(COMPOSE_KEY); } catch (_) {}
        }

        let composeSeconds = readComposeSeconds();
        let lastActivity = Date.now();

        // Anything that shows somebody is still at the page, not only typing into it.
        ['keydown', 'pointerdown', 'pointermove', 'wheel', 'scroll', 'touchstart', 'focus']
            .forEach((evt) => {
                window.addEventListener(evt, () => { lastActivity = Date.now(); },
                    { passive: true, capture: true });
            });

        setInterval(() => {
            if (document.visibilityState !== 'visible') return;
            if (Date.now() - lastActivity > COMPOSE_IDLE_MS) return;
            composeSeconds += 1;
            // Persist once a second so a crash or a reload loses at most one second.
            if (composeSeconds % 5 === 0) writeComposeSeconds(composeSeconds);
        }, 1000);

        // A reload mid-sentence must not lose the tail of the count.
        window.addEventListener('pagehide', () => writeComposeSeconds(composeSeconds));

        /* ── Drafts ───────────────────────────────────────────────────────────────
           The editor saves continuously, like a document editor should. Nobody has to
           press anything for their work to survive closing the tab, losing the network
           or forgetting about it for an hour — a contributor asked for exactly this
           ("надо было черновики хоть отправлять"), after throwing away about ten solved
           problems rather than face retyping them here.

           Three copies of a solution can exist: the published file, the draft on the
           server, and the draft in this browser. js/draft-state.js decides which one the
           editor opens, and it is the same module the server uses to decide whether a
           publish actually changed anything. */
        const DRAFT_KEY = { problemName: '<%= name %>', language: '<%= lang %>' };
        const LOCAL_KEY = 'solDraft:<%= lang %>:<%= name %>';
        const PUBLISHED_CONTENT = editor.getValue();
        const FILE_MODIFIED_AT = <%= typeof fileModifiedAt !== 'undefined' && fileModifiedAt ? fileModifiedAt : 0 %>;

        const DRAFT_DEBOUNCE_MS = 700;    // quiet period after typing stops
        const DRAFT_MIN_GAP_MS = 2000;    // floor between network writes
        const statusEl = document.getElementById('draft-status');

        /* Complete sentences, no interpolation. `__()` runs every string through
           Mustache, and with no values passed a `{{time}}` placeholder is *stripped*
           server-side — which turned "Сохранено в {{time}}" into the dangling
           "Сохранено в ". The exact time lives in the tooltip instead. */
        const TXT_SAVED   = '<%= __('post.draftSaved') %>';
        const TXT_SAVING  = '<%= __('post.draftSaving') %>';
        const TXT_OFFLINE = '<%= __('post.draftOffline') %>';

        let lastDraftSaved = PUBLISHED_CONTENT;
        let lastDraftPostAt = 0;
        let draftTimer = null;
        let draftOffline = false;

        const fmtTime = (d) => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        function setStatus(text, offline, title) {
            if (!statusEl) return;
            if (statusEl.textContent !== text) statusEl.textContent = text || '';
            statusEl.title = title || '';
            statusEl.classList.toggle('is-offline', !!offline);
        }

        /* localStorage is the copy that survives a dead network, which is not a corner
           case here — contributors write from connections where a request simply does
           not arrive. It is written on every change; the server write is debounced. */
        function saveLocal(content) {
            try {
                localStorage.setItem(LOCAL_KEY, JSON.stringify({ content: content, savedAt: Date.now() }));
            } catch (_) { /* private mode or quota — the server copy still applies */ }
        }

        function readLocal() {
            try {
                const raw = localStorage.getItem(LOCAL_KEY);
                if (!raw) return null;
                const parsed = JSON.parse(raw);
                return (parsed && typeof parsed.content === 'string') ? parsed : null;
            } catch (_) { return null; }
        }

        function clearLocal() {
            try { localStorage.removeItem(LOCAL_KEY); } catch (_) {}
        }

        async function saveDraft(force) {
            if (!isLoggedIn) return;
            const content = editor.getValue();
            if (!content.trim() || content === lastDraftSaved) return;
            if (!force && Date.now() - lastDraftPostAt < DRAFT_MIN_GAP_MS) {
                scheduleDraft();
                return;
            }
            lastDraftPostAt = Date.now();
            setStatus(TXT_SAVING);
            try {
                const res = await fetch('/api/drafts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ ...DRAFT_KEY, content: content }),
                });
                if (res.ok) {
                    lastDraftSaved = content;
                    draftOffline = false;
                    setStatus(TXT_SAVED, false, fmtTime(new Date()));
                } else {
                    /* Includes 429. The work is already in localStorage, so the honest
                       message is "not on the server yet", never an error dialog. */
                    draftOffline = true;
                    setStatus(TXT_OFFLINE, true);
                }
            } catch (_) {
                draftOffline = true;
                setStatus(TXT_OFFLINE, true);
            }
        }

        function scheduleDraft() {
            clearTimeout(draftTimer);
            draftTimer = setTimeout(() => saveDraft(false), DRAFT_DEBOUNCE_MS);
        }

        editor.on('change', () => {
            hasUnsavedChanges = true;
            lastActivity = Date.now();
            if (!isLoggedIn) return;
            const content = editor.getValue();
            saveLocal(content);
            /* Flip the label on the keystroke, not when the debounce expires. The
               network write is still debounced, but "Все изменения сохранены" must not
               sit there for a second after the text stopped matching it — that is the
               one moment the line would be actively lying. */
            if (!draftOffline && content !== lastDraftSaved) setStatus(TXT_SAVING);
            scheduleDraft();
        });

        /* Anything that means "the person is leaving this text alone for a moment" is a
           good time to make the server copy current. */
        window.addEventListener('blur', () => saveDraft(true));
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden') saveDraft(true);
        });
        window.addEventListener('online', () => { if (draftOffline) saveDraft(true); });

        /* A closing tab gets one last attempt; keepalive is what lets it survive
           teardown, which a normal fetch does not. */
        window.addEventListener('pagehide', () => {
            if (!isLoggedIn) return;
            const content = editor.getValue();
            if (!content.trim() || content === lastDraftSaved) return;
            saveLocal(content);
            try {
                fetch('/api/drafts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ ...DRAFT_KEY, content: content }),
                    keepalive: true,
                });
            } catch (_) {}
        });

        /* ── Opening: restore whatever is newest ──────────────────────────────── */
        const restoredBar = document.getElementById('draft-restored-bar');

        function showRestored(savedAt) {
            const text = document.getElementById('draft-restored-text');
            if (text) {
                text.textContent = '<%= __('post.draftRestored') %> \u00b7 '
                    + new Date(savedAt).toLocaleString();
            }
            if (restoredBar) restoredBar.classList.add('show');
        }

        async function restoreDraft() {
            if (!isLoggedIn || !window.DraftState) return;
            let serverDraft = null;
            try {
                const res = await fetch('/api/drafts/<%= name %>/<%= lang %>', { credentials: 'same-origin' });
                if (res.ok) {
                    const data = await res.json();
                    if (data && data.draft) {
                        serverDraft = { content: data.draft.content, savedAt: data.draft.updated_at };
                    }
                }
            } catch (_) { /* offline: the local copy below still applies */ }

            const local = readLocal();
            const picked = window.DraftState.pickEditorContent({
                fileContent: PUBLISHED_CONTENT,
                fileModifiedAt: FILE_MODIFIED_AT,
                serverDraft: serverDraft,
                localDraft: local,
            });

            if (picked.source === window.DraftState.SOURCE_FILE) {
                /* Whatever was cached locally is now published or stale; drop it so it
                   cannot come back and overwrite the published text later. */
                if (local) clearLocal();
                setStatus(TXT_SAVED);
                return;
            }

            editor.setValue(picked.content);
            hasUnsavedChanges = false;
            showRestored(picked.savedAt);
            setStatus(TXT_SAVED, false, fmtTime(new Date(picked.savedAt)));

            if (picked.source === window.DraftState.SOURCE_LOCAL) {
                /* The browser copy was ahead of the server — the connection dropped
                   before the last POST landed. Push it now, and deliberately do NOT
                   set lastDraftSaved first: saveDraft short-circuits on equal content,
                   so pre-setting it here would silently skip the very sync this case
                   exists for. */
                saveDraft(true);
            } else {
                lastDraftSaved = picked.content;
            }
        }

        if (isLoggedIn) {
            setStatus(TXT_SAVED);
            restoreDraft();
        }

        const showPublishedLink = document.getElementById('draft-show-published');
        if (showPublishedLink) {
            showPublishedLink.addEventListener('click', (e) => {
                e.preventDefault();
                editor.setValue(PUBLISHED_CONTENT);
                if (restoredBar) restoredBar.classList.remove('show');
            });
        }
        const restoredClose = document.getElementById('draft-restored-close');
        if (restoredClose) {
            restoredClose.addEventListener('click', () => restoredBar.classList.remove('show'));
        }

        /* ── Publishing ───────────────────────────────────────────────────────────
           A real in-flight flag, not just a disabled button. The button was the only
           guard before, and the Ctrl+S handler below never looked at it — so OS key
           repeat (~30 presses/second) fired one independent request per press. That is
           where the duplicate contributions came from: 15 rows inside one second at the
           peak, and one problem written 67 times in a single sitting. */
        const saveButtonLabel = document.getElementById('save-button-label');
        const publishLabel = saveButtonLabel ? saveButtonLabel.textContent : '';
        let publishing = false;

        async function submitSave() {
            if (!isLoggedIn || publishing) return;
            publishing = true;
            const content = editor.getValue();
            document.getElementById('hidden-content').value = content;
            saveButton.disabled = true;
            if (saveButtonLabel) saveButtonLabel.textContent = '<%= __('post.publishing') %>';

            /* Without this a request that never completes leaves the button dead
               forever, which reads as "the site is broken" and starts the retry loop. */
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 30000);

            try {
                const res = await fetch(saveForm.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({
                        content: content,
                        composeSeconds: String(composeSeconds),
                        baseModifiedAt: String(FILE_MODIFIED_AT),
                    }),
                    credentials: 'same-origin',
                    signal: controller.signal
                });

                const ct = res.headers.get('content-type') || '';
                let data = {};
                if (ct.includes('application/json')) {
                    try {
                        data = await res.json();
                    } catch (e) {
                        showSaveModal('<%= lang === "ru" ? "Некорректный ответ сервера." : "Invalid server response." %>');
                        return;
                    }
                }

                if (!res.ok) {
                    const err = data.error || (res.status >= 500
                        ? '<%= lang === "ru" ? "Ошибка сервера при сохранении." : "Server error while saving." %>'
                        : '<%= lang === "ru" ? "Не удалось сохранить." : "Could not save." %>');
                    showSaveModal(err);
                    return;
                }

                if (data.review && data.message) {
                    showSaveModal(data.message);
                    return;
                }

                /* Published, so the browser copy has served its purpose. The clock
                   is cleared here and only here: the seconds just banked belong to the
                   contribution that was saved, and leaving them behind would count them
                   again on the next one. */
                clearLocal();
                clearComposeSeconds();
                composeSeconds = 0;
                hasUnsavedChanges = false;
                window.location.href = data.redirect || '/<%= lang %>/<%= name %>';
            } catch (err) {
                showSaveModal('<%= lang === "ru" ? "Сеть недоступна или запрос прерван. Ваш текст сохранён — попробуйте ещё раз." : "Network error or request was aborted. Your text is saved — try again." %>');
            } finally {
                clearTimeout(timeout);
                publishing = false;
                saveButton.disabled = false;
                if (saveButtonLabel) saveButtonLabel.textContent = publishLabel;
            }
        }

        if (isLoggedIn) {
            saveForm.addEventListener('submit', (e) => {
                e.preventDefault();
                submitSave();
            });
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && saveModal.getAttribute('aria-hidden') === 'false') {
                hideSaveModal();
                return;
            }
            /* Ctrl+S saves a draft. It used to publish, which is the muscle memory that
               put an unfinished solution on the site. Publishing is Ctrl+Enter, or the
               button that says so. */
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                saveDraft(true);
                return;
            }
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                submitSave();
            }
        });

        /* Leaving is only risky when the text never reached anywhere durable. Once
           autosave has it, an unpublished draft is not lost work — it is in Drafts —
           and prompting about it on every exit would be noise that trains people to
           dismiss the one prompt that matters. */
        function hasUnsafeChanges() {
            if (!isLoggedIn) return hasUnsavedChanges;
            const content = editor.getValue();
            if (!content.trim() || content === lastDraftSaved) return false;
            return true;
        }

        // Add click handler to the Go Back button
        document.querySelector('a[href="/<%= lang %>/<%= name %>"]').addEventListener('click', (e) => {
            if (!hasUnsafeChanges()) return;
            e.preventDefault();
            saveDraft(true).finally(() => { window.location.href = '/<%= lang %>/<%= name %>'; });
        });

        // Handle browser navigation (optional, for better coverage)
        window.addEventListener('beforeunload', (e) => {
            if (hasUnsafeChanges()) {
                e.preventDefault();
                e.returnValue = '';
                return '';
            }
        });


        // Add functionality to insert image markdown
        document.querySelectorAll('.list-group-item').forEach(item => {
            item.addEventListener('click', function () {
                // Hide the popover after an item is clicked
                document.querySelector('.ol-cm-toolbar-button-menu-popover').style.display = 'none';
            });
        });

        // Add event listener to the button to trigger file input
        document.getElementById('upload-button').addEventListener('click', function () {
            document.getElementById('file-input').click();
        });

        // Use AJAX to submit the form when a file is selected
        document.getElementById('file-input').addEventListener('change', function () {
            if (this.files.length > 0) { // Check if a file is selected
                const formData = new FormData(document.getElementById('upload-form'));
                const xhr = new XMLHttpRequest();
                xhr.open('POST', document.getElementById('upload-form').action, true);

                xhr.onload = function () {
                    if (xhr.status === 200) {
                        // Parse the JSON response
                        const response = JSON.parse(xhr.responseText);

                        // Extract image path and dimensions
                        const imagePath = response.imagePath;
                        const width = response.width;
                        const height = response.height;

                        // Use the actual dimensions in the markdown
                        const markdown = `![<%= __('post.forProblem') %> \$<%= name %>\$|${width}x${height}, 50%](../..${imagePath})`;
                        editor.replaceSelection(markdown);

                        // Reset file input to allow re-uploading the same file
                        document.getElementById('file-input').value = '';
                    } else {
                        alert('Failed to upload image.');
                    }
                };

                xhr.send(formData);
            }
        });

        document.querySelector('.fa-archive').parentElement.addEventListener('click', function () {
            const modal = document.getElementById('imageModal');
            const imageList = document.getElementById('imageList');
            const name = '<%= name %>';

            fetch(`/img/${name}`)
                .then(response => response.json())
                .then(images => {
                    imageList.innerHTML = ''; // Clear existing content

                    images.forEach(image => {
                        // Create a temporary image to get dimensions
                        const img = new Image();
                        img.src = `/img/${name}/${image}`;

                        img.onload = function () {
                            const listItem = document.createElement('div');
                            listItem.className = 'image-list-item';
                            listItem.onclick = () => insertImageMarkdown(image);

                            listItem.innerHTML = `
                                <img src="/img/${name}/${image}" class="image-thumbnail" alt="${image}">
                                <div class="image-details">
                                    <div class="image-name">${image}</div>
                                    <div class="image-dimensions">${this.width} × ${this.height} <%= __('post.pixels') %></div>
                                    <div class="image-size"><%= __('post.loadingSize') %></div>
                                </div>
                            `;

                            // Get file size
                            fetch(`/img/${name}/${image}`)
                                .then(response => {
                                    const size = response.headers.get('content-length');
                                    const sizeInKB = (size / 1024).toFixed(2);
                                    listItem.querySelector('.image-size').textContent = `${sizeInKB} KB`;
                                });

                            imageList.appendChild(listItem);
                        };
                    });
                    modal.style.display = 'block';
                })
                .catch(error => console.error('Error fetching images:', error));
        });

        document.querySelectorAll('.close').forEach(button => {
            button.addEventListener('click', function () {
                // Find the closest modal and hide it
                const modal = this.closest('.modal');
                if (modal) {
                    modal.style.display = 'none';
                }
            });
        });

        // Close the modal when clicking outside of it
        window.addEventListener('click', function (event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            });
        });

        function insertImageMarkdown(image) {
            const name = '<%= name %>';
            const imageElement = new Image();
            imageElement.src = `/img/${name}/${image}`;

            imageElement.onload = function () {
                const width = this.width;
                const height = this.height;
                const scale = '50%'; // Example scale

                const markdown = `![${image}|${width}x${height}, ${scale}](../../img/${name}/${image})`;
                editor.replaceSelection(markdown);
                document.getElementById('imageModal').style.display = 'none';
            };
        }

        // Show the URL modal when the "From URL" button is clicked
        document.querySelector('.fa-globe').parentElement.addEventListener('click', function () {
            document.getElementById('urlModal').style.display = 'block';
        });

        // Close the URL modal
        document.querySelector('.close-url-modal').onclick = function () {
            document.getElementById('urlModal').style.display = 'none';
        };

        // Insert the URL into the editor
        document.getElementById('insertUrlButton').addEventListener('click', function () {
            let url = document.getElementById('urlInput').value;
            if (url) {
                // Add https:// if the URL doesn't start with http:// or https://
                if (!/^https?:\/\//i.test(url)) {
                    url = 'https://' + url;
                }
                const markdown = `![<%= __('post.forProblem') %> \$<%= name %>\$|123x456, 50%](${url})`;
                editor.replaceSelection(markdown);
                document.getElementById('urlModal').style.display = 'none';
                document.getElementById('urlInput').value = ''; // Clear the input field
            } else {
                alert('Please enter a valid URL.');
            }
        });

        // Close the modal when clicking outside of it
        window.addEventListener('click', function (event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            });
        });

        // Function to adjust editor height
        function adjustEditorHeight() {
            const symbolPalette = document.querySelector('.symbol-palette-items');
            const editor = document.getElementById('editor');
            const observer = new MutationObserver(() => {
                if (symbolPalette.style.display === 'block') {
                    editor.style.height = 'calc(100% - 30vh)'; // Reduce height by the symbol palette's height
                } else {
                    editor.style.height = '100%'; // Reset to full height
                }
            });

            // Observe changes to the 'style' attribute of the symbol palette
            observer.observe(symbolPalette, { attributes: true, attributeFilter: ['style'] });
        }

        // Call adjustEditorHeight once to set up the observer
        adjustEditorHeight();

        // Toggle symbol palette visibility
        document.querySelector('.ol-cm-toolbar-button-math').addEventListener('click', function () {
            const symbolPalette = document.querySelector('.symbol-palette-items');
            if (symbolPalette.style.display === 'none' || symbolPalette.style.display === '') {
                symbolPalette.style.display = 'block';
            } else {
                symbolPalette.style.display = 'none';
            }
            adjustEditorHeight(); // Adjust editor height when toggling
        });

        // Toggle popover visibility for Insert Figure button
        document.querySelector('.ol-cm-toolbar-button[aria-label="Insert Figure"]').addEventListener('click', function () {
            const popover = document.querySelector('.ol-cm-toolbar-button-menu-popover');
            if (popover.classList.contains('show')) {
                popover.classList.remove('show');
                setTimeout(() => popover.style.display = 'none', 300); // Wait for transition to complete
            } else {
                popover.style.display = 'block';
                setTimeout(() => popover.classList.add('show'), 10); // Slight delay to trigger transition
            }
        });

        // Add event listeners to symbol palette items
        document.querySelectorAll('.symbol-palette-item').forEach(button => {
            button.addEventListener('click', function () {
                const command = this.getAttribute('data-command');
                if (command) {
                    editor.replaceSelection(command);
                }
            });
        });

        // Add event listener to the close button in the symbol palette
        document.querySelector('.symbol-palette-close-button').addEventListener('click', function () {
            document.querySelector('.symbol-palette-items').style.display = 'none';
        });

        document.querySelectorAll('.symbol-palette-tab').forEach(tab => {
            tab.addEventListener('click', function () {
                // Deselect all tabs and hide all panels
                document.querySelectorAll('.symbol-palette-tab').forEach(t => {
                    t.setAttribute('aria-selected', 'false');
                    t.setAttribute('tabindex', '-1');
                });
                document.querySelectorAll('.symbol-palette-panel').forEach(panel => {
                    panel.style.display = 'none';
                });

                // Select the clicked tab and show the corresponding panel
                this.setAttribute('aria-selected', 'true');
                this.setAttribute('tabindex', '0');
                const panelId = this.getAttribute('aria-controls');
                document.getElementById(panelId).style.display = 'block';
            });
        });

        // Initialize by showing the first tab and panel
        document.querySelector('.symbol-palette-tab[aria-selected="true"]').click();

        // ── Matrices modal ────────────────────────────────────────────────
        const matrixModal = document.getElementById('matrixModal');
        const matrixBtn = document.getElementById('matrix-btn');
        let matrixMathJaxDone = false;

        function openMatrixModal() {
            matrixModal.style.display = 'flex';
            if (!matrixMathJaxDone && typeof MathJax !== 'undefined' && MathJax.typesetPromise) {
                MathJax.typesetPromise([matrixModal]).then(() => { matrixMathJaxDone = true; });
            }
        }

        matrixBtn.addEventListener('click', openMatrixModal);

        matrixModal.querySelectorAll('.close-matrix-modal').forEach(el => {
            el.addEventListener('click', () => { matrixModal.style.display = 'none'; });
        });

        window.addEventListener('click', (e) => {
            if (e.target === matrixModal) matrixModal.style.display = 'none';
        });

        // Highlight selected matrix type option
        document.querySelectorAll('.matrix-type-option').forEach(opt => {
            opt.addEventListener('click', () => {
                document.querySelectorAll('.matrix-type-option').forEach(o => o.classList.remove('selected'));
                opt.classList.add('selected');
            });
        });

        function generateMatrixLatex(type, rows, cols) {
            const rowArr = [];
            for (let r = 0; r < rows; r++) {
                const cells = [];
                for (let c = 0; c < cols; c++) {
                    cells.push('\\cdot');
                }
                rowArr.push(cells.join(' & '));
            }
            const body = rowArr.join(' \\\\\\\\\n');
            return `$$\\begin{${type}}\n${body}\n\\end{${type}}$$`;
        }

        document.getElementById('applyMatrixBtn').addEventListener('click', () => {
            const type = document.querySelector('input[name="matrixType"]:checked').value;
            const rows = Math.max(1, Math.min(15, parseInt(document.getElementById('matrixRows').value) || 3));
            const cols = Math.max(1, Math.min(15, parseInt(document.getElementById('matrixCols').value) || 3));
            const latex = generateMatrixLatex(type, rows, cols);
            editor.replaceSelection(latex);
            matrixModal.style.display = 'none';
        });

        // ── Equations popover ─────────────────────────────────────────────
        const equationsBtn = document.getElementById('equations-btn');
        const equationsPopover = document.getElementById('equations-popover');

        equationsBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const rect = equationsBtn.getBoundingClientRect();
            equationsPopover.style.top = (rect.bottom + 2) + 'px';
            equationsPopover.style.left = rect.left + 'px';
            equationsPopover.classList.toggle('show');
        });

        document.addEventListener('click', (e) => {
            if (!equationsPopover.contains(e.target) && e.target !== equationsBtn) {
                equationsPopover.classList.remove('show');
            }
        });

        const EQ_TEMPLATES = {
            cases:   '$$\\begin{cases}\n\\cdot & = \\cdot \\\\\\\\\n\\cdot & = \\cdot\n\\end{cases}$$',
            aligned: '$$\\begin{aligned}\nx &= \\cdot \\\\\\\\\ny &= \\cdot\n\\end{aligned}$$',
            gather:  '$$\\begin{gather}\n\\cdot \\\\\\\\\n\\cdot\n\\end{gather}$$',
            split:   '$$\\begin{split}\n\\cdot &= \\cdot \\\\\\\\\n&= \\cdot\n\\end{split}$$'
        };

        document.querySelectorAll('.eq-insert-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const key = btn.getAttribute('data-eq');
                if (EQ_TEMPLATES[key]) {
                    editor.replaceSelection(EQ_TEMPLATES[key]);
                }
                equationsPopover.classList.remove('show');
            });
        });
        }); // DOMContentLoaded
    </script>

    <% if (typeof saveError !== 'undefined' && saveError) { %>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var textEl = document.getElementById('save-msg-modal-text');
            var modal = document.getElementById('save-message-modal');
            if (!textEl || !modal) return;
            textEl.textContent = <%- JSON.stringify(saveError) %>;
            modal.style.display = 'flex';
            modal.setAttribute('aria-hidden', 'false');
        });
    </script>
    <% } %>

</body>

</html>