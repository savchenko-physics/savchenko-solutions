            padding: 0;
            color: initial;
        }

        .fa {
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            display: inline-block;
            font: normal normal normal 14px / 1 FontAwesome;
            font-size: inherit;
