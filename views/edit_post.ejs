        <%# The right-hand group. Saving is continuous and automatic; the status line is
            the only thing that ever reports it. It lives here, where the row is empty,
            rather than in the header: sat between Back and Publish it was squeezed
            between two fixed-width buttons and clipped mid-word. %>
        <% if (userId) { %>
        <div class="toolbar-right">
