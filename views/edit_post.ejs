                style="font-size: 16px; color: #fff; opacity: 0.6; background-color: #666; border-radius: 1px; box-shadow: none; padding: 10px 18px; text-decoration: none; pointer-events: auto;">
                <i class="fa fa-save" aria-hidden="true"></i>
                <span><%= lang === 'ru' ? 'Войдите для сохранения' : 'Log in to save' %></span>
            </a>
            <% } %>
        </div>
    </header>

