        /* Matrix modal */
        .matrix-type-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }
        .matrix-type-option {
            cursor: pointer;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            padding: 10px 6px 8px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            background: #fafafa;
            transition: border-color 0.15s, background 0.15s;
            user-select: none;
        }
        .matrix-type-option:hover { border-color: #1a5276; background: #f0f4f8; }
        .matrix-type-option.selected { border-color: #1a5276; background: #e8f0fb; }
        .matrix-type-option input[type="radio"] { accent-color: #1a5276; }
        .matrix-preview-math { font-size: 13px; line-height: 1.2; min-height: 48px; display: flex; align-items: center; justify-content: center; }
        .matrix-dimensions { display: flex; gap: 20px; margin-bottom: 20px; }
        .matrix-dim-group { flex: 1; }
        .matrix-dim-group label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; }
        .matrix-dim-group input { width: 100%; padding: 8px 12px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 16px; outline: none; box-sizing: border-box; }
        .matrix-dim-group input:focus { border-color: #1a5276; }
        .modal-footer-btns { display: flex; justify-content: flex-end; gap: 10px; }
        .modal-action-btn { padding: 8px 22px; border: none; border-radius: 6px; cursor: pointer; font-size: 15px; font-weight: 500; }
        .modal-action-btn:hover { opacity: 0.85; }
        .modal-action-btn-secondary { background: #6c757d; color: #fff; }
        .modal-action-btn-primary { background: #1a1a2e; color: #fff; }

        /* Equations popover */
        .equations-popover {
            position: fixed;
            background-color: #2f3a4c;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.35);
            z-index: 1002;
            display: none;
            min-width: 230px;
        }
        .equations-popover.show { display: block; }

        /* Toolbar text buttons */
        .toolbar-text-btn {
            width: auto !important;
            padding: 0 10px !important;
            font-size: 12px !important;
            color: rgba(255,255,255,0.85) !important;
            letter-spacing: 0.2px;
            border-left: 1px solid rgba(125,125,125,0.3) !important;
        }

        /* Draft status — the whole report that autosave gives. Calm by default; it must
           never look like an error, because the common state is "everything is fine".
           `margin-left:auto` parks it at the far end of the toolbar, so it grows into
           empty space instead of competing with anything. */
        /* Everything that lives at the empty end of the toolbar. One auto margin on the
           group, not one per child — two competing auto margins would push the drafts
           link and the status apart instead of keeping them together on the right. */
        .toolbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 18px;
            min-width: 0;
        }

        .toolbar-drafts-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.82);
            text-decoration: none;
            white-space: nowrap;
            padding: 3px 8px;
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 5px;
        }
        .toolbar-drafts-link:link,
        .toolbar-drafts-link:visited { color: rgba(255, 255, 255, 0.82); }
        .toolbar-drafts-link:hover {
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.45);
            background: rgba(255, 255, 255, 0.08);
        }
        .toolbar-drafts-count {
            font-variant-numeric: tabular-nums;
            color: rgba(255, 255, 255, 0.58);
        }
        @media (max-width: 700px) {
            .toolbar-drafts-link span:not(.toolbar-drafts-count) { display: none; }
        }

        .draft-status {
            padding-left: 0;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.72);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
        }
        .draft-status.is-offline { color: #ffcf70; }
        /* Below this the toolbar's own buttons need the width more than the reassurance
           does; the restore bar and the Publish button still say everything essential. */
        @media (max-width: 560px) {
            .draft-status { display: none; }
        }

        /* On a phone the header ran out of room and clipped the primary button — it read
           as a bare icon with no label at 380px, before this change too. The problem
           number is already in the URL and the tab title, so the centre label is the one
           thing here that can be given up. `!important` because the buttons carry inline
           styles from long before the no-inline-styles rule. */
        @media (max-width: 640px) {
            .post-title { display: none; }
            .header-right .submit-button {
                font-size: 13px !important;
                padding: 8px 10px !important;
            }
            .header-right .submit-button svg,
            .header-right .submit-button .fa {
                margin-right: 2px;
            }
            /* The wordmark is the widest thing in the row and the least load-bearing
               here — you already know which site you are on, and it stays a link home.
               Measured at a 500px viewport with these rules on: the header row totals
               ~376px and reports zero overflow, so the primary button keeps its full
               label down to the narrowest phones. */
            .header-left .mw-logo-wordmark { max-width: 120px; }
        }

        /* Restore notice — shown once, when the editor opened a draft instead of the
           published text. Sits under the toolbar so it cannot cover the first line. */
        .draft-restored-bar {
            position: fixed;
            top: 72px;
            left: 0;
            right: 0;
            z-index: 999;
            display: none;
            align-items: center;
            gap: 14px;
            padding: 8px 24px;
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            font-size: 13px;
            color: #2d2d2d;
        }
        .draft-restored-bar.show { display: flex; }
        .draft-restored-bar a {
            color: #1a5276;
            text-decoration: none;
        }
        .draft-restored-bar a:hover { color: #0d3b54; text-decoration: underline; }
        .draft-restored-bar button {
            margin-left: auto;
            border: none;
            background: none;
            color: #6c757d;
            font-size: 18px;
            line-height: 1;
            cursor: pointer;
            padding: 0 4px;
        }
    </style>

    <link rel="stylesheet" href="/css/vendor/fontawesome4/css/font-awesome.min.css">
    <link href="/css/vendor/fonts/fonts.css" rel="stylesheet">
    <script src="/js/analytics.js"></script>
</head>

<body>
